# ============================================
# 企业知识库前端 - 环境变量示例
# 复制此文件为 .env 并填写实际值
# ============================================

# API 基础地址（后端服务地址）
PUBLIC_API_BASE=http://localhost:8000

# WebSocket 地址（协同编辑服务）
PUBLIC_WS_URL=ws://localhost:8001

# 应用名称
PUBLIC_APP_NAME=企业知识库

# 应用环境（development / staging / production）
PUBLIC_APP_ENV=development
