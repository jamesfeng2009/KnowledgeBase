---
/**
 * 协同编辑器页面
 * 挂载 CollabEditor React Island（client:only="react"），启用 Yjs 实时协同编辑
 * 顶部工具栏：文档标题 + 保存状态 + 当前用户 + 版本历史
 * 版本历史对接 getDocumentVersions / restoreDocumentVersion
 *
 * 说明：CollabEditor 依赖浏览器 localStorage（wsToken / user），
 * 而 client:only Island 的 props 在服务端序列化无法读取 localStorage，
 * 故通过 CollabEditorMount 包装组件在客户端读取后再渲染 CollabEditor
 * （CollabEditor 与 getUserColor 的导入位于 CollabEditorMount 中，
 *  本页 <script> 中亦按需导入 knowledge API 与 getUserColor）。
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import '@/styles/collab.css';
import CollabEditorMount from '@/components/management/CollabEditorMount';

const breadcrumb = [{ label: '管理', href: '/manage/kb' }, { label: '协同编辑' }];

// WebSocket 服务地址（环境变量，构建期内联）
const wsUrl = import.meta.env.PUBLIC_WS_URL || 'ws://localhost:8001';

// 从 URL 参数获取文档 ID
const docId =
  Astro.url.searchParams.get('docId') ||
  Astro.url.searchParams.get('id') ||
  'new';
---

<DefaultLayout title="协同编辑" breadcrumb={breadcrumb}>
  <!-- 顶部工具栏：标题 + 保存状态 + 当前用户 + 版本历史 -->
  <div class="editor-toolbar">
    <div class="editor-toolbar-left">
      <input
        type="text"
        class="form-input editor-title-input"
        id="doc-title"
        placeholder="文档标题"
      />
      <span class="editor-status" id="save-status">已保存</span>
    </div>
    <div class="editor-toolbar-right">
      <div class="avatar avatar-sm current-user-avatar" id="current-user-avatar" title="当前用户">U</div>
      <button class="btn btn-ghost btn-sm" id="version-btn">版本历史</button>
    </div>
  </div>

  <!-- 协同编辑器 React Island -->
  <div class="editor-wrapper" id="collab-editor-wrapper" data-doc-id={docId}>
    <div class="editor-loading" id="editor-loading">正在加载协同编辑器...</div>
    <CollabEditorMount client:only="react" docId={docId} wsUrl={wsUrl} />
  </div>

  <!-- 版本历史侧边栏 -->
  <div class="version-sidebar" id="version-sidebar" style="display: none;">
    <div class="version-sidebar-header">
      <h3>版本历史</h3>
      <div class="version-sidebar-actions">
        <button class="btn btn-ghost btn-sm" id="refresh-version" title="刷新版本列表">刷新</button>
        <button class="btn btn-ghost btn-sm" id="close-version" title="关闭">✕</button>
      </div>
    </div>
    <div class="version-sidebar-body" id="version-list">
      <div class="version-loading">加载中...</div>
    </div>
  </div>

  <!-- 版本对比模态框 -->
  <div class="version-modal-overlay" id="version-diff-modal" style="display: none;">
    <div class="version-diff-dialog">
      <div class="version-diff-header">
        <h3 id="version-diff-title">版本对比</h3>
        <button class="btn btn-ghost btn-sm" id="close-version-diff" title="关闭">✕</button>
      </div>
      <div class="version-diff-body" id="version-diff-body">
        <div class="version-loading">加载中...</div>
      </div>
      <div class="version-diff-footer">
        <button class="btn btn-ghost btn-sm" id="cancel-version-diff">关闭</button>
        <button class="btn btn-primary btn-sm" id="confirm-restore-version">恢复到此版本</button>
      </div>
    </div>
  </div>
</DefaultLayout>

<style>
  .editor-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .editor-toolbar-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 1;
    min-width: 200px;
  }
  .editor-title-input {
    max-width: 400px;
    font-size: var(--text-md);
    font-weight: 500;
  }
  .editor-status {
    font-size: var(--text-xs);
    color: var(--success);
  }
  .editor-toolbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .current-user-avatar {
    color: var(--text-white);
    font-weight: 600;
  }

  /* 协同编辑器容器（内部由 collab.css 的 .collab-editor 提供边框与圆角） */
  .editor-wrapper {
    position: relative;
    min-height: 500px;
  }
  /* Island 加载占位 */
  .editor-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    z-index: 1;
  }

  /* 版本历史侧边栏 */
  .version-sidebar {
    position: fixed;
    top: 0;
    right: 0;
    width: 360px;
    height: 100vh;
    background: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    display: flex;
    flex-direction: column;
  }
  .version-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .version-sidebar-header h3 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .version-sidebar-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4);
  }
  .version-loading,
  .version-empty {
    padding: var(--space-4);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .version-entry {
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }
  .version-entry:hover {
    border-color: var(--primary);
  }
  .version-entry-head {
    font-weight: 500;
    color: var(--primary);
  }
  .version-entry-time,
  .version-entry-author,
  .version-entry-preview {
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin-top: var(--space-1);
  }
  .version-entry-preview {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* === 版本历史增强样式（P2-4 追加） === */
  /* 侧边栏头部操作按钮组 */
  .version-sidebar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  /* 版本条目头部：版本号 + 当前徽标 */
  .version-entry-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }
  .version-entry-num {
    color: var(--primary);
  }
  .version-entry-badge {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-white);
    background: var(--success);
    padding: 1px var(--space-2);
    border-radius: 4px;
    line-height: 1.4;
  }
  /* 当前版本高亮 */
  .version-entry-current {
    border-color: var(--primary);
    background: rgba(59, 130, 246, 0.06);
  }
  .version-restore-btn {
    margin-top: var(--space-2);
  }
  .btn-xs {
    padding: 2px var(--space-2);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  /* 加载骨架屏 */
  .version-skeleton {
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
  }
  .version-skeleton-line {
    height: 12px;
    border-radius: 4px;
    margin-bottom: var(--space-2);
    background: linear-gradient(90deg, var(--border) 25%, #f1f5f9 37%, var(--border) 63%);
    background-size: 400% 100%;
    animation: version-skeleton-shimmer 1.4s ease infinite;
  }
  .version-skeleton-title {
    width: 30%;
  }
  .version-skeleton-text {
    width: 80%;
  }
  .version-skeleton-text.short {
    width: 50%;
  }
  @keyframes version-skeleton-shimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }

  /* 版本对比模态框 */
  .version-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .version-diff-dialog {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    width: 90%;
    max-width: 960px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }
  .version-diff-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .version-diff-header h3 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .version-diff-body {
    flex: 1;
    overflow: auto;
    padding: var(--space-4) var(--space-5);
  }
  .version-diff-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--border);
  }
  .version-diff-meta {
    margin-bottom: var(--space-3);
    padding: var(--space-3);
    background: #f8fafc;
    border-radius: var(--radius);
  }
  .version-diff-meta-item {
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }
  .version-diff-label {
    color: var(--text-muted);
  }
  .version-diff-hint {
    padding: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    background: #f8fafc;
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
    line-height: 1.6;
  }
  .version-diff-preview {
    margin-top: var(--space-3);
  }
  .version-diff-preview-text {
    margin-top: var(--space-1);
    padding: var(--space-3);
    background: #f8fafc;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    white-space: pre-wrap;
    word-break: break-word;
  }
  /* diff 两栏表格 */
  .version-diff-table {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    font-size: var(--text-xs);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .version-diff-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .version-diff-row-head {
    position: sticky;
    top: 0;
    background: #f8fafc;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
  }
  .version-diff-cell {
    padding: 2px var(--space-3);
    white-space: pre-wrap;
    word-break: break-word;
    border-right: 1px solid var(--border);
    min-height: 22px;
  }
  .version-diff-cell:last-child {
    border-right: none;
  }
  .diff-same {
    color: var(--text-muted);
  }
  .diff-add {
    background: rgba(34, 197, 94, 0.12);
    color: var(--success);
  }
  .diff-del {
    background: rgba(239, 68, 68, 0.12);
    color: var(--danger);
    text-decoration: line-through;
  }
  .diff-empty {
    background: #f8fafc;
  }
</style>

<script>
  import {
    getDocument,
    getDocumentVersions,
    restoreDocumentVersion,
    updateDocument,
    type DocVersion,
  } from '@/lib/apis/knowledge';
  import { getUserColor } from '@/lib/collab';

  // 从页面 data 属性读取 docId（与 Island 接收的一致）
  const wrapperEl = document.getElementById('collab-editor-wrapper');
  const docId: string = wrapperEl?.dataset.docId || 'new';

  // === 当前用户头像（使用 getUserColor 分配稳定光标颜色） ===
  function renderCurrentUser(): void {
    const userRaw = localStorage.getItem('ekb_user');
    let name = '当前用户';
    let id = 'anonymous';
    if (userRaw) {
      try {
        const parsed = JSON.parse(userRaw) as { name?: string; id?: string };
        if (parsed.name) name = parsed.name;
        if (parsed.id) id = parsed.id;
      } catch {
        // 解析失败使用默认值
      }
    }
    const avatarEl = document.getElementById('current-user-avatar');
    if (avatarEl) {
      avatarEl.textContent = name.charAt(0).toUpperCase();
      avatarEl.style.background = getUserColor(id);
      avatarEl.title = name;
    }
  }

  // === 文档加载（仅获取标题，文档内容由 Yjs 通过 WebSocket 自动同步） ===
  async function loadDoc(): Promise<void> {
    if (docId === 'new') return;
    const token = localStorage.getItem('ekb_access_token');
    if (!token) {
      window.location.href = '/auth/login';
      return;
    }
    try {
      const doc = await getDocument(docId);
      const titleInput = document.getElementById('doc-title') as HTMLInputElement | null;
      if (titleInput) titleInput.value = doc.title || '';
    } catch (err) {
      alert(err instanceof Error ? err.message : '加载文档失败');
    }
  }

  // === 标题自动保存（防抖，静默保存；内容由 CollabEditor 负责） ===
  let titleTimer: ReturnType<typeof setTimeout> | null = null;
  const titleInput = document.getElementById('doc-title') as HTMLInputElement | null;
  titleInput?.addEventListener('input', () => {
    if (docId === 'new') return;
    if (titleTimer) clearTimeout(titleTimer);
    titleTimer = setTimeout(async () => {
      if (!titleInput) return;
      try {
        await updateDocument(docId, { title: titleInput.value });
      } catch (err) {
        alert(err instanceof Error ? err.message : '标题保存失败');
      }
    }, 1500);
  });

  // === 保存状态指示器（由 CollabEditor 的 update 事件驱动） ===
  const statusEl = document.getElementById('save-status');
  function setSaveStatus(status: string): void {
    if (!statusEl) return;
    if (status === 'editing') {
      statusEl.textContent = '编辑中...';
      statusEl.style.color = 'var(--warning)';
    } else if (status === 'saving') {
      statusEl.textContent = '保存中...';
      statusEl.style.color = 'var(--info)';
    } else if (status === 'saved') {
      statusEl.textContent = '已保存';
      statusEl.style.color = 'var(--success)';
    } else if (status === 'error') {
      statusEl.textContent = '保存失败';
      statusEl.style.color = 'var(--danger)';
    }
  }
  window.addEventListener('ekb:save-status', (e: Event) => {
    const detail = (e as CustomEvent).detail as { status?: string } | undefined;
    if (detail?.status) setSaveStatus(detail.status);
  });

  // === Island 加载完成后隐藏占位 ===
  window.addEventListener('ekb:collab-ready', () => {
    document.getElementById('editor-loading')?.remove();
  });

  // === 版本历史 ===
  function formatTime(iso: string): string {
    try {
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return iso;
      const pad = (n: number) => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    } catch {
      return iso;
    }
  }

  // 相对时间格式：刚刚 / X分钟前 / X小时前 / X天前 / YYYY-MM-DD HH:mm
  function relativeTime(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    const diff = Date.now() - d.getTime();
    const minute = 60 * 1000;
    const hour = 60 * minute;
    const day = 24 * hour;
    if (diff < minute) return '刚刚';
    if (diff < hour) return `${Math.floor(diff / minute)}分钟前`;
    if (diff < day) return `${Math.floor(diff / hour)}小时前`;
    if (diff < 7 * day) return `${Math.floor(diff / day)}天前`;
    return formatTime(iso);
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // 缓存已加载的版本列表，供对比 / 恢复使用
  let cachedVersions: DocVersion[] = [];
  // 当前对比模态框所对应的版本 ID
  let currentDiffVersionId: string | null = null;

  // 行级 LCS diff，返回 diff 行数组（same=相同, add=当前版本新增, del=历史版本删除）
  type DiffLine = { type: 'same' | 'add' | 'del'; text: string };
  function lineDiff(oldLines: string[], newLines: string[]): DiffLine[] {
    const m = oldLines.length;
    const n = newLines.length;
    const dp: number[][] = Array.from({ length: m + 1 }, () => new Array<number>(n + 1).fill(0));
    for (let i = 1; i <= m; i++) {
      for (let j = 1; j <= n; j++) {
        if (oldLines[i - 1] === newLines[j - 1]) {
          dp[i][j] = dp[i - 1][j - 1] + 1;
        } else {
          dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
        }
      }
    }
    const result: DiffLine[] = [];
    let i = m;
    let j = n;
    while (i > 0 || j > 0) {
      if (i > 0 && j > 0 && oldLines[i - 1] === newLines[j - 1]) {
        result.unshift({ type: 'same', text: oldLines[i - 1] });
        i--;
        j--;
      } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
        result.unshift({ type: 'add', text: newLines[j - 1] });
        j--;
      } else {
        result.unshift({ type: 'del', text: oldLines[i - 1] });
        i--;
      }
    }
    return result;
  }

  // 渲染加载骨架屏
  function renderSkeleton(): string {
    let html = '';
    for (let i = 0; i < 4; i++) {
      html += `<div class="version-skeleton">
        <div class="version-skeleton-line version-skeleton-title"></div>
        <div class="version-skeleton-line version-skeleton-text"></div>
        <div class="version-skeleton-line version-skeleton-text short"></div>
      </div>`;
    }
    return html;
  }

  async function loadVersions(): Promise<void> {
    const list = document.getElementById('version-list');
    if (!list) return;
    list.innerHTML = renderSkeleton();
    if (docId === 'new') {
      cachedVersions = [];
      list.innerHTML = '<div class="version-empty">新文档暂无历史版本</div>';
      return;
    }
    try {
      const versions = await getDocumentVersions(docId);
      cachedVersions = Array.isArray(versions) ? versions.slice() : [];
      if (cachedVersions.length === 0) {
        list.innerHTML = '<div class="version-empty">暂无历史版本</div>';
        return;
      }
      // 按版本号倒序排列（最新在上）
      cachedVersions.sort((a, b) => b.version - a.version);
      const currentVersion = cachedVersions[0];
      list.innerHTML = cachedVersions
        .map((v: DocVersion) => {
          const isCurrent = v.id === currentVersion.id;
          const restoreBtn = isCurrent
            ? ''
            : `<button class="btn btn-ghost btn-xs version-restore-btn" data-version-id="${escapeHtml(v.id)}">恢复到此版本</button>`;
          return `
          <div class="version-entry${isCurrent ? ' version-entry-current' : ''}" data-version-id="${escapeHtml(v.id)}">
            <div class="version-entry-head">
              <span class="version-entry-num">v${v.version}</span>
              ${isCurrent ? '<span class="version-entry-badge">当前</span>' : ''}
            </div>
            <div class="version-entry-time">${escapeHtml(relativeTime(v.created_at))}</div>
            <div class="version-entry-author">编辑者：${escapeHtml(v.author || '未知')}</div>
            ${v.preview ? `<div class="version-entry-preview">${escapeHtml(v.preview)}</div>` : ''}
            ${restoreBtn}
          </div>`;
        })
        .join('');
      // 点击版本条目 → 打开对比模态框
      list.querySelectorAll<HTMLElement>('.version-entry').forEach((el) => {
        el.addEventListener('click', (e) => {
          // 若点击的是恢复按钮，交给恢复按钮处理器
          const target = e.target as HTMLElement;
          if (target.classList.contains('version-restore-btn')) return;
          const versionId = el.dataset.versionId;
          if (!versionId) return;
          void openVersionDiff(versionId);
        });
      });
      // 恢复按钮
      list.querySelectorAll<HTMLElement>('.version-restore-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const versionId = btn.dataset.versionId;
          if (!versionId) return;
          void restoreVersion(versionId);
        });
      });
    } catch (err) {
      list.innerHTML = '<div class="version-empty">加载版本失败</div>';
      alert(err instanceof Error ? err.message : '加载版本历史失败');
    }
  }

  // 获取当前文档内容（用于 diff 右侧）
  async function fetchCurrentContent(): Promise<string> {
    const doc = await getDocument(docId);
    return doc.content || doc.content_text || doc.content_html || '';
  }

  // 打开版本对比模态框
  async function openVersionDiff(versionId: string): Promise<void> {
    const modal = document.getElementById('version-diff-modal');
    const body = document.getElementById('version-diff-body');
    const titleEl = document.getElementById('version-diff-title');
    const confirmBtn = document.getElementById('confirm-restore-version');
    if (!modal || !body) return;
    currentDiffVersionId = versionId;
    modal.style.display = 'flex';
    body.innerHTML = '<div class="version-loading">加载中...</div>';
    const v = cachedVersions.find((x) => x.id === versionId);
    if (titleEl && v) titleEl.textContent = `版本对比 - v${v.version}`;
    // 当前版本不在对比模态框中提供"恢复"按钮（恢复到自身无意义）
    const currentVersion = cachedVersions[0];
    const isCurrent = !!(v && currentVersion && v.id === currentVersion.id);
    if (confirmBtn) confirmBtn.style.display = isCurrent ? 'none' : '';
    try {
      const currentContent = await fetchCurrentContent();
      // DocVersion 接口未包含 content 字段，防御性读取（后端若返回则进行 diff）
      const vAny = v as (DocVersion & { content?: string }) | undefined;
      const historyContent = vAny?.content || '';
      const metaHtml = `
        <div class="version-diff-meta">
          <div class="version-diff-meta-item"><span class="version-diff-label">版本号：</span>v${v?.version ?? '-'}</div>
          <div class="version-diff-meta-item"><span class="version-diff-label">创建时间：</span>${escapeHtml(formatTime(v?.created_at || ''))}（${escapeHtml(relativeTime(v?.created_at || ''))}）</div>
          <div class="version-diff-meta-item"><span class="version-diff-label">编辑者：</span>${escapeHtml(v?.author || '未知')}</div>
        </div>`;
      if (historyContent) {
        // 有内容则渲染左右两栏行级 diff
        const oldLines = historyContent.split('\n');
        const newLines = currentContent.split('\n');
        const diff = lineDiff(oldLines, newLines);
        const diffHtml = diff
          .map((l) => {
            const leftText = l.type === 'add' ? '' : l.text;
            const rightText = l.type === 'del' ? '' : l.text;
            const leftCls = l.type === 'del' ? 'diff-del' : l.type === 'same' ? 'diff-same' : 'diff-empty';
            const rightCls = l.type === 'add' ? 'diff-add' : l.type === 'same' ? 'diff-same' : 'diff-empty';
            return `<div class="version-diff-row"><div class="version-diff-cell ${leftCls}">${leftText ? escapeHtml(leftText) : '&nbsp;'}</div><div class="version-diff-cell ${rightCls}">${rightText ? escapeHtml(rightText) : '&nbsp;'}</div></div>`;
          })
          .join('');
        body.innerHTML = `${metaHtml}
          <div class="version-diff-table">
            <div class="version-diff-row version-diff-row-head">
              <div class="version-diff-cell">历史版本 (v${v?.version ?? '-'})</div>
              <div class="version-diff-cell">当前版本</div>
            </div>
            ${diffHtml}
          </div>`;
      } else {
        // 后端不返回 content，只显示版本元数据
        body.innerHTML = `${metaHtml}
          <div class="version-diff-hint">该版本仅保存了元数据，未返回正文内容，无法进行内容对比。可点击下方"恢复到此版本"将该版本内容恢复到编辑器。</div>
          ${v?.preview ? `<div class="version-diff-preview"><div class="version-diff-label">变更摘要：</div><div class="version-diff-preview-text">${escapeHtml(v.preview)}</div></div>` : ''}`;
      }
    } catch (err) {
      body.innerHTML = `<div class="version-empty">加载版本详情失败：${escapeHtml(err instanceof Error ? err.message : String(err))}</div>`;
    }
  }

  function closeVersionDiff(): void {
    const modal = document.getElementById('version-diff-modal');
    if (modal) modal.style.display = 'none';
    currentDiffVersionId = null;
  }

  // 恢复版本（带确认对话框）
  async function restoreVersion(versionId: string): Promise<void> {
    const v = cachedVersions.find((x) => x.id === versionId);
    const vNum = v?.version ?? '?';
    if (!confirm(`确定要恢复到 v${vNum} 吗？当前内容将被覆盖。`)) return;
    try {
      await restoreDocumentVersion(docId, versionId);
      alert('版本已恢复，编辑器将通过 Yjs 自动同步内容');
      // 刷新版本列表
      await loadVersions();
      // 关闭对比模态框（如在对比中触发恢复）
      closeVersionDiff();
      // 通知编辑器重新加载内容（CollabEditorMount 可监听该事件；Yjs 也会自动同步）
      window.dispatchEvent(new CustomEvent('ekb:version-restored', { detail: { docId, versionId } }));
    } catch (err) {
      alert(err instanceof Error ? err.message : '恢复版本失败');
    }
  }

  // 版本侧边栏开关 + 刷新
  document.getElementById('version-btn')?.addEventListener('click', () => {
    const sidebar = document.getElementById('version-sidebar');
    if (sidebar) sidebar.style.display = 'flex';
    void loadVersions();
  });
  document.getElementById('close-version')?.addEventListener('click', () => {
    const sidebar = document.getElementById('version-sidebar');
    if (sidebar) sidebar.style.display = 'none';
  });
  document.getElementById('refresh-version')?.addEventListener('click', () => {
    void loadVersions();
  });

  // 对比模态框事件
  document.getElementById('close-version-diff')?.addEventListener('click', closeVersionDiff);
  document.getElementById('cancel-version-diff')?.addEventListener('click', closeVersionDiff);
  document.getElementById('version-diff-modal')?.addEventListener('click', (e: MouseEvent) => {
    const overlay = e.currentTarget as HTMLElement | null;
    if (overlay && e.target === overlay) closeVersionDiff();
  });
  document.getElementById('confirm-restore-version')?.addEventListener('click', () => {
    if (currentDiffVersionId) void restoreVersion(currentDiffVersionId);
  });

  // === 初始化 ===
  renderCurrentUser();
  loadDoc();
</script>
