---
/**
 * 知识缺口页面
 * 知识缺口热力图 + 缺口列表 + 处理建议 + 刷新分析
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '管理', href: '/manage/kb' }, { label: '知识缺口' }];
---

<DefaultLayout title="知识缺口" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">知识缺口分析</h1>
    <button class="btn btn-outline" id="refresh-btn">🔄 刷新分析</button>
  </div>

  <!-- 热力图 -->
  <div class="card" style="margin-bottom: var(--space-5);">
    <div class="card-header">
      <h3>缺口热力图</h3>
      <span class="text-muted" style="font-size: var(--text-sm);" id="heatmap-hint">按主题分布的缺口密度</span>
    </div>
    <div id="heatmap-container" style="padding: var(--space-4);">
      <div class="loading-state">加载中...</div>
    </div>
  </div>

  <!-- 缺口列表 -->
  <div class="card">
    <div class="card-header">
      <h3>缺口列表</h3>
      <div style="display: flex; gap: var(--space-3);">
        <select class="form-input" id="gap-status-filter" style="width: 140px;">
          <option value="">全部状态</option>
          <option value="open">待处理</option>
          <option value="ignored">已忽略</option>
          <option value="filled">已填补</option>
        </select>
        <select class="form-input" id="gap-priority-filter" style="width: 140px;">
          <option value="">全部优先级</option>
          <option value="high">高</option>
          <option value="medium">中</option>
          <option value="low">低</option>
        </select>
      </div>
    </div>
    <div id="gap-list">
      <div class="loading-state">加载中...</div>
    </div>
  </div>
</DefaultLayout>

<style>
  .heatmap-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .heatmap-cell {
    aspect-ratio: 1;
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    position: relative;
  }
  .heatmap-cell:hover {
    transform: scale(1.1);
    z-index: 1;
  }
  .heatmap-cell-tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--text);
    color: var(--surface);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
    font-size: var(--text-xs);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
    z-index: 10;
  }
  .heatmap-cell:hover .heatmap-cell-tooltip {
    opacity: 1;
  }
  .gap-item {
    padding: var(--space-4);
    border-bottom: 1px solid var(--border-light);
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: var(--space-4);
    align-items: start;
  }
  .gap-item:last-child {
    border-bottom: none;
  }
  .gap-item-title {
    font-weight: 500;
    color: var(--text);
    margin-bottom: var(--space-2);
  }
  .gap-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .gap-item-suggestion {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
  }
  .gap-item-suggestion-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  .gap-item-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .error-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--danger);
  }
  .priority-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: var(--space-1);
  }
  .priority-high { background: var(--danger); }
  .priority-medium { background: var(--warning); }
  .priority-low { background: var(--info); }
</style>

<script>
  import { getData, putData, postData } from '@/lib/api';

  const BASE = '/api/v1';

  interface Gap {
    id: string;
    title: string;
    description?: string;
    topic?: string;
    category?: string;
    priority: string;
    status: string;
    count?: number;
    suggestion?: string;
    created_at?: string;
    updated_at?: string;
  }

  let allGaps: Gap[] = [];

  function escapeHtml(s: string): string {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  const priorityLabel: Record<string, string> = {
    high: '高',
    medium: '中',
    low: '低',
  };
  const statusLabel: Record<string, string> = {
    open: '待处理',
    ignored: '已忽略',
    filled: '已填补',
  };

  // ===== 加载缺口列表 =====
  async function loadGaps() {
    const container = document.getElementById('gap-list')!;
    container.innerHTML = '<div class="loading-state">加载中...</div>';
    try {
      const result = await getData<Gap[] | { items: Gap[] }>(`${BASE}/manage/knowledge-gaps`);
      let list: Gap[] = [];
      if (Array.isArray(result)) {
        list = result;
      } else if (result && Array.isArray(result.items)) {
        list = result.items;
      }
      allGaps = list;
      renderHeatmap(list);
      renderGapList(list);
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      container.innerHTML = `<div class="error-state">知识缺口加载失败：${escapeHtml(msg)}<br/><button class="btn btn-outline btn-sm" id="retry-gaps" style="margin-top: var(--space-3);">重试</button></div>`;
      document.getElementById('retry-gaps')?.addEventListener('click', loadGaps);
      document.getElementById('heatmap-container')!.innerHTML =
        `<div class="empty-state">热力图数据加载失败</div>`;
    }
  }

  // ===== 热力图：基于真实缺口数据按主题聚合 =====
  function renderHeatmap(gaps: Gap[]) {
    const container = document.getElementById('heatmap-container')!;
    if (!gaps || gaps.length === 0) {
      container.innerHTML = '<div class="empty-state">暂无热力图数据</div>';
      return;
    }
    // 按主题/分类聚合缺口数
    const topicMap: Record<string, number> = {};
    gaps.forEach((g) => {
      const key = g.topic || g.category || '未分类';
      topicMap[key] = (topicMap[key] || 0) + (g.count || 1);
    });
    const topics = Object.entries(topicMap).sort((a, b) => b[1] - a[1]);
    const counts = topics.map((t) => t[1]);
    const maxCount = Math.max(...counts, 1);
    const minCount = Math.min(...counts, 0);

    // 颜色梯度：从浅到深（基于真实缺口数量）
    const colorFor = (count: number): string => {
      const ratio = maxCount === minCount ? 0.5 : (count - minCount) / (maxCount - minCount);
      // 使用 rgba 让强度随缺口数量变化（不再使用 Math.random）
      const alpha = 0.15 + ratio * 0.85;
      return `rgba(59, 130, 246, ${alpha.toFixed(2)})`;
    };

    container.innerHTML = `
      <div class="heatmap-grid">
        ${topics
          .map(
            ([topic, count]) => `
          <div class="heatmap-cell" style="background: ${colorFor(count)};">
            <span>${escapeHtml(topic.length > 4 ? topic.slice(0, 4) + '…' : topic)}</span>
            <div class="heatmap-cell-tooltip">${escapeHtml(topic)}：${count} 个缺口</div>
          </div>`
          )
          .join('')}
      </div>
      <div class="text-muted" style="font-size: var(--text-xs); margin-top: var(--space-3); text-align: right;">
        共 ${topics.length} 个主题，${gaps.length} 个缺口
      </div>`;
  }

  // ===== 缺口列表 =====
  function renderGapList(gaps: Gap[]) {
    const statusFilter = (document.getElementById('gap-status-filter') as HTMLSelectElement).value;
    const priorityFilter = (document.getElementById('gap-priority-filter') as HTMLSelectElement).value;
    // 本地过滤
    let list = gaps.filter((g) => {
      if (statusFilter && g.status !== statusFilter) return false;
      if (priorityFilter && g.priority !== priorityFilter) return false;
      return true;
    });
    const container = document.getElementById('gap-list')!;
    if (list.length === 0) {
      container.innerHTML = '<div class="empty-state">暂无知识缺口</div>';
      return;
    }

    container.innerHTML = list
      .map(
        (g) => `
      <div class="gap-item">
        <div>
          <div class="gap-item-title">${escapeHtml(g.title)}</div>
          <div class="gap-item-meta">
            <span><span class="priority-dot priority-${escapeHtml(g.priority)}"></span>${priorityLabel[g.priority] || g.priority}</span>
            <span class="badge ${g.status === 'ignored' ? 'badge-warning' : g.status === 'filled' ? 'badge-success' : 'badge-primary'}">${statusLabel[g.status] || g.status}</span>
            <span>${escapeHtml(g.topic || g.category || '')}</span>
            <span>${escapeHtml(g.created_at || '')}</span>
          </div>
        </div>
        <div>
          ${g.description ? `<div class="gap-item-suggestion" style="margin-bottom: var(--space-2);">${escapeHtml(g.description)}</div>` : ''}
          <div class="gap-item-suggestion-label">处理建议：</div>
          <div class="gap-item-suggestion">${escapeHtml(g.suggestion || '暂无建议')}</div>
        </div>
        <div class="gap-item-actions">
          ${g.status !== 'ignored' ? `<button class="btn btn-ghost btn-sm" data-action="ignore" data-id="${escapeHtml(g.id)}">忽略</button>` : ''}
          ${g.status !== 'filled' ? `<button class="btn btn-outline btn-sm" data-action="fill" data-id="${escapeHtml(g.id)}">标记已填补</button>` : ''}
        </div>
      </div>`
      )
      .join('');

    container.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = (btn as HTMLElement).dataset.action!;
        const id = (btn as HTMLElement).dataset.id!;
        if (action === 'ignore') await updateGapStatus(id, 'ignored');
        else if (action === 'fill') await updateGapStatus(id, 'filled');
      });
    });
  }

  // ===== 更新缺口状态：调用 PUT /api/v1/manage/knowledge-gaps/{id} =====
  async function updateGapStatus(id: string, status: string) {
    try {
      await putData(`${BASE}/manage/knowledge-gaps/${id}`, { status });
      alert('状态已更新');
      await loadGaps();
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      alert('更新失败：' + msg);
    }
  }

  // ===== 刷新分析：调用 POST /api/v1/manage/knowledge-gaps/refresh 触发重新分析 =====
  async function refreshAnalysis() {
    const btn = document.getElementById('refresh-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = '分析中...';
    try {
      try {
        // 优先尝试 POST 触发后端重新分析
        await postData(`${BASE}/manage/knowledge-gaps/refresh`, {});
        alert('已触发重新分析');
      } catch (err) {
        // 后端无此接口时，回退为重新 GET 加载缺口列表
        // 仅当错误为 404 / 405 时静默回退，其他错误抛出
        const msg = err instanceof Error ? err.message : '';
        if (/404|405|not found|method not allowed/i.test(msg)) {
          // 静默回退到重新加载
        } else {
          throw err;
        }
      }
      await loadGaps();
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      alert('刷新分析失败：' + msg);
    } finally {
      btn.disabled = false;
      btn.textContent = '🔄 刷新分析';
    }
  }

  document.getElementById('refresh-btn')?.addEventListener('click', refreshAnalysis);
  document.getElementById('gap-status-filter')?.addEventListener('change', () => renderGapList(allGaps));
  document.getElementById('gap-priority-filter')?.addEventListener('change', () => renderGapList(allGaps));

  loadGaps();
</script>
