---
/**
 * 文档上传页面
 * 拖拽上传区 + 批量上传 + 上传进度 + 文档分类和标签
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '管理', href: '/manage/kb' }, { label: '文档上传' }];
---

<DefaultLayout title="文档上传" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">文档上传</h1>
  </div>

  <div class="upload-layout">
    <!-- 左侧：上传区 -->
    <div class="upload-main">
      <!-- 拖拽上传区 -->
      <div class="upload-zone" id="upload-zone">
        <div class="upload-zone-icon">📤</div>
        <h3>拖拽文件到此处，或 <span style="color: var(--primary);">点击选择文件</span></h3>
        <p class="text-muted">支持 PDF、Word、Excel、PPT、Markdown、图片、视频、音频等格式，单个文件最大 100MB</p>
        <input type="file" id="file-input" multiple style="display: none;" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.md,.txt,.mp4,.avi,.mov,.mkv,.mp3,.wav,.m4a,.aac,.flac,.ogg,.png,.jpg,.jpeg,.gif,.webp" />
      </div>

      <!-- 上传列表 -->
      <div class="card" id="upload-list-card" style="display: none;">
        <div class="card-header">
          <h3>上传列表</h3>
          <button class="btn btn-ghost btn-sm" id="clear-list">清空</button>
        </div>
        <div id="upload-list"></div>
      </div>
    </div>

    <!-- 右侧：上传设置 -->
    <aside class="upload-settings">
      <div class="card">
        <div class="card-header"><h3>上传设置</h3></div>
        <div class="form-group">
          <label class="form-label">目标知识库 *</label>
          <select class="form-input" id="target-kb">
            <option value="">加载中...</option>
          </select>
          <div id="kb-load-error" class="form-error" style="display: none;"></div>
        </div>
        <div class="form-group">
          <label class="form-label">文档分类</label>
          <select class="form-input" id="doc-category">
            <option value="">不分类</option>
            <option value="policy">制度规范</option>
            <option value="guide">操作指南</option>
            <option value="reference">参考资料</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">标签（逗号分隔）</label>
          <input type="text" class="form-input" id="doc-tags" placeholder="如：人事, 财务, 流程" />
        </div>
        <div class="form-group">
          <label class="form-label">解析选项</label>
          <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); margin-bottom: var(--space-2);">
            <input type="checkbox" id="opt-vlm" checked /> VLM 视觉理解（图片/文档内嵌图片描述）
          </label>
          <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); margin-bottom: var(--space-2);">
            <input type="checkbox" id="opt-asr" checked /> 音频转写（音频/视频 ASR 语音转文本）
          </label>
          <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); margin-bottom: var(--space-2);">
            <input type="checkbox" id="opt-vectorize" checked /> 自动向量化入库
          </label>
          <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm);">
            <input type="checkbox" id="opt-graph" /> 提取知识图谱实体
          </label>
        </div>
      </div>
    </aside>
  </div>
</DefaultLayout>

<style>
  .upload-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-5);
  }
  .upload-zone {
    border: 2px dashed var(--border-dark);
    border-radius: var(--radius-lg);
    padding: var(--space-12);
    text-align: center;
    cursor: pointer;
    transition: all var(--transition);
    background: var(--surface);
  }
  .upload-zone:hover,
  .upload-zone.dragover {
    border-color: var(--primary);
    background: var(--primary-bg);
  }
  .upload-zone-icon {
    font-size: 48px;
    margin-bottom: var(--space-4);
  }
  .upload-zone h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .upload-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-2);
  }
  .upload-item-icon {
    font-size: 24px;
  }
  .upload-item-body {
    flex: 1;
    min-width: 0;
  }
  .upload-item-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .upload-item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-1);
  }
  .progress-bar {
    height: 4px;
    background: var(--surface-muted);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-top: var(--space-2);
  }
  .progress-bar-fill {
    height: 100%;
    background: var(--primary);
    border-radius: var(--radius-full);
    transition: width var(--transition);
  }
  .progress-bar-fill.success {
    background: var(--success);
  }
  .progress-bar-fill.error {
    background: var(--danger);
  }
  /* === 解析进度区域 === */
  .parse-section {
    margin-top: var(--space-3);
    padding: var(--space-3);
    background: var(--surface-muted);
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
  }
  .parse-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .parse-stage-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }
  .parse-stage {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .parse-stage-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--border-dark);
    transition: all var(--transition);
  }
  .parse-stage.active .parse-stage-dot {
    background: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
    animation: pulse 1.4s ease-in-out infinite;
  }
  .parse-stage.done .parse-stage-dot {
    background: var(--success);
  }
  .parse-stage-arrow {
    color: var(--border-dark);
    font-size: 10px;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .parse-result {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .parse-result-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .parse-warnings {
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--warning-bg);
    border-left: 3px solid var(--warning);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--warning);
  }
  .parse-error {
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--danger-bg);
    border-left: 3px solid var(--danger);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--danger);
  }
  .parse-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  @media (max-width: 1024px) {
    .upload-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { getKnowledgeBases, getDocumentSummary } from '@/lib/apis/knowledge';

  const API_BASE = import.meta.env.PUBLIC_API_BASE || 'http://localhost:8000';
  const TOKEN_KEY = 'ekb_access_token';

  interface UploadItem {
    file: File;
    progress: number;
    status: 'pending' | 'uploading' | 'success' | 'error';
    docId?: string;
    parseStatus?: 'pending' | 'processing' | 'completed' | 'failed';
    parseStage?: number; // 0:等待 1:解析中 2:分块 3:向量化 4:完成
    parseWarnings?: string[];
    pageCount?: number;
    charCount?: number;
    parseError?: string;
    polling?: boolean;
  }

  let uploadItems: UploadItem[] = [];
  const fileIconMap: Record<string, string> = {
    pdf: '📄', doc: '📘', docx: '📘', xls: '📊', xlsx: '📊',
    ppt: '📙', pptx: '📙', md: '📝', txt: '📃',
    mp4: '🎬', avi: '🎬', mov: '🎬', mkv: '🎬',
    mp3: '🎵', wav: '🎵', m4a: '🎵', aac: '🎵', flac: '🎵', ogg: '🎵',
    png: '🖼️', jpg: '🖼️', jpeg: '🖼️', gif: '🖼️', webp: '🖼️',
  };

  function getFileIcon(name: string): string {
    const ext = name.split('.').pop()?.toLowerCase() || '';
    return fileIconMap[ext] || '📄';
  }

  function formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1024 / 1024).toFixed(1) + ' MB';
  }

  function addFiles(files: FileList | File[]) {
    Array.from(files).forEach((file) => {
      uploadItems.push({ file, progress: 0, status: 'pending' });
    });
    renderList();
    // 自动开始上传
    uploadItems.filter((i) => i.status === 'pending').forEach(uploadFile);
  }

  async function uploadFile(item: UploadItem) {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      window.location.href = '/auth/login';
      return;
    }
    const kbId = (document.getElementById('target-kb') as HTMLSelectElement).value;
    if (!kbId) {
      alert('请先选择目标知识库');
      return;
    }

    // 读取解析选项
    const vlm = (document.getElementById('opt-vlm') as HTMLInputElement).checked;
    const asr = (document.getElementById('opt-asr') as HTMLInputElement).checked;
    const vectorize = (document.getElementById('opt-vectorize') as HTMLInputElement).checked;
    const graph = (document.getElementById('opt-graph') as HTMLInputElement).checked;

    item.status = 'uploading';
    renderList();

    const formData = new FormData();
    formData.append('file', item.file);
    formData.append('kb_id', kbId);
    // 解析选项发送到后端
    formData.append('enable_vlm', String(vlm));
    formData.append('enable_asr', String(asr));
    formData.append('enable_vectorize', String(vectorize));
    formData.append('enable_graph', String(graph));

    try {
      const xhr = new XMLHttpRequest();
      xhr.open('POST', `${API_BASE}/api/v1/knowledge/documents/upload`);
      xhr.setRequestHeader('Authorization', `Bearer ${token}`);

      xhr.upload.onprogress = (e) => {
        if (e.lengthComputable) {
          item.progress = Math.round((e.loaded / e.total) * 100);
          renderList();
        }
      };

      xhr.onload = () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          item.status = 'success';
          item.progress = 100;
          // 解析返回的 document_id
          try {
            const res = JSON.parse(xhr.responseText);
            const data = res.data || res;
            item.docId = data.id || data.document_id || data.doc_id;
            item.parseStatus = (data.parse_status as UploadItem['parseStatus']) || 'pending';
            item.parseStage = 0;
          } catch {
            // 响应解析失败，忽略
          }
          renderList();
          // 启动解析状态轮询
          if (item.docId) {
            pollParseStatus(item);
          }
        } else {
          item.status = 'error';
          try {
            const res = JSON.parse(xhr.responseText);
            item.parseError = res.message || `上传失败 (${xhr.status})`;
          } catch {
            item.parseError = `上传失败 (${xhr.status})`;
          }
          renderList();
        }
      };

      xhr.onerror = () => {
        item.status = 'error';
        item.parseError = '网络请求异常';
        renderList();
      };

      xhr.send(formData);
    } catch (err) {
      item.status = 'error';
      item.parseError = err instanceof Error ? err.message : '上传异常';
      renderList();
    }
  }

  /** 轮询文档解析状态，每 3 秒一次，直到 completed/failed */
  async function pollParseStatus(item: UploadItem) {
    if (!item.docId || item.polling) return;
    item.polling = true;
    const maxAttempts = 100; // 最长 5 分钟
    for (let i = 0; i < maxAttempts; i++) {
      try {
        const summary = await getDocumentSummary(item.docId);
        item.parseStatus = (summary.parse_status as UploadItem['parseStatus']) || item.parseStatus;
        // 推断当前阶段（后端只给 4 个状态，按时间模拟子阶段进度）
        if (item.parseStatus === 'pending') {
          item.parseStage = 1;
        } else if (item.parseStatus === 'processing') {
          // 根据轮询次数推进展示阶段：1→2→3
          item.parseStage = Math.min(3, 1 + Math.floor(i / 3));
        } else if (item.parseStatus === 'completed') {
          item.parseStage = 4;
          item.pageCount = summary.pages;
          item.charCount = summary.char_count;
          item.parseWarnings = summary.warnings || [];
        } else if (item.parseStatus === 'failed') {
          item.parseStage = 0;
          item.parseError = summary.warnings?.[0] || '文档解析失败';
        }
        renderList();
        if (item.parseStatus === 'completed' || item.parseStatus === 'failed') {
          item.polling = false;
          return;
        }
      } catch (err) {
        // 单次查询失败不中断轮询，继续重试
        if (i === maxAttempts - 1) {
          item.parseStatus = 'failed';
          item.parseError = err instanceof Error ? err.message : '查询解析状态失败';
          renderList();
          item.polling = false;
          return;
        }
      }
      await new Promise((resolve) => setTimeout(resolve, 3000));
    }
    // 超时
    item.parseStatus = 'failed';
    item.parseError = '解析超时，请稍后在文档详情页查看';
    item.polling = false;
    renderList();
  }

  /** 加载知识库列表填充到下拉框 */
  async function loadKnowledgeBases() {
    const select = document.getElementById('target-kb') as HTMLSelectElement | null;
    const errorEl = document.getElementById('kb-load-error');
    if (!select) return;
    try {
      const res = await getKnowledgeBases(1, 100);
      const list: Array<{ id: string; name: string; document_count?: number }> = res?.items || [];
      select.innerHTML = '<option value="">请选择知识库</option>';
      if (list.length === 0) {
        select.innerHTML = '<option value="">暂无知识库，请先创建</option>';
        return;
      }
      list.forEach((kb) => {
        const opt = document.createElement('option');
        opt.value = kb.id;
        opt.textContent = kb.document_count !== undefined
          ? `${kb.name} (${kb.document_count} 篇)`
          : kb.name;
        select.appendChild(opt);
      });
      if (errorEl) errorEl.style.display = 'none';
    } catch (err) {
      select.innerHTML = '<option value="">请选择知识库</option>';
      if (errorEl) {
        errorEl.textContent = '知识库列表加载失败：' + (err instanceof Error ? err.message : '未知错误');
        errorEl.style.display = 'block';
      }
    }
  }

  function renderList() {
    const card = document.getElementById('upload-list-card')!;
    const list = document.getElementById('upload-list')!;

    if (uploadItems.length === 0) {
      card.style.display = 'none';
      return;
    }
    card.style.display = 'block';

    const statusMap: Record<string, { label: string; badge: string }> = {
      pending: { label: '等待中', badge: 'badge-warning' },
      uploading: { label: '上传中', badge: 'badge-primary' },
      success: { label: '成功', badge: 'badge-success' },
      error: { label: '失败', badge: 'badge-danger' },
    };

    list.innerHTML = uploadItems
      .map(
        (item, i) => `
      <div class="upload-item">
        <span class="upload-item-icon">${getFileIcon(item.file.name)}</span>
        <div class="upload-item-body">
          <div class="upload-item-name">${escapeHtml(item.file.name)}</div>
          <div class="upload-item-meta">
            <span>${formatSize(item.file.size)}</span>
            <span class="badge ${statusMap[item.status].badge}">${statusMap[item.status].label}</span>
            ${item.docId ? `<span class="text-muted">ID: ${escapeHtml(item.docId)}</span>` : ''}
          </div>
          <div class="progress-bar">
            <div class="progress-bar-fill ${item.status === 'success' ? 'success' : item.status === 'error' ? 'error' : ''}" style="width: ${item.progress}%;"></div>
          </div>
          ${renderParseSection(item)}
        </div>
        <button class="btn btn-ghost btn-sm" data-index="${i}">✕</button>
      </div>`
      )
      .join('');

    list.querySelectorAll('button[data-index]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.index!);
        uploadItems.splice(idx, 1);
        renderList();
      });
    });

    // 绑定"查看文档"按钮
    list.querySelectorAll('button[data-view-doc]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const docId = (btn as HTMLElement).dataset.viewDoc;
        if (docId) window.location.href = `/knowledge/detail?id=${docId}`;
      });
    });
  }

  /** 渲染解析进度区域：步骤指示器 + 解析结果 + 警告 + 操作按钮 */
  function renderParseSection(item: UploadItem): string {
    // 上传未成功或无 docId 时不显示解析区域（仅上传失败时显示错误）
    if (item.status === 'error') {
      if (!item.parseError) return '';
      return `<div class="parse-error">${escapeHtml(item.parseError)}</div>`;
    }
    if (item.status !== 'success' || !item.docId) return '';
    if (!item.parseStatus) return '';

    // 4 个阶段：解析中 → 分块 → 向量化 → 完成
    const stages = ['解析中', '分块', '向量化', '完成'];
    const currentStage = item.parseStage || 0;

    const statusLabelMap: Record<string, string> = {
      pending: '等待解析',
      processing: '解析处理中',
      completed: '解析完成',
      failed: '解析失败',
    };
    const statusBadgeMap: Record<string, string> = {
      pending: 'badge-warning',
      processing: 'badge-primary',
      completed: 'badge-success',
      failed: 'badge-danger',
    };

    let html = `<div class="parse-section">
      <div class="parse-section-header">
        <span>解析状态：<span class="badge ${statusBadgeMap[item.parseStatus]}">${statusLabelMap[item.parseStatus] || item.parseStatus}</span></span>
      </div>
      <div class="parse-stage-indicator">`;

    stages.forEach((stage, idx) => {
      const stageNum = idx + 1;
      let stageClass = 'parse-stage';
      if (item.parseStatus === 'failed') {
        // 失败时，已完成的阶段标记为 done
        if (stageNum < currentStage) stageClass += ' done';
      } else if (stageNum < currentStage) {
        stageClass += ' done';
      } else if (stageNum === currentStage && (item.parseStatus === 'pending' || item.parseStatus === 'processing')) {
        stageClass += ' active';
      } else if (item.parseStatus === 'completed') {
        stageClass += ' done';
      }
      html += `<span class="${stageClass}"><span class="parse-stage-dot"></span>${stage}</span>`;
      if (idx < stages.length - 1) {
        html += `<span class="parse-stage-arrow">›</span>`;
      }
    });
    html += `</div>`;

    // 解析失败展示错误
    if (item.parseStatus === 'failed' && item.parseError) {
      html += `<div class="parse-error">${escapeHtml(item.parseError)}</div>`;
    }

    // 解析完成展示结果
    if (item.parseStatus === 'completed') {
      html += `<div class="parse-result">`;
      if (item.pageCount !== undefined) {
        html += `<span class="parse-result-item">📄 ${item.pageCount} 页</span>`;
      }
      if (item.charCount !== undefined) {
        html += `<span class="parse-result-item">🔤 ${item.charCount.toLocaleString()} 字符</span>`;
      }
      html += `</div>`;
      if (item.parseWarnings && item.parseWarnings.length > 0) {
        html += `<div class="parse-warnings">⚠️ ${escapeHtml(item.parseWarnings.join('；'))}</div>`;
      }
      html += `<div class="parse-actions">
        <button class="btn btn-primary btn-sm" data-view-doc="${escapeHtml(item.docId!)}">查看文档</button>
      </div>`;
    }

    html += `</div>`;
    return html;
  }

  function escapeHtml(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // 拖拽上传
  const zone = document.getElementById('upload-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;

  zone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(fileInput.files);
    fileInput.value = '';
  });

  zone.addEventListener('dragover', (e) => {
    e.preventDefault();
    zone.classList.add('dragover');
  });
  zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
  zone.addEventListener('drop', (e) => {
    e.preventDefault();
    zone.classList.remove('dragover');
    if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
  });

  document.getElementById('clear-list')?.addEventListener('click', () => {
    uploadItems = [];
    renderList();
  });

