---
/**
 * 文档上传页面
 * 拖拽上传区 + 批量上传 + 上传进度 + 文档分类和标签
 *
 * P1 体验优化：
 *   P1-4 客户端文件大小校验（100MB）
 *   P1-3 上传失败 / 解析失败重试按钮
 *   P1-1 真实解析进度反馈（对接 getDocumentProgress，替代模拟进度）
 *   P1-2 扫描件 OCR 标签页（挂载 ScanProcessor React Island）
 *   P1-5 智能处理进度面板（解析完成后自动触发摘要/标签/分类）
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import ScanProcessor from '@/components/management/ScanProcessor';

const breadcrumb = [{ label: '管理', href: '/manage/kb' }, { label: '文档上传' }];
---

<DefaultLayout title="文档上传" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">文档上传</h1>
  </div>

  <div class="upload-layout">
    <!-- 左侧：上传区（含标签页切换） -->
    <div class="upload-main">
      <!-- 上传方式标签页：普通上传 / 扫描件 OCR -->
      <div class="upload-tabs" role="tablist">
        <button
          type="button"
          class="upload-tab active"
          data-tab="normal"
          role="tab"
          aria-selected="true"
          aria-controls="tab-normal"
        >📄 普通上传</button>
        <button
          type="button"
          class="upload-tab"
          data-tab="scan"
          role="tab"
          aria-selected="false"
          aria-controls="tab-scan"
        >🔍 扫描件 OCR</button>
      </div>

      <!-- 普通上传面板 -->
      <div class="upload-tab-panel active" id="tab-normal" role="tabpanel">
        <!-- 拖拽上传区 -->
        <div class="upload-zone" id="upload-zone">
          <div class="upload-zone-icon">📤</div>
          <h3>拖拽文件到此处，或 <span style="color: var(--primary);">点击选择文件</span></h3>
          <p class="text-muted">支持 PDF、Word、Excel、PPT、Markdown、图片、视频、音频等格式；超过 100MB 自动分片上传，支持 GB 级视频</p>
          <input type="file" id="file-input" multiple style="display: none;" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.md,.txt,.mp4,.avi,.mov,.mkv,.mp3,.wav,.m4a,.aac,.flac,.ogg,.png,.jpg,.jpeg,.gif,.webp" />
        </div>

        <!-- 上传列表 -->
        <div class="card" id="upload-list-card" style="display: none;">
          <div class="card-header">
            <h3>上传列表</h3>
            <button class="btn btn-ghost btn-sm" id="clear-list">清空</button>
          </div>
          <!-- P1-B: 上传查重提示 -->
          <div id="upload-dedup-warn" class="dedup-warn" style="display: none;"></div>
          <div id="upload-list"></div>
        </div>
      </div>

      <!-- 扫描件 OCR 面板（挂载 React Island） -->
      <div class="upload-tab-panel" id="tab-scan" role="tabpanel">
        <div class="scan-hint">
          <span aria-hidden="true">💡</span>
          <span>上传扫描版 PDF，AI 将自动 OCR 识别文字。点击「使用此文本」后，识别内容将作为新文档入库到右侧选定的目标知识库。</span>
        </div>
        <ScanProcessor client:only="react" />
      </div>
    </div>

    <!-- 右侧：上传设置 -->
    <aside class="upload-settings">
      <div class="card">
        <div class="card-header"><h3>上传设置</h3></div>
        <div class="form-group">
          <label class="form-label">目标知识库 *</label>
          <select class="form-input" id="target-kb">
            <option value="">加载中...</option>
          </select>
          <div id="kb-load-error" class="form-error" style="display: none;"></div>
        </div>
        <div class="form-group">
          <label class="form-label">文档分类</label>
          <select class="form-input" id="doc-category">
            <option value="">不分类</option>
            <option value="policy">制度规范</option>
            <option value="guide">操作指南</option>
            <option value="reference">参考资料</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">标签（逗号分隔）</label>
          <input type="text" class="form-input" id="doc-tags" placeholder="如：人事, 财务, 流程" />
        </div>
        <div class="form-group">
          <label class="form-label">解析选项</label>
          <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); margin-bottom: var(--space-2);">
            <input type="checkbox" id="opt-vlm" checked /> VLM 视觉理解（图片/文档内嵌图片描述）
          </label>
          <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); margin-bottom: var(--space-2);">
            <input type="checkbox" id="opt-asr" checked /> 音频转写（音频/视频 ASR 语音转文本）
          </label>
          <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); margin-bottom: var(--space-2);">
            <input type="checkbox" id="opt-vectorize" checked /> 自动向量化入库
          </label>
          <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm);">
            <input type="checkbox" id="opt-graph" /> 提取知识图谱实体
          </label>
        </div>
      </div>
    </aside>
  </div>
</DefaultLayout>

<style>
  /* P1-B: 上传查重提示（告警语义，对齐 global.css .alert-error/.alert-success 范式） */
  .dedup-warn {
    padding: var(--space-2) var(--space-3);
    margin: var(--space-2) var(--space-4);
    background: var(--warning-bg);
    border: 1px solid var(--warning);
    border-radius: var(--radius-md);
    color: var(--warning);
    font-size: var(--text-sm);
  }

  .upload-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-5);
  }
  /* === 上传方式标签页 === */
  .upload-tabs {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
    border-radius: var(--radius) var(--radius) 0 0;
    padding: 0 var(--space-2);
  }
  .upload-tab {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: all var(--transition-fast);
    margin-bottom: -1px;
  }
  .upload-tab:hover {
    color: var(--text);
    background: var(--surface-hover);
  }
  .upload-tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
    background: var(--surface);
  }
  .upload-tab-panel {
    display: none;
  }
  .upload-tab-panel.active {
    display: block;
  }
  .scan-hint {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    background: var(--info-bg, var(--primary-bg));
    border-left: 3px solid var(--info, var(--primary));
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
  }
  .upload-zone {
    border: 2px dashed var(--border-dark);
    border-radius: var(--radius-lg);
    padding: var(--space-12);
    text-align: center;
    cursor: pointer;
    transition: all var(--transition);
    background: var(--surface);
  }
  .upload-zone:hover,
  .upload-zone.dragover {
    border-color: var(--primary);
    background: var(--primary-bg);
  }
  .upload-zone-icon {
    font-size: 48px;
    margin-bottom: var(--space-4);
  }
  .upload-zone h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .upload-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-2);
  }
  .upload-item-icon {
    font-size: 24px;
  }
  .upload-item-body {
    flex: 1;
    min-width: 0;
  }
  .upload-item-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .upload-item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-1);
  }
  .progress-bar {
    height: 4px;
    background: var(--surface-muted);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-top: var(--space-2);
  }
  .progress-bar-fill {
    height: 100%;
    background: var(--primary);
    border-radius: var(--radius-full);
    transition: width var(--transition);
  }
  .progress-bar-fill.success {
    background: var(--success);
  }
  .progress-bar-fill.error {
    background: var(--danger);
  }
  /* === 解析进度区域 === */
  .parse-section {
    margin-top: var(--space-3);
    padding: var(--space-3);
    background: var(--surface-muted);
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
  }
  .parse-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .parse-stage-hint {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
  .parse-stage-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }
  .parse-stage {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .parse-stage-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--border-dark);
    transition: all var(--transition);
  }
  .parse-stage.active .parse-stage-dot {
    background: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
    animation: pulse 1.4s ease-in-out infinite;
  }
  .parse-stage.done .parse-stage-dot {
    background: var(--success);
  }
  .parse-stage-arrow {
    color: var(--border-dark);
    font-size: 10px;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .parse-result {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .parse-result-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .parse-warnings {
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--warning-bg);
    border-left: 3px solid var(--warning);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--warning);
  }
  .parse-error {
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--danger-bg);
    border-left: 3px solid var(--danger);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--danger);
  }
  .parse-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  /* === 智能处理进度区域 === */
  .intel-section {
    margin-top: var(--space-2);
    padding: var(--space-3);
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
  }
  .intel-section-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
  }
  .intel-stage-indicator {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .intel-stage {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .intel-stage.active .parse-stage-dot {
    background: var(--info, var(--primary));
    box-shadow: 0 0 0 3px var(--primary-bg);
    animation: pulse 1.4s ease-in-out infinite;
  }
  .intel-stage.done {
    color: var(--success);
  }
  .intel-stage.done .parse-stage-dot {
    background: var(--success);
  }
  @media (max-width: 1024px) {
    .upload-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import {
    getKnowledgeBases,
    getDocumentSummary,
    getDocumentProgress,
    initMultipartUpload,
    uploadPart,
    completeMultipartUpload,
    abortMultipartUpload,
    listUploadedParts,
  } from '@/lib/apis/knowledge';
  import type { DocParseProgress, MultipartPart, Document as KbDocument } from '@/lib/apis/knowledge';
  import { processIntelligence, getIntelligenceStatus } from '@/lib/apis/intelligence';
  import { postData, ApiError } from '@/lib/api';

  const API_BASE = import.meta.env.PUBLIC_API_BASE || 'http://localhost:8000';
  const TOKEN_KEY = 'ekb_access_token';

  /** 分片上传阈值：超过 100MB 走分片上传，否则走普通上传 */
  const MULTIPART_THRESHOLD = 100 * 1024 * 1024;
  /** 分片大小：10MB/片（S3 协议最小 5MB，10MB 平衡性能与内存） */
  const PART_SIZE = 10 * 1024 * 1024;
  /** 并发上传分片数：同时上传 3 个分片（避免打满浏览器连接） */
  const MAX_CONCURRENT_PARTS = 3;
  /** 单片最大重试次数 */
  const MAX_PART_RETRIES = 3;
  /** P0: complete 前服务端对账最大尝试次数 */
  const MAX_RECONCILE_ATTEMPTS = 3;
  /** P0: complete 失败后最大重试次数（解析 missing_parts 自动补传） */
  const MAX_COMPLETE_RETRIES = 3;
  /** P1: 跨会话断点续传 localStorage key 前缀 */
  const MULTIPART_STORAGE_PREFIX = 'ekb:multipart:';
  /** P1: 持久化状态最大保留时长（7 天过期清理） */
  const MULTIPART_STATE_MAX_AGE = 7 * 24 * 60 * 60 * 1000;

  /** P1: 分片上传持久化状态（跨会话断点续传） */
  interface MultipartPersistState {
    uploadId: string;
    objectName: string;
    uploadedParts: number[];
    partEtags: Record<number, string>;
    /** 持久化时间戳，用于过期清理 */
    timestamp: number;
  }

  /**
   * P1: 计算文件指纹（name + size + lastModified 简单 hash）
   * 不引入 crypto 库，仅用于本地 localStorage key 唯一性
   * 使用 djb2 变体字符串 hash
   */
  function computeFileFingerprint(file: File): string {
    const raw = `${file.name}|${file.size}|${file.lastModified}`;
    let hash = 5381;
    for (let i = 0; i < raw.length; i++) {
      hash = ((hash << 5) + hash) + raw.charCodeAt(i);
      hash = hash & 0xffffffff; // 限制为 32 位
    }
    return (hash >>> 0).toString(16);
  }

  /**
   * P1: 持久化分片上传状态到 localStorage
   * localStorage 不可用（隐私模式/配额满）时优雅降级，不阻断上传
   */
  function persistMultipartState(
    file: File,
    state: {
      uploadId: string;
      objectName: string;
      uploadedParts: number[];
      partEtags: Record<number, string>;
    }
  ): void {
    try {
      const key = MULTIPART_STORAGE_PREFIX + computeFileFingerprint(file);
      const payload: MultipartPersistState = {
        uploadId: state.uploadId,
        objectName: state.objectName,
        uploadedParts: state.uploadedParts,
        partEtags: state.partEtags,
        timestamp: Date.now(),
      };
      localStorage.setItem(key, JSON.stringify(payload));
    } catch {
      // localStorage 不可用（隐私模式/配额满）：优雅降级，不阻断上传
    }
  }

  /**
   * P1: 读取 localStorage 中的分片上传状态
   * 超过 7 天的记录自动清理，返回 null
   */
  function loadMultipartState(file: File): MultipartPersistState | null {
    try {
      const key = MULTIPART_STORAGE_PREFIX + computeFileFingerprint(file);
      const raw = localStorage.getItem(key);
      if (!raw) return null;
      const state = JSON.parse(raw) as MultipartPersistState;
      // 过期清理
      if (Date.now() - state.timestamp > MULTIPART_STATE_MAX_AGE) {
        localStorage.removeItem(key);
        return null;
      }
      return state;
    } catch {
      return null;
    }
  }

  /** P1: 清除 localStorage 中的分片上传状态 */
  function clearMultipartState(file: File): void {
    try {
      const key = MULTIPART_STORAGE_PREFIX + computeFileFingerprint(file);
      localStorage.removeItem(key);
    } catch {
      // localStorage 不可用：忽略
    }
  }

  /**
   * P1: 扫描 localStorage 中未完成的分片上传记录
   * 页面加载时调用，提示用户重新选择对应文件以续传
   */
  function scanUnfinishedUploads(): void {
    try {
      let count = 0;
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith(MULTIPART_STORAGE_PREFIX)) {
          // 校验是否过期
          try {
            const raw = localStorage.getItem(key);
            if (raw) {
              const state = JSON.parse(raw) as MultipartPersistState;
              if (Date.now() - state.timestamp > MULTIPART_STATE_MAX_AGE) {
                localStorage.removeItem(key);
              } else {
                count++;
              }
            }
          } catch {
            // 单条记录损坏：清理
            if (key) localStorage.removeItem(key);
          }
        }
      }
      if (count > 0) {
        alert(
          `检测到 ${count} 个未完成的分片上传记录。\n重新选择对应文件后将自动从断点续传。`
        );
      }
    } catch {
      // localStorage 不可用：忽略
    }
  }

  /** 智能处理状态 */
  type IntelStatus = 'idle' | 'processing' | 'done' | 'unavailable';

  interface UploadItem {
    file: File;
    progress: number;
    status: 'pending' | 'uploading' | 'success' | 'error';
    docId?: string;
    parseStatus?: 'pending' | 'processing' | 'completed' | 'failed';
    parseStage?: number; // 0:等待 1:解析中 2:分块 3:向量化 4:完成
    parseStageHint?: string; // P1-1: 真实进度提示（如 "第 3/10 页"）
    parseWarnings?: string[];
    pageCount?: number;
    charCount?: number;
    parseError?: string;
    polling?: boolean;
    /** 标记是否为 OCR 文本创建的文档（无文件解析流程） */
    isOcrDoc?: boolean;
    /** P1-5: 智能处理状态 */
    intelStatus?: IntelStatus;
    intelSummary?: boolean;
    intelTags?: boolean;
    intelCategory?: boolean;
    intelPolling?: boolean;
    /** 分片上传模式（文件 > 100MB 时自动启用） */
    multipartMode?: boolean;
    /** 分片上传会话 ID（后端 init 返回） */
    uploadId?: string;
    /** 对象存储对象名（后端 init 返回，complete/abort 需要） */
    objectName?: string;
    /** 已上传分片序号列表（断点续传依据） */
    uploadedParts?: number[];
    /** 已上传分片的 etag 映射（complete 请求需要） */
    partEtags?: Record<number, string>;
    /** 总分片数 */
    totalParts?: number;
    /** AbortController 引用，支持 abort() 取消上传 */
    abortController?: AbortController;
  }

  let uploadItems: UploadItem[] = [];
  const fileIconMap: Record<string, string> = {
    pdf: '📄', doc: '📘', docx: '📘', xls: '📊', xlsx: '📊',
    ppt: '📙', pptx: '📙', md: '📝', txt: '📃',
    mp4: '🎬', avi: '🎬', mov: '🎬', mkv: '🎬',
    mp3: '🎵', wav: '🎵', m4a: '🎵', aac: '🎵', flac: '🎵', ogg: '🎵',
    png: '🖼️', jpg: '🖼️', jpeg: '🖼️', gif: '🖼️', webp: '🖼️',
  };

  function getFileIcon(name: string): string {
    const ext = name.split('.').pop()?.toLowerCase() || '';
    return fileIconMap[ext] || '📄';
  }

  function formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    if (bytes < 1024 * 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
    return (bytes / 1024 / 1024 / 1024).toFixed(2) + ' GB';
  }

  /** 格式化时间为 YYYY-MM-DD HH:mm */
  function formatTime(d: Date): string {
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  /**
   * 添加文件到上传队列
   * 文件 > 100MB 自动标记为分片上传模式（multipartMode），否则走普通上传
   * P1: 跨会话断点续传 - 检查 localStorage 是否有未完成的分片上传记录，
   *      若存在则预填充 uploadId/uploadedParts/partEtags，UI 立即显示已有进度
   */
  function addFiles(files: FileList | File[]) {
    Array.from(files).forEach((file) => {
      const isMultipart = file.size > MULTIPART_THRESHOLD;

      // P1-B: 客户端查重 — 同一会话内检测重复文件
      const fingerprint = computeFileFingerprint(file);
      const existingDup = uploadItems.find(
        (i) => computeFileFingerprint(i.file) === fingerprint
      );
      if (existingDup) {
        // 已有相同文件在上传列表中，跳过并提示
        const warnEl = document.getElementById('upload-dedup-warn');
        if (warnEl) {
          warnEl.textContent = `⚠ 文件 "${file.name}" 已在上传列表中，已跳过重复添加`;
          warnEl.style.display = 'block';
          setTimeout(() => { warnEl.style.display = 'none'; }, 5000);
        }
        return;
      }

      const item: UploadItem = {
        file,
        progress: 0,
        status: 'pending',
        multipartMode: isMultipart,
        totalParts: isMultipart ? Math.ceil(file.size / PART_SIZE) : undefined,
        uploadedParts: isMultipart ? [] : undefined,
      };
      // P1: 跨会话断点续传 - 预填充已持久化的分片上传状态
      if (isMultipart) {
        const saved = loadMultipartState(file);
        if (saved && saved.uploadId) {
          item.uploadId = saved.uploadId;
          item.objectName = saved.objectName;
          item.uploadedParts = saved.uploadedParts || [];
          item.partEtags = saved.partEtags || {};
          const total = item.totalParts || 1;
          item.progress = Math.round((item.uploadedParts.length / total) * 100);
        }
      }
      uploadItems.push(item);
    });
    renderList();
    // 自动开始上传：根据文件大小调度到普通上传或分片上传
    uploadItems.filter((i) => i.status === 'pending').forEach(handleFileUpload);
  }

  /**
   * 文件上传调度器
   * 文件 > 100MB（multipartMode）走分片上传 startMultipartUpload，否则走原有普通上传 uploadFile
   */
  function handleFileUpload(item: UploadItem) {
    if (item.multipartMode) {
      startMultipartUpload(item);
    } else {
      uploadFile(item);
    }
  }

  async function uploadFile(item: UploadItem) {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      window.location.href = '/auth/login';
      return;
    }
    const kbId = (document.getElementById('target-kb') as HTMLSelectElement).value;
    if (!kbId) {
      alert('请先选择目标知识库');
      return;
    }

    // NOTE: 解析选项（opt-vlm/opt-asr/opt-vectorize/opt-graph）后端暂未接线，
    // 后端无任何端点接收 enable_* 参数，待后端支持后再从此处读取发送。

    item.status = 'uploading';
    renderList();

    const formData = new FormData();
    formData.append('file', item.file);

    try {
      const xhr = new XMLHttpRequest();
      // 后端 /documents/upload 要求 kb_id/title 为 query 参数（与 multipart/init 一致）
      const params = new URLSearchParams({ kb_id: kbId, title: item.file.name });
      xhr.open('POST', `${API_BASE}/api/v1/documents/upload?${params.toString()}`);
      xhr.setRequestHeader('Authorization', `Bearer ${token}`);

      xhr.upload.onprogress = (e) => {
        if (e.lengthComputable) {
          item.progress = Math.round((e.loaded / e.total) * 100);
          renderList();
        }
      };

      xhr.onload = () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          item.status = 'success';
          item.progress = 100;
          // 解析返回的 document_id
          try {
            const res = JSON.parse(xhr.responseText);
            const data = res.data || res;
            item.docId = data.id || data.document_id || data.doc_id;
            item.parseStatus = (data.parse_status as UploadItem['parseStatus']) || 'pending';
            item.parseStage = 0;
          } catch {
            // 响应解析失败，忽略
          }
          renderList();
          // 启动解析状态轮询
          if (item.docId) {
            pollParseStatus(item);
          }
        } else {
          item.status = 'error';
          try {
            const res = JSON.parse(xhr.responseText);
            item.parseError = res.message || `上传失败 (${xhr.status})`;
          } catch {
            item.parseError = `上传失败 (${xhr.status})`;
          }
          renderList();
        }
      };

      xhr.onerror = () => {
        item.status = 'error';
        item.parseError = '网络请求异常';
        renderList();
      };

      xhr.send(formData);
    } catch (err) {
      item.status = 'error';
      item.parseError = err instanceof Error ? err.message : '上传异常';
      renderList();
    }
  }

  // ===== 分片上传（GB 级视频）=====

  /**
   * 启动分片上传流程
   * 流程：init 初始化 → 分片切片 → 并发上传（3） → 自检+服务端对账 → complete 合并 → 触发解析轮询
   * 断点续传：如果 uploadId 仍有效（非用户主动取消），跳过 init 并跳过已上传分片
   * P1: 跨会话断点续传 - 通过 localStorage 持久化 uploadId/uploadedParts/partEtags
   * P0: complete 前自检 + 服务端对账 - verifyAndCompleteMultipart 确保分片完整性
   */
  async function startMultipartUpload(item: UploadItem) {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      window.location.href = '/auth/login';
      return;
    }
    const kbId = (document.getElementById('target-kb') as HTMLSelectElement).value;
    if (!kbId) {
      alert('请先选择目标知识库');
      return;
    }

    item.status = 'uploading';
    item.abortController = new AbortController();
    renderList();

    try {
      // 1. 初始化分片上传（断点续传：uploadId 仍有效则跳过 init）
      // P1: 跨会话断点续传 - 优先从 localStorage 恢复（item.uploadId 未设置时）
      if (!item.uploadId) {
        const saved = loadMultipartState(item.file);
        if (saved && saved.uploadId) {
          item.uploadId = saved.uploadId;
          item.objectName = saved.objectName;
          item.uploadedParts = saved.uploadedParts || [];
          item.partEtags = saved.partEtags || {};
        }
      }
      let uploadId = item.uploadId;
      let objectName = item.objectName || '';
      if (!uploadId) {
        const init = await initMultipartUpload(kbId, item.file.name, item.file.name);
        uploadId = init.upload_id;
        objectName = init.object_name;
        item.uploadId = uploadId;
        item.objectName = objectName;
        item.uploadedParts = [];
        item.partEtags = {};
      }

      const totalParts = Math.ceil(item.file.size / PART_SIZE);
      item.totalParts = totalParts;
      const uploadedParts: number[] = item.uploadedParts || [];
      item.uploadedParts = uploadedParts;
      const partEtags: Record<number, string> = { ...(item.partEtags || {}) };
      item.partEtags = partEtags;

      // 初始进度（断点续传时可能 > 0）
      item.progress = Math.round((uploadedParts.length / totalParts) * 100);
      renderList();

      // 2. 构建待上传分片列表（跳过已上传的，实现断点续传）
      const partsToUpload: number[] = [];
      for (let i = 1; i <= totalParts; i++) {
        if (!uploadedParts.includes(i)) {
          partsToUpload.push(i);
        }
      }

      // 3. 并发上传（同时 MAX_CONCURRENT_PARTS 个分片，避免打满浏览器连接）
      let cursor = 0;
      const uploadNext = async (): Promise<void> => {
        while (cursor < partsToUpload.length) {
          if (item.abortController?.signal.aborted) {
            return; // 已取消，静默退出
          }
          const partNumber = partsToUpload[cursor++];
          const start = (partNumber - 1) * PART_SIZE;
          const end = Math.min(start + PART_SIZE, item.file.size);
          const blob = item.file.slice(start, end);
          try {
            const etag = await uploadPartWithRetry(item, partNumber, blob, uploadId);
            partEtags[partNumber] = etag;
            uploadedParts.push(partNumber);
            item.progress = Math.round((uploadedParts.length / totalParts) * 100);
            // P1: 持久化分片上传进度（跨会话断点续传，localStorage 失败时优雅降级）
            persistMultipartState(item.file, {
              uploadId,
              objectName,
              uploadedParts,
              partEtags,
            });
            renderList();
          } catch (err) {
            if (item.abortController?.signal.aborted) {
              return; // 已取消，静默退出
            }
            throw err; // 真实错误，向上抛出
          }
        }
      };

      const workerCount = Math.min(MAX_CONCURRENT_PARTS, partsToUpload.length);
      const workers: Promise<void>[] = [];
      for (let w = 0; w < workerCount; w++) {
        workers.push(uploadNext());
      }
      await Promise.all(workers);

      // 4. 检查是否已取消
      if (item.abortController?.signal.aborted) {
        return; // cancelMultipartUpload 已处理 UI
      }

      // 5-6. P0: complete 前自检 + 服务端对账（替代直接调用 completeMultipartUpload）
      // verifyAndCompleteMultipart 内部会：前端自检 → 补传缺失分片 → 服务端对账 → complete
      // 对账失败 3 次抛出错误（不自动 abort，让用户决定是否重试）
      const ext = item.file.name.split('.').pop()?.toLowerCase() || 'bin';
      const doc = await verifyAndCompleteMultipart(
        item,
        uploadId,
        objectName,
        partEtags,
        totalParts,
        kbId,
        item.file.name,
        ext
      );

      item.status = 'success';
      item.progress = 100;
      item.docId = doc.id;
      item.parseStatus = (doc.parse_status as UploadItem['parseStatus']) || 'pending';
      item.parseStage = 0;
      // P1: 上传完成，清除 localStorage 中的分片上传状态
      clearMultipartState(item.file);
      renderList();

      // 7. 启动解析状态轮询（复用现有 getDocumentProgress 逻辑）
      if (item.docId) {
        pollParseStatus(item);
      }
    } catch (err) {
      if (item.abortController?.signal.aborted) {
        item.status = 'error';
        item.parseError = '上传已取消';
      } else {
        item.status = 'error';
        item.parseError = err instanceof Error ? err.message : '分片上传失败';
      }
      renderList();
    }
  }

  /**
   * 单分片上传（带重试）
   * 单片最多重试 MAX_PART_RETRIES 次，指数退避（1s/2s/4s）
   * 已取消（AbortError）不重试，直接抛出
   */
  async function uploadPartWithRetry(
    item: UploadItem,
    partNumber: number,
    data: Blob,
    uploadId: string
  ): Promise<string> {
    let lastError: Error | null = null;
    for (let attempt = 0; attempt < MAX_PART_RETRIES; attempt++) {
      // 检查是否已取消
      if (item.abortController?.signal.aborted) {
        throw new Error('上传已取消');
      }
      try {
        const { etag } = await uploadPart(
          uploadId,
          partNumber,
          data,
          item.abortController?.signal
        );
        return etag;
      } catch (err) {
        // 已取消（AbortError）不重试，直接抛出
        if (item.abortController?.signal.aborted) {
          throw err;
        }
        lastError = err instanceof Error ? err : new Error(String(err));
        // 最后一次重试不再等待
        if (attempt < MAX_PART_RETRIES - 1) {
          const delay = Math.min(1000 * Math.pow(2, attempt), 8000);
          await new Promise((resolve) => setTimeout(resolve, delay));
        }
      }
    }
    throw lastError || new Error(`分片 ${partNumber} 上传失败`);
  }

  /**
   * P0: complete 前自检 + 服务端对账
   * 步骤 1: 前端自检 partEtags 是否覆盖所有 totalParts，找出缺失分片
   * 步骤 2: 缺失分片调用 uploadPartWithRetry 补传
   * 步骤 3: 调用 listUploadedParts 获取服务端实际分片
   * 步骤 4: 对比前端 partEtags 与服务端 list:
   *         - 客户端有服务端无 → 重传
   *         - 服务端有客户端无 → 用服务端 etag 补齐
   *         - etag 不匹配 → 重传
   * 步骤 5: 三次对账失败 → 抛出错误（调用方处理，不自动 abort，让用户决定）
   * 步骤 6: 对账成功 → 调用 completeMultipartUpload
   *         complete 失败时解析后端 missing_parts，自动补传后重试 complete（最多 3 次）
   */
  async function verifyAndCompleteMultipart(
    item: UploadItem,
    uploadId: string,
    objectName: string,
    partEtags: Record<number, string>,
    totalParts: number,
    kbId: string,
    title: string,
    docType: string
  ): Promise<KbDocument> {
    // 辅助：从 item.file 切出指定分片
    const slicePart = (partNumber: number): Blob => {
      const start = (partNumber - 1) * PART_SIZE;
      const end = Math.min(start + PART_SIZE, item.file.size);
      return item.file.slice(start, end);
    };

    // 辅助：上传单个缺失/不匹配分片（带重试）
    const uploadMissingPart = async (partNumber: number): Promise<void> => {
      if (item.abortController?.signal.aborted) {
        throw new Error('上传已取消');
      }
      const etag = await uploadPartWithRetry(item, partNumber, slicePart(partNumber), uploadId);
      partEtags[partNumber] = etag;
    };

    // 辅助：构建 complete 请求体（按 part_number 升序）
    const buildPartsList = (): MultipartPart[] => {
      const parts: MultipartPart[] = [];
      for (let i = 1; i <= totalParts; i++) {
        const etag = partEtags[i];
        if (etag) {
          parts.push({ part_number: i, etag });
        }
      }
      return parts;
    };

    // 步骤 1: 前端自检 - 找出 partEtags 缺失的分片
    const selfMissing: number[] = [];
    for (let i = 1; i <= totalParts; i++) {
      if (!partEtags[i]) {
        selfMissing.push(i);
      }
    }

    // 步骤 2: 补传前端缺失的分片
    if (selfMissing.length > 0) {
      for (const partNumber of selfMissing) {
        await uploadMissingPart(partNumber);
      }
    }

    // 步骤 3-5: 服务端对账（最多 MAX_RECONCILE_ATTEMPTS 次）
    let lastReconcileError: Error | null = null;
    for (let attempt = 0; attempt < MAX_RECONCILE_ATTEMPTS; attempt++) {
      if (item.abortController?.signal.aborted) {
        throw new Error('上传已取消');
      }

      // 步骤 3: 拉取服务端分片列表
      const serverList = await listUploadedParts(uploadId, objectName);
      const serverPartsMap = new Map<number, string>();
      for (const p of serverList.parts) {
        serverPartsMap.set(p.part_number, p.etag);
      }

      // 步骤 4: 对比客户端与服务端
      const partsToReupload: number[] = [];
      for (let i = 1; i <= totalParts; i++) {
        const clientEtag = partEtags[i];
        const serverEtag = serverPartsMap.get(i);
        if (clientEtag && !serverEtag) {
          // 客户端有服务端无 → 重传
          partsToReupload.push(i);
        } else if (!clientEtag && serverEtag) {
          // 服务端有客户端无 → 用服务端 etag 补齐
          partEtags[i] = serverEtag;
        } else if (!clientEtag && !serverEtag) {
          // 双方都没有 → 重传
          partsToReupload.push(i);
        } else if (clientEtag && serverEtag && clientEtag !== serverEtag) {
          // etag 不匹配 → 重传
          partsToReupload.push(i);
        }
      }

      // 步骤 4 续: 重传不匹配/缺失的分片
      if (partsToReupload.length > 0) {
        for (const partNumber of partsToReupload) {
          await uploadMissingPart(partNumber);
        }
        // 重传后进入下一轮对账
        lastReconcileError = new Error(
          `分片对账不一致，已重传 ${partsToReupload.length} 个分片，重试对账（第 ${attempt + 1}/${MAX_RECONCILE_ATTEMPTS} 次）`
        );
        continue;
      }

      // 对账成功，执行 complete（步骤 6 + complete 失败重试）
      const parts = buildPartsList();
      for (let completeAttempt = 0; completeAttempt < MAX_COMPLETE_RETRIES; completeAttempt++) {
        if (item.abortController?.signal.aborted) {
          throw new Error('上传已取消');
        }
        try {
          const doc = await completeMultipartUpload(
            uploadId,
            parts,
            objectName,
            kbId,
            title,
            docType
          );
          return doc;
        } catch (err) {
          // 解析后端返回的 missing_parts，自动补传后重试 complete
          const missingParts = extractMissingParts(err);
          if (missingParts.length > 0 && completeAttempt < MAX_COMPLETE_RETRIES - 1) {
            for (const partNumber of missingParts) {
              await uploadMissingPart(partNumber);
            }
            // 更新 parts 数组后重试 complete
            parts.length = 0;
            parts.push(...buildPartsList());
            continue;
          }
          // 无法恢复的 complete 错误，向上抛出
          throw err;
        }
      }
      // 理论上不会到达这里（complete 重试循环要么 return 要么 throw）
      throw new Error('complete 重试次数耗尽');
    }

    // 步骤 5: 对账失败 3 次，抛出错误（不自动 abort，让用户决定）
    throw lastReconcileError || new Error('分片对账失败，已重试 3 次');
  }

  /**
   * P0: 从 ApiError 中提取后端返回的 missing_parts 字段
   * 后端 complete 失败时可能返回 { missing_parts: [1, 3, 5] } 提示缺失分片
   */
  function extractMissingParts(err: unknown): number[] {
    if (err instanceof ApiError && err.data) {
      const data = err.data as { missing_parts?: unknown };
      if (Array.isArray(data.missing_parts)) {
        return data.missing_parts.filter((n): n is number => typeof n === 'number');
      }
    }
    return [];
  }

  /**
   * 取消分片上传
   * 1. abort 进行中的 fetch 请求（通过 AbortController）
   * 2. 调用后端 abort 端点清理对象存储临时分片
   * 3. 清除上传会话状态（重试时将重新 init）+ localStorage 持久化状态 + UI 状态更新
   */
  async function cancelMultipartUpload(item: UploadItem) {
    // 1. 中止进行中的 fetch 请求
    if (item.abortController) {
      item.abortController.abort();
    }
    // 2. 调用后端取消端点，清理服务端临时分片
    if (item.uploadId && item.objectName) {
      try {
        await abortMultipartUpload(item.uploadId, item.objectName);
      } catch (err) {
        // 后端清理失败不阻断 UI，仅 alert 提示
        alert('取消分片上传时后端清理失败: ' + (err instanceof Error ? err.message : '未知错误'));
      }
    }
    // 3. 清除上传会话状态（重试时将重新 init）
    item.uploadId = undefined;
    item.objectName = undefined;
    item.uploadedParts = [];
    item.partEtags = undefined;
    item.abortController = undefined;
    item.status = 'error';
    item.parseError = '上传已取消';
    // P1: 清除 localStorage 中的分片上传状态（用户主动取消，不再续传）
    clearMultipartState(item.file);
    renderList();
  }

  /**
   * P1-1: 真实解析进度映射
   * 将后端 DocParseProgress.stage 映射到前端 parseStage（0-4）
   * 返回 null 表示需要降级为轮询次数模拟
   */
  function mapProgressToStage(progress: DocParseProgress): number | null {
    switch (progress.stage) {
      case 'queued':
        return 0; // 等待中
      case 'unknown':
        // 后端无进度记录，降级为模拟
        return null;
      case 'parsing':
        return 1; // 解析中
      case 'chunking':
        return 2; // 分块中
      case 'embedding':
      case 'indexing':
      case 'publishing':
        return 3; // 向量化/索引/发布中
      case 'done':
        return 4; // 完成
      case 'failed':
        return 0; // 失败
      default:
        return null;
    }
  }

  /**
   * P1-1: 构建阶段提示文案
   * 如果 current/total > 0，显示 "第 X/Y 页" 或 "X/Y 块"
   * 否则使用后端返回的 message
   */
  function buildProgressHint(progress: DocParseProgress): string {
    // P2-E: 优先展示子阶段进度（GB 视频 ASR 分段等）
    if (progress.sub_stage && progress.sub_total && progress.sub_total > 0) {
      const subLabel = formatSubStageLabel(progress.sub_stage);
      return `${subLabel} ${progress.sub_current || 0}/${progress.sub_total}`;
    }
    if (progress.current > 0 && progress.total > 0) {
      const unit = progress.stage === 'parsing' ? '页' : '块';
      return `第 ${progress.current}/${progress.total} ${unit}`;
    }
    return progress.message || '';
  }

  /** P2-E: 格式化子阶段标签为中文 */
  function formatSubStageLabel(subStage: string): string {
    if (subStage.startsWith('asr_segment_')) {
      return 'ASR 转写';
    }
    const labelMap: Record<string, string> = {
      'extract_audio': '提取音轨',
      'extract_audio_done': '音轨提取',
      'asr_multipart': 'ASR 转写',
      'asr_done': 'ASR 转写',
      'asr_failed': 'ASR 失败',
      'keyframe_extract': '关键帧提取',
      'keyframe_done': '关键帧提取',
      'keyframe_failed': '关键帧失败',
      'finalize_start': '合并处理',
      'chunking': '分块中',
      'embedding': '向量化',
      'publishing': '发布中',
    };
    return labelMap[subStage] || subStage;
  }

  /**
   * 轮询文档解析状态，每 3 秒一次，直到 completed/failed
   * P1-1: 同时调用 getDocumentProgress 获取真实阶段进度
   *       如果 progress 返回 unknown，降级为轮询次数模拟
   */
  async function pollParseStatus(item: UploadItem) {
    if (!item.docId || item.polling) return;
    item.polling = true;
    const maxAttempts = 100; // 最长 5 分钟
    for (let i = 0; i < maxAttempts; i++) {
      try {
        const summary = await getDocumentSummary(item.docId);
        item.parseStatus = (summary.parse_status as UploadItem['parseStatus']) || item.parseStatus;

        // 终态处理
        if (item.parseStatus === 'completed') {
          item.parseStage = 4;
          item.pageCount = summary.pages;
          item.charCount = summary.char_count;
          item.parseWarnings = summary.warnings || [];
          item.parseStageHint = '';
          renderList();
          item.polling = false;
          // P1-5: 解析完成后自动触发智能处理
          triggerIntelligence(item);
          return;
        } else if (item.parseStatus === 'failed') {
          item.parseStage = 0;
          item.parseError = summary.warnings?.[0] || '文档解析失败';
          item.parseStageHint = '';
          renderList();
          item.polling = false;
          return;
        }

        // 非终态：尝试获取真实进度
        let progressSet = false;
        try {
          const progress = await getDocumentProgress(item.docId);
          const mapped = mapProgressToStage(progress);
          if (mapped !== null) {
            item.parseStage = mapped;
            item.parseStageHint = buildProgressHint(progress);
            progressSet = true;
          }
        } catch {
          // 进度查询失败，降级为模拟
        }

        // 降级：按轮询次数模拟阶段进度（保持兼容）
        if (!progressSet) {
          if (item.parseStatus === 'pending') {
            item.parseStage = 1;
          } else if (item.parseStatus === 'processing') {
            item.parseStage = Math.min(3, 1 + Math.floor(i / 3));
          }
          item.parseStageHint = '';
        }
        renderList();
      } catch (err) {
        // 单次查询失败不中断轮询，继续重试
        if (i === maxAttempts - 1) {
          item.parseStatus = 'failed';
          item.parseError = err instanceof Error ? err.message : '查询解析状态失败';
          renderList();
          item.polling = false;
          return;
        }
      }
      await new Promise((resolve) => setTimeout(resolve, 3000));
    }
    // 超时
    item.parseStatus = 'failed';
    item.parseError = '解析超时，请稍后在文档详情页查看';
    item.polling = false;
    renderList();
  }

  /**
   * P1-5: 触发文档智能处理（自动摘要/标签/分类）
   * 智能处理是可选增强，失败不影响主流程（静默降级）
   */
  async function triggerIntelligence(item: UploadItem) {
    if (!item.docId || item.intelPolling) return;
    item.intelStatus = 'processing';
    item.intelPolling = true;
    item.intelSummary = false;
    item.intelTags = false;
    item.intelCategory = false;
    renderList();

    try {
      // 触发智能处理
      await processIntelligence(item.docId);

      // 轮询智能处理状态
      const maxAttempts = 60; // 最长 3 分钟
      for (let i = 0; i < maxAttempts; i++) {
        try {
          const status = await getIntelligenceStatus(item.docId);
          item.intelSummary = status.has_summary;
          item.intelTags = status.has_tags;
          item.intelCategory = status.has_category;
          if (!status.processing) {
            item.intelStatus = 'done';
            renderList();
            item.intelPolling = false;
            return;
          }
          renderList();
        } catch {
          // 单次查询失败不中断，继续重试
          if (i === maxAttempts - 1) {
            item.intelStatus = 'unavailable';
            renderList();
            item.intelPolling = false;
            return;
          }
        }
        await new Promise((resolve) => setTimeout(resolve, 3000));
      }
      // 超时：静默降级
      item.intelStatus = 'unavailable';
      renderList();
      item.intelPolling = false;
    } catch {
      // 智能处理不可用：静默降级，不影响主流程
      item.intelStatus = 'unavailable';
      renderList();
      item.intelPolling = false;
    }
  }

  /** 加载知识库列表填充到下拉框 */
  async function loadKnowledgeBases() {
    const select = document.getElementById('target-kb') as HTMLSelectElement | null;
    const errorEl = document.getElementById('kb-load-error');
    if (!select) return;
    try {
      const res = await getKnowledgeBases(1, 100);
      const list: Array<{ id: string; name: string; document_count?: number }> = res?.items || [];
      select.innerHTML = '<option value="">请选择知识库</option>';
      if (list.length === 0) {
        select.innerHTML = '<option value="">暂无知识库，请先创建</option>';
        return;
      }
      list.forEach((kb) => {
        const opt = document.createElement('option');
        opt.value = kb.id;
        opt.textContent = kb.document_count !== undefined
          ? `${kb.name} (${kb.document_count} 篇)`
          : kb.name;
        select.appendChild(opt);
      });
      if (errorEl) errorEl.style.display = 'none';
    } catch (err) {
      select.innerHTML = '<option value="">请选择知识库</option>';
      if (errorEl) {
        errorEl.textContent = '知识库列表加载失败：' + (err instanceof Error ? err.message : '未知错误');
        errorEl.style.display = 'block';
      }
    }
  }

  function renderList() {
    const card = document.getElementById('upload-list-card')!;
    const list = document.getElementById('upload-list')!;

    if (uploadItems.length === 0) {
      card.style.display = 'none';
      return;
    }
    card.style.display = 'block';

    const statusMap: Record<string, { label: string; badge: string }> = {
      pending: { label: '等待中', badge: 'badge-warning' },
      uploading: { label: '上传中', badge: 'badge-primary' },
      success: { label: '成功', badge: 'badge-success' },
      error: { label: '失败', badge: 'badge-danger' },
    };

    list.innerHTML = uploadItems
      .map(
        (item, i) => `
      <div class="upload-item">
        <span class="upload-item-icon">${getFileIcon(item.file.name)}</span>
        <div class="upload-item-body">
          <div class="upload-item-name">${escapeHtml(item.file.name)}</div>
          <div class="upload-item-meta">
            <span>${formatSize(item.file.size)}</span>
            <span class="badge ${statusMap[item.status].badge}">${statusMap[item.status].label}</span>
            ${item.multipartMode ? `<span class="text-muted">分片上传</span>` : ''}
            ${item.multipartMode && item.status === 'uploading' && item.totalParts
              ? `<span class="text-muted">分片 ${item.uploadedParts?.length || 0}/${item.totalParts}</span>`
              : ''}
            ${item.docId ? `<span class="text-muted">ID: ${escapeHtml(item.docId)}</span>` : ''}
          </div>
          <div class="progress-bar">
            <div class="progress-bar-fill ${item.status === 'success' ? 'success' : item.status === 'error' ? 'error' : ''}" style="width: ${item.progress}%;"></div>
          </div>
          ${renderParseSection(item, i)}
          ${renderIntelligenceSection(item)}
        </div>
        <button class="btn btn-ghost btn-sm" data-index="${i}" title="${item.status === 'uploading' && item.multipartMode ? '取消上传' : '移除'}">${item.status === 'uploading' && item.multipartMode ? '取消' : '✕'}</button>
      </div>`
      )
      .join('');

    list.querySelectorAll('button[data-index]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.index!);
        const item = uploadItems[idx];
        if (!item) return;
        // 分片上传中：点击取消按钮触发 cancelMultipartUpload（abort + 后端清理）
        if (item.status === 'uploading' && item.multipartMode && item.uploadId) {
          cancelMultipartUpload(item);
        } else {
          uploadItems.splice(idx, 1);
          renderList();
        }
      });
    });

    // 绑定"查看文档"按钮
    list.querySelectorAll('button[data-view-doc]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const docId = (btn as HTMLElement).dataset.viewDoc;
        if (docId) window.location.href = `/knowledge/detail?id=${docId}`;
      });
    });

    // P1-3: 绑定"重试上传"按钮
    list.querySelectorAll('button[data-retry-upload]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.retryUpload!);
        const item = uploadItems[idx];
        if (!item) return;
        item.status = 'pending';
        item.progress = 0;
        item.parseError = undefined;
        // 分片上传：uploadId 仍存在（非用户主动取消）时保留 uploadedParts/partEtags 实现断点续传
        // uploadId 已被清除（取消场景）时 startMultipartUpload 会重新 init
        item.abortController = undefined;
        renderList();
        handleFileUpload(item);
      });
    });

    // P1-3: 绑定"重试解析"按钮
    list.querySelectorAll('button[data-retry-parse]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.retryParse!);
        const item = uploadItems[idx];
        if (!item || !item.docId) return;
        // 文档已创建，只需重新轮询解析状态
        item.parseStatus = 'pending';
        item.parseStage = 0;
        item.parseError = undefined;
        item.parseStageHint = '';
        item.polling = false;
        renderList();
        pollParseStatus(item);
      });
    });
  }

  /** 渲染解析进度区域：步骤指示器 + 解析结果 + 警告 + 重试按钮 */
  function renderParseSection(item: UploadItem, itemIndex: number): string {
    // P1-3: 上传失败状态显示错误 + 重试按钮
    if (item.status === 'error') {
      if (!item.parseError) return '';
      return `<div class="parse-error">${escapeHtml(item.parseError)}</div>
        <div class="parse-actions">
          <button class="btn btn-outline btn-sm" data-retry-upload="${itemIndex}">🔄 重试</button>
        </div>`;
    }
    if (item.status !== 'success' || !item.docId) return '';
    if (!item.parseStatus) return '';

    // 4 个阶段：解析中 → 分块 → 向量化 → 完成
    const stages = ['解析中', '分块', '向量化', '完成'];
    const currentStage = item.parseStage || 0;

    const statusLabelMap: Record<string, string> = {
      pending: '等待解析',
      processing: '解析处理中',
      completed: '解析完成',
      failed: '解析失败',
    };
    const statusBadgeMap: Record<string, string> = {
      pending: 'badge-warning',
      processing: 'badge-primary',
      completed: 'badge-success',
      failed: 'badge-danger',
    };

    let html = `<div class="parse-section">
      <div class="parse-section-header">
        <span>解析状态：<span class="badge ${statusBadgeMap[item.parseStatus]}">${statusLabelMap[item.parseStatus] || item.parseStatus}</span></span>
        ${item.parseStageHint ? `<span class="parse-stage-hint">${escapeHtml(item.parseStageHint)}</span>` : ''}
      </div>
      <div class="parse-stage-indicator">`;

    stages.forEach((stage, idx) => {
      const stageNum = idx + 1;
      let stageClass = 'parse-stage';
      if (item.parseStatus === 'failed') {
        // 失败时，已完成的阶段标记为 done
        if (stageNum < currentStage) stageClass += ' done';
      } else if (stageNum < currentStage) {
        stageClass += ' done';
      } else if (stageNum === currentStage && (item.parseStatus === 'pending' || item.parseStatus === 'processing')) {
        stageClass += ' active';
      } else if (item.parseStatus === 'completed') {
        stageClass += ' done';
      }
      html += `<span class="${stageClass}"><span class="parse-stage-dot"></span>${stage}</span>`;
      if (idx < stages.length - 1) {
        html += `<span class="parse-stage-arrow">›</span>`;
      }
    });
    html += `</div>`;

    // P1-3: 解析失败展示错误 + 重试解析按钮
    if (item.parseStatus === 'failed' && item.parseError) {
      html += `<div class="parse-error">${escapeHtml(item.parseError)}</div>`;
      html += `<div class="parse-actions">
        <button class="btn btn-outline btn-sm" data-retry-parse="${itemIndex}">🔄 重试解析</button>
      </div>`;
    }

    // 解析完成展示结果
    if (item.parseStatus === 'completed') {
      html += `<div class="parse-result">`;
      if (item.pageCount !== undefined) {
        html += `<span class="parse-result-item">📄 ${item.pageCount} 页</span>`;
      }
      if (item.charCount !== undefined) {
        html += `<span class="parse-result-item">🔤 ${item.charCount.toLocaleString()} 字符</span>`;
      }
      html += `</div>`;
      if (item.parseWarnings && item.parseWarnings.length > 0) {
        html += `<div class="parse-warnings">⚠️ ${escapeHtml(item.parseWarnings.join('；'))}</div>`;
      }
      html += `<div class="parse-actions">
        <button class="btn btn-primary btn-sm" data-view-doc="${escapeHtml(item.docId!)}">查看文档</button>
      </div>`;
    }

    html += `</div>`;
    return html;
  }

  /**
   * P1-5: 渲染智能处理进度面板
   * 仅在智能处理已触发（intelStatus 非 undefined）时显示
   * 失败时静默显示"智能处理暂不可用"
   */
  function renderIntelligenceSection(item: UploadItem): string {
    if (!item.intelStatus) return '';

    const sections = [
      { label: '摘要生成', done: item.intelSummary },
      { label: '标签提取', done: item.intelTags },
      { label: '分类判断', done: item.intelCategory },
    ];

    let html = `<div class="intel-section">
      <div class="intel-section-header">`;

    if (item.intelStatus === 'processing') {
      html += `<span style="color: var(--text-secondary);">🤖 智能处理中...</span>`;
    } else if (item.intelStatus === 'done') {
      html += `<span style="color: var(--success);">✓ 智能处理完成</span>`;
    } else if (item.intelStatus === 'unavailable') {
      html += `<span class="text-muted">智能处理暂不可用</span>`;
    }

    html += `</div>`;

    // 处理中或完成时显示阶段指示器
    if (item.intelStatus === 'processing' || item.intelStatus === 'done') {
      html += `<div class="intel-stage-indicator">`;
      sections.forEach((s, idx) => {
        const isDone = !!s.done;
        // 当前激活阶段：处理中且前一项已完成
        const isActive = item.intelStatus === 'processing' && !isDone &&
          (idx === 0 || sections[idx - 1].done);
        let cls = 'intel-stage';
        if (isDone) cls += ' done';
        else if (isActive) cls += ' active';
        html += `<span class="${cls}"><span class="parse-stage-dot"></span>${isDone ? '✓ ' : ''}${s.label}</span>`;
        if (idx < sections.length - 1) {
          html += `<span class="parse-stage-arrow">›</span>`;
        }
      });
      html += `</div>`;

      // 完成时显示明细
      if (item.intelStatus === 'done') {
        html += `<div class="parse-result">`;
        if (item.intelSummary) html += `<span class="parse-result-item">✓ 摘要已生成</span>`;
        if (item.intelTags) html += `<span class="parse-result-item">✓ 标签已提取</span>`;
        if (item.intelCategory) html += `<span class="parse-result-item">✓ 分类已完成</span>`;
        html += `</div>`;
      }
    }

    html += `</div>`;
    return html;
  }

  /**
   * P1-2: 处理 ScanProcessor 回传的 OCR 文本
   * 将 OCR 文本作为新文档创建到目标知识库
   */
  async function handleOcrText(text: string) {
    const kbId = (document.getElementById('target-kb') as HTMLSelectElement).value;
    if (!kbId) {
      alert('请先选择目标知识库');
      return;
    }

    // 生成文档标题：取首行非空文本，截断 30 字符
    const firstLine = text.split(/\r?\n/).map((l) => l.trim()).find(Boolean) || '';
    const titleBase = firstLine.slice(0, 30) || '扫描件 OCR 文档';
    const title = `${titleBase} ${formatTime(new Date())}`;

    // 创建占位 File 用于展示（不实际上传该文件）
    const file = new File([text], `${title}.md`, { type: 'text/markdown' });
    const item: UploadItem = {
      file,
      progress: 0,
      status: 'uploading',
      isOcrDoc: true,
    };
    uploadItems.push(item);
    renderList();

    try {
      item.progress = 50;
      renderList();

      // 调用文档创建 API（JSON body，文本直接入库）
      const doc = await postData<{ id: string }>(
        `/api/v1/knowledge/${kbId}/documents`,
        {
          kb_id: kbId,
          title,
          content_text: text,
          doc_type: 'md',
        }
      );

      item.status = 'success';
      item.progress = 100;
      item.docId = doc.id;
      item.charCount = text.length;
      // OCR 文本文档无需解析流程，跳过 parse section
      renderList();

      // P1-5: OCR 文档同样触发智能处理
      triggerIntelligence(item);
    } catch (err) {
      item.status = 'error';
      item.parseError = err instanceof Error ? err.message : 'OCR 文档创建失败';
      renderList();
    }
  }

  function escapeHtml(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // === 标签页切换 ===
  document.querySelectorAll<HTMLButtonElement>('.upload-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabName = tab.dataset.tab;
      if (!tabName) return;
      document.querySelectorAll<HTMLButtonElement>('.upload-tab').forEach((t) => {
        const active = t.dataset.tab === tabName;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      document.querySelectorAll<HTMLDivElement>('.upload-tab-panel').forEach((panel) => {
        panel.classList.toggle('active', panel.id === `tab-${tabName}`);
      });
    });
  });

  // === 拖拽上传 ===
  const zone = document.getElementById('upload-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;

  zone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(fileInput.files);
    fileInput.value = '';
  });

  zone.addEventListener('dragover', (e) => {
    e.preventDefault();
    zone.classList.add('dragover');
  });
  zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
  zone.addEventListener('drop', (e) => {
    e.preventDefault();
    zone.classList.remove('dragover');
    if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
  });

  document.getElementById('clear-list')?.addEventListener('click', () => {
    uploadItems = [];
    renderList();
  });

  // P1-2: 监听 ScanProcessor 回传的 OCR 文本事件
  // ScanProcessor（React Island, client:only="react"）通过 window CustomEvent
  // 'ekb:ocr-text' 回传识别后的文本（client:only props 无法序列化函数）
  window.addEventListener('ekb:ocr-text', (e: Event) => {
    const detail = (e as CustomEvent<string>).detail;
    if (detail) {
      // 切换到普通上传标签页以展示入库进度
      const normalTab = document.querySelector<HTMLButtonElement>('.upload-tab[data-tab="normal"]');
      normalTab?.click();
      handleOcrText(detail);
    }
  });

  // 页面加载时拉取知识库列表
  loadKnowledgeBases();
  // P1: 扫描 localStorage 中未完成的分片上传记录，提示用户可续传
  scanUnfinishedUploads();
</script>
