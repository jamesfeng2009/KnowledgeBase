---
/**
 * 知识库管理页面
 * 知识库列表表格 + 创建/编辑知识库 + 成员管理 + 权限设置
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '管理', href: '/manage/kb' }, { label: '知识库管理' }];
---

<DefaultLayout title="知识库管理" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">知识库管理</h1>
    <button class="btn btn-primary" id="create-kb-btn">＋ 创建知识库</button>
  </div>

  <div class="card">
    <div class="table-toolbar">
      <input type="text" class="form-input" id="kb-search" placeholder="搜索知识库..." style="max-width: 240px;" />
      <select class="form-input" id="kb-status" style="width: 140px;">
        <option value="">全部状态</option>
        <option value="active">启用</option>
        <option value="archived">归档</option>
      </select>
    </div>
    <div style="overflow-x: auto;">
      <table class="data-table">
        <thead>
          <tr>
            <th>知识库名称</th>
            <th>描述</th>
            <th>文档数</th>
            <th>成员</th>
            <th>状态</th>
            <th>更新时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="kb-table-body">
          <tr><td colspan="7" class="loading-state">加载中...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 创建/编辑知识库弹窗 -->
  <div class="modal-overlay" id="kb-modal" style="display: none;">
    <div class="modal" style="max-width: 560px;">
      <div class="modal-header">
        <h3 id="modal-title">创建知识库</h3>
        <button class="btn btn-ghost btn-sm" id="close-modal">✕</button>
      </div>
      <form id="kb-form">
        <div class="modal-body">
          <input type="hidden" name="id" />
          <div class="form-group">
            <label class="form-label">知识库名称 *</label>
            <input type="text" class="form-input" name="name" required placeholder="如：公司制度" />
          </div>
          <div class="form-group">
            <label class="form-label">描述</label>
            <textarea class="form-textarea" name="description" placeholder="描述知识库的用途和范围"></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">访问权限</label>
            <select class="form-input" name="visibility">
              <option value="private">私有（仅成员可见）</option>
              <option value="team">团队可见</option>
              <option value="public">全员可见</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">自动解析</label>
            <div style="display: flex; align-items: center; gap: var(--space-2);">
              <label class="switch"><input type="checkbox" name="auto_parse" checked /><span class="switch-slider"></span></label>
              <span class="text-muted" style="font-size: var(--text-sm);">上传文档后自动解析和向量化</span>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="cancel-btn">取消</button>
          <button type="submit" class="btn btn-primary">保存</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 成员管理弹窗 -->
  <div class="modal-overlay" id="member-modal" style="display: none;">
    <div class="modal" style="max-width: 560px;">
      <div class="modal-header">
        <h3>成员管理</h3>
        <button class="btn btn-ghost btn-sm" id="close-member-modal">✕</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">添加成员</label>
          <div style="display: flex; gap: var(--space-2);">
            <input type="text" class="form-input" placeholder="输入邮箱或用户名" />
            <select class="form-input" style="width: 120px;">
              <option value="viewer">查看者</option>
              <option value="editor">编辑者</option>
              <option value="admin">管理员</option>
            </select>
            <button class="btn btn-primary">添加</button>
          </div>
        </div>
        <div id="member-list"></div>
      </div>
    </div>
  </div>
</DefaultLayout>

<style>
  .table-toolbar {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table th {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }
  .data-table td {
    padding: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--border-light);
  }
  .data-table tbody tr:hover {
    background: var(--surface-hover);
  }
  .kb-name-cell {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
  }
  .kb-name-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--primary-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .action-btns {
    display: flex;
    gap: var(--space-2);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .error-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--danger);
  }
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  .modal {
    background: var(--surface);
    border-radius: var(--radius-lg);
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-xl);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .modal-body {
    padding: var(--space-5);
  }
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .switch {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
  }
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .switch-slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background: var(--border-dark);
    border-radius: var(--radius-full);
    transition: var(--transition);
  }
  .switch-slider::before {
    content: '';
    position: absolute;
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 3px;
    background: var(--surface);
    border-radius: 50%;
    transition: var(--transition);
  }
  .switch input:checked + .switch-slider {
    background: var(--primary);
  }
  .switch input:checked + .switch-slider::before {
    transform: translateX(18px);
  }
  .member-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-light);
  }
</style>

<script>
  import {
    getKnowledgeBases,
    createKnowledgeBase,
    updateKnowledgeBase,
    deleteKnowledgeBase,
    type KnowledgeBase,
  } from '@/lib/apis/knowledge';
  import { getData } from '@/lib/api';

  const BASE = '/api/v1';

  let kbs: KnowledgeBase[] = [];

  function escapeHtml(s: string): string {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // ===== 加载知识库列表 =====
  async function loadKbs() {
    const body = document.getElementById('kb-table-body')!;
    body.innerHTML = '<tr><td colspan="7" class="loading-state">加载中...</td></tr>';
    try {
      const res = await getKnowledgeBases(1, 100);
      kbs = res?.items || [];
      renderTable();
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      body.innerHTML = `<tr><td colspan="7" class="error-state">知识库加载失败：${escapeHtml(msg)}<br/><button class="btn btn-outline btn-sm" id="retry-kbs" style="margin-top: var(--space-3);">重试</button></td></tr>`;
      document.getElementById('retry-kbs')?.addEventListener('click', loadKbs);
    }
  }

  function renderTable() {
    const keyword = (document.getElementById('kb-search') as HTMLInputElement).value.trim().toLowerCase();
    const status = (document.getElementById('kb-status') as HTMLSelectElement).value;

    // 本地过滤：搜索关键字 + 状态
    let list = kbs.filter((k) => {
      if (keyword && !k.name.toLowerCase().includes(keyword)) return false;
      if (status && (k.visibility || 'active') !== status) return false;
      return true;
    });

    const body = document.getElementById('kb-table-body')!;
    if (list.length === 0) {
      body.innerHTML = '<tr><td colspan="7" class="empty-state">暂无知识库</td></tr>';
      return;
    }

    body.innerHTML = list
      .map(
        (k) => `
      <tr>
        <td>
          <div class="kb-name-cell">
            <div class="kb-name-icon">📚</div>
            ${escapeHtml(k.name)}
          </div>
        </td>
        <td class="text-muted">${escapeHtml(k.description || '')}</td>
        <td>${k.document_count || 0}</td>
        <td>--</td>
        <td><span class="badge ${(k.visibility || 'active') === 'archived' ? 'badge-warning' : 'badge-success'}">${(k.visibility || 'active') === 'archived' ? '归档' : '启用'}</span></td>
        <td class="text-muted">${escapeHtml(k.updated_at || '')}</td>
        <td>
          <div class="action-btns">
            <button class="btn btn-ghost btn-sm" data-action="edit" data-id="${escapeHtml(k.id)}">编辑</button>
            <button class="btn btn-ghost btn-sm" data-action="member" data-id="${escapeHtml(k.id)}">成员</button>
            <button class="btn btn-ghost btn-sm" data-action="delete" data-id="${escapeHtml(k.id)}">删除</button>
          </div>
        </td>
      </tr>`
      )
      .join('');

    body.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = (btn as HTMLElement).dataset.action!;
        const id = (btn as HTMLElement).dataset.id!;
        const kb = kbs.find((k) => k.id === id);
        if (!kb) return;
        if (action === 'edit') openEditModal(kb);
        else if (action === 'member') openMemberModal(kb);
        else if (action === 'delete') deleteKb(kb);
      });
    });
  }

  function openCreateModal() {
    (document.getElementById('modal-title') as HTMLElement).textContent = '创建知识库';
    (document.getElementById('kb-form') as HTMLFormElement).reset();
    (document.querySelector('input[name="id"]') as HTMLInputElement).value = '';
    document.getElementById('kb-modal')!.style.display = 'flex';
  }

  function openEditModal(kb: KnowledgeBase) {
    (document.getElementById('modal-title') as HTMLElement).textContent = '编辑知识库';
    const form = document.getElementById('kb-form') as HTMLFormElement;
    (form.querySelector('input[name="id"]') as HTMLInputElement).value = kb.id;
    (form.querySelector('input[name="name"]') as HTMLInputElement).value = kb.name;
    (form.querySelector('textarea[name="description"]') as HTMLTextAreaElement).value = kb.description || '';
    if (kb.visibility) {
      (form.querySelector('select[name="visibility"]') as HTMLSelectElement).value = kb.visibility;
    }
    document.getElementById('kb-modal')!.style.display = 'flex';
  }

  // ===== 成员管理 =====
  async function openMemberModal(kb: KnowledgeBase) {
    const modal = document.getElementById('member-modal')!;
    const listEl = document.getElementById('member-list')!;
    modal.style.display = 'flex';
    listEl.innerHTML = '<div class="loading-state">加载中...</div>';
    try {
      // 调用 GET /api/v1/knowledge/{kb_id}/members
      const result = await getData<any[] | { items: any[] }>(`${BASE}/knowledge/${kb.id}/members`);
      let members: any[] = [];
      if (Array.isArray(result)) {
        members = result;
      } else if (result && Array.isArray(result.items)) {
        members = result.items;
      }
      if (members.length === 0) {
        listEl.innerHTML = '<div class="empty-state">该知识库暂无成员</div>';
        return;
      }
      listEl.innerHTML = members
        .map(
          (m) => `
        <div class="member-row">
          <div class="avatar avatar-sm">${escapeHtml((m.name || m.user_name || '?').charAt(0).toUpperCase())}</div>
          <div style="flex: 1;">
            <div style="font-size: var(--text-sm); font-weight: 500;">${escapeHtml(m.name || m.user_name || '未知')}</div>
            <div class="text-muted" style="font-size: var(--text-xs);">${escapeHtml(m.email || '')}</div>
          </div>
          <span class="badge badge-primary">${escapeHtml(m.role || '成员')}</span>
        </div>`
        )
        .join('');
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      // 后端无此接口时显示友好提示
      listEl.innerHTML = `<div class="empty-state">成员管理功能开发中<br/><span class="text-muted" style="font-size: var(--text-xs);">${escapeHtml(msg)}</span></div>`;
    }
  }

  // ===== 删除知识库 =====
  async function deleteKb(kb: KnowledgeBase) {
    if (!confirm(`确定删除知识库「${kb.name}」吗？此操作不可恢复。`)) return;
    try {
      await deleteKnowledgeBase(kb.id);
      alert('删除成功');
      await loadKbs();
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      alert('删除失败：' + msg);
    }
  }

  document.getElementById('create-kb-btn')?.addEventListener('click', openCreateModal);
  document.getElementById('close-modal')?.addEventListener('click', () => (document.getElementById('kb-modal')!.style.display = 'none'));
  document.getElementById('cancel-btn')?.addEventListener('click', () => (document.getElementById('kb-modal')!.style.display = 'none'));
  document.getElementById('close-member-modal')?.addEventListener('click', () => (document.getElementById('member-modal')!.style.display = 'none'));

  // ===== 表单提交：区分新建（POST）和更新（PUT） =====
  document.getElementById('kb-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = Object.fromEntries(new FormData(form));
    const id = (formData.id as string) || '';
    const payload = {
      name: formData.name as string,
      description: (formData.description as string) || undefined,
      visibility: formData.visibility as string,
    };
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = '保存中...';
    try {
      if (id) {
        // 编辑：调用 PUT 更新
        await updateKnowledgeBase(id, payload);
        alert('更新成功');
      } else {
        // 新建：调用 POST 创建
        await createKnowledgeBase(payload);
        alert('创建成功');
      }
      document.getElementById('kb-modal')!.style.display = 'none';
      await loadKbs();
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      alert('操作失败：' + msg);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '保存';
    }
  });

  document.getElementById('kb-search')?.addEventListener('input', renderTable);
  document.getElementById('kb-status')?.addEventListener('change', renderTable);

  loadKbs();
</script>
