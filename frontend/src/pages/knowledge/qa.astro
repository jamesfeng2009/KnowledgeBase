---
/**
 * 问答社区页面
 * 问题列表（状态筛选） + 问题统计 + 提问按钮 + 热门标签
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '知识', href: '/knowledge' }, { label: '问答社区' }];
---

<DefaultLayout title="问答社区" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">问答社区</h1>
    <button class="btn btn-primary" id="ask-btn">＋ 提问</button>
  </div>

  <!-- 统计卡片 -->
  <div class="grid grid-cols-4" style="margin-bottom: var(--space-5);">
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">问题总数</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--primary);" id="stat-all">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">待回答</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--warning);" id="stat-open">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">已解决</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--success);" id="stat-solved">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">今日新增</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--info);" id="stat-today">--</div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-5);">
    <!-- 问题列表 -->
    <div>
      <!-- 状态筛选 -->
      <div class="tabs" style="margin-bottom: var(--space-4);">
        <button class="tab active" data-status="all">全部</button>
        <button class="tab" data-status="open">待回答</button>
        <button class="tab" data-status="solved">已解决</button>
      </div>

      <div id="question-list">
        <div class="loading-state">加载中...</div>
      </div>
    </div>

    <!-- 热门标签 -->
    <div class="card">
      <div class="card-header"><h3>热门标签</h3></div>
      <div id="hot-tags" style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
        <div class="loading-state">加载中...</div>
      </div>
    </div>
  </div>
</DefaultLayout>

<!-- 提问弹窗 -->
<div class="modal-overlay" id="ask-modal" style="display: none;">
  <div class="modal" style="max-width: 560px;">
    <div class="modal-header">
      <h3>发布问题</h3>
      <button class="btn btn-ghost btn-sm" id="close-ask-modal">✕</button>
    </div>
    <form id="ask-form">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">问题标题 *</label>
          <input type="text" class="form-input" name="title" required placeholder="一句话描述你的问题" />
        </div>
        <div class="form-group">
          <label class="form-label">问题内容 *</label>
          <textarea class="form-textarea" name="content" required placeholder="详细描述你的问题..." style="min-height: 150px;"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">标签（逗号分隔）</label>
          <input type="text" class="form-input" name="tags" placeholder="如：报销, 流程" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="cancel-ask">取消</button>
        <button type="submit" class="btn btn-primary">发布</button>
      </div>
    </form>
  </div>
</div>

<!-- 问题详情弹窗 -->
<div class="modal-overlay" id="detail-modal" style="display: none;">
  <div class="modal" style="max-width: 680px;">
    <div class="modal-header">
      <h3>问题详情</h3>
      <button class="btn btn-ghost btn-sm" id="close-detail-modal">✕</button>
    </div>
    <div class="modal-body" id="detail-body">
      <div class="loading-state">加载中...</div>
    </div>
  </div>
</div>

<style>
  .tabs {
    display: flex;
    gap: var(--space-1);
    border-bottom: 1px solid var(--border);
  }
  .tab {
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-base);
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    transition: all var(--transition-fast);
    background: transparent;
    border-left: none;
    border-right: none;
    border-top: none;
    cursor: pointer;
  }
  .tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
    font-weight: 500;
  }
  .question-item {
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .question-item:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-sm);
  }
  .question-item-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .question-item-title {
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--text);
    flex: 1;
  }
  .question-item-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .error-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--danger);
  }
  .card .tag {
    cursor: pointer;
  }
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  .modal {
    background: var(--surface);
    border-radius: var(--radius-lg);
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-xl);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .modal-body {
    padding: var(--space-5);
  }
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .answer-item {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-light);
  }
  .answer-item:last-child {
    border-bottom: none;
  }
  .answer-item-meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  .answer-item-content {
    font-size: var(--text-sm);
    color: var(--text);
    line-height: var(--lh-relaxed);
  }
</style>

<script>
  import { getSearchHotwords, type KeywordCount } from '@/lib/apis/analytics';
  import { getQuestions, getQuestion, createQuestion } from '@/lib/apis/qa';

  interface Question {
    id: string;
    title: string;
    content?: string;
    status: string;
    answers?: number;
    views?: number;
    tags?: string[];
    author?: string;
    created_at?: string;
  }

  interface Answer {
    id: string;
    content: string;
    author?: string;
    created_at?: string;
  }

  let currentStatus = 'all';

  /** 从接口返回值中提取问题数组（兼容数组 / { items: [] } / 分页对象） */
  function toQuestions(raw: unknown): Question[] {
    const arr = Array.isArray(raw)
      ? raw
      : raw && typeof raw === 'object' && Array.isArray((raw as { items?: unknown[] }).items)
        ? (raw as { items: unknown[] }).items
        : [];
    return arr as Question[];
  }

  function escapeHtml(s: string): string {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function isToday(iso?: string): boolean {
    if (!iso) return false;
    const d = new Date(iso);
    if (isNaN(d.getTime())) return false;
    const today = new Date();
    return d.getFullYear() === today.getFullYear()
      && d.getMonth() === today.getMonth()
      && d.getDate() === today.getDate();
  }

  // ===== 问题列表 =====
  async function loadQuestions() {
    const container = document.getElementById('question-list')!;
    container.innerHTML = '<div class="loading-state">加载中...</div>';
    try {
      const result = await getQuestions(
        currentStatus === 'all' ? undefined : { status: currentStatus }
      );
      const questions = toQuestions(result);
      renderQuestions(questions);
      updateStats(questions);
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      container.innerHTML = `<div class="error-state">问题加载失败：${escapeHtml(msg)}<br/><button class="btn btn-outline btn-sm" id="retry-questions" style="margin-top: var(--space-3);">重试</button></div>`;
      document.getElementById('retry-questions')?.addEventListener('click', loadQuestions);
    }
  }

  function updateStats(questions: Question[]) {
    const setText = (id: string, v: number | string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(v);
    };
    setText('stat-all', questions.length);
    setText('stat-open', questions.filter((q) => q.status === 'open').length);
    setText('stat-solved', questions.filter((q) => q.status === 'solved').length);
    setText('stat-today', questions.filter((q) => isToday(q.created_at)).length);
  }

  function renderQuestions(questions: Question[]) {
    const container = document.getElementById('question-list')!;
    if (questions.length === 0) {
      container.innerHTML = '<div class="empty-state">暂无问题</div>';
      return;
    }
    container.innerHTML = questions
      .map(
        (q) => `
      <div class="question-item" data-id="${escapeHtml(q.id)}">
        <div class="question-item-header">
          <span class="badge ${q.status === 'solved' ? 'badge-success' : 'badge-warning'}">${q.status === 'solved' ? '已解决' : '待回答'}</span>
          <span class="question-item-title">${escapeHtml(q.title)}</span>
        </div>
        <div class="question-item-footer">
          <span>${q.answers || 0} 回答</span>
          <span>${q.views || 0} 浏览</span>
          <span>${escapeHtml(q.author || '匿名')}</span>
          <span>${escapeHtml(q.created_at || '')}</span>
          ${q.tags?.map((t) => `<span class="tag">${escapeHtml(t)}</span>`).join('') || ''}
        </div>
      </div>`
      )
      .join('');

    container.querySelectorAll('.question-item').forEach((el) => {
      el.addEventListener('click', () => {
        const id = (el as HTMLElement).dataset.id;
        if (id) openQuestionDetail(id);
      });
    });
  }

  // ===== 问题详情 =====
  async function openQuestionDetail(id: string) {
    const modal = document.getElementById('detail-modal')!;
    const body = document.getElementById('detail-body')!;
    modal.style.display = 'flex';
    body.innerHTML = '<div class="loading-state">加载中...</div>';
    try {
      const data = (await getQuestion(id)) as unknown as Question & { answers?: Answer[] };
      const answers: Answer[] = data?.answers || [];
      body.innerHTML = `
        <div style="margin-bottom: var(--space-4);">
          <h3 style="font-size: var(--text-lg); margin-bottom: var(--space-2);">${escapeHtml(data.title || '')}</h3>
          <div class="text-muted" style="font-size: var(--text-xs);">
            ${escapeHtml(data.author || '匿名')} · ${escapeHtml(data.created_at || '')} · ${data.answers || answers.length || 0} 回答
          </div>
          ${data.tags && data.tags.length ? `<div style="margin-top: var(--space-2);">${data.tags.map((t) => `<span class="tag">${escapeHtml(t)}</span>`).join('')}</div>` : ''}
        </div>
        <div style="padding: var(--space-3); background: var(--surface-muted); border-radius: var(--radius); margin-bottom: var(--space-4); font-size: var(--text-sm); line-height: var(--lh-relaxed);">
          ${escapeHtml(data.content || '（无详细内容）')}
        </div>
        <h4 style="font-size: var(--text-md); margin-bottom: var(--space-3);">回答列表（${answers.length}）</h4>
        ${answers.length === 0
          ? '<div class="empty-state">暂无回答，快来发表第一条吧</div>'
          : answers.map((a) => `
            <div class="answer-item">
              <div class="answer-item-meta">${escapeHtml(a.author || '匿名')} · ${escapeHtml(a.created_at || '')}</div>
              <div class="answer-item-content">${escapeHtml(a.content || '')}</div>
            </div>
          `).join('')
        }
      `;
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      body.innerHTML = `<div class="error-state">问题详情加载失败：${escapeHtml(msg)}<br/><button class="btn btn-outline btn-sm" id="retry-detail" style="margin-top: var(--space-3);">重试</button></div>`;
      document.getElementById('retry-detail')?.addEventListener('click', () => openQuestionDetail(id));
    }
  }

  // ===== 热门标签云（从搜索热词取） =====
  async function loadHotTags() {
    const container = document.getElementById('hot-tags')!;
    try {
      const data: KeywordCount[] = await getSearchHotwords(30, 10);
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="empty-state">暂无热门标签</div>';
        return;
      }
      container.innerHTML = data
        .map((t) => `<span class="tag" data-tag="${escapeHtml(t.keyword)}">${escapeHtml(t.keyword)} (${t.count})</span>`)
        .join('');
      container.querySelectorAll('.tag').forEach((el) => {
        el.addEventListener('click', () => {
          const tag = (el as HTMLElement).dataset.tag!;
          window.location.href = `/knowledge/search?q=${encodeURIComponent(tag)}`;
        });
      });
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      container.innerHTML = `<div class="error-state">热门标签加载失败：${escapeHtml(msg)}</div>`;
    }
  }

  // ===== 提问弹窗 =====
  const askModal = document.getElementById('ask-modal')!;
  document.getElementById('ask-btn')?.addEventListener('click', () => {
    (document.getElementById('ask-form') as HTMLFormElement).reset();
    askModal.style.display = 'flex';
  });
  document.getElementById('close-ask-modal')?.addEventListener('click', () => (askModal.style.display = 'none'));
  document.getElementById('cancel-ask')?.addEventListener('click', () => (askModal.style.display = 'none'));
  document.getElementById('close-detail-modal')?.addEventListener('click', () => {
    (document.getElementById('detail-modal') as HTMLElement).style.display = 'none';
  });

  document.getElementById('ask-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form));
    const tags = (data.tags as string || '').split(',').map((t) => t.trim()).filter(Boolean);
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = '发布中...';
    try {
      await createQuestion({
        title: String(data.title),
        content: String(data.content),
        tags,
      });
      alert('问题发布成功');
      askModal.style.display = 'none';
      form.reset();
      loadQuestions();
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      alert('问题发布失败：' + msg);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '发布';
    }
  });

  // ===== 状态筛选 =====
  document.querySelectorAll('.tab').forEach((el) => {
    el.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach((e) => e.classList.remove('active'));
      el.classList.add('active');
      currentStatus = (el as HTMLElement).dataset.status!;
      loadQuestions();
    });
  });

  loadQuestions();
  loadHotTags();
</script>
