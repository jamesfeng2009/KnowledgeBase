---
/**
 * 专家发现页面
 * 顶部搜索区 + 专家卡片列表（左 2/3） + 贡献排行榜（右 1/3）
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '知识', href: '/knowledge' }, { label: '专家发现' }];
---

<DefaultLayout title="专家发现" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">专家发现</h1>
  </div>

  <!-- 顶部搜索区 -->
  <section class="expert-search-wrapper">
    <div class="expert-search-bar">
      <span class="expert-search-icon">🔍</span>
      <input
        type="text"
        class="expert-search-input"
        id="expert-search-input"
        placeholder="输入技术关键词，如“微服务”、“数据分析”"
        autocomplete="off"
      />
      <button class="btn btn-primary" id="expert-search-btn">搜索专家</button>
    </div>
    <p class="expert-search-tip">输入技术关键词，找到团队中的专家</p>
    <div class="expert-search-suggestions">
      <span class="text-muted" style="font-size: var(--text-sm);">试试搜索：</span>
      <button class="tag" data-q="微服务">微服务</button>
      <button class="tag" data-q="数据分析">数据分析</button>
      <button class="tag" data-q="机器学习">机器学习</button>
      <button class="tag" data-q="DevOps">DevOps</button>
      <button class="tag" data-q="架构设计">架构设计</button>
    </div>
  </section>

  <!-- 主体布局：左 2/3 搜索结果 + 右 1/3 排行榜 -->
  <div class="experts-layout">
    <!-- 左侧：搜索结果区 -->
    <main class="experts-main">
      <div class="experts-section-header">
        <h2 class="experts-section-title">专家列表</h2>
        <span class="text-muted experts-section-count" id="expert-count"></span>
      </div>
      <div id="expert-list">
        <div class="expert-empty">
          <div class="expert-empty-icon">👥</div>
          <h3>输入关键词开始搜索</h3>
          <p class="text-muted">输入技术关键词，找到团队中的专家</p>
        </div>
      </div>
    </main>

    <!-- 右侧：贡献排行榜 -->
    <aside class="experts-aside">
      <div class="card ranking-card">
        <div class="card-header ranking-header">
          <h3>贡献排行榜</h3>
          <div class="ranking-range-switcher" role="tablist">
            <button class="ranking-range-btn" data-days="7" role="tab">近 7 天</button>
            <button class="ranking-range-btn active" data-days="30" role="tab">近 30 天</button>
            <button class="ranking-range-btn" data-days="90" role="tab">近 90 天</button>
          </div>
        </div>
        <div id="ranking-list">
          <div class="ranking-loading">
            <div class="spinner" style="margin: 0 auto;"></div>
            <p class="text-muted">加载中...</p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</DefaultLayout>

<style>
  /* === 顶部搜索区 === */
  .expert-search-wrapper {
    margin-bottom: var(--space-6);
  }
  .expert-search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .expert-search-bar:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
  }
  .expert-search-icon {
    padding: 0 var(--space-3);
    color: var(--text-muted);
    font-size: 20px;
  }
  .expert-search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--text-md);
    padding: var(--space-3) 0;
  }
  .expert-search-input:focus {
    outline: none;
    box-shadow: none;
  }
  .expert-search-tip {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .expert-search-suggestions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }
  .expert-search-suggestions .tag {
    cursor: pointer;
  }

  /* === 主体布局 === */
  .experts-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }
  .experts-main {
    min-width: 0;
  }
  .experts-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .experts-section-title {
    font-size: var(--text-xl);
    font-weight: 600;
  }
  .experts-section-count {
    font-size: var(--text-sm);
  }

  /* === 专家卡片 === */
  .expert-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-4);
    transition: all var(--transition);
    display: flex;
    gap: var(--space-5);
  }
  .expert-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--primary-light);
    transform: translateY(-1px);
  }

  .expert-card-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .expert-avatar {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-white);
    font-size: var(--text-2xl);
    font-weight: 600;
    overflow: hidden;
    flex-shrink: 0;
  }
  .expert-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* === 圆环进度条（专业度分数） === */
  .expert-score-ring {
    position: relative;
    width: 64px;
    height: 64px;
  }
  .expert-score-ring svg {
    transform: rotate(-90deg);
    display: block;
  }
  .expert-score-ring-bg {
    fill: none;
    stroke: var(--border);
    stroke-width: 4;
  }
  .expert-score-ring-fg {
    fill: none;
    stroke: var(--primary);
    stroke-width: 4;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.6s ease;
  }
  .expert-score-ring-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--primary);
    line-height: 1;
  }
  .expert-score-ring-caption {
    font-size: 10px;
    color: var(--text-muted);
    text-align: center;
    margin-top: 2px;
  }

  .expert-card-body {
    flex: 1;
    min-width: 0;
  }
  .expert-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .expert-name {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text);
  }
  .expert-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-1);
  }
  .expert-card-areas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0;
  }
  .expert-card-stats {
    display: flex;
    gap: var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }
  .expert-card-stats span strong {
    color: var(--text);
    font-weight: 600;
    margin-right: var(--space-1);
  }

  /* === 空状态 === */
  .expert-empty {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }
  .expert-empty-icon {
    font-size: 48px;
    margin-bottom: var(--space-4);
    line-height: 1;
  }
  .expert-empty h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  /* === 排行榜 === */
  .ranking-card {
    padding: var(--space-4);
    position: sticky;
    top: calc(var(--topbar-height) + var(--space-4));
  }
  .ranking-header {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .ranking-header h3 {
    font-size: var(--text-lg);
  }
  .ranking-range-switcher {
    display: flex;
    gap: var(--space-1);
    background: var(--surface-muted);
    border-radius: var(--radius);
    padding: var(--space-1);
  }
  .ranking-range-btn {
    flex: 1;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }
  .ranking-range-btn:hover {
    color: var(--text);
  }
  .ranking-range-btn.active {
    background: var(--surface);
    color: var(--primary);
    font-weight: 500;
    box-shadow: var(--shadow-xs);
  }

  .ranking-loading {
    text-align: center;
    padding: var(--space-8) 0;
  }
  .ranking-loading p {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .ranking-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-1);
    border-bottom: 1px solid var(--border-light);
    transition: background var(--transition-fast);
  }
  .ranking-item:last-child {
    border-bottom: none;
  }
  .ranking-item-rank {
    width: 28px;
    text-align: center;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--text-muted);
    flex-shrink: 0;
    line-height: 1;
  }
  .ranking-item.top-1,
  .ranking-item.top-2,
  .ranking-item.top-3 {
    border-radius: var(--radius);
  }
  .ranking-item.top-1 .ranking-item-rank,
  .ranking-item.top-2 .ranking-item-rank,
  .ranking-item.top-3 .ranking-item-rank {
    font-size: var(--text-xl);
  }
  .ranking-item.top-1 {
    background: linear-gradient(90deg, var(--warning-bg) 0%, transparent 80%);
  }
  .ranking-item.top-2 {
    background: linear-gradient(90deg, var(--surface-muted) 0%, transparent 80%);
  }
  .ranking-item.top-3 {
    background: linear-gradient(90deg, #FFF0E0 0%, transparent 80%);
  }
  .ranking-item-avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-white);
    font-size: var(--text-sm);
    font-weight: 600;
    overflow: hidden;
    flex-shrink: 0;
  }
  .ranking-item-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ranking-item-info {
    flex: 1;
    min-width: 0;
  }
  .ranking-item-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ranking-item-dept {
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
  }
  .ranking-item-score {
    text-align: right;
    flex-shrink: 0;
  }
  .ranking-item-score-value {
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--primary);
    line-height: 1;
  }
  .ranking-item-score-meta {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .ranking-error {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .ranking-error-icon {
    font-size: 32px;
    margin-bottom: var(--space-2);
    line-height: 1;
  }

  /* === 响应式 === */
  @media (max-width: 1024px) {
    .experts-layout {
      grid-template-columns: 1fr;
    }
    .ranking-card {
      position: static;
    }
  }
  @media (max-width: 768px) {
    .expert-card {
      flex-direction: column;
      gap: var(--space-3);
    }
    .expert-card-left {
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
    }
    .expert-avatar {
      width: 48px;
      height: 48px;
      font-size: var(--text-lg);
    }
    .expert-card-header {
      flex-direction: column;
      gap: var(--space-2);
    }
    .expert-card-stats {
      gap: var(--space-3);
    }
  }
</style>

<script>
  import { findExperts, getTopContributors } from '@/lib/apis/experts';

  // 基于姓名/用户 ID 哈希生成稳定的头像背景色
  const AVATAR_COLORS = [
    '#6C5CE7', '#00B884', '#FF9500', '#2196F3',
    '#FF3B5C', '#9B59B6', '#1ABC9C', '#34495E',
    '#E67E22', '#16A085', '#2980B9', '#8E44AD',
  ];

  function hashString(s: string): number {
    let hash = 0;
    for (let i = 0; i < s.length; i++) {
      hash = ((hash << 5) - hash) + s.charCodeAt(i);
      hash |= 0;
    }
    return Math.abs(hash);
  }

  function getAvatarColor(seed: string): string {
    return AVATAR_COLORS[hashString(seed || 'unknown') % AVATAR_COLORS.length];
  }

  function getInitial(name: string): string {
    if (!name) return '?';
    return name.charAt(0).toUpperCase();
  }

  function escapeHtml(s: string): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // 渲染头像：有图片显示图片，否则显示首字母 + 哈希背景色
  function renderAvatar(
    avatar: string | null,
    name: string,
    userId: string,
    cls: string,
  ): string {
    const color = getAvatarColor(userId || name);
    if (avatar) {
      return `<div class="${cls}" style="background:${color};"><img src="${escapeHtml(avatar)}" alt="${escapeHtml(name)}" /></div>`;
    }
    return `<div class="${cls}" style="background:${color};">${escapeHtml(getInitial(name))}</div>`;
  }

  // 渲染圆环进度条（专业度分数，0-100）
  function renderScoreRing(score: number): string {
    const normalized = Math.max(0, Math.min(100, Math.round(score || 0)));
    const radius = 28;
    const circumference = 2 * Math.PI * radius;
    const offset = circumference - (normalized / 100) * circumference;
    return `
      <div class="expert-score-ring">
        <svg width="64" height="64" viewBox="0 0 64 64">
          <circle class="expert-score-ring-bg" cx="32" cy="32" r="${radius}" />
          <circle class="expert-score-ring-fg" cx="32" cy="32" r="${radius}"
            stroke-dasharray="${circumference.toFixed(2)}" stroke-dashoffset="${offset.toFixed(2)}" />
        </svg>
        <div class="expert-score-ring-label">${normalized}</div>
      </div>`;
  }

  // 渲染单张专家卡片
  function renderExpertCard(expert: any): string {
    const deptTitle = [expert.department, expert.title]
      .filter(Boolean)
      .join(' · ') || '未填写部门信息';
    const areas = (expert.expertise_areas || [])
      .slice(0, 6)
      .map((a: string) => `<span class="tag">${escapeHtml(a)}</span>`)
      .join('');
    return `
      <article class="expert-card">
        <div class="expert-card-left">
          ${renderAvatar(expert.avatar, expert.name, expert.user_id, 'expert-avatar')}
          ${renderScoreRing(expert.expertise_score)}
        </div>
        <div class="expert-card-body">
          <div class="expert-card-header">
            <div>
              <div class="expert-name">${escapeHtml(expert.name)}</div>
              <div class="expert-meta">${escapeHtml(deptTitle)}</div>
            </div>
            <button class="btn btn-outline btn-sm expert-ask-btn"
              data-user-id="${escapeHtml(expert.user_id)}"
              data-name="${escapeHtml(expert.name)}">发起问答</button>
          </div>
          <div class="expert-card-areas">
            ${areas || '<span class="text-muted" style="font-size: var(--text-sm);">暂无专业领域标签</span>'}
          </div>
          <div class="expert-card-stats">
            <span><strong>${expert.document_count || 0}</strong>文档</span>
            <span><strong>${expert.answer_count || 0}</strong>回答</span>
            <span class="text-muted">专业度 ${Math.round(expert.expertise_score || 0)}</span>
          </div>
        </div>
      </article>`;
  }

  // 渲染搜索结果列表
  function renderExperts(experts: any[]): void {
    const container = document.getElementById('expert-list');
    const countEl = document.getElementById('expert-count');
    if (!container) return;

    if (!experts || experts.length === 0) {
      if (countEl) countEl.textContent = '';
      container.innerHTML = `
        <div class="expert-empty">
          <div class="expert-empty-icon">😕</div>
          <h3>未找到相关专家</h3>
          <p class="text-muted">试试其他关键词</p>
        </div>`;
      return;
    }

    if (countEl) countEl.textContent = `共 ${experts.length} 位专家`;
    container.innerHTML = experts.map(renderExpertCard).join('');

    container.querySelectorAll('.expert-ask-btn').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const name = (el as HTMLElement).dataset.name || '';
        alert(`向 ${name} 发起问答，即将跳转到问答社区`);
        window.location.href = '/knowledge/qa';
      });
    });
  }

  // 执行专家搜索
  async function doSearch(): Promise<void> {
    const input = document.getElementById('expert-search-input') as HTMLInputElement | null;
    if (!input) return;
    const keyword = input.value.trim();
    if (!keyword) {
      alert('请输入搜索关键词');
      return;
    }

    const container = document.getElementById('expert-list');
    const countEl = document.getElementById('expert-count');
    if (countEl) countEl.textContent = '';
    if (container) {
      container.innerHTML = `
        <div class="expert-empty">
          <div class="spinner" style="margin: 0 auto;"></div>
          <p class="text-muted" style="margin-top: var(--space-3);">搜索专家中...</p>
        </div>`;
    }

    try {
      const experts = await findExperts(keyword, 10);
      renderExperts(experts);
    } catch (err) {
      if (container) {
        container.innerHTML = `
          <div class="expert-empty">
            <div class="expert-empty-icon">⚠️</div>
            <h3>搜索失败</h3>
            <p class="text-muted">${escapeHtml(err instanceof Error ? err.message : '请稍后重试')}</p>
          </div>`;
      }
    }
  }

  // 渲染贡献排行榜
  function renderRanking(contributors: any[]): void {
    const container = document.getElementById('ranking-list');
    if (!container) return;

    if (!contributors || contributors.length === 0) {
      container.innerHTML = `
        <div class="ranking-error">
          <div class="ranking-error-icon">📊</div>
          暂无贡献数据
        </div>`;
      return;
    }

    const medals = ['🥇', '🥈', '🥉'];
    container.innerHTML = contributors
      .map((c, idx) => {
        const rank = idx + 1;
        const rankDisplay = rank <= 3 ? medals[rank - 1] : String(rank);
        const topCls = rank <= 3 ? `top-${rank}` : '';
        return `
          <div class="ranking-item ${topCls}">
            <div class="ranking-item-rank">${rankDisplay}</div>
            ${renderAvatar(c.avatar, c.name, c.user_id, 'ranking-item-avatar')}
            <div class="ranking-item-info">
              <div class="ranking-item-name">${escapeHtml(c.name)}</div>
              <div class="ranking-item-dept">${escapeHtml(c.department || '未填写')}</div>
            </div>
            <div class="ranking-item-score">
              <div class="ranking-item-score-value">${c.contribution_score || 0}</div>
              <div class="ranking-item-score-meta">${c.document_count || 0} 文档 / ${c.answer_count || 0} 回答</div>
            </div>
          </div>`;
      })
      .join('');
  }

  // 加载贡献排行榜
  async function loadRanking(days: number): Promise<void> {
    const container = document.getElementById('ranking-list');
    if (!container) return;
    container.innerHTML = `
      <div class="ranking-loading">
        <div class="spinner" style="margin: 0 auto;"></div>
        <p class="text-muted">加载中...</p>
      </div>`;
    try {
      const data = await getTopContributors(days, 10);
      renderRanking(data);
    } catch (err) {
      container.innerHTML = `
        <div class="ranking-error">
          <div class="ranking-error-icon">⚠️</div>
          排行榜加载失败<br/>
          <span style="font-size: var(--text-xs);">${escapeHtml(err instanceof Error ? err.message : '请稍后重试')}</span>
        </div>`;
    }
  }

  // === 事件绑定 ===
  document.getElementById('expert-search-btn')?.addEventListener('click', doSearch);
  document.getElementById('expert-search-input')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') doSearch();
  });

  document.querySelectorAll('.expert-search-suggestions .tag').forEach((el) => {
    el.addEventListener('click', () => {
      const q = (el as HTMLElement).dataset.q || '';
      const input = document.getElementById('expert-search-input') as HTMLInputElement | null;
      if (input) input.value = q;
      doSearch();
    });
  });

  document.querySelectorAll('.ranking-range-btn').forEach((el) => {
    el.addEventListener('click', () => {
      document.querySelectorAll('.ranking-range-btn').forEach((e) => e.classList.remove('active'));
      el.classList.add('active');
      const days = parseInt((el as HTMLElement).dataset.days || '30', 10);
      loadRanking(days);
    });
  });

  // 初始化：默认加载近 30 天排行榜
  loadRanking(30);
</script>
