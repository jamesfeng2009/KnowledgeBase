---
  /**
   * 知识图谱页面
   * 对接后端图谱 API：统计卡片 + 力导向可视化 + 节点详情抽屉 + 推荐 + 搜索/类型筛选
   */
  import DefaultLayout from '@/layouts/DefaultLayout.astro';

  const breadcrumb = [{ label: '知识', href: '/knowledge' }, { label: '知识图谱' }];
---

<DefaultLayout title="知识图谱" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">知识图谱</h1>
    <div class="header-actions">
      <input type="text" class="form-input" id="graph-search" placeholder="搜索节点..." />
      <button class="btn btn-outline btn-sm" id="reset-graph">重置视图</button>
      <button class="btn btn-primary btn-sm" id="refresh-graph">刷新图谱</button>
    </div>
  </div>

  <!-- 统计卡片 -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-label">节点总数</div>
      <div class="stat-value" id="stat-nodes">--</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">关系总数</div>
      <div class="stat-value" id="stat-edges">--</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">核心节点数</div>
      <div class="stat-value" id="stat-core">--</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">平均度数</div>
      <div class="stat-value" id="stat-degree">--</div>
    </div>
  </div>

  <!-- 类型筛选 -->
  <div class="filter-chips" id="filter-chips">
    <button class="chip active" data-cat="all" type="button">全部</button>
    <button class="chip" data-cat="core" type="button">核心</button>
    <button class="chip" data-cat="entity" type="button">实体</button>
    <button class="chip" data-cat="topic" type="button">主题</button>
    <button class="chip" data-cat="keyword" type="button">关键词</button>
  </div>

  <!-- 图谱 + 详情抽屉 -->
  <div class="graph-layout">
    <div class="graph-canvas-wrapper">
      <canvas id="graph-canvas" class="graph-canvas"></canvas>
      <div class="graph-legend">
        <div class="legend-item"><span class="legend-dot" style="background:#6C5CE7;"></span> 核心</div>
        <div class="legend-item"><span class="legend-dot" style="background:#2196F3;"></span> 实体</div>
        <div class="legend-item"><span class="legend-dot" style="background:#00B884;"></span> 主题</div>
        <div class="legend-item"><span class="legend-dot" style="background:#8B8D9F;"></span> 关键词</div>
      </div>
      <div class="graph-tip">点击节点查看详情 · 节点大小按权重缩放 · 边粗细按权重缩放</div>
      <div class="graph-loading" id="graph-loading">加载中...</div>
    </div>

    <aside class="graph-detail">
      <div class="card">
        <div class="card-header"><h3>节点详情</h3></div>
        <div id="node-detail">
          <div class="detail-empty">点击节点查看详情</div>
        </div>
      </div>
    </aside>
  </div>

  <!-- 推荐区 -->
  <div class="recommend-section">
    <div class="card">
      <div class="card-header">
        <h3>推荐节点</h3>
        <span class="rec-basis" id="rec-basis"></span>
      </div>
      <div id="recommend-list">
        <div class="detail-empty">请选择一个节点以查看推荐</div>
      </div>
    </div>
  </div>
</DefaultLayout>

<style>
  .header-actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .header-actions .form-input {
    width: 220px;
  }

  /* 统计卡片 */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    box-shadow: var(--shadow-sm);
  }
  .stat-label {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .stat-value {
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
  }

  /* 类型筛选 chips */
  .filter-chips {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .chip {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .chip:hover {
    border-color: var(--primary-light);
    color: var(--primary);
  }
  .chip.active {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--text-white);
  }

  /* 图谱布局 */
  .graph-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }
  .graph-canvas-wrapper {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: 580px;
  }
  .graph-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: default;
  }
  .graph-legend {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3);
    box-shadow: var(--shadow-sm);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-1);
  }
  .legend-item:last-child {
    margin-bottom: 0;
  }
  .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .graph-tip {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-4);
    right: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-align: center;
    pointer-events: none;
  }
  .graph-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.7);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* 详情抽屉 */
  .graph-detail {
    height: 580px;
    overflow-y: auto;
  }
  .detail-empty {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-8);
    font-size: var(--text-sm);
  }
  .detail-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-3);
    word-break: break-word;
  }
  .detail-subtitle {
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-secondary);
  }
  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-light);
    font-size: var(--text-sm);
  }
  .detail-row:last-child {
    border-bottom: none;
  }
  .detail-row .label {
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .detail-value {
    text-align: right;
    word-break: break-all;
    color: var(--text);
  }
  .type-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-2);
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
  }
  .prop-list {
    max-height: 280px;
    overflow-y: auto;
  }

  /* 推荐区 */
  .recommend-section {
    margin-bottom: var(--space-6);
  }
  .rec-basis {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 400;
  }
  .rec-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    margin-bottom: var(--space-2);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .rec-item:hover {
    border-color: var(--primary-light);
    background: var(--primary-bg);
  }
  .rec-item:last-child {
    margin-bottom: 0;
  }
  .rec-main {
    flex: 1;
    min-width: 0;
  }
  .rec-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    margin-bottom: var(--space-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rec-reason {
    font-size: var(--text-xs);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rec-score {
    flex-shrink: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--primary);
    background: var(--primary-bg);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
  }

  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .graph-layout {
      grid-template-columns: 1fr;
    }
    .graph-canvas-wrapper {
      height: 460px;
    }
    .graph-detail {
      height: auto;
      max-height: 520px;
    }
    .header-actions .form-input {
      width: 140px;
    }
  }
</style>

<script>
  import {
    getGraphData,
    getNode,
    getRelatedNodes,
    getGraphStats,
    getRecommendations,
    invalidateRecommendationCache,
  } from '@/lib/apis/graph';
  import type { GraphNode, GraphEdge, GraphStats, Recommendation } from '@/lib/apis/graph';

  type NodeCategory = 'core' | 'entity' | 'topic' | 'keyword';

  interface DetailView {
    id: string;
    label: string;
    type: string;
    category: NodeCategory;
    weight: number;
    properties: Record<string, unknown>;
  }

  interface RenderNode extends DetailView {
    x: number;
    y: number;
    vx: number;
    vy: number;
  }

  interface RenderEdge {
    source: string;
    target: string;
    relation: string;
    weight: number;
  }

  const canvas = document.getElementById('graph-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  let renderNodes: RenderNode[] = [];
  let renderEdges: RenderEdge[] = [];
  let nodeMap = new Map<string, RenderNode>();
  let maxNodeWeight = 1;
  let maxEdgeWeight = 1;

  let selectedNodeId: string | null = null;
  let highlightedIds: Set<string> = new Set();
  let activeCategory: NodeCategory | 'all' = 'all';
  let searchKeyword = '';

  // ===== 工具函数 =====

  function normalizeType(raw: string): NodeCategory {
    const t = (raw || '').toLowerCase();
    if (t.includes('document') || t.includes('core') || t === 'doc') return 'core';
    if (t.includes('entity')) return 'entity';
    if (t.includes('topic')) return 'topic';
    if (t.includes('keyword') || t.includes('key')) return 'keyword';
    return 'entity';
  }

  function categoryColor(cat: NodeCategory): string {
    switch (cat) {
      case 'core':
        return '#6C5CE7';
      case 'entity':
        return '#2196F3';
      case 'topic':
        return '#00B884';
      case 'keyword':
        return '#8B8D9F';
    }
  }

  function categoryLabel(cat: NodeCategory): string {
    switch (cat) {
      case 'core':
        return '核心';
      case 'entity':
        return '实体';
      case 'topic':
        return '主题';
      case 'keyword':
        return '关键词';
    }
  }

  // 后端 getNode/getRelatedNodes 需要 Neo4j 标签作为 label 参数，这里把任意类型归一为标准标签
  function labelForApi(type: string): string {
    switch (normalizeType(type)) {
      case 'core':
        return 'Document';
      case 'entity':
        return 'Entity';
      case 'topic':
        return 'Topic';
      case 'keyword':
        return 'Keyword';
    }
  }

  function extractWeight(properties: Record<string, unknown> | undefined): number {
    if (!properties) return 1;
    const keys = ['weight', 'score', 'importance', 'strength', 'value'];
    for (const key of keys) {
      const v = properties[key];
      if (typeof v === 'number' && isFinite(v) && v > 0) return v;
    }
    return 1;
  }

  function escapeHtml(s: string): string {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatValue(v: unknown): string {
    if (v === null || v === undefined) return '-';
    let s: string;
    if (typeof v === 'string') s = v;
    else if (typeof v === 'number' || typeof v === 'boolean') s = String(v);
    else {
      try {
        s = JSON.stringify(v);
      } catch {
        s = String(v);
      }
    }
    return s.length > 120 ? s.slice(0, 120) + '...' : s;
  }

  function setText(id: string, text: string): void {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function showLoading(loading: boolean): void {
    const el = document.getElementById('graph-loading');
    if (el) el.style.display = loading ? 'flex' : 'none';
  }

  function isVisible(n: RenderNode): boolean {
    if (activeCategory !== 'all' && n.category !== activeCategory) return false;
    if (searchKeyword && !n.label.toLowerCase().includes(searchKeyword)) return false;
    return true;
  }

  function radiusFor(n: RenderNode): number {
    const base =
      n.category === 'core' ? 24 : n.category === 'entity' ? 17 : n.category === 'topic' ? 13 : 10;
    const ratio = maxNodeWeight > 0 ? n.weight / maxNodeWeight : 0;
    return base * (0.75 + 0.6 * ratio);
  }

  function edgeWidthFor(e: RenderEdge): number {
    const ratio = maxEdgeWeight > 0 ? e.weight / maxEdgeWeight : 0;
    return 1 + 2 * ratio;
  }

  function toDetailView(node: GraphNode): DetailView {
    return {
      id: node.id,
      label: node.label,
      type: node.type,
      category: normalizeType(node.type),
      weight: extractWeight(node.properties),
      properties: node.properties || {},
    };
  }

  // ===== 数据加载 =====

  async function loadGraphData(): Promise<void> {
    showLoading(true);
    try {
      const data = await getGraphData({ limit: 120 });
      const w = canvas.width || 800;
      const h = canvas.height || 600;
      renderNodes = data.nodes.map((n: GraphNode) => ({
        id: n.id,
        label: n.label,
        type: n.type,
        category: normalizeType(n.type),
        weight: extractWeight(n.properties),
        properties: n.properties || {},
        x: w / 2 + (Math.random() - 0.5) * 240,
        y: h / 2 + (Math.random() - 0.5) * 240,
        vx: 0,
        vy: 0,
      }));
      renderEdges = data.edges.map((e: GraphEdge) => ({
        source: e.source,
        target: e.target,
        relation: e.type || '关联',
        weight: extractWeight(e.properties),
      }));
      nodeMap = new Map(renderNodes.map((n) => [n.id, n]));
      maxNodeWeight = renderNodes.reduce((m, n) => Math.max(m, n.weight), 0) || 1;
      maxEdgeWeight = renderEdges.reduce((m, e) => Math.max(m, e.weight), 0) || 1;
      seedPositions();
    } catch (err) {
      alert(err instanceof Error ? err.message : '加载图谱数据失败');
      renderNodes = [];
      renderEdges = [];
      nodeMap = new Map();
    } finally {
      showLoading(false);
    }
  }

  async function loadStats(): Promise<void> {
    try {
      const stats = await getGraphStats();
      renderStats(stats);
    } catch {
      // 统计加载失败时保留占位符，不打扰用户
    }
  }

  function renderStats(stats: GraphStats): void {
    const totalNodes = stats.total_nodes || 0;
    const totalEdges = stats.total_edges || 0;
    let coreCount = 0;
    if (stats.node_types) {
      for (const [k, v] of Object.entries(stats.node_types)) {
        if (normalizeType(k) === 'core') coreCount += v;
      }
    }
    const avgDegree = totalNodes > 0 ? (2 * totalEdges) / totalNodes : 0;
    setText('stat-nodes', String(totalNodes));
    setText('stat-edges', String(totalEdges));
    setText('stat-core', String(coreCount));
    setText('stat-degree', avgDegree.toFixed(2));
  }

  async function loadNodeDetail(nodeId: string, type: string): Promise<void> {
    const panel = document.getElementById('node-detail');
    if (panel) panel.innerHTML = '<div class="detail-empty">加载中...</div>';
    try {
      const node = await getNode(nodeId, labelForApi(type));
      renderDetail(toDetailView(node));
    } catch (err) {
      // API 失败时回退到本地数据
      const local = nodeMap.get(nodeId);
      if (local) {
        renderDetail(local);
      } else if (panel) {
        panel.innerHTML = `<div class="detail-empty">${escapeHtml(
          err instanceof Error ? err.message : '加载节点详情失败'
        )}</div>`;
      }
    }
  }

  async function loadRelated(nodeId: string, type: string): Promise<void> {
    const btn = document.getElementById('btn-related') as HTMLButtonElement | null;
    if (btn) {
      btn.textContent = '加载中...';
      btn.disabled = true;
    }
    try {
      const related = await getRelatedNodes(nodeId, { label: labelForApi(type), max_depth: 2 });
      highlightedIds = new Set(related.map((n) => n.id));
      highlightedIds.add(nodeId);
      if (btn) {
        btn.textContent =
          related.length > 0 ? `已高亮 ${related.length} 个相关节点（点击重置）` : '无相关节点';
        btn.disabled = false;
      }
    } catch (err) {
      alert(err instanceof Error ? err.message : '加载相关节点失败');
      highlightedIds = new Set();
      if (btn) {
        btn.textContent = '查看相关节点';
        btn.disabled = false;
      }
    }
  }

  async function loadRecommendations(docId: string | null): Promise<void> {
    const list = document.getElementById('recommend-list');
    const basis = document.getElementById('rec-basis');
    if (!list) return;
    if (!docId) {
      if (basis) basis.textContent = '';
      list.innerHTML = '<div class="detail-empty">请选择一个节点以查看推荐</div>';
      return;
    }
    const local = nodeMap.get(docId);
    if (basis) basis.textContent = local ? `基于节点：${local.label}` : '';
    list.innerHTML = '<div class="detail-empty">加载推荐中...</div>';
    try {
      const recs = await getRecommendations(docId, 10);
      renderRecommendations(recs);
    } catch (err) {
      list.innerHTML = `<div class="detail-empty">${escapeHtml(
        err instanceof Error ? err.message : '加载推荐失败'
      )}</div>`;
    }
  }

  function renderRecommendations(recs: Recommendation[]): void {
    const list = document.getElementById('recommend-list');
    if (!list) return;
    if (!recs || recs.length === 0) {
      list.innerHTML = '<div class="detail-empty">暂无推荐</div>';
      return;
    }
    list.innerHTML = recs
      .map(
        (r) => `
      <div class="rec-item" data-id="${escapeHtml(r.doc_id)}">
        <div class="rec-main">
          <div class="rec-title">${escapeHtml(r.title || r.doc_id)}</div>
          <div class="rec-reason">${escapeHtml(r.reason || '')}</div>
        </div>
        <div class="rec-score">${(r.score ?? 0).toFixed(2)}</div>
      </div>`
      )
      .join('');
    list.querySelectorAll('.rec-item').forEach((el) => {
      el.addEventListener('click', () => {
        const id = (el as HTMLElement).dataset.id;
        if (id) jumpToNode(id);
      });
    });
  }

  function renderDetail(node: DetailView): void {
    const panel = document.getElementById('node-detail');
    if (!panel) return;
    const color = categoryColor(node.category);
    const props = node.properties || {};
    const propHtml =
      Object.keys(props).length > 0
        ? Object.entries(props)
            .map(
              ([k, v]) => `
        <div class="detail-row">
          <span class="label">${escapeHtml(k)}</span>
          <span class="detail-value">${escapeHtml(formatValue(v))}</span>
        </div>`
            )
            .join('')
        : '<div class="detail-empty">无属性</div>';

    panel.innerHTML = `
      <div class="detail-title">${escapeHtml(node.label)}</div>
      <div class="detail-row">
        <span class="label">类型</span>
        <span class="type-badge" style="color:${color};background:${color}1A;border-color:${color}33;">
          ${categoryLabel(node.category)}
        </span>
      </div>
      <div class="detail-row">
        <span class="label">原始类型</span>
        <span class="detail-value">${escapeHtml(node.type || '-')}</span>
      </div>
      <div class="detail-row">
        <span class="label">权重</span>
        <span class="detail-value">${node.weight.toFixed(3)}</span>
      </div>
      <button class="btn btn-outline btn-sm" id="btn-related" style="width:100%;margin-top:var(--space-3);">
        查看相关节点
      </button>
      <div class="detail-subtitle">属性信息</div>
      <div class="prop-list">${propHtml}</div>
    `;

    const btn = document.getElementById('btn-related');
    if (btn) {
      btn.addEventListener('click', () => {
        // 二次点击时若已高亮，则清除
        if (highlightedIds.size > 0) {
          highlightedIds = new Set();
          (btn as HTMLButtonElement).textContent = '查看相关节点';
        } else {
          loadRelated(node.id, node.type);
        }
      });
    }
  }

  // ===== 节点选择 =====

  function selectNode(nodeId: string): void {
    selectedNodeId = nodeId;
    highlightedIds = new Set();
    const local = nodeMap.get(nodeId);
    const type = local ? local.type : 'Document';
    loadNodeDetail(nodeId, type);
    loadRecommendations(nodeId);
  }

  function jumpToNode(nodeId: string): void {
    selectNode(nodeId);
  }

  function pickPrimaryNode(): RenderNode | null {
    if (renderNodes.length === 0) return null;
    const cores = renderNodes.filter((n) => n.category === 'core');
    const pool = cores.length > 0 ? cores : renderNodes.slice();
    return pool.reduce((best, n) => (n.weight > best.weight ? n : best), pool[0]);
  }

  // ===== 力导向布局 =====

  function seedPositions(): void {
    const w = canvas.width || 800;
    const h = canvas.height || 600;
    const cx = w / 2;
    const cy = h / 2;
    const n = renderNodes.length;
    renderNodes.forEach((node, i) => {
      if (n <= 1) {
        node.x = cx;
        node.y = cy;
      } else {
        const angle = (i / n) * Math.PI * 2;
        const radius = 90 + (i % 4) * 55;
        node.x = cx + Math.cos(angle) * radius + (Math.random() - 0.5) * 20;
        node.y = cy + Math.sin(angle) * radius + (Math.random() - 0.5) * 20;
      }
      node.vx = 0;
      node.vy = 0;
    });
  }

  function resize(): void {
    const wrapper = canvas.parentElement;
    if (!wrapper) return;
    canvas.width = wrapper.clientWidth;
    canvas.height = wrapper.clientHeight;
  }

  function draw(): void {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // 节点间排斥力（弹簧模型 O(n^2)）
    const repulsion = 0.5;
    for (let i = 0; i < renderNodes.length; i++) {
      const a = renderNodes[i];
      for (let j = i + 1; j < renderNodes.length; j++) {
        const b = renderNodes[j];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const force = (repulsion * 900) / (dist * dist);
        a.vx -= (dx / dist) * force;
        a.vy -= (dy / dist) * force;
        b.vx += (dx / dist) * force;
        b.vy += (dy / dist) * force;
      }
    }

    // 边的弹簧吸引力
    renderEdges.forEach((e) => {
      const s = nodeMap.get(e.source);
      const t = nodeMap.get(e.target);
      if (!s || !t) return;
      const dx = t.x - s.x;
      const dy = t.y - s.y;
      const dist = Math.sqrt(dx * dx + dy * dy) || 1;
      const force = (dist - 140) * 0.01;
      s.vx += (dx / dist) * force;
      s.vy += (dy / dist) * force;
      t.vx -= (dx / dist) * force;
      t.vy -= (dy / dist) * force;
    });

    // 中心吸引 + 阻尼 + 位置更新
    const cx = canvas.width / 2;
    const cy = canvas.height / 2;
    renderNodes.forEach((n) => {
      n.vx += (cx - n.x) * 0.001;
      n.vy += (cy - n.y) * 0.001;
      n.vx *= 0.9;
      n.vy *= 0.9;
      n.x += n.vx;
      n.y += n.vy;
    });

    const hasHighlight = highlightedIds.size > 0;

    // 绘制边
    renderEdges.forEach((e) => {
      const s = nodeMap.get(e.source);
      const t = nodeMap.get(e.target);
      if (!s || !t) return;
      if (!isVisible(s) || !isVisible(t)) return;
      const isHi =
        hasHighlight && (highlightedIds.has(s.id) || highlightedIds.has(t.id));
      ctx.beginPath();
      ctx.moveTo(s.x, s.y);
      ctx.lineTo(t.x, t.y);
      ctx.strokeStyle = isHi ? '#A29BFE' : hasHighlight ? '#F0F1F5' : '#E5E6EB';
      ctx.lineWidth = isHi ? edgeWidthFor(e) + 1 : edgeWidthFor(e);
      ctx.stroke();

      // 关系标签
      const mx = (s.x + t.x) / 2;
      const my = (s.y + t.y) / 2;
      ctx.fillStyle = isHi ? '#6C5CE7' : '#8B8D9F';
      ctx.font = '11px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(e.relation, mx, my);
    });

    // 绘制节点
    renderNodes.forEach((n) => {
      if (!isVisible(n)) return;
      const r = radiusFor(n);
      const isSelected = selectedNodeId === n.id;
      const isHi = highlightedIds.has(n.id);
      const dim = hasHighlight && !isHi && selectedNodeId !== n.id;

      if (isHi) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, r + 6, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(108, 92, 231, 0.4)';
        ctx.lineWidth = 3;
        ctx.stroke();
      }
      if (isSelected) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, r + 4, 0, Math.PI * 2);
        ctx.strokeStyle = '#6C5CE7';
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      ctx.beginPath();
      ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
      ctx.fillStyle = dim ? '#C4C5D3' : categoryColor(n.category);
      ctx.fill();

      ctx.fillStyle = dim ? '#8B8D9F' : '#1A1B2E';
      ctx.font = `${n.category === 'core' ? 'bold ' : ''}12px sans-serif`;
      ctx.textAlign = 'center';
      ctx.fillText(n.label, n.x, n.y + r + 16);
    });

    requestAnimationFrame(draw);
  }

  // ===== 交互事件 =====

  function canvasCoord(e: MouseEvent): { x: number; y: number } {
    const rect = canvas.getBoundingClientRect();
    const sx = rect.width > 0 ? canvas.width / rect.width : 1;
    const sy = rect.height > 0 ? canvas.height / rect.height : 1;
    return { x: (e.clientX - rect.left) * sx, y: (e.clientY - rect.top) * sy };
  }

  canvas.addEventListener('click', (e) => {
    const { x, y } = canvasCoord(e);
    let hit: RenderNode | null = null;
    for (let i = renderNodes.length - 1; i >= 0; i--) {
      const n = renderNodes[i];
      if (!isVisible(n)) continue;
      const r = radiusFor(n);
      const dx = n.x - x;
      const dy = n.y - y;
      if (dx * dx + dy * dy < r * r) {
        hit = n;
        break;
      }
    }
    if (hit) selectNode(hit.id);
  });

  canvas.addEventListener('mousemove', (e) => {
    const { x, y } = canvasCoord(e);
    let over = false;
    for (const n of renderNodes) {
      if (!isVisible(n)) continue;
      const r = radiusFor(n);
      const dx = n.x - x;
      const dy = n.y - y;
      if (dx * dx + dy * dy < r * r) {
        over = true;
        break;
      }
    }
    canvas.style.cursor = over ? 'pointer' : 'default';
  });

  // 搜索过滤（本地）
  document.getElementById('graph-search')?.addEventListener('input', (e) => {
    searchKeyword = (e.target as HTMLInputElement).value.trim().toLowerCase();
  });

  // 类型筛选 chips
  const chipsContainer = document.getElementById('filter-chips');
  chipsContainer?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('chip')) return;
    activeCategory = target.dataset.cat as NodeCategory | 'all';
    chipsContainer.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
    target.classList.add('active');
  });

  // 重置视图
  document.getElementById('reset-graph')?.addEventListener('click', () => {
    selectedNodeId = null;
    highlightedIds = new Set();
    activeCategory = 'all';
    searchKeyword = '';
    const si = document.getElementById('graph-search') as HTMLInputElement | null;
    if (si) si.value = '';
    chipsContainer?.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
    chipsContainer?.querySelector('.chip[data-cat="all"]')?.classList.add('active');
    seedPositions();
    const panel = document.getElementById('node-detail');
    if (panel) panel.innerHTML = '<div class="detail-empty">点击节点查看详情</div>';
    loadRecommendations(null);
  });

  // 刷新图谱：失效推荐缓存 + 重新加载
  document.getElementById('refresh-graph')?.addEventListener('click', async () => {
    const btn = document.getElementById('refresh-graph') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = '刷新中...';
    }
    try {
      if (selectedNodeId) {
        try {
          await invalidateRecommendationCache(selectedNodeId);
        } catch {
          // 缓存失效失败不阻断刷新流程
        }
      }
      await Promise.all([loadStats(), loadGraphData()]);
      if (selectedNodeId) {
        const local = nodeMap.get(selectedNodeId);
        if (local) {
          loadNodeDetail(selectedNodeId, local.type);
        }
        loadRecommendations(selectedNodeId);
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = '刷新图谱';
      }
    }
  });

  window.addEventListener('resize', resize);

  // ===== 初始化 =====
  resize();
  draw();
  loadStats();
  loadGraphData().then(() => {
    // 首次加载后自动选中权重最高的核心节点，展示详情与推荐
    const primary = pickPrimaryNode();
    if (primary) selectNode(primary.id);
  });
</script>
