---
/**
 * 时间线页面
 * 知识变更时间线 + 按日期分组 + 变更类型标记
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '知识', href: '/knowledge' }, { label: '变更时间线' }];
---

<DefaultLayout title="变更时间线" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">知识变更时间线</h1>
    <div style="display: flex; gap: var(--space-3); align-items: center;">
      <select class="form-input" id="filter-type" style="width: 160px;">
        <option value="">全部变更</option>
        <option value="create">新建</option>
        <option value="update">更新</option>
        <option value="version">版本更新</option>
        <option value="expire">过期</option>
        <option value="merge">合并</option>
        <option value="delete">删除</option>
      </select>
      <select class="form-input" id="filter-kb" style="width: 160px;">
        <option value="">全部知识库</option>
      </select>
    </div>
  </div>

  <div id="timeline-container">
    <div class="loading-state">加载中...</div>
  </div>
</DefaultLayout>

<style>
  .timeline {
    position: relative;
    padding-left: var(--space-8);
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }
  .timeline-group {
    margin-bottom: var(--space-6);
  }
  .timeline-group-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    padding-left: var(--space-2);
  }
  .timeline-item {
    position: relative;
    margin-bottom: var(--space-5);
  }
  .timeline-item-dot {
    position: absolute;
    left: -29px;
    top: var(--space-2);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--surface);
    box-shadow: 0 0 0 2px var(--border);
  }
  .timeline-item-dot.create { background: var(--success); }
  .timeline-item-dot.update { background: var(--info); }
  .timeline-item-dot.version { background: var(--primary); }
  .timeline-item-dot.expire { background: var(--warning); }
  .timeline-item-dot.merge { background: var(--info); }
  .timeline-item-dot.delete { background: var(--danger); }
  .timeline-item-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    transition: all var(--transition-fast);
    cursor: pointer;
  }
  .timeline-item-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--primary-light);
  }
  .timeline-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }
  .timeline-item-title {
    font-weight: 500;
    font-size: var(--text-base);
    color: var(--text);
  }
  .timeline-item-time {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .timeline-item-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
  }
  .timeline-item-footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-12);
    color: var(--text-muted);
  }
  .error-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--danger);
  }
</style>

<script>
  import { getKnowledgeBases, type KnowledgeBase } from '@/lib/apis/knowledge';
  import { getData } from '@/lib/api';

  const BASE = '/api/v1';

  interface TimelineItem {
    id: string;
    doc_id: string;
    title: string;
    type: string;
    desc?: string;
    kb_id?: string;
    kb_name?: string;
    author?: string;
    created_at: string | number;
  }

  let allItems: TimelineItem[] = [];

  function escapeHtml(s: string): string {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function formatTime(ts: string | number): string {
    if (!ts) return '';
    const t = typeof ts === 'number' ? ts : new Date(ts).getTime();
    if (isNaN(t)) return String(ts);
    const d = new Date(t);
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }

  // ===== 加载知识库筛选下拉框 =====
  async function loadKbFilter() {
    const select = document.getElementById('filter-kb') as HTMLSelectElement | null;
    if (!select) return;
    try {
      const res = await getKnowledgeBases(1, 100);
      const kbs: KnowledgeBase[] = res?.items || [];
      const current = select.value;
      select.innerHTML = '<option value="">全部知识库</option>';
      kbs.forEach((kb) => {
        const opt = document.createElement('option');
        opt.value = kb.id;
        opt.textContent = kb.name;
        select.appendChild(opt);
      });
      if (current) select.value = current;
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      const opt = document.createElement('option');
      opt.disabled = true;
      opt.textContent = '知识库加载失败：' + msg;
      select.appendChild(opt);
    }
  }

  // ===== 加载时间线 =====
  async function loadTimeline() {
    const container = document.getElementById('timeline-container')!;
    container.innerHTML = '<div class="loading-state">加载中...</div>';
    try {
      const result = await getData<TimelineItem[] | { items: TimelineItem[] }>(`${BASE}/knowledge/timeline`);
      let items: TimelineItem[] = [];
      if (Array.isArray(result)) {
        items = result;
      } else if (result && Array.isArray(result.items)) {
        items = result.items;
      }
      allItems = items;
      renderTimeline(items);
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      container.innerHTML = `<div class="error-state">时间线加载失败：${escapeHtml(msg)}<br/><button class="btn btn-outline btn-sm" id="retry-timeline" style="margin-top: var(--space-3);">重试</button></div>`;
      document.getElementById('retry-timeline')?.addEventListener('click', loadTimeline);
    }
  }

  function renderTimeline(items: TimelineItem[]) {
    const typeFilter = (document.getElementById('filter-type') as HTMLSelectElement).value;
    const kbFilter = (document.getElementById('filter-kb') as HTMLSelectElement).value;

    // 本地过滤：类型 + 知识库
    let list = items.filter((i) => {
      if (typeFilter && i.type !== typeFilter) return false;
      if (kbFilter && i.kb_id !== kbFilter) return false;
      return true;
    });

    const container = document.getElementById('timeline-container')!;
    if (list.length === 0) {
      container.innerHTML = '<div class="empty-state">暂无变更记录</div>';
      return;
    }

    // 按日期分组
    const groups: Record<string, TimelineItem[]> = {};
    list.forEach((i) => {
      const date = new Date(i.created_at);
      const today = new Date();
      const diff = Math.floor((today.setHours(0, 0, 0, 0) - new Date(date).setHours(0, 0, 0, 0)) / 86400000);
      let label: string;
      if (diff === 0) label = '今天';
      else if (diff === 1) label = '昨天';
      else if (diff < 7) label = '本周';
      else label = `${date.getMonth() + 1}月${date.getDate()}日`;
      if (!groups[label]) groups[label] = [];
      groups[label].push(i);
    });

    const typeLabel: Record<string, string> = {
      create: '新建',
      update: '更新',
      version: '版本更新',
      expire: '过期',
      merge: '合并',
      delete: '删除',
    };
    const typeBadge: Record<string, string> = {
      create: 'badge-success',
      update: 'badge-primary',
      version: 'badge-primary',
      expire: 'badge-warning',
      merge: 'badge-primary',
      delete: 'badge-danger',
    };

    container.innerHTML = `<div class="timeline">${Object.entries(groups)
      .map(
        ([label, group]) => `
      <div class="timeline-group">
        <div class="timeline-group-title">${escapeHtml(label)}</div>
        ${group
          .map(
            (i) => `
          <div class="timeline-item">
            <div class="timeline-item-dot ${escapeHtml(i.type)}"></div>
            <div class="timeline-item-card" data-doc="${escapeHtml(i.doc_id)}">
              <div class="timeline-item-header">
                <div class="timeline-item-title">${escapeHtml(i.title)}</div>
                <div class="timeline-item-time">${escapeHtml(formatTime(i.created_at))}</div>
              </div>
              <p class="timeline-item-desc">${escapeHtml(i.desc || '')}</p>
              <div class="timeline-item-footer">
                <span class="badge ${typeBadge[i.type] || 'badge-primary'}">${typeLabel[i.type] || '变更'}</span>
                <span>${escapeHtml(i.kb_name || '')}</span>
                <span>操作人：${escapeHtml(i.author || '系统')}</span>
              </div>
            </div>
          </div>`
          )
          .join('')}
      </div>`
      )
      .join('')}</div>`;

    container.querySelectorAll('.timeline-item-card').forEach((el) => {
      el.addEventListener('click', () => {
        const docId = (el as HTMLElement).dataset.doc;
        if (docId) window.location.href = `/knowledge/detail?id=${encodeURIComponent(docId)}`;
      });
    });
  }

  // 类型筛选：本地过滤，无需重新请求
  document.getElementById('filter-type')?.addEventListener('change', () => renderTimeline(allItems));
  // 知识库筛选：本地过滤
  document.getElementById('filter-kb')?.addEventListener('change', () => renderTimeline(allItems));

  // 初始化
  loadKbFilter();
  loadTimeline();
</script>
