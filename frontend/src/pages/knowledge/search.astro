---
/**
 * 知识搜索页面
 * 搜索栏 + 结果列表（高亮匹配） + 筛选面板 + 搜索类型切换（全文/向量/混合）
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '知识', href: '/knowledge' }, { label: '知识搜索' }];
---

<DefaultLayout title="知识搜索" breadcrumb={breadcrumb}>
  <div class="search-layout">
    <!-- 搜索主区 -->
    <div class="search-main">
      <!-- 搜索栏 -->
      <div class="search-bar-wrapper">
        <div class="search-bar">
          <span class="search-bar-icon">🔍</span>
          <input
            type="text"
            class="search-bar-input"
            id="search-input"
            placeholder="搜索知识库内容，支持自然语言提问..."
          />
          <button class="btn btn-primary" id="search-btn">搜索</button>
        </div>
        <!-- 搜索模式切换 Tab -->
        <div class="tabs tabs-pill search-mode-tabs">
          <button class="tab tab-pill active" data-mode="knowledge">知识库搜索</button>
          <button class="tab tab-pill" data-mode="unified">统一搜索</button>
        </div>
        <!-- 知识库搜索：检索类型切换（仅知识库模式显示） -->
        <div class="search-type-switcher" id="search-type-switcher">
          <button class="search-type-btn active" data-type="hybrid">混合检索</button>
          <button class="search-type-btn" data-type="vector">向量检索</button>
          <button class="search-type-btn" data-type="keyword">全文检索</button>
        </div>
        <!-- 统一搜索：来源筛选器（仅统一模式显示） -->
        <div class="source-filter" id="source-filter" style="display:none;">
          <span class="source-filter-label">来源：</span>
          <button class="tag tag-active source-tag" data-source="knowledge">📚 知识库</button>
          <button class="tag tag-active source-tag" data-source="oa">📋 OA</button>
          <button class="tag tag-active source-tag" data-source="erp">📊 ERP</button>
          <button class="tag tag-active source-tag" data-source="crm">🤝 CRM</button>
          <button class="tag tag-active source-tag" data-source="mail">✉️ 邮件</button>
        </div>
      </div>

      <!-- 搜索结果 -->
      <div id="search-results">
        <div class="search-hint">
          <div style="font-size: 48px; margin-bottom: var(--space-4);">🔍</div>
          <h3>开始搜索知识</h3>
          <p class="text-muted">输入关键词或问题，系统将从知识库中检索相关内容</p>
          <div class="search-suggestions">
            <span class="text-muted" style="font-size: var(--text-sm);">试试搜索：</span>
            <button class="tag" data-q="报销流程">报销流程</button>
            <button class="tag" data-q="年假政策">年假政策</button>
            <button class="tag" data-q="API 文档">API 文档</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 筛选面板 -->
    <aside class="filter-panel">
      <div class="card">
        <div class="card-header">
          <h3>筛选</h3>
        </div>
        <div class="filter-section">
          <div class="filter-label">知识库</div>
          <div id="filter-kb">
            <div class="loading-state" style="padding: var(--space-2) 0; text-align: left;">加载中...</div>
          </div>
        </div>
        <div class="filter-section">
          <div class="filter-label">标签</div>
          <div id="filter-tags" style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
            <div class="loading-state" style="padding: var(--space-2) 0; text-align: left;">加载中...</div>
          </div>
        </div>
        <div class="filter-section">
          <div class="filter-label">时间范围</div>
          <select class="form-input" id="filter-time">
            <option value="">全部时间</option>
            <option value="7">最近 7 天</option>
            <option value="30">最近 30 天</option>
            <option value="90">最近 3 个月</option>
            <option value="365">最近 1 年</option>
          </select>
        </div>
      </div>
    </aside>
  </div>
</DefaultLayout>

<style>
  .search-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--space-5);
  }
  .search-bar-wrapper {
    margin-bottom: var(--space-5);
  }
  .search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .search-bar:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
  }
  .search-bar-icon {
    padding: 0 var(--space-3);
    color: var(--text-muted);
    font-size: 20px;
  }
  .search-bar-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--text-md);
    padding: var(--space-2) 0;
  }
  .search-bar-input:focus {
    outline: none;
    box-shadow: none;
  }
  .search-type-switcher {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .search-type-btn {
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--text-muted);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    transition: all var(--transition-fast);
  }
  .search-type-btn.active {
    background: var(--primary);
    color: var(--text-white);
    border-color: var(--primary);
  }
  .search-hint {
    text-align: center;
    padding: var(--space-12);
  }
  .search-suggestions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }
  .search-suggestions .tag {
    cursor: pointer;
  }
  .result-item {
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .result-item:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .result-item-title {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--primary);
    margin-bottom: var(--space-2);
  }
  .result-item-snippet {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-3);
  }
  .result-item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .highlight {
    background: var(--warning-bg);
    color: var(--warning);
    padding: 0 2px;
    border-radius: var(--radius-xs);
    font-weight: 500;
  }
  .filter-section {
    margin-bottom: var(--space-5);
  }
  .filter-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-3);
  }
  .filter-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding: var(--space-1) 0;
    cursor: pointer;
  }
  .filter-panel .tag {
    cursor: pointer;
  }
  @media (max-width: 1024px) {
    .search-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- 统一搜索相关样式（is:global 以便对动态插入结果生效） -->
<style is:global>
  /* === 搜索模式 Tab（pill 样式） === */
  .tabs.tabs-pill {
    display: flex;
    gap: var(--space-1);
    margin-top: var(--space-3);
    padding: var(--space-1);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    width: fit-content;
  }
  .tabs.tabs-pill .tab {
    padding: var(--space-2) var(--space-5);
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .tabs.tabs-pill .tab:hover {
    color: var(--primary);
  }
  .tabs.tabs-pill .tab.active {
    background: var(--surface);
    color: var(--primary);
    box-shadow: var(--shadow-sm);
  }

  /* === 来源筛选器 === */
  .source-filter {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .source-filter-label {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-right: var(--space-1);
  }
  .source-tag {
    cursor: pointer;
    user-select: none;
  }
  .source-tag.tag-active {
    background: var(--primary-bg);
    color: var(--primary);
    border-color: var(--primary-light);
  }

  /* === 统一搜索来源分组 Tab === */
  .source-tabs {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .source-tab {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .source-tab:hover {
    border-color: var(--primary-light);
    color: var(--primary);
  }
  .source-tab.active {
    background: var(--primary);
    color: var(--text-white);
    border-color: var(--primary);
  }

  /* === 统一搜索结果项 === */
  .unified-result-item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-3);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .unified-result-item:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .unified-result-source {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-width: 56px;
    padding-top: var(--space-1);
  }
  .unified-result-source .source-icon {
    font-size: 24px;
    line-height: 1;
  }
  .unified-result-body {
    flex: 1;
    min-width: 0;
  }
  .unified-result-body .result-item-title {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--primary);
    margin-bottom: var(--space-2);
  }
  .unified-result-body .result-item-snippet {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-3);
  }
  .unified-result-body .result-item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .unified-result-source {
      min-width: 44px;
    }
  }
</style>

<script>
  import { unifiedSearch, searchKnowledge, getKnowledgeBases, type ExternalSearchResult, type SearchResult } from '@/lib/apis/knowledge';
  import { logSearch, getSearchHotwords } from '@/lib/apis/analytics';

  const TOKEN_KEY = 'ekb_access_token';

  let searchType = 'hybrid';
  let searchMode: 'knowledge' | 'unified' = 'knowledge';
  const selectedSources = new Set<string>(['knowledge', 'oa', 'erp', 'crm', 'mail']);
  let lastUnifiedResults: Record<string, ExternalSearchResult[]> = {};
  let activeSourceTab = 'all';
  let lastUnifiedQuery = '';
  const selectedKbIds = new Set<string>();

  // 从 URL 读取参数
  const params = new URLSearchParams(window.location.search);
  const initQ = params.get('q') || params.get('tag') || '';
  const initKb = params.get('kb') || '';
  if (initQ) {
    (document.getElementById('search-input') as HTMLInputElement).value = initQ;
  }
  if (initKb) selectedKbIds.add(initKb);

  function escapeHtml(s: string): string {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ===== 加载知识库筛选面板 =====
  async function loadKbFilters() {
    const container = document.getElementById('filter-kb')!;
    try {
      const res = await getKnowledgeBases(1, 100);
      const kbs = res?.items || [];
      if (kbs.length === 0) {
        container.innerHTML = '<div class="text-muted" style="font-size: var(--text-sm); padding: var(--space-2) 0;">暂无知识库</div>';
        return;
      }
      container.innerHTML = kbs
        .map(
          (kb) => `
        <label class="filter-item">
          <input type="checkbox" value="${escapeHtml(kb.id)}" ${selectedKbIds.has(kb.id) ? 'checked' : ''} />
          ${escapeHtml(kb.name)} <span class="text-muted">(${kb.document_count || 0})</span>
        </label>`
        )
        .join('');
      container.querySelectorAll('input[type="checkbox"]').forEach((el) => {
        el.addEventListener('change', () => {
          const id = (el as HTMLInputElement).value;
          if ((el as HTMLInputElement).checked) selectedKbIds.add(id);
          else selectedKbIds.delete(id);
          if ((document.getElementById('search-input') as HTMLInputElement).value.trim() && searchMode === 'knowledge') {
            doSearch();
          }
        });
      });
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      container.innerHTML = `<div class="text-muted" style="font-size: var(--text-sm); padding: var(--space-2) 0; color: var(--danger);">知识库加载失败：${escapeHtml(msg)}</div>`;
    }
  }

  // ===== 加载标签筛选面板（取搜索热词） =====
  async function loadTagFilters() {
    const container = document.getElementById('filter-tags')!;
    try {
      const data = await getSearchHotwords(30, 10);
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="text-muted" style="font-size: var(--text-sm); padding: var(--space-2) 0;">暂无标签</div>';
        return;
      }
      container.innerHTML = data
        .map((t) => `<span class="tag" data-tag="${escapeHtml(t.keyword)}">${escapeHtml(t.keyword)}</span>`)
        .join('');
      container.querySelectorAll('.tag').forEach((el) => {
        el.addEventListener('click', () => {
          const tag = (el as HTMLElement).dataset.tag!;
          (document.getElementById('search-input') as HTMLInputElement).value = tag;
          doSearch();
        });
      });
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      container.innerHTML = `<div class="text-muted" style="font-size: var(--text-sm); padding: var(--space-2) 0; color: var(--danger);">标签加载失败：${escapeHtml(msg)}</div>`;
    }
  }

  async function doSearch() {
    const query = (document.getElementById('search-input') as HTMLInputElement).value.trim();
    if (!query) return;

    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      window.location.href = '/auth/login';
      return;
    }

    // 统一搜索模式：走跨系统统一搜索
    if (searchMode === 'unified') {
      await doUnifiedSearch(query);
      return;
    }

    const container = document.getElementById('search-results')!;
    container.innerHTML = '<div class="search-hint"><div class="spinner" style="margin: 0 auto;"></div><p class="text-muted" style="margin-top: var(--space-3);">搜索中...</p></div>';

    try {
      const searchParams: { q: string; kb_ids?: string; search_type?: string; page?: number; page_size?: number } = {
        q: query,
        search_type: searchType,
        page: 1,
        page_size: 20,
      };
      if (selectedKbIds.size > 0) {
        searchParams.kb_ids = Array.from(selectedKbIds).join(',');
      }
      const timeRange = (document.getElementById('filter-time') as HTMLSelectElement).value;
      if (timeRange) {
        // 后端如未支持 days 参数，仅作为本地筛选条件传递
        (searchParams as Record<string, string | number>).days = Number(timeRange);
      }
      const res = await searchKnowledge(searchParams);
      const results: SearchResult[] = res?.items || [];
      renderResults(results, query);
      // 记录搜索行为（失败静默，不影响主流程）
      try {
        await logSearch(query, results.length, 'knowledge');
      } catch {
        // 静默
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      container.innerHTML = `
        <div class="search-hint">
          <div style="font-size: 48px;">⚠️</div>
          <h3>搜索失败</h3>
          <p class="text-muted">${escapeHtml(msg)}</p>
          <button class="btn btn-outline btn-sm" id="retry-search" style="margin-top: var(--space-3);">重试</button>
        </div>`;
      document.getElementById('retry-search')?.addEventListener('click', doSearch);
    }
  }

  function renderResults(results: SearchResult[], query: string) {
    const container = document.getElementById('search-results')!;
    if (results.length === 0) {
      container.innerHTML = `
        <div class="search-hint">
          <div style="font-size: 48px;">😕</div>
          <h3>未找到相关结果</h3>
          <p class="text-muted">试试更换关键词或调整筛选条件</p>
        </div>`;
      return;
    }

    container.innerHTML = `
      <div class="text-muted" style="margin-bottom: var(--space-4);">找到约 ${results.length} 条结果</div>
      ${results
        .map(
          (r) => `
        <div class="result-item" data-id="${escapeHtml(r.id)}">
          <div class="result-item-title">${highlightText(r.title, query)}</div>
          <p class="result-item-snippet">${highlightText(r.highlight || r.content, query)}</p>
          <div class="result-item-meta">
            <span class="badge badge-primary">${escapeHtml(r.kb_name || '')}</span>
            <span>相关度 ${Math.round((r.score || 0) * 100)}%</span>
            <span>${escapeHtml(r.doc_type || '')}</span>
          </div>
        </div>`
        )
        .join('')}`;

    container.querySelectorAll('.result-item').forEach((el) => {
      el.addEventListener('click', () => {
        const id = (el as HTMLElement).dataset.id;
        if (id) window.location.href = `/knowledge/detail?id=${encodeURIComponent(id)}`;
      });
    });
  }

  function highlightText(text: string, query: string): string {
    if (!text) return '';
    if (!query) return escapeHtml(text);
    const escaped = escapeHtml(text);
    const reg = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return escaped.replace(reg, '<span class="highlight">$1</span>');
  }

  // ===== 统一搜索（跨系统） =====
  const SOURCE_META: Record<string, { label: string; icon: string }> = {
    knowledge: { label: '知识库', icon: '📚' },
    oa: { label: 'OA', icon: '📋' },
    erp: { label: 'ERP', icon: '📊' },
    crm: { label: 'CRM', icon: '🤝' },
    mail: { label: '邮件', icon: '✉️' },
  };
  const SOURCE_ORDER = ['knowledge', 'oa', 'erp', 'crm', 'mail'];

  async function doUnifiedSearch(query: string) {
    const container = document.getElementById('search-results')!;
    container.innerHTML =
      '<div class="search-hint"><div class="spinner" style="margin: 0 auto;"></div><p class="text-muted" style="margin-top: var(--space-3);">正在搜索...</p></div>';

    try {
      const sources = Array.from(selectedSources).join(',');
      const result = await unifiedSearch({ q: query, sources, top_k: 20 });
      lastUnifiedResults = result || {};
      lastUnifiedQuery = query;
      activeSourceTab = 'all';
      // 统一搜索同样记录搜索行为
      const totalCount = SOURCE_ORDER.reduce((sum, s) => sum + (lastUnifiedResults[s]?.length || 0), 0);
      try {
        await logSearch(query, totalCount, 'unified');
      } catch {
        // 静默
      }
      renderUnifiedResults(lastUnifiedResults, query);
    } catch (err) {
      const msg = err instanceof Error ? err.message : '未知错误';
      container.innerHTML = `
        <div class="search-hint">
          <div style="font-size: 48px;">⚠️</div>
          <h3>统一搜索失败</h3>
          <p class="text-muted">${escapeHtml(msg)}</p>
          <button class="btn btn-outline btn-sm" id="retry-unified" style="margin-top: var(--space-3);">重试</button>
        </div>`;
      document.getElementById('retry-unified')?.addEventListener('click', () => doUnifiedSearch(query));
      lastUnifiedResults = {};
      lastUnifiedQuery = query;
    }
  }

  function renderUnifiedResults(grouped: Record<string, ExternalSearchResult[]>, query: string) {
    const container = document.getElementById('search-results')!;
    const availableSources = SOURCE_ORDER.filter((s) => (grouped[s]?.length || 0) > 0);
    const totalCount = availableSources.reduce((sum, s) => sum + (grouped[s]?.length || 0), 0);

    if (totalCount === 0) {
      container.innerHTML = `
        <div class="search-hint">
          <div style="font-size: 48px;">😕</div>
          <h3>未找到相关结果</h3>
          <p class="text-muted">试试更换关键词或调整来源筛选</p>
        </div>`;
      return;
    }

    // 来源分组 Tab
    const tabsHtml = [
      `<button class="source-tab${activeSourceTab === 'all' ? ' active' : ''}" data-source-tab="all">全部 (${totalCount})</button>`,
      ...availableSources.map((s) => {
        const meta = SOURCE_META[s];
        const count = grouped[s]?.length || 0;
        return `<button class="source-tab${activeSourceTab === s ? ' active' : ''}" data-source-tab="${s}">${meta.icon} ${meta.label} (${count})</button>`;
      }),
    ].join('');

    // 根据当前选中的来源 Tab 过滤结果
    let resultsToShow: ExternalSearchResult[];
    if (activeSourceTab === 'all') {
      resultsToShow = availableSources.flatMap((s) => grouped[s] || []);
    } else {
      resultsToShow = grouped[activeSourceTab] || [];
    }

    container.innerHTML = `
      <div class="text-muted" style="margin-bottom: var(--space-3);">找到约 ${totalCount} 条结果，来自 ${availableSources.length} 个来源</div>
      <div class="source-tabs">${tabsHtml}</div>
      <div class="unified-results">
        ${resultsToShow.map((r) => renderUnifiedItem(r, query)).join('')}
      </div>`;

    // 绑定来源分组 Tab 点击
    container.querySelectorAll('.source-tab').forEach((el) => {
      el.addEventListener('click', () => {
        activeSourceTab = (el as HTMLElement).dataset.sourceTab || 'all';
        renderUnifiedResults(lastUnifiedResults, lastUnifiedQuery);
      });
    });

    // 绑定结果项点击：知识库跳详情，外部系统新标签打开
    container.querySelectorAll('.unified-result-item').forEach((el) => {
      el.addEventListener('click', () => {
        const id = (el as HTMLElement).dataset.id || '';
        const source = (el as HTMLElement).dataset.source || '';
        const url = (el as HTMLElement).dataset.url || '';
        if (source === 'knowledge') {
          window.location.href = `/knowledge/detail?id=${encodeURIComponent(id)}`;
        } else if (url) {
          window.open(url, '_blank', 'noopener,noreferrer');
        }
      });
    });
  }

  function renderUnifiedItem(r: ExternalSearchResult, query: string): string {
    const meta = SOURCE_META[r.source] || { label: r.source, icon: r.source_icon || '📄' };
    const snippet = r.highlight || r.content || '';
    const isExternal = r.source !== 'knowledge';
    return `
      <div class="unified-result-item" data-id="${escapeHtml(r.id)}" data-source="${escapeHtml(r.source)}" data-url="${escapeHtml(r.source_url || '')}">
        <div class="unified-result-source">
          <span class="source-icon">${meta.icon}</span>
          <span class="badge badge-primary">${escapeHtml(meta.label)}</span>
        </div>
        <div class="unified-result-body">
          <div class="result-item-title">${highlightText(r.title, query)}</div>
          <p class="result-item-snippet">${highlightText(snippet, query)}</p>
          <div class="result-item-meta">
            <span>相关度 ${Math.round((r.score || 0) * 100)}%</span>
            ${isExternal ? '<span class="text-muted">↗ 在新标签页打开</span>' : ''}
          </div>
        </div>
      </div>`;
  }

  document.getElementById('search-btn')?.addEventListener('click', doSearch);
  document.getElementById('search-input')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') doSearch();
  });

  document.querySelectorAll('.search-type-btn').forEach((el) => {
    el.addEventListener('click', () => {
      document.querySelectorAll('.search-type-btn').forEach((e) => e.classList.remove('active'));
      el.classList.add('active');
      searchType = (el as HTMLElement).dataset.type!;
      if ((document.getElementById('search-input') as HTMLInputElement).value.trim()) {
        doSearch();
      }
    });
  });

  document.querySelectorAll('.search-suggestions .tag').forEach((el) => {
    el.addEventListener('click', () => {
      const q = (el as HTMLElement).dataset.q!;
      (document.getElementById('search-input') as HTMLInputElement).value = q;
      doSearch();
    });
  });

  // 时间范围筛选：变更后触发重新搜索
  document.getElementById('filter-time')?.addEventListener('change', () => {
    if (searchMode === 'knowledge' && (document.getElementById('search-input') as HTMLInputElement).value.trim()) {
      doSearch();
    }
  });

  // 搜索模式切换：知识库搜索 / 统一搜索
  document.querySelectorAll('.search-mode-tabs .tab').forEach((el) => {
    el.addEventListener('click', () => {
      document.querySelectorAll('.search-mode-tabs .tab').forEach((e) => e.classList.remove('active'));
      el.classList.add('active');
      searchMode = ((el as HTMLElement).dataset.mode as 'knowledge' | 'unified') || 'knowledge';

      const typeSwitcher = document.getElementById('search-type-switcher');
      const sourceFilter = document.getElementById('source-filter');
      if (searchMode === 'unified') {
        if (typeSwitcher) typeSwitcher.style.display = 'none';
        if (sourceFilter) sourceFilter.style.display = 'flex';
      } else {
        if (typeSwitcher) typeSwitcher.style.display = 'flex';
        if (sourceFilter) sourceFilter.style.display = 'none';
      }

      // 切换模式后，若已有查询词则自动触发对应模式的搜索
      if ((document.getElementById('search-input') as HTMLInputElement).value.trim()) {
        doSearch();
      }
    });
  });

  // 来源筛选标签切换（多选）
  document.querySelectorAll('.source-tag').forEach((el) => {
    el.addEventListener('click', () => {
      const source = (el as HTMLElement).dataset.source || '';
      if (selectedSources.has(source)) {
        // 至少保留一个来源
        if (selectedSources.size > 1) {
          selectedSources.delete(source);
          el.classList.remove('tag-active');
        } else {
          alert('至少需要选择一个来源');
        }
      } else {
        selectedSources.add(source);
        el.classList.add('tag-active');
      }
      // 统一搜索模式下，调整来源后自动重新搜索
      if (searchMode === 'unified' && (document.getElementById('search-input') as HTMLInputElement).value.trim()) {
        doSearch();
      }
    });
  });

  // 初始化：加载知识库 + 标签筛选
  loadKbFilters();
  loadTagFilters();

  // 如果有初始查询，自动搜索
  if (initQ) doSearch();
</script>
