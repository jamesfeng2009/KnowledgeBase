---
/**
 * API 密钥管理页面
 * API 密钥列表 + 创建密钥 + 密钥权限范围 + 使用记录
 * 数据来源：GET /api/v1/apikeys、POST /api/v1/apikeys、DELETE /api/v1/apikeys/{id}
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import ApiKeyTable from '@/components/settings/ApiKeyTable.astro';

const breadcrumb = [{ label: '设置', href: '/settings/tenant' }, { label: 'API 密钥' }];
---

<DefaultLayout title="API 密钥" breadcrumb={breadcrumb}>
  <div class="settings-nav" style="margin-bottom: var(--space-5);">
    <a href="/settings/tenant" class="settings-nav-item">租户设置</a>
    <a href="/settings/api" class="settings-nav-item active">API 密钥</a>
    <a href="/settings/llm" class="settings-nav-item">LLM 配置</a>
    <a href="/settings/system" class="settings-nav-item">系统设置</a>
  </div>

  <div class="page-header">
    <h1 class="page-title">API 密钥管理</h1>
    <button class="btn btn-primary btn-sm" id="create-key-btn">＋ 创建密钥</button>
  </div>

  <!-- 密钥列表 -->
  <div class="card" style="margin-bottom: var(--space-5);">
    <ApiKeyTable keys={[]} tbodyId="key-list" emptyText="加载中..." />
  </div>

  <!-- 使用记录 -->
  <div class="card">
    <div class="card-header"><h3>使用记录（近 24 小时）</h3></div>
    <div id="usage-records">
      <div class="loading-state">加载中...</div>
    </div>
  </div>

  <!-- 创建密钥弹窗 -->
  <div class="modal-overlay" id="create-modal" style="display: none;">
    <div class="modal" style="max-width: 480px;">
      <div class="modal-header">
        <h3>创建 API 密钥</h3>
        <button class="btn btn-ghost btn-sm" id="close-modal">✕</button>
      </div>
      <form id="key-form">
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label">密钥名称 *</label>
            <input type="text" class="form-input" name="name" required placeholder="如：搜索 API 密钥" />
          </div>
          <div class="form-group">
            <label class="form-label">权限范围</label>
            <div class="scope-options">
              <label class="scope-item"><input type="checkbox" name="scope" value="knowledge:read" checked /> 知识读取</label>
              <label class="scope-item"><input type="checkbox" name="scope" value="knowledge:write" /> 知识写入</label>
              <label class="scope-item"><input type="checkbox" name="scope" value="chat" checked /> AI 对话</label>
              <label class="scope-item"><input type="checkbox" name="scope" value="search" checked /> 搜索</label>
              <label class="scope-item"><input type="checkbox" name="scope" value="admin" /> 管理权限</label>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">有效期</label>
            <select class="form-input" name="expiry">
              <option value="365">1 年</option>
              <option value="90">90 天</option>
              <option value="30">30 天</option>
              <option value="0">永久</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="cancel-btn">取消</button>
          <button type="submit" class="btn btn-primary">创建</button>
        </div>
      </form>
    </div>
  </div>
</DefaultLayout>

<style>
  .settings-nav {
    display: flex;
    gap: var(--space-1);
    border-bottom: 1px solid var(--border);
  }
  .settings-nav-item {
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .settings-nav-item:hover {
    color: var(--primary);
  }
  .settings-nav-item.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
    font-weight: 500;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table th {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }
  .data-table td {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--border-light);
  }
  .key-value {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: var(--surface-muted);
    padding: 2px var(--space-2);
    border-radius: var(--radius-xs);
  }
  .scope-badge {
    display: inline-block;
    padding: 2px var(--space-2);
    margin: 1px;
    font-size: var(--text-xs);
    background: var(--primary-bg);
    color: var(--primary);
    border-radius: var(--radius-xs);
  }
  .scope-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
  .scope-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    cursor: pointer;
  }
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  .modal {
    background: var(--surface);
    border-radius: var(--radius-lg);
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-xl);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .modal-body {
    padding: var(--space-5);
  }
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--text-muted);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .error-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--danger);
    font-size: var(--text-sm);
  }
</style>

<script>
  import { getApiKeys, createApiKey, deleteApiKey, getApiKeyUsage } from '@/lib/apis/apikeys';
  import { ApiError } from '@/lib/api';

  interface ApiKey {
    id: string;
    name: string;
    key: string;
    keyPlain?: string;
    scopes: string[];
    created_at: string;
    last_used: string;
    status: string;
  }

  let keys: ApiKey[] = [];

  /** 判断是否为 401/未登录错误（已在底层处理跳转，业务层需静默退出） */
  function isAuthError(err: unknown): boolean {
    return err instanceof ApiError && err.status === 401;
  }

  /** 从接口返回值中提取数组（兼容数组 / { items: [] } / 分页对象） */
  function toItems(raw: unknown): Record<string, unknown>[] {
    if (Array.isArray(raw)) return raw as Record<string, unknown>[];
    if (raw && typeof raw === 'object') {
      const obj = raw as { items?: unknown[] };
      if (Array.isArray(obj.items)) return obj.items as Record<string, unknown>[];
    }
    return [];
  }

  function normalizeKey(raw: Record<string, unknown>): ApiKey {
    const keyPlain =
      typeof raw.key === 'string'
        ? raw.key
        : typeof raw.full_key === 'string'
          ? raw.full_key
          : typeof raw.api_key === 'string'
            ? raw.api_key
            : '';
    return {
      id: String(raw.id || raw.key_id || ''),
      name: String(raw.name || raw.label || '未命名'),
      // 后端通常只返回脱敏后的密钥前缀
      key:
        typeof raw.key_masked === 'string'
          ? raw.key_masked
          : typeof raw.key_prefix === 'string'
            ? raw.key_prefix + '...'
            : keyPlain
              ? keyPlain.slice(0, 8) + '...'
              : '******',
      keyPlain: keyPlain || undefined,
      scopes: Array.isArray(raw.scopes) ? (raw.scopes as string[]) : (Array.isArray(raw.scope) ? (raw.scope as string[]) : []),
      created_at: String(raw.created_at || raw.created_time || '-'),
      last_used: String(raw.last_used || raw.last_used_at || '从未使用'),
      status: String(raw.status || 'active'),
    };
  }

  async function loadKeys(): Promise<void> {
    const tbody = document.getElementById('key-list')!;
    tbody.innerHTML = '<tr><td colspan="7" class="loading-state">加载中...</td></tr>';
    try {
      const result = await getApiKeys();
      keys = toItems(result).map(normalizeKey);
    } catch (err) {
      if (isAuthError(err)) return;
      const msg = err instanceof Error ? err.message : '网络异常';
      tbody.innerHTML = `<tr><td colspan="7" class="error-state">加载密钥列表失败：${escapeHtml(msg)}<br/><button class="btn btn-outline btn-sm" id="retry-keys" style="margin-top: var(--space-3);">重试</button></td></tr>`;
      document.getElementById('retry-keys')?.addEventListener('click', loadKeys);
      return;
    }
    renderKeys();
    renderUsage();
  }

  function renderKeys(): void {
    const tbody = document.getElementById('key-list')!;
    if (keys.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state">暂无 API 密钥，点击右上角创建</td></tr>';
      return;
    }
    tbody.innerHTML = keys
      .map(
        (k) => `
      <tr>
        <td style="font-weight: 500;">${escapeHtml(k.name)}</td>
        <td><code class="key-value">${escapeHtml(k.key)}</code></td>
        <td>${k.scopes.length > 0 ? k.scopes.map((s) => `<span class="scope-badge">${escapeHtml(s)}</span>`).join('') : '<span class="text-muted">-</span>'}</td>
        <td class="text-muted">${escapeHtml(k.created_at)}</td>
        <td class="text-muted">${escapeHtml(k.last_used)}</td>
        <td><span class="badge ${k.status === 'active' ? 'badge-success' : 'badge-danger'}">${k.status === 'active' ? '启用' : '禁用'}</span></td>
        <td>
          <div style="display: flex; gap: var(--space-2);">
            <button class="btn btn-ghost btn-sm" data-action="copy" data-id="${escapeHtml(k.id)}">复制</button>
            <button class="btn btn-ghost btn-sm" data-action="toggle" data-id="${escapeHtml(k.id)}">${k.status === 'active' ? '禁用' : '启用'}</button>
            <button class="btn btn-ghost btn-sm" data-action="delete" data-id="${escapeHtml(k.id)}">删除</button>
          </div>
        </td>
      </tr>`
      )
      .join('');

    tbody.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = (btn as HTMLElement).dataset.action!;
        const id = (btn as HTMLElement).dataset.id!;
        const key = keys.find((k) => k.id === id);
        if (!key) return;
        if (action === 'copy') {
          if (key.keyPlain) {
            try {
              await navigator.clipboard.writeText(key.keyPlain);
              alert('密钥已复制到剪贴板');
            } catch {
              alert('复制失败，请手动复制');
            }
          } else {
            alert('密钥仅创建时可见');
          }
        } else if (action === 'toggle' || action === 'delete') {
          const confirmMsg = action === 'delete' ? '确定删除此密钥？此操作将停用密钥。' : `确定${key.status === 'active' ? '禁用' : '启用'}此密钥？`;
          if (!confirm(confirmMsg)) return;
          try {
            await deleteApiKey(id);
            alert(action === 'delete' ? '密钥已删除' : '密钥状态已更新');
            await loadKeys();
          } catch (err) {
            if (isAuthError(err)) return;
            alert(err instanceof Error ? err.message : '网络异常');
          }
        }
      });
    });
  }

  async function renderUsage(): Promise<void> {
    const container = document.getElementById('usage-records')!;
    if (keys.length === 0) {
      container.innerHTML = '<div class="empty-state">暂无 API 密钥，无法显示使用记录</div>';
      return;
    }
    // 尝试调用使用记录接口
    try {
      const raw = await getApiKeyUsage(keys[0].id);
      const records = toItems(raw);
      if (records.length === 0) {
        container.innerHTML = '<div class="empty-state">近 24 小时暂无使用记录</div>';
        return;
      }
      container.innerHTML = records
        .map((r) => {
          const status = typeof r.status === 'number' ? r.status : 200;
          const method = String(r.method || 'GET');
          const endpoint = String(r.endpoint || r.path || '-');
          const keyName = String(r.key_name || r.key || '-');
          const time = String(r.time || r.timestamp || '-');
          return `
            <div class="usage-record" style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--border-light);">
              <span class="badge ${status === 200 ? 'badge-success' : 'badge-danger'}">${escapeHtml(method)}</span>
              <span style="font-family: var(--font-mono); font-size: var(--text-sm); flex: 1;">${escapeHtml(endpoint)}</span>
              <span class="text-muted" style="font-size: var(--text-xs);">${escapeHtml(keyName)}</span>
              <span class="badge ${status === 200 ? 'badge-success' : 'badge-danger'}">${status}</span>
              <span class="text-muted" style="font-size: var(--text-xs);">${escapeHtml(time)}</span>
            </div>`;
        })
        .join('');
    } catch (err) {
      if (isAuthError(err)) return;
      container.innerHTML = '<div class="empty-state">使用记录功能需要后端支持</div>';
    }
  }

  function escapeHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  const modal = document.getElementById('create-modal')!;
  document.getElementById('create-key-btn')?.addEventListener('click', () => (modal.style.display = 'flex'));
  document.getElementById('close-modal')?.addEventListener('click', () => (modal.style.display = 'none'));
  document.getElementById('cancel-btn')?.addEventListener('click', () => (modal.style.display = 'none'));

  document.getElementById('key-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form));
    const scopes = form.querySelectorAll('input[name="scope"]:checked') as NodeListOf<HTMLInputElement>;
    const scopeList = Array.from(scopes).map((s) => s.value);
    const expiry = typeof data.expiry === 'string' && data.expiry ? String(data.expiry) : undefined;
    try {
      const newKeyRaw = await createApiKey({
        name: String(data.name || ''),
        scopes: scopeList,
        expires_at: expiry,
      });
      const newKey = normalizeKey(newKeyRaw as unknown as Record<string, unknown>);
      keys.unshift(newKey);
      renderKeys();
      // 如果后端返回明文密钥，提示用户保存
      if (newKey.keyPlain) {
        alert(`密钥创建成功，请妥善保管：\n${newKey.keyPlain}\n\n此密钥仅本次显示，之后将不可见。`);
      } else {
        alert('密钥创建成功，请妥善保管');
      }
      modal.style.display = 'none';
      form.reset();
    } catch (err) {
      if (isAuthError(err)) return;
      alert(err instanceof Error ? err.message : '网络异常');
    }
  });

  loadKeys();
</script>
