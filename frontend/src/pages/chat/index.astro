---
/**
 * AI 对话主界面
 * 全屏三列布局：会话历史 + 消息流 + 引用面板
 * 使用 SSE 流式接收 AI 回复（/api/v1/chat/stream）
 * 支持三种 Agent 类型切换（qa/workflow/action）
 * AI 回复支持完整 Markdown 渲染（代码块语法高亮、表格、列表、引用等）
 */
import '@/styles/global.css';
// highlight.js 主题：代码块深色配色
import 'highlight.js/styles/github-dark.css';

const appName = import.meta.env.PUBLIC_APP_NAME || '企业知识库';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>AI 对话 · {appName}</title>
  </head>
  <body>
    <div class="chat-app">
      <!-- 左侧：会话历史 -->
      <aside class="chat-sidebar" id="chat-sidebar">
        <div class="chat-sidebar-header">
          <button class="btn btn-primary btn-block" id="new-chat-btn">
            <span>＋</span> 新建对话
          </button>
        </div>
        <div class="chat-sidebar-search">
          <input type="text" class="form-input" id="conv-search" placeholder="搜索对话..." />
        </div>
        <div class="chat-conversation-list" id="conversation-list">
          <div class="chat-empty-hint">暂无对话，点击「新建对话」开始</div>
        </div>
      </aside>

      <!-- 中间：消息流 + 输入栏 -->
      <main class="chat-main">
        <header class="chat-main-header">
          <div class="chat-agent-switcher">
            <button class="agent-tab active" data-agent="qa">问答 Agent</button>
            <button class="agent-tab" data-agent="workflow">工作流 Agent</button>
            <button class="agent-tab" data-agent="action">动作 Agent</button>
          </div>
          <button class="btn btn-ghost btn-sm" id="toggle-right">引用 ▸</button>
        </header>

        <div class="chat-messages" id="chat-messages">
          <div class="chat-welcome">
            <div class="chat-welcome-icon">💬</div>
            <h2>AI 智能对话</h2>
            <p>基于 Agentic RAG 的智能问答，支持流式输出和引用溯源</p>
            <div class="chat-suggestions">
              <button class="chat-suggestion-item" data-q="公司报销流程是什么？">公司报销流程是什么？</button>
              <button class="chat-suggestion-item" data-q="年假有多少天？">年假有多少天？</button>
              <button class="chat-suggestion-item" data-q="新人入职需要准备什么材料？">新人入职需要准备什么材料？</button>
            </div>
          </div>
        </div>

        <footer class="chat-input-area">
          <div class="chat-input-wrapper">
            <textarea
              id="chat-input"
              class="chat-input"
              placeholder="输入您的问题，按 Enter 发送，Shift+Enter 换行"
              rows="1"
            ></textarea>
            <button class="btn btn-primary" id="send-btn" disabled>发送</button>
          </div>
          <div class="chat-input-tip">AI 回复基于知识库内容，可能存在偏差，请核实重要信息</div>
        </footer>
      </main>

      <!-- 右侧：引用面板 -->
      <aside class="chat-right" id="chat-right">
        <div class="chat-right-header">
          <span>引用来源</span>
          <button class="btn btn-ghost btn-sm" id="close-right">✕</button>
        </div>
        <div class="chat-right-body" id="references-list">
          <div class="chat-empty-hint">回复生成后将显示引用来源</div>
        </div>
      </aside>
    </div>

    <script>
      import { renderMarkdownStream } from '@/lib/markdown';

      const API_BASE = import.meta.env.PUBLIC_API_BASE || 'http://localhost:8000';
      const TOKEN_KEY = 'ekb_access_token';

      // 对话状态
      let conversations: Array<{ id: string; title: string; messages: any[] }> = [];
      let currentConvId: string | null = null;
      let currentAgent: 'qa' | 'workflow' | 'action' = 'qa';
      let isStreaming = false;

      const $ = (id: string) => document.getElementById(id);
      const convListEl = $('conversation-list')!;
      const messagesEl = $('chat-messages')!;
      const inputEl = $('chat-input') as HTMLTextAreaElement;
      const sendBtn = $('send-btn') as HTMLButtonElement;
      const refListEl = $('references-list')!;

      // 加载会话列表
      async function loadConversations() {
        const token = localStorage.getItem(TOKEN_KEY);
        if (!token) {
          window.location.href = '/auth/login';
          return;
        }
        try {
          const res = await fetch(`${API_BASE}/api/v1/chat/conversations`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          if (res.ok) {
            const result = await res.json();
            conversations = result.data?.items || result.data || [];
            renderConversationList();
          } else if (res.status === 401) {
            window.location.href = '/auth/login';
          }
        } catch {
          conversations = mockConversations();
          renderConversationList();
        }
      }

      function mockConversations() {
        return [
          { id: 'mock-1', title: '公司报销流程', messages: [] },
          { id: 'mock-2', title: '年假政策咨询', messages: [] },
        ];
      }

      function renderConversationList() {
        const keyword = ($('conv-search') as HTMLInputElement)?.value?.trim() || '';
        const list = keyword
          ? conversations.filter((c) => c.title.includes(keyword))
          : conversations;

        if (list.length === 0) {
          convListEl.innerHTML = '<div class="chat-empty-hint">暂无对话</div>';
          return;
        }

        convListEl.innerHTML = list
          .map(
            (c) => `
          <div class="chat-conv-item ${c.id === currentConvId ? 'active' : ''}" data-id="${c.id}">
            <span class="chat-conv-icon">💬</span>
            <span class="chat-conv-title">${escapeHtml(c.title)}</span>
          </div>`
          )
          .join('');

        convListEl.querySelectorAll('.chat-conv-item').forEach((el) => {
          el.addEventListener('click', () => {
            const id = (el as HTMLElement).dataset.id!;
            selectConversation(id);
          });
        });
      }

      function selectConversation(id: string) {
        currentConvId = id;
        const conv = conversations.find((c) => c.id === id);
        renderConversationList();
        messagesEl.innerHTML = '';
        if (conv && conv.messages.length > 0) {
          conv.messages.forEach((m) => renderMessage(m.role, m.content));
        } else {
          renderWelcome();
        }
      }

      function renderWelcome() {
        messagesEl.innerHTML = `
          <div class="chat-welcome">
            <div class="chat-welcome-icon">💬</div>
            <h2>AI 智能对话</h2>
            <p>基于 Agentic RAG 的智能问答，支持流式输出和引用溯源</p>
            <div class="chat-suggestions">
              <button class="chat-suggestion-item" data-q="公司报销流程是什么？">公司报销流程是什么？</button>
              <button class="chat-suggestion-item" data-q="年假有多少天？">年假有多少天？</button>
              <button class="chat-suggestion-item" data-q="新人入职需要准备什么材料？">新人入职需要准备什么材料？</button>
            </div>
          </div>`;
        bindSuggestions();
      }

      function renderMessage(role: string, content: string, streaming = false) {
        const welcome = messagesEl.querySelector('.chat-welcome');
        if (welcome) welcome.remove();

        const msgEl = document.createElement('div');
        msgEl.className = `chat-message ${role}`;
        // 用户消息保持纯文本（避免 XSS）；AI 消息使用 Markdown 渲染
        const isAI = role === 'assistant';
        const contentHtml = isAI
          ? `<div class="markdown-body">${content ? renderMarkdownStream(content) : ''}</div>`
          : escapeHtml(content);
        const contentClass = isAI ? 'chat-message-content chat-message-content-ai' : 'chat-message-content';
        msgEl.innerHTML = `
          <div class="chat-message-avatar">${role === 'user' ? '我' : 'AI'}</div>
          <div class="chat-message-body">
            <div class="${contentClass}">${contentHtml}${streaming ? '<span class="chat-cursor"></span>' : ''}</div>
          </div>`;
        // 对历史 AI 消息绑定代码复制按钮和引用点击事件
        if (isAI && content) {
          bindCodeCopyButtons(msgEl);
          bindCitationClicks(msgEl);
        }
        messagesEl.appendChild(msgEl);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return msgEl;
      }

      function bindSuggestions() {
        messagesEl.querySelectorAll('.chat-suggestion-item').forEach((el) => {
          el.addEventListener('click', () => {
            const q = (el as HTMLElement).dataset.q!;
            inputEl.value = q;
            inputEl.dispatchEvent(new Event('input'));
            sendMessage();
          });
        });
      }

      // 发送消息（SSE 流式）
      async function sendMessage() {
        const query = inputEl.value.trim();
        if (!query || isStreaming) return;

        const token = localStorage.getItem(TOKEN_KEY);
        if (!token) {
          window.location.href = '/auth/login';
          return;
        }

        // 创建新会话
        if (!currentConvId) {
          currentConvId = 'conv-' + Date.now();
          conversations.unshift({
            id: currentConvId,
            title: query.slice(0, 20),
            messages: [],
          });
          renderConversationList();
        }

        // 渲染用户消息
        renderMessage('user', query);
        const conv = conversations.find((c) => c.id === currentConvId);
        conv?.messages.push({ role: 'user', content: query });

        inputEl.value = '';
        inputEl.style.height = 'auto';
        sendBtn.disabled = true;
        isStreaming = true;

        // 渲染 AI 占位消息
        const aiEl = renderMessage('assistant', '', true);
        const contentEl = aiEl.querySelector('.chat-message-content')!;
        // 流式累积文本状态（通过对象引用传递给 handleSSEEvent）
        const streamState = { fullText: '' };

        try {
          const res = await fetch(`${API_BASE}/api/v1/chat/stream`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'text/event-stream',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              query,
              conversation_id: currentConvId,
              agent_type: currentAgent,
            }),
          });

          if (!res.ok || !res.body) {
            throw new Error('流式连接失败');
          }

          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          const sources: any[] = [];

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop() || '';

            let evtType = '';
            let evtData = '';

            for (const line of lines) {
              const trimmed = line.trim();
              if (trimmed === '') {
                if (evtData) {
                  handleSSEEvent(evtType, evtData, contentEl, sources, streamState);
                  evtType = '';
                  evtData = '';
                }
                continue;
              }
              if (trimmed.startsWith('event:')) {
                evtType = trimmed.slice(6).trim();
              } else if (trimmed.startsWith('data:')) {
                const d = trimmed.slice(5).trim();
                evtData = evtData ? `${evtData}\n${d}` : d;
              }
            }
          }

          // 处理最后的数据
          if (buffer.trim().startsWith('data:')) {
            handleSSEEvent('', buffer.trim().slice(5).trim(), contentEl, sources, streamState);
          }

          // 最终一次渲染（去掉光标），并保存到会话历史
          contentEl.innerHTML = `<div class="markdown-body">${renderMarkdownStream(streamState.fullText)}</div>`;
          conv?.messages.push({ role: 'assistant', content: streamState.fullText });
        } catch (err) {
          contentEl.innerHTML =
            '<span class="text-danger">连接异常：' +
            escapeHtml(err instanceof Error ? err.message : String(err)) +
            '</span>';
        } finally {
          const cursor = aiEl.querySelector('.chat-cursor');
          cursor?.remove();
          // 流式结束后绑定代码复制按钮和引用点击事件
          bindCodeCopyButtons(aiEl);
          bindCitationClicks(aiEl);
          isStreaming = false;
          sendBtn.disabled = false;
        }
      }

      function handleSSEEvent(
        type: string,
        data: string,
        contentEl: Element,
        sources: any[],
        state: { fullText: string }
      ) {
        let parsed: any = data;
        try {
          parsed = JSON.parse(data);
        } catch {
          // 纯文本
        }

        const evtType = type || parsed?.type || 'message';

        if (evtType === 'token' || evtType === 'chunk') {
          const text = parsed?.text || String(parsed);
          state.fullText += text;
          // 流式增量渲染：每次新 token 到达后重新渲染整个累积文本
          contentEl.innerHTML = `<div class="markdown-body">${renderMarkdownStream(state.fullText)}</div><span class="chat-cursor"></span>`;
          messagesEl.scrollTop = messagesEl.scrollHeight;
        } else if (evtType === 'sources') {
          const list = Array.isArray(parsed) ? parsed : parsed?.sources || [];
          sources.push(...list);
          renderReferences(list);
        } else if (evtType === 'error') {
          state.fullText += `\n\n> **[错误]** ${parsed?.message || '未知错误'}\n`;
          contentEl.innerHTML = `<div class="markdown-body">${renderMarkdownStream(state.fullText)}</div><span class="chat-cursor"></span>`;
          messagesEl.scrollTop = messagesEl.scrollHeight;
        }
      }

      function renderReferences(sources: any[]) {
        if (!sources || sources.length === 0) return;
        refListEl.innerHTML = sources
          .map(
            (s, i) => `
          <div class="reference-card">
            <div class="reference-card-header">
              <span class="reference-index">[${i + 1}]</span>
              <span class="reference-title">${escapeHtml(s.title || s.doc_title || '未知文档')}</span>
            </div>
            <p class="reference-snippet">${escapeHtml(s.snippet || s.content || '')}</p>
            <div class="reference-meta">
              <span class="badge badge-primary">${escapeHtml(s.score ? (s.score * 100).toFixed(0) + '%' : '匹配')}</span>
              ${s.kb_name ? `<span class="text-muted">${escapeHtml(s.kb_name)}</span>` : ''}
            </div>
          </div>`
          )
          .join('');
      }

      /**
       * 为代码块的复制按钮绑定点击事件
       * 复制对应代码到剪贴板，并临时切换按钮文案为「已复制」
       */
      function bindCodeCopyButtons(scope: ParentNode) {
        scope.querySelectorAll('.code-copy-btn').forEach((btn) => {
          const el = btn as HTMLElement;
          if (el.dataset.bound === '1') return;
          el.dataset.bound = '1';
          el.addEventListener('click', async () => {
            const code = decodeURIComponent(el.dataset.code || '');
            try {
              await navigator.clipboard.writeText(code);
              el.textContent = '已复制';
              setTimeout(() => {
                el.textContent = '复制';
              }, 1500);
            } catch {
              alert('复制失败，请手动选择代码复制');
            }
          });
        });
      }

      /**
       * 为引用标注 [1] [2] 绑定点击事件
       * 点击后滚动到右侧引用面板对应卡片并高亮
       */
      function bindCitationClicks(scope: ParentNode) {
        scope.querySelectorAll('.chat-msg-citation').forEach((el) => {
          const node = el as HTMLElement;
          if (node.dataset.bound === '1') return;
          node.dataset.bound = '1';
          node.addEventListener('click', () => {
            const idx = parseInt(node.dataset.idx || '0', 10);
            const cards = refListEl.querySelectorAll('.reference-card');
            const target = cards[idx - 1] as HTMLElement | undefined;
            if (target) {
              // 确保引用面板可见
              const rightPanel = $('chat-right')!;
              if (rightPanel.classList.contains('hidden')) {
                rightPanel.classList.remove('hidden');
                ($('toggle-right') as HTMLElement).textContent = '引用 ◂';
              }
              target.scrollIntoView({ behavior: 'smooth', block: 'center' });
              target.classList.add('reference-highlight');
              setTimeout(() => target.classList.remove('reference-highlight'), 2000);
            } else {
              alert(`引用 [${idx}] 暂无对应来源`);
            }
          });
        });
      }

      function escapeHtml(s: string): string {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      // 事件绑定
      $('new-chat-btn')?.addEventListener('click', () => {
        currentConvId = null;
        renderConversationList();
        renderWelcome();
        inputEl.focus();
      });

      $('conv-search')?.addEventListener('input', renderConversationList);

      inputEl.addEventListener('input', () => {
        sendBtn.disabled = !inputEl.value.trim();
        inputEl.style.height = 'auto';
        inputEl.style.height = Math.min(inputEl.scrollHeight, 200) + 'px';
      });

      inputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });

      sendBtn.addEventListener('click', sendMessage);

      // Agent 切换
      document.querySelectorAll('.agent-tab').forEach((el) => {
        el.addEventListener('click', () => {
          document.querySelectorAll('.agent-tab').forEach((e) => e.classList.remove('active'));
          el.classList.add('active');
          currentAgent = (el as HTMLElement).dataset.agent as any;
        });
      });

      // 引用面板折叠
      $('toggle-right')?.addEventListener('click', () => {
        const right = $('chat-right')!;
        right.classList.toggle('hidden');
        ($('toggle-right') as HTMLElement).textContent = right.classList.contains('hidden')
          ? '引用 ▸'
          : '引用 ◂';
      });

      $('close-right')?.addEventListener('click', () => {
        $('chat-right')!.classList.add('hidden');
        ($('toggle-right') as HTMLElement).textContent = '引用 ▸';
      });

      bindSuggestions();
      loadConversations();
    </script>

    <style>
      .chat-app {
        display: flex;
        height: 100vh;
        background: var(--bg);
        overflow: hidden;
      }
      .chat-sidebar {
        width: 280px;
        background: var(--surface);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
      }
      .chat-sidebar-header {
        padding: var(--space-4);
      }
      .chat-sidebar-search {
        padding: 0 var(--space-4) var(--space-3);
      }
      .chat-conversation-list {
        flex: 1;
        overflow-y: auto;
        padding: 0 var(--space-2);
      }
      .chat-conv-item {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-3);
        border-radius: var(--radius);
        cursor: pointer;
        color: var(--text-secondary);
        transition: all var(--transition-fast);
      }
      .chat-conv-item:hover {
        background: var(--surface-hover);
      }
      .chat-conv-item.active {
        background: var(--primary-bg);
        color: var(--primary);
      }
      .chat-conv-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: var(--text-sm);
      }
      .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .chat-main-header {
        height: 56px;
        padding: 0 var(--space-5);
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .chat-agent-switcher {
        display: flex;
        gap: var(--space-1);
        background: var(--surface-muted);
        padding: var(--space-1);
        border-radius: var(--radius);
      }
      .agent-tab {
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
        font-size: var(--text-sm);
        color: var(--text-muted);
        transition: all var(--transition-fast);
      }
      .agent-tab.active {
        background: var(--surface);
        color: var(--primary);
        box-shadow: var(--shadow-xs);
        font-weight: 500;
      }
      .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: var(--space-6);
      }
      .chat-welcome {
        text-align: center;
        padding-top: 10vh;
      }
      .chat-welcome-icon {
        font-size: 48px;
        margin-bottom: var(--space-4);
      }
      .chat-welcome h2 {
        font-size: var(--text-2xl);
        margin-bottom: var(--space-2);
      }
      .chat-welcome p {
        color: var(--text-muted);
        margin-bottom: var(--space-6);
      }
      .chat-suggestions {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        max-width: 480px;
        margin: 0 auto;
      }
      .chat-suggestion-item {
        padding: var(--space-4);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        text-align: left;
        color: var(--text-secondary);
        transition: all var(--transition-fast);
      }
      .chat-suggestion-item:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-bg);
      }
      .chat-message {
        display: flex;
        gap: var(--space-3);
        margin-bottom: var(--space-5);
        max-width: 820px;
        margin-left: auto;
        margin-right: auto;
      }
      .chat-message.user {
        flex-direction: row-reverse;
      }
      .chat-message-avatar {
        width: 36px;
        height: 36px;
        border-radius: var(--radius-full);
        background: var(--primary);
        color: var(--text-white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-sm);
        font-weight: 600;
        flex-shrink: 0;
      }
      .chat-message.user .chat-message-avatar {
        background: var(--success);
      }
      .chat-message-body {
        flex: 1;
        min-width: 0;
      }
      .chat-message-content {
        padding: var(--space-4);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        font-size: var(--text-base);
        line-height: var(--lh-relaxed);
        word-break: break-word;
        white-space: pre-wrap;
      }
      .chat-message.user .chat-message-content {
        background: var(--primary);
        color: var(--text-white);
        border-color: var(--primary);
      }
      /* AI 消息内容：覆盖 pre-wrap，交由 Markdown 自行控制换行 */
      .chat-message-content-ai {
        white-space: normal;
      }
      .chat-cursor {
        display: inline-block;
        width: 8px;
        height: 16px;
        background: var(--primary);
        animation: blink 1s infinite;
        vertical-align: middle;
        margin-left: 2px;
      }
      @keyframes blink {
        50% { opacity: 0; }
      }

      /* === Markdown 正文样式 === */
      .markdown-body {
        font-size: var(--text-base);
        line-height: var(--lh-relaxed);
        color: var(--text);
        word-break: break-word;
      }
      .markdown-body > *:first-child {
        margin-top: 0;
      }
      .markdown-body > *:last-child {
        margin-bottom: 0;
      }
      .markdown-body h1,
      .markdown-body h2,
      .markdown-body h3,
      .markdown-body h4,
      .markdown-body h5,
      .markdown-body h6 {
        margin: var(--space-5) 0 var(--space-3);
        font-weight: 600;
        line-height: var(--lh-tight);
        color: var(--text);
      }
      .markdown-body h1 { font-size: var(--text-2xl); }
      .markdown-body h2 { font-size: var(--text-xl); }
      .markdown-body h3 { font-size: var(--text-lg); }
      .markdown-body h4,
      .markdown-body h5,
      .markdown-body h6 { font-size: var(--text-md); }
      .markdown-body p {
        margin: var(--space-2) 0;
      }
      .markdown-body ul,
      .markdown-body ol {
        margin: var(--space-2) 0;
        padding-left: var(--space-6);
      }
      .markdown-body ul {
        list-style: disc;
      }
      .markdown-body ol {
        list-style: decimal;
      }
      .markdown-body li {
        margin: var(--space-1) 0;
        padding-left: var(--space-1);
      }
      .markdown-body li > ul,
      .markdown-body li > ol {
        margin: var(--space-1) 0;
      }
      .markdown-body blockquote {
        margin: var(--space-3) 0;
        padding: var(--space-2) var(--space-4);
        border-left: 4px solid var(--primary);
        background: var(--primary-bg);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        color: var(--text-secondary);
      }
      .markdown-body blockquote > *:first-child { margin-top: 0; }
      .markdown-body blockquote > *:last-child { margin-bottom: 0; }
      .markdown-body a {
        color: var(--primary);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .markdown-body a:hover {
        color: var(--primary-dark);
      }
      .markdown-body img {
        max-width: 100%;
        border-radius: var(--radius);
        margin: var(--space-2) 0;
      }
      .markdown-body hr {
        margin: var(--space-4) 0;
        border: none;
        border-top: 1px solid var(--border);
      }
      .markdown-body strong {
        font-weight: 600;
        color: var(--text);
      }
      .markdown-body em {
        font-style: italic;
      }
      .markdown-body del {
        text-decoration: line-through;
        color: var(--text-muted);
      }
      /* 行内代码 */
      .markdown-body code:not(.hljs) {
        padding: 2px 6px;
        background: var(--surface-muted);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-xs);
        font-family: var(--font-mono);
        font-size: 0.9em;
        color: var(--danger);
      }

      /* === 表格 === */
      .markdown-body table {
        width: 100%;
        margin: var(--space-3) 0;
        border-collapse: collapse;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
        font-size: var(--text-sm);
      }
      .markdown-body thead {
        background: var(--surface-muted);
      }
      .markdown-body th,
      .markdown-body td {
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--border);
        text-align: left;
      }
      .markdown-body th {
        font-weight: 600;
        color: var(--text);
      }
      .markdown-body tbody tr:nth-child(even) {
        background: var(--surface-muted);
      }

      /* === 代码块（highlight.js） === */
      .markdown-body .code-block {
        position: relative;
        margin: var(--space-3) 0;
        background: #0d1117;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--border-dark);
      }
      .markdown-body .code-block code {
        display: block;
        padding: var(--space-4);
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        line-height: var(--lh-normal);
        background: transparent;
        border: none;
        color: inherit;
      }
      /* 复制按钮：默认半透明，hover 时完全显示 */
      .code-copy-btn {
        position: absolute;
        top: var(--space-2);
        right: var(--space-2);
        padding: var(--space-1) var(--space-3);
        background: rgba(255, 255, 255, 0.1);
        color: #c9d1d9;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: var(--radius-xs);
        font-size: var(--text-xs);
        cursor: pointer;
        opacity: 0;
        transition: opacity var(--transition-fast), background var(--transition-fast);
      }
      .code-block:hover .code-copy-btn {
        opacity: 1;
      }
      .code-copy-btn:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      /* === 引用标注徽章 === */
      .chat-msg-citation {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        padding: 0 4px;
        margin: 0 1px;
        background: var(--primary-bg);
        color: var(--primary);
        border-radius: var(--radius-xs);
        font-size: var(--text-xs);
        font-weight: 600;
        cursor: pointer;
        vertical-align: super;
        line-height: 1;
        transition: background var(--transition-fast), color var(--transition-fast);
        user-select: none;
      }
      .chat-msg-citation:hover {
        background: var(--primary);
        color: var(--text-white);
      }

      /* === 引用卡片高亮（点击 [N] 时） === */
      .reference-card.reference-highlight {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-bg);
        animation: ref-flash 2s ease;
      }
      @keyframes ref-flash {
        0%, 100% { background: var(--surface); }
        30% { background: var(--primary-bg); }
      }
      .chat-input-area {
        padding: var(--space-4) var(--space-6);
        background: var(--surface);
        border-top: 1px solid var(--border);
      }
      .chat-input-wrapper {
        display: flex;
        gap: var(--space-3);
        align-items: flex-end;
        max-width: 820px;
        margin: 0 auto;
      }
      .chat-input {
        flex: 1;
        padding: var(--space-3) var(--space-4);
        background: var(--surface-muted);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        resize: none;
        max-height: 200px;
        line-height: var(--lh-normal);
      }
      .chat-input-tip {
        text-align: center;
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-top: var(--space-2);
      }
      .chat-right {
        width: 320px;
        background: var(--surface);
        border-left: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: width var(--transition);
      }
      .chat-right.hidden {
        width: 0;
        overflow: hidden;
      }
      .chat-right-header {
        height: 56px;
        padding: 0 var(--space-4);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 600;
      }
      .chat-right-body {
        flex: 1;
        overflow-y: auto;
        padding: var(--space-4);
      }
      .reference-card {
        padding: var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin-bottom: var(--space-3);
      }
      .reference-card-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-2);
      }
      .reference-index {
        font-weight: 600;
        color: var(--primary);
        font-size: var(--text-sm);
      }
      .reference-title {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text);
      }
      .reference-snippet {
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: var(--lh-relaxed);
        margin-bottom: var(--space-2);
      }
      .reference-meta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      .chat-empty-hint {
        text-align: center;
        color: var(--text-muted);
        font-size: var(--text-sm);
        padding: var(--space-8);
      }
      @media (max-width: 1024px) {
        .chat-right { display: none; }
      }
      @media (max-width: 768px) {
        .chat-sidebar { display: none; }
      }
    </style>
  </body>
</html>
