---
/**
 * AI 对话主界面
 * 全屏三列布局：会话历史 + 消息流 + 引用面板
 * 使用 SSE 流式接收 AI 回复（/api/v1/chat/stream）
 * 支持三种 Agent 类型切换（qa/workflow/action）
 * AI 回复支持完整 Markdown 渲染（代码块语法高亮、表格、列表、引用等）
 */
import '@/styles/global.css';
// highlight.js 主题：代码块深色配色
import 'highlight.js/styles/github-dark.css';

const appName = import.meta.env.PUBLIC_APP_NAME || '企业知识库';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>AI 对话 · {appName}</title>
  </head>
  <body>
    <div class="chat-app">
      <!-- 左侧：会话历史 -->
      <aside class="chat-sidebar" id="chat-sidebar">
        <div class="chat-sidebar-header">
          <button class="btn btn-primary btn-block" id="new-chat-btn">
            <span>＋</span> 新建对话
          </button>
        </div>
        <div class="chat-sidebar-search">
          <input type="text" class="form-input" id="conv-search" placeholder="搜索对话..." />
        </div>
        <div class="chat-sidebar-stats">
          <div class="chat-stat-item">
            <span class="chat-stat-label">今日对话</span>
            <span class="chat-stat-value" id="stat-today">0</span>
          </div>
          <div class="chat-stat-item">
            <span class="chat-stat-label">本周对话</span>
            <span class="chat-stat-value" id="stat-week">0</span>
          </div>
        </div>
        <div class="chat-conversation-list" id="conversation-list">
          <div class="chat-empty-hint">暂无对话，点击「新建对话」开始</div>
        </div>
      </aside>

      <!-- 中间：消息流 + 输入栏 -->
      <main class="chat-main">
        <header class="chat-main-header">
          <div class="chat-agent-switcher">
            <button class="agent-tab active" data-agent="qa">问答 Agent</button>
            <button class="agent-tab" data-agent="workflow">工作流 Agent</button>
            <button class="agent-tab" data-agent="action">动作 Agent</button>
          </div>
          <div class="chat-header-right">
            <select id="model-selector" class="model-selector" title="选择 AI 模型">
              <option value="">加载模型中...</option>
            </select>
            <button class="btn btn-ghost btn-sm" id="toggle-right">引用 ▸</button>
          </div>
        </header>

        <div class="chat-messages" id="chat-messages">
          <div class="chat-welcome">
            <div class="chat-welcome-icon">💬</div>
            <h2>AI 智能对话</h2>
            <p>基于 Agentic RAG 的智能问答，支持流式输出和引用溯源</p>
            <div class="chat-suggestions">
              <button class="chat-suggestion-item" data-q="公司报销流程是什么？">公司报销流程是什么？</button>
              <button class="chat-suggestion-item" data-q="年假有多少天？">年假有多少天？</button>
              <button class="chat-suggestion-item" data-q="新人入职需要准备什么材料？">新人入职需要准备什么材料？</button>
            </div>
          </div>
        </div>

        <footer class="chat-input-area">
          <div class="chat-input-wrapper">
            <textarea
              id="chat-input"
              class="chat-input"
              placeholder="输入您的问题，按 Enter 发送，Shift+Enter 换行"
              rows="1"
            ></textarea>
            <button class="btn btn-primary" id="send-btn" disabled>发送</button>
          </div>
          <div class="chat-input-tip">AI 回复基于知识库内容，可能存在偏差，请核实重要信息</div>
        </footer>
      </main>

      <!-- 右侧：引用面板 -->
      <aside class="chat-right" id="chat-right">
        <div class="chat-right-header">
          <span>引用来源</span>
          <button class="btn btn-ghost btn-sm" id="close-right">✕</button>
        </div>
        <div class="chat-right-body" id="references-list">
          <div class="chat-empty-hint">回复生成后将显示引用来源</div>
        </div>
      </aside>
    </div>

    <script>
      import { renderMarkdownStream } from '@/lib/markdown';

      const API_BASE = import.meta.env.PUBLIC_API_BASE || 'http://localhost:8000';
      const TOKEN_KEY = 'ekb_access_token';

      // 对话状态
      let conversations: Array<{ id: string; title: string; messages: any[] }> = [];
      let currentConvId: string | null = null;
      let currentAgent: 'qa' | 'workflow' | 'action' = 'qa';
      let isStreaming = false;
      // P2-6: 模型选择器状态
      let availableModels: Array<{ id: string; display_name: string; is_default: boolean; tier: string }> = [];
      let currentModelId: string | null = null;

      const $ = (id: string) => document.getElementById(id);
      const convListEl = $('conversation-list')!;
      const messagesEl = $('chat-messages')!;
      const inputEl = $('chat-input') as HTMLTextAreaElement;
      const sendBtn = $('send-btn') as HTMLButtonElement;
      const refListEl = $('references-list')!;
      const modelSelectorEl = $('model-selector') as HTMLSelectElement;

      // P2-6: 加载可用模型列表
      async function loadModels() {
        const token = localStorage.getItem(TOKEN_KEY);
        try {
          const sessionId = currentConvId || '';
          const url = sessionId
            ? `${API_BASE}/api/v1/models?session_id=${encodeURIComponent(sessionId)}`
            : `${API_BASE}/api/v1/models`;
          const res = await fetch(url, {
            headers: { Authorization: `Bearer ${token}` },
          });
          if (!res.ok) return;
          const data = await res.json();
          availableModels = data.models || [];
          currentModelId = data.current_model_id || null;
          renderModelSelector();
        } catch (e) {
          // 静默失败 — 模型选择器不影响核心功能
        }
      }

      // P2-6: 渲染模型选择器下拉框
      function renderModelSelector() {
        if (!modelSelectorEl) return;
        if (availableModels.length === 0) {
          modelSelectorEl.innerHTML = '<option value="">默认模型</option>';
          return;
        }
        const selected = currentModelId || availableModels.find(m => m.is_default)?.id || '';
        modelSelectorEl.innerHTML = availableModels.map(m => {
          const badge = m.tier === 'premium' ? ' ⭐' : '';
          const defaultMark = m.is_default ? ' (默认)' : '';
          return `<option value="${m.id}" ${m.id === selected ? 'selected' : ''}>${escapeHtml(m.display_name)}${badge}${defaultMark}</option>`;
        }).join('');
      }

      // P2-6: 切换会话模型
      async function setSessionModel(modelId: string) {
        if (!currentConvId || !modelId) return;
        const token = localStorage.getItem(TOKEN_KEY);
        try {
          const res = await fetch(`${API_BASE}/api/v1/models/session/${encodeURIComponent(currentConvId)}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ model_id: modelId }),
          });
          if (res.ok) {
            currentModelId = modelId;
          }
        } catch (e) {
          // 静默失败
        }
      }

      // P2-6: 绑定模型选择器事件
      if (modelSelectorEl) {
        modelSelectorEl.addEventListener('change', () => {
          const selectedId = modelSelectorEl.value;
          if (selectedId) {
            setSessionModel(selectedId);
          }
        });
      }

      // 加载会话列表
      async function loadConversations() {
        const token = localStorage.getItem(TOKEN_KEY);
        if (!token) {
          window.location.href = '/auth/login';
          return;
        }
        showConvListLoading();
        try {
          const res = await fetch(`${API_BASE}/api/v1/chat/conversations`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          if (res.status === 401) {
            window.location.href = '/auth/login';
            return;
          }
          if (!res.ok) {
            throw new Error(`请求失败 (${res.status})`);
          }
          const result = await res.json();
          conversations = result.data?.items || result.data || [];
          renderConversationList();
          updateConvStats();
        } catch (err) {
          showConvListError(err instanceof Error ? err.message : String(err));
        }
      }

      /** 会话列表加载中 */
      function showConvListLoading() {
        convListEl.innerHTML = '<div class="chat-empty-hint">加载中...</div>';
      }

      /** 会话列表加载失败 - 显示错误信息 + 重试按钮 */
      function showConvListError(msg: string) {
        convListEl.innerHTML = `
          <div class="chat-list-error">
            <div class="chat-list-error-msg">会话列表加载失败</div>
            <div class="chat-list-error-detail">${escapeHtml(msg)}</div>
            <button class="btn btn-outline btn-sm" id="conv-retry-btn">重试</button>
          </div>`;
        document.getElementById('conv-retry-btn')?.addEventListener('click', loadConversations);
      }

      /** 从会话列表计算今日/本周对话数 */
      function updateConvStats() {
        const now = Date.now();
        const toTs = (c: any): number => {
          if (typeof c.created_at === 'number') return c.created_at;
          if (typeof c.created_at === 'string') {
            const t = new Date(c.created_at).getTime();
            return isNaN(t) ? 0 : t;
          }
          if (c.updated_at) {
            const t = new Date(c.updated_at).getTime();
            return isNaN(t) ? 0 : t;
          }
          return 0;
        };
        const today = conversations.filter((c) => {
          const ts = toTs(c);
          return ts > 0 && now - ts < 86400000;
        }).length;
        const week = conversations.filter((c) => {
          const ts = toTs(c);
          return ts > 0 && now - ts < 86400000 * 7;
        }).length;
        const todayEl = $('stat-today');
        const weekEl = $('stat-week');
        if (todayEl) todayEl.textContent = String(today);
        if (weekEl) weekEl.textContent = String(week);
      }

      function renderConversationList() {
        const keyword = ($('conv-search') as HTMLInputElement)?.value?.trim() || '';
        const list = keyword
          ? conversations.filter((c) => c.title.includes(keyword))
          : conversations;

        if (list.length === 0) {
          convListEl.innerHTML = '<div class="chat-empty-hint">暂无对话</div>';
          return;
        }

        convListEl.innerHTML = list
          .map(
            (c) => `
          <div class="chat-conv-item ${c.id === currentConvId ? 'active' : ''}" data-id="${c.id}">
            <span class="chat-conv-icon">💬</span>
            <span class="chat-conv-title">${escapeHtml(c.title)}</span>
          </div>`
          )
          .join('');

        convListEl.querySelectorAll('.chat-conv-item').forEach((el) => {
          el.addEventListener('click', () => {
            const id = (el as HTMLElement).dataset.id!;
            selectConversation(id);
          });
        });
      }

      function selectConversation(id: string) {
        currentConvId = id;
        const conv = conversations.find((c) => c.id === id);
        renderConversationList();
        messagesEl.innerHTML = '';
        if (conv && conv.messages.length > 0) {
          conv.messages.forEach((m) => renderMessage(m.role, m.content));
        } else {
          renderWelcome();
        }
      }

      function renderWelcome() {
        messagesEl.innerHTML = `
          <div class="chat-welcome">
            <div class="chat-welcome-icon">💬</div>
            <h2>AI 智能对话</h2>
            <p>基于 Agentic RAG 的智能问答，支持流式输出和引用溯源</p>
            <div class="chat-suggestions">
              <button class="chat-suggestion-item" data-q="公司报销流程是什么？">公司报销流程是什么？</button>
              <button class="chat-suggestion-item" data-q="年假有多少天？">年假有多少天？</button>
              <button class="chat-suggestion-item" data-q="新人入职需要准备什么材料？">新人入职需要准备什么材料？</button>
            </div>
          </div>`;
        bindSuggestions();
      }

      function renderMessage(role: string, content: string, streaming = false) {
        const welcome = messagesEl.querySelector('.chat-welcome');
        if (welcome) welcome.remove();

        const msgEl = document.createElement('div');
        msgEl.className = `chat-message ${role}`;
        // 用户消息保持纯文本（避免 XSS）；AI 消息使用 Markdown 渲染
        const isAI = role === 'assistant';
        const contentHtml = isAI
          ? `<div class="markdown-body">${content ? renderMarkdownStream(content) : ''}</div>`
          : escapeHtml(content);
        const contentClass = isAI ? 'chat-message-content chat-message-content-ai' : 'chat-message-content';
        // P0-6: AI 消息增加状态区（thinking/retrieve 进度）和工具调用区（ToolCallCard）
        const statusArea = isAI ? '<div class="chat-message-status"></div>' : '';
        const toolsArea = isAI ? '<div class="chat-message-tools"></div>' : '';
        msgEl.innerHTML = `
          <div class="chat-message-avatar">${role === 'user' ? '我' : 'AI'}</div>
          <div class="chat-message-body">
            ${statusArea}
            ${toolsArea}
            <div class="${contentClass}">${contentHtml}${streaming ? '<span class="chat-cursor"></span>' : ''}</div>
          </div>`;
        // 对历史 AI 消息绑定代码复制按钮和引用点击事件
        if (isAI && content) {
          bindCodeCopyButtons(msgEl);
          bindCitationClicks(msgEl);
        }
        messagesEl.appendChild(msgEl);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return msgEl;
      }

      function bindSuggestions() {
        messagesEl.querySelectorAll('.chat-suggestion-item').forEach((el) => {
          el.addEventListener('click', () => {
            const q = (el as HTMLElement).dataset.q!;
            inputEl.value = q;
            inputEl.dispatchEvent(new Event('input'));
            sendMessage();
          });
        });
      }

      // 发送消息（SSE 流式）
      async function sendMessage() {
        const query = inputEl.value.trim();
        if (!query || isStreaming) return;

        const token = localStorage.getItem(TOKEN_KEY);
        if (!token) {
          window.location.href = '/auth/login';
          return;
        }

        // 新会话不预先创建本地 ID：首次发消息时由后端自动创建会话
        const isNewConversation = !currentConvId;

        // 渲染用户消息
        renderMessage('user', query);
        const conv = conversations.find((c) => c.id === currentConvId);
        conv?.messages.push({ role: 'user', content: query });

        inputEl.value = '';
        inputEl.style.height = 'auto';
        sendBtn.disabled = true;
        isStreaming = true;

        // 渲染 AI 占位消息
        const aiEl = renderMessage('assistant', '', true);
        const contentEl = aiEl.querySelector('.chat-message-content')!;
        const statusEl = aiEl.querySelector('.chat-message-status') as HTMLElement;
        const toolsEl = aiEl.querySelector('.chat-message-tools') as HTMLElement;
        // 流式累积文本状态（通过对象引用传递给 handleSSEEvent）
        const streamState = { fullText: '' };

        try {
          const res = await fetch(`${API_BASE}/api/v1/chat/stream`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'text/event-stream',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              query,
              // 仅在已有会话时携带 conversation_id，新会话由后端自动创建
              ...(currentConvId ? { conversation_id: currentConvId } : {}),
              agent_type: currentAgent,
            }),
          });

          if (res.status === 401) {
            localStorage.removeItem(TOKEN_KEY);
            window.location.href = '/auth/login';
            return;
          }

          if (!res.ok || !res.body) {
            throw new Error('流式连接失败');
          }

          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          const sources: any[] = [];

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop() || '';

            let evtType = '';
            let evtData = '';

            for (const line of lines) {
              const trimmed = line.trim();
              if (trimmed === '') {
                if (evtData) {
                  handleSSEEvent(evtType, evtData, contentEl, sources, streamState, statusEl, toolsEl);
                  evtType = '';
                  evtData = '';
                }
                continue;
              }
              if (trimmed.startsWith('event:')) {
                evtType = trimmed.slice(6).trim();
              } else if (trimmed.startsWith('data:')) {
                const d = trimmed.slice(5).trim();
                evtData = evtData ? `${evtData}\n${d}` : d;
              }
            }
          }

          // 处理最后的数据
          if (buffer.trim().startsWith('data:')) {
            handleSSEEvent('', buffer.trim().slice(5).trim(), contentEl, sources, streamState, statusEl, toolsEl);
          }

          // 最终一次渲染（去掉光标）
          contentEl.innerHTML = `<div class="markdown-body">${renderMarkdownStream(streamState.fullText)}</div>`;

          if (isNewConversation) {
            // 后端已自动创建会话，重新拉取列表以获取真实会话 ID，并保留当前已渲染的消息
            await loadConversations();
            if (conversations.length > 0) {
              currentConvId = conversations[0].id;
              const newConv = conversations.find((c) => c.id === currentConvId);
              if (newConv) {
                newConv.title = newConv.title || query.slice(0, 20);
                newConv.messages = [
                  { role: 'user', content: query },
                  { role: 'assistant', content: streamState.fullText },
                ];
              }
              renderConversationList();
            }
          } else {
            conv?.messages.push({ role: 'assistant', content: streamState.fullText });
          }
        } catch (err) {
          contentEl.innerHTML =
            '<span class="text-danger">连接异常：' +
            escapeHtml(err instanceof Error ? err.message : String(err)) +
            '</span>';
        } finally {
          const cursor = aiEl.querySelector('.chat-cursor');
          cursor?.remove();
          // 流式结束后绑定代码复制按钮和引用点击事件
          bindCodeCopyButtons(aiEl);
          bindCitationClicks(aiEl);
          isStreaming = false;
          sendBtn.disabled = false;
        }
      }

      function handleSSEEvent(
        type: string,
        data: string,
        contentEl: Element,
        sources: any[],
        state: { fullText: string },
        statusEl?: HTMLElement,
        toolsEl?: HTMLElement,
      ) {
        let parsed: any = data;
        try {
          parsed = JSON.parse(data);
        } catch {
          // 纯文本
        }

        const evtType = type || parsed?.type || 'message';

        if (evtType === 'token' || evtType === 'chunk' || evtType === 'message') {
          // P0-6: 首个 token 到达时清除状态区
          if (statusEl && !state.fullText) {
            statusEl.innerHTML = '';
          }
          const text = parsed?.text || String(parsed);
          state.fullText += text;
          // 流式增量渲染：每次新 token 到达后重新渲染整个累积文本
          contentEl.innerHTML = `<div class="markdown-body">${renderMarkdownStream(state.fullText)}</div><span class="chat-cursor"></span>`;
          messagesEl.scrollTop = messagesEl.scrollHeight;
        } else if (evtType === 'meta') {
          // P0-6: 绑定会话 ID
          if (parsed?.conversation_id && !currentConvId) {
            currentConvId = parsed.conversation_id;
          }
          // P2-6: 更新当前模型 ID 并同步选择器
          if (parsed?.model_id) {
            currentModelId = parsed.model_id;
            if (modelSelectorEl && modelSelectorEl.value !== parsed.model_id) {
              modelSelectorEl.value = parsed.model_id;
            }
          }
        } else if (evtType === 'thinking') {
          // P0-6: Agent 思考进度
          if (statusEl) {
            const content = parsed?.content || '正在分析问题...';
            const iter = parsed?.iteration ? `（第 ${parsed.iteration} 轮）` : '';
            statusEl.innerHTML = `<div class="chat-status-item chat-status-thinking"><span class="chat-status-dot"></span>${escapeHtml(content)}${escapeHtml(iter)}</div>`;
            messagesEl.scrollTop = messagesEl.scrollHeight;
          }
        } else if (evtType === 'retrieve_start') {
          // P0-6: 检索开始
          if (statusEl) {
            statusEl.innerHTML = '<div class="chat-status-item chat-status-retrieve"><span class="chat-status-dot"></span>正在检索知识库...</div>';
            messagesEl.scrollTop = messagesEl.scrollHeight;
          }
        } else if (evtType === 'retrieve_end') {
          // P0-6: 检索完成
          if (statusEl) {
            const count = parsed?.doc_count ?? 0;
            statusEl.innerHTML = `<div class="chat-status-item chat-status-retrieve-done"><span class="chat-status-dot"></span>检索到 ${count} 篇相关文档</div>`;
            messagesEl.scrollTop = messagesEl.scrollHeight;
            // 2 秒后淡出
            setTimeout(() => { if (statusEl) statusEl.innerHTML = ''; }, 2000);
          }
        } else if (evtType === 'tool_call_start') {
          // P0-7: 工具调用开始 — 渲染 ToolCallCard
          if (toolsEl) {
            const toolName = parsed?.tool_name || 'unknown';
            const toolUseId = parsed?.tool_use_id || '';
            const args = parsed?.arguments || {};
            const argsStr = Object.keys(args).length > 0
              ? JSON.stringify(args, null, 2)
              : '(无参数)';
            const card = document.createElement('div');
            card.className = 'tool-call-card';
            card.dataset.toolUseId = toolUseId;
            card.innerHTML = `
              <div class="tool-call-header">
                <span class="tool-call-icon">🔧</span>
                <span class="tool-call-name">${escapeHtml(toolName)}</span>
                <span class="tool-call-status tool-call-status-running">执行中...</span>
              </div>
              <div class="tool-call-body">
                <div class="tool-call-section">
                  <div class="tool-call-label">参数</div>
                  <pre class="tool-call-args">${escapeHtml(argsStr)}</pre>
                </div>
                <div class="tool-call-section tool-call-result-section" style="display:none">
                  <div class="tool-call-label">结果</div>
                  <pre class="tool-call-result"></pre>
                </div>
              </div>`;
            toolsEl.appendChild(card);
            messagesEl.scrollTop = messagesEl.scrollHeight;
          }
        } else if (evtType === 'tool_call_end') {
          // P0-7: 工具调用完成 — 更新 ToolCallCard
          if (toolsEl) {
            const toolUseId = parsed?.tool_use_id || '';
            const card = toolsEl.querySelector(`[data-tool-use-id="${toolUseId}"]`);
            if (card) {
              const statusEl2 = card.querySelector('.tool-call-status');
              const resultSection = card.querySelector('.tool-call-result-section') as HTMLElement;
              const resultEl = card.querySelector('.tool-call-result');
              const duration = parsed?.duration_ms ? `${parsed.duration_ms}ms` : '';
              const status = parsed?.status || 'success';
              // P1-6: approval_required 状态不覆盖审批 UI（由 approval_required 事件渲染）
              if (status === 'approval_required') {
                if (statusEl2) {
                  statusEl2.textContent = '等待审批';
                  statusEl2.className = 'tool-call-status tool-call-status-pending';
                }
              } else {
                if (statusEl2) {
                  statusEl2.textContent = status === 'success' ? `完成 ${duration}` : `失败 ${duration}`;
                  statusEl2.className = `tool-call-status ${status === 'success' ? 'tool-call-status-success' : 'tool-call-status-error'}`;
                }
                if (resultSection && resultEl && parsed?.result) {
                  resultSection.style.display = '';
                  resultEl.textContent = String(parsed.result).slice(0, 500);
                }
              }
            }
            messagesEl.scrollTop = messagesEl.scrollHeight;
          }
        } else if (evtType === 'approval_required') {
          // P1-6: 危险工具需要用户审批 — 在 ToolCallCard 中渲染审批 UI
          if (toolsEl) {
            const toolUseId = parsed?.tool_use_id || '';
            const approvalId = parsed?.approval_id || '';
            const toolName = parsed?.tool_name || 'unknown';
            const reason = parsed?.reason || '此操作需要确认';
            const irreversible = parsed?.irreversible || false;
            const args = parsed?.arguments || {};
            const argsStr = Object.keys(args).length > 0
              ? JSON.stringify(args, null, 2)
              : '(无参数)';
            const card = toolsEl.querySelector(`[data-tool-use-id="${toolUseId}"]`) as HTMLElement | null;
            if (card) {
              // 将 ToolCallCard 转为审批卡片
              card.classList.add('tool-call-approval');
              card.dataset.approvalId = approvalId;
              const irreversibleBadge = irreversible
                ? '<span class="approval-irreversible-badge">不可逆操作</span>'
                : '';
              card.innerHTML = `
                <div class="tool-call-header">
                  <span class="tool-call-icon">⚠️</span>
                  <span class="tool-call-name">${escapeHtml(toolName)}</span>
                  <span class="tool-call-status tool-call-status-pending">等待审批</span>
                </div>
                <div class="tool-call-body">
                  <div class="tool-call-section">
                    <div class="tool-call-label">参数</div>
                    <pre class="tool-call-args">${escapeHtml(argsStr)}</pre>
                  </div>
                  <div class="approval-reason">
                    <div class="approval-reason-label">审批原因</div>
                    <div class="approval-reason-text">${escapeHtml(reason)}</div>
                    ${irreversibleBadge}
                  </div>
                  <div class="approval-actions">
                    <button class="btn btn-sm btn-primary approval-btn-approve" data-approval-id="${approvalId}">
                      批准执行
                    </button>
                    <button class="btn btn-sm btn-ghost approval-btn-reject" data-approval-id="${approvalId}">
                      拒绝
                    </button>
                  </div>
                </div>`;
              // 绑定审批按钮事件
              const approveBtn = card.querySelector('.approval-btn-approve') as HTMLElement;
              const rejectBtn = card.querySelector('.approval-btn-reject') as HTMLElement;
              if (approveBtn) {
                approveBtn.addEventListener('click', () => handleApproval(approvalId, true, card));
              }
              if (rejectBtn) {
                rejectBtn.addEventListener('click', () => handleApproval(approvalId, false, card));
              }
            }
            messagesEl.scrollTop = messagesEl.scrollHeight;
          }
        } else if (evtType === 'sources') {
          const list = Array.isArray(parsed) ? parsed : parsed?.sources || [];
          sources.push(...list);
          renderReferences(list);
        } else if (evtType === 'quality') {
          // P0-6: 质量评分 — 在内容区末尾追加质量徽章
          if (statusEl) {
            const lowConf = parsed?.low_confidence;
            const score = parsed?.total_score;
            if (lowConf) {
              statusEl.innerHTML = `<div class="chat-status-item chat-status-quality-low"><span class="chat-status-dot"></span>${escapeHtml(parsed?.message || '置信度较低，建议核实')}</div>`;
            } else if (score !== undefined) {
              statusEl.innerHTML = `<div class="chat-status-item chat-status-quality-ok"><span class="chat-status-dot"></span>质量评分：${(score * 100).toFixed(0)}%</div>`;
              setTimeout(() => { if (statusEl) statusEl.innerHTML = ''; }, 3000);
            }
          }
        } else if (evtType === 'done') {
          // P0-6: 流结束 — 清除状态区（done 事件由 _to_sse_stream 兜底发送）
          if (statusEl && !state.fullText) {
            statusEl.innerHTML = '';
          }
        } else if (evtType === 'error') {
          state.fullText += `\n\n> **[错误]** ${parsed?.message || '未知错误'}\n`;
          contentEl.innerHTML = `<div class="markdown-body">${renderMarkdownStream(state.fullText)}</div><span class="chat-cursor"></span>`;
          messagesEl.scrollTop = messagesEl.scrollHeight;
        }
      }

      // P1-6: 处理审批操作 — 调用 REST API 批准/拒绝危险工具
      async function handleApproval(approvalId: string, approved: boolean, card: Element) {
        const token = localStorage.getItem(TOKEN_KEY);
        const action = approved ? 'approve' : 'reject';
        const actionText = approved ? '批准' : '拒绝';
        const actionsEl = card.querySelector('.approval-actions') as HTMLElement;
        if (actionsEl) {
          actionsEl.innerHTML = `<span class="approval-pending">正在${actionText}...</span>`;
        }
        try {
          const res = await fetch(`${API_BASE}/api/v1/approvals/${approvalId}/${action}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              ...(token ? { Authorization: `Bearer ${token}` } : {}),
            },
            body: JSON.stringify({}),
          });
          if (!res.ok) {
            const errData = await res.json().catch(() => null);
            throw new Error(errData?.message || `审批请求失败 (${res.status})`);
          }
          // 审批成功 — 更新卡片状态
          const statusEl2 = card.querySelector('.tool-call-status');
          if (statusEl2) {
            statusEl2.textContent = approved ? '已批准' : '已拒绝';
            statusEl2.className = `tool-call-status ${approved ? 'tool-call-status-success' : 'tool-call-status-error'}`;
          }
          if (actionsEl) {
            if (approved) {
              actionsEl.innerHTML = '<span class="approval-done approval-done-approved">已批准 — 请重新提问以继续执行</span>';
            } else {
              actionsEl.innerHTML = '<span class="approval-done approval-done-rejected">已拒绝</span>';
            }
          }
        } catch (err: any) {
          // 审批失败 — 恢复按钮
          if (actionsEl) {
            actionsEl.innerHTML = `
              <span class="approval-error">${escapeHtml(err.message || '审批失败')}</span>
              <button class="btn btn-sm btn-primary approval-btn-approve" data-approval-id="${approvalId}">重试批准</button>
              <button class="btn btn-sm btn-ghost approval-btn-reject" data-approval-id="${approvalId}">拒绝</button>`;
            const approveBtn = actionsEl.querySelector('.approval-btn-approve') as HTMLElement;
            const rejectBtn = actionsEl.querySelector('.approval-btn-reject') as HTMLElement;
            if (approveBtn) {
              approveBtn.addEventListener('click', () => handleApproval(approvalId, true, card));
            }
            if (rejectBtn) {
              rejectBtn.addEventListener('click', () => handleApproval(approvalId, false, card));
            }
          }
        }
      }

      function renderReferences(sources: any[]) {
        if (!sources || sources.length === 0) return;
        refListEl.innerHTML = sources
          .map(
            (s, i) => `
          <div class="reference-card">
            <div class="reference-card-header">
              <span class="reference-index">[${i + 1}]</span>
              <span class="reference-title">${escapeHtml(s.title || s.doc_title || '未知文档')}</span>
            </div>
            <p class="reference-snippet">${escapeHtml(s.snippet || s.content || '')}</p>
            <div class="reference-meta">
              <span class="badge badge-primary">${escapeHtml(s.score ? (s.score * 100).toFixed(0) + '%' : '匹配')}</span>
              ${s.kb_name ? `<span class="text-muted">${escapeHtml(s.kb_name)}</span>` : ''}
            </div>
          </div>`
          )
          .join('');
      }

      /**
       * 为代码块的复制按钮绑定点击事件
       * 复制对应代码到剪贴板，并临时切换按钮文案为「已复制」
       */
      function bindCodeCopyButtons(scope: ParentNode) {
        scope.querySelectorAll('.code-copy-btn').forEach((btn) => {
          const el = btn as HTMLElement;
          if (el.dataset.bound === '1') return;
          el.dataset.bound = '1';
          el.addEventListener('click', async () => {
            const code = decodeURIComponent(el.dataset.code || '');
            try {
              await navigator.clipboard.writeText(code);
              el.textContent = '已复制';
              setTimeout(() => {
                el.textContent = '复制';
              }, 1500);
            } catch {
              alert('复制失败，请手动选择代码复制');
            }
          });
        });
      }

      /**
       * 为引用标注 [1] [2] 绑定点击事件
       * 点击后滚动到右侧引用面板对应卡片并高亮
       */
      function bindCitationClicks(scope: ParentNode) {
        scope.querySelectorAll('.chat-msg-citation').forEach((el) => {
          const node = el as HTMLElement;
          if (node.dataset.bound === '1') return;
          node.dataset.bound = '1';
          node.addEventListener('click', () => {
            const idx = parseInt(node.dataset.idx || '0', 10);
            const cards = refListEl.querySelectorAll('.reference-card');
            const target = cards[idx - 1] as HTMLElement | undefined;
            if (target) {
              // 确保引用面板可见
              const rightPanel = $('chat-right')!;
              if (rightPanel.classList.contains('hidden')) {
                rightPanel.classList.remove('hidden');
                ($('toggle-right') as HTMLElement).textContent = '引用 ◂';
              }
              target.scrollIntoView({ behavior: 'smooth', block: 'center' });
              target.classList.add('reference-highlight');
              setTimeout(() => target.classList.remove('reference-highlight'), 2000);
            } else {
              alert(`引用 [${idx}] 暂无对应来源`);
            }
          });
        });
      }

      function escapeHtml(s: string): string {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      // 事件绑定
      $('new-chat-btn')?.addEventListener('click', () => {
        currentConvId = null;
        renderConversationList();
        renderWelcome();
        inputEl.focus();
      });

      $('conv-search')?.addEventListener('input', renderConversationList);

      inputEl.addEventListener('input', () => {
        sendBtn.disabled = !inputEl.value.trim();
        inputEl.style.height = 'auto';
        inputEl.style.height = Math.min(inputEl.scrollHeight, 200) + 'px';
      });

      inputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });

      sendBtn.addEventListener('click', sendMessage);

      // Agent 切换
      document.querySelectorAll('.agent-tab').forEach((el) => {
        el.addEventListener('click', () => {
          document.querySelectorAll('.agent-tab').forEach((e) => e.classList.remove('active'));
          el.classList.add('active');
          currentAgent = (el as HTMLElement).dataset.agent as any;
        });
      });

      // 引用面板折叠
      $('toggle-right')?.addEventListener('click', () => {
        const right = $('chat-right')!;
        right.classList.toggle('hidden');
        ($('toggle-right') as HTMLElement).textContent = right.classList.contains('hidden')
          ? '引用 ▸'
          : '引用 ◂';
      });

      $('close-right')?.addEventListener('click', () => {
        $('chat-right')!.classList.add('hidden');
        ($('toggle-right') as HTMLElement).textContent = '引用 ▸';
      });

      bindSuggestions();
      loadConversations();
      loadModels(); // P2-6: 加载可用模型列表
    </script>

