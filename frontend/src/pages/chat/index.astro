        background: var(--primary-bg);
        color: var(--primary);
        border-radius: var(--radius-xs);
        font-size: var(--text-xs);
        font-weight: 600;
        cursor: pointer;
        vertical-align: super;
        line-height: 1;
        transition: background var(--transition-fast), color var(--transition-fast);
        user-select: none;
      }
      .chat-msg-citation:hover {
        background: var(--primary);
        color: var(--text-white);
      }

      /* === 引用卡片高亮（点击 [N] 时） === */
      .reference-card.reference-highlight {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-bg);
        animation: ref-flash 2s ease;
      }
      @keyframes ref-flash {
        0%, 100% { background: var(--surface); }
        30% { background: var(--primary-bg); }
      }
      .chat-input-area {
        padding: var(--space-4) var(--space-6);
        background: var(--surface);
        border-top: 1px solid var(--border);
      }
      .chat-input-wrapper {
        display: flex;
        gap: var(--space-3);
        align-items: flex-end;
        max-width: 820px;
        margin: 0 auto;
      }
      .chat-input {
        flex: 1;
        padding: var(--space-3) var(--space-4);
        background: var(--surface-muted);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        resize: none;
        max-height: 200px;
        line-height: var(--lh-normal);
      }
      .chat-input-tip {
        text-align: center;
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-top: var(--space-2);
      }
      .chat-right {
        width: 320px;
        background: var(--surface);
        border-left: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: width var(--transition);
      }
      .chat-right.hidden {
        width: 0;
        overflow: hidden;
      }
      .chat-right-header {
        height: 56px;
        padding: 0 var(--space-4);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 600;
      }
      .chat-right-body {
        flex: 1;
        overflow-y: auto;
        padding: var(--space-4);
      }
      .reference-card {
        padding: var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin-bottom: var(--space-3);
      }
      .reference-card-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-2);
      }
      .reference-index {
        font-weight: 600;
        color: var(--primary);
        font-size: var(--text-sm);
      }
      .reference-title {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text);
      }
      .reference-snippet {
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: var(--lh-relaxed);
        margin-bottom: var(--space-2);
      }
      .reference-meta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      .chat-empty-hint {
        text-align: center;
        color: var(--text-muted);
        font-size: var(--text-sm);
        padding: var(--space-8);
      }
      /* 侧边栏统计 */
      .chat-sidebar-stats {
        display: flex;
        gap: var(--space-2);
        padding: 0 var(--space-4) var(--space-3);
      }
      .chat-stat-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        padding: var(--space-2) var(--space-3);
        background: var(--surface-muted);
        border-radius: var(--radius);
      }
      .chat-stat-label {
        font-size: var(--text-xs);
        color: var(--text-muted);
      }
      .chat-stat-value {
        font-size: var(--text-lg);
        font-weight: 600;
        color: var(--primary);
      }
      /* 会话列表错误状态 */
      .chat-list-error {
        text-align: center;
        padding: var(--space-6) var(--space-4);
        color: var(--text-muted);
      }
      .chat-list-error-msg {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--danger);
        margin-bottom: var(--space-1);
      }
      .chat-list-error-detail {
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-bottom: var(--space-3);
        word-break: break-all;
      }
      /* === P0-6: 状态指示器（thinking / retrieve / quality） === */
      .chat-message-status {
        min-height: 0;
        margin-bottom: var(--space-2);
      }
      .chat-message-status:empty {
        display: none;
      }
      .chat-status-item {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-3);
        font-size: var(--text-sm);
        color: var(--text-muted);
        border-radius: var(--radius-sm);
        background: var(--surface-muted);
        animation: status-fade-in 0.2s ease;
      }
      @keyframes status-fade-in {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .chat-status-dot {
        width: 8px;
        height: 8px;
        border-radius: var(--radius-full);
        flex-shrink: 0;
      }
      .chat-status-thinking .chat-status-dot {
        background: var(--info);
        animation: pulse 1.2s infinite ease-in-out;
      }
      .chat-status-retrieve .chat-status-dot {
        background: var(--warning);
        animation: pulse 1.2s infinite ease-in-out;
      }
      .chat-status-retrieve-done .chat-status-dot {
        background: var(--success);
      }
      .chat-status-quality-low {
        background: var(--warning-bg);
        color: var(--warning);
      }
      .chat-status-quality-low .chat-status-dot {
        background: var(--warning);
      }
      .chat-status-quality-ok {
        background: var(--success-bg);
        color: var(--success);
      }
      .chat-status-quality-ok .chat-status-dot {
        background: var(--success);
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.8); }
      }

      /* === P0-7: ToolCallCard 组件 === */
      .chat-message-tools {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        margin-bottom: var(--space-2);
      }
      .chat-message-tools:empty {
        display: none;
      }
      .tool-call-card {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface-muted);
        overflow: hidden;
        font-size: var(--text-sm);
        animation: status-fade-in 0.2s ease;
      }
      .tool-call-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-3);
        background: var(--surface);
        border-bottom: 1px solid var(--border);
      }
      .tool-call-icon {
        font-size: 14px;
      }
      .tool-call-name {
        font-weight: 600;
        color: var(--text);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
      }
      .tool-call-status {
        margin-left: auto;
        padding: 2px 8px;
        border-radius: var(--radius-full);
        font-size: var(--text-xs);
        font-weight: 500;
      }
      .tool-call-status-running {
        background: var(--info-bg);
        color: var(--info);
      }
      .tool-call-status-success {
        background: var(--success-bg);
        color: var(--success);
      }
      .tool-call-status-error {
        background: var(--danger-bg);
        color: var(--danger);
      }
      /* P1-6: 审批相关样式 */
      .tool-call-status-pending {
        background: var(--warning-bg, #fef3c7);
        color: var(--warning, #d97706);
      }
      .tool-call-approval {
        border-color: var(--warning, #d97706);
        border-width: 2px;
      }
      .approval-reason {
        margin: var(--space-2) 0;
        padding: var(--space-2) var(--space-3);
        background: var(--warning-bg, #fef3c7);
        border-radius: var(--radius-md, 6px);
        border-left: 3px solid var(--warning, #d97706);
      }
      .approval-reason-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--warning, #d97706);
        margin-bottom: 4px;
      }
      .approval-reason-text {
        font-size: 13px;
        color: var(--text-secondary, #666);
      }
      .approval-irreversible-badge {
        display: inline-block;
        margin-top: 6px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 600;
        background: var(--danger, #dc2626);
        color: white;
        border-radius: 10px;
      }
      .approval-actions {
        display: flex;
        gap: var(--space-2);
        align-items: center;
        margin-top: var(--space-2);
      }
      .approval-pending {
        font-size: 13px;
        color: var(--text-secondary, #666);
      }
      .approval-done {
        font-size: 13px;
        font-weight: 500;
      }
      .approval-done-approved {
        color: var(--success, #16a34a);
      }
      .approval-done-rejected {
        color: var(--danger, #dc2626);
      }
      .approval-error {
        font-size: 12px;
        color: var(--danger, #dc2626);
      }
      .tool-call-body {
        padding: var(--space-2) var(--space-3);
      }
      .tool-call-section {
        margin-bottom: var(--space-2);
      }
      .tool-call-section:last-child {
        margin-bottom: 0;
      }
      .tool-call-label {
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-bottom: var(--space-1);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .tool-call-args,
      .tool-call-result {
        margin: 0;
        padding: var(--space-2);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: var(--lh-normal);
        color: var(--text-secondary);
        overflow-x: auto;
        max-height: 200px;
        overflow-y: auto;
        white-space: pre-wrap;
        word-break: break-all;
      }

      @media (max-width: 1024px) {
        .chat-right { display: none; }
      }
      @media (max-width: 768px) {
        .chat-sidebar { display: none; }
      }
    </style>
  </body>
</html>
