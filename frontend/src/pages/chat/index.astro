---
/**
 * AI 对话主界面
 * 全屏三列布局：会话历史 + 消息流 + 引用面板
 * 使用 SSE 流式接收 AI 回复（/api/v1/chat/stream）
 * 支持三种 Agent 类型切换（qa/workflow/action）
 */
import '@/styles/global.css';

const appName = import.meta.env.PUBLIC_APP_NAME || '企业知识库';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>AI 对话 · {appName}</title>
  </head>
  <body>
    <div class="chat-app">
      <!-- 左侧：会话历史 -->
      <aside class="chat-sidebar" id="chat-sidebar">
        <div class="chat-sidebar-header">
          <button class="btn btn-primary btn-block" id="new-chat-btn">
            <span>＋</span> 新建对话
          </button>
        </div>
        <div class="chat-sidebar-search">
          <input type="text" class="form-input" id="conv-search" placeholder="搜索对话..." />
        </div>
        <div class="chat-conversation-list" id="conversation-list">
          <div class="chat-empty-hint">暂无对话，点击「新建对话」开始</div>
        </div>
      </aside>

      <!-- 中间：消息流 + 输入栏 -->
      <main class="chat-main">
        <header class="chat-main-header">
          <div class="chat-agent-switcher">
            <button class="agent-tab active" data-agent="qa">问答 Agent</button>
            <button class="agent-tab" data-agent="workflow">工作流 Agent</button>
            <button class="agent-tab" data-agent="action">动作 Agent</button>
          </div>
          <button class="btn btn-ghost btn-sm" id="toggle-right">引用 ▸</button>
        </header>

        <div class="chat-messages" id="chat-messages">
          <div class="chat-welcome">
            <div class="chat-welcome-icon">💬</div>
            <h2>AI 智能对话</h2>
            <p>基于 Agentic RAG 的智能问答，支持流式输出和引用溯源</p>
            <div class="chat-suggestions">
              <button class="chat-suggestion-item" data-q="公司报销流程是什么？">公司报销流程是什么？</button>
              <button class="chat-suggestion-item" data-q="年假有多少天？">年假有多少天？</button>
              <button class="chat-suggestion-item" data-q="新人入职需要准备什么材料？">新人入职需要准备什么材料？</button>
            </div>
          </div>
        </div>

        <footer class="chat-input-area">
          <div class="chat-input-wrapper">
            <textarea
              id="chat-input"
              class="chat-input"
              placeholder="输入您的问题，按 Enter 发送，Shift+Enter 换行"
              rows="1"
            ></textarea>
            <button class="btn btn-primary" id="send-btn" disabled>发送</button>
          </div>
          <div class="chat-input-tip">AI 回复基于知识库内容，可能存在偏差，请核实重要信息</div>
        </footer>
      </main>

      <!-- 右侧：引用面板 -->
      <aside class="chat-right" id="chat-right">
        <div class="chat-right-header">
          <span>引用来源</span>
          <button class="btn btn-ghost btn-sm" id="close-right">✕</button>
        </div>
        <div class="chat-right-body" id="references-list">
          <div class="chat-empty-hint">回复生成后将显示引用来源</div>
        </div>
      </aside>
    </div>

    <script>
      const API_BASE = import.meta.env.PUBLIC_API_BASE || 'http://localhost:8000';
      const TOKEN_KEY = 'ekb_access_token';

      // 对话状态
      let conversations: Array<{ id: string; title: string; messages: any[] }> = [];
      let currentConvId: string | null = null;
      let currentAgent: 'qa' | 'workflow' | 'action' = 'qa';
      let isStreaming = false;

      const $ = (id: string) => document.getElementById(id);
      const convListEl = $('conversation-list')!;
      const messagesEl = $('chat-messages')!;
      const inputEl = $('chat-input') as HTMLTextAreaElement;
      const sendBtn = $('send-btn') as HTMLButtonElement;
      const refListEl = $('references-list')!;

      // 加载会话列表
      async function loadConversations() {
        const token = localStorage.getItem(TOKEN_KEY);
        if (!token) {
          window.location.href = '/auth/login';
          return;
        }
        try {
          const res = await fetch(`${API_BASE}/api/v1/chat/conversations`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          if (res.ok) {
            const result = await res.json();
            conversations = result.data?.items || result.data || [];
            renderConversationList();
          } else if (res.status === 401) {
            window.location.href = '/auth/login';
          }
        } catch {
          conversations = mockConversations();
          renderConversationList();
        }
      }

      function mockConversations() {
        return [
          { id: 'mock-1', title: '公司报销流程', messages: [] },
          { id: 'mock-2', title: '年假政策咨询', messages: [] },
        ];
      }

      function renderConversationList() {
        const keyword = ($('conv-search') as HTMLInputElement)?.value?.trim() || '';
        const list = keyword
          ? conversations.filter((c) => c.title.includes(keyword))
          : conversations;

        if (list.length === 0) {
          convListEl.innerHTML = '<div class="chat-empty-hint">暂无对话</div>';
          return;
        }

        convListEl.innerHTML = list
          .map(
            (c) => `
          <div class="chat-conv-item ${c.id === currentConvId ? 'active' : ''}" data-id="${c.id}">
            <span class="chat-conv-icon">💬</span>
            <span class="chat-conv-title">${escapeHtml(c.title)}</span>
          </div>`
          )
          .join('');

        convListEl.querySelectorAll('.chat-conv-item').forEach((el) => {
          el.addEventListener('click', () => {
            const id = (el as HTMLElement).dataset.id!;
            selectConversation(id);
          });
        });
      }

      function selectConversation(id: string) {
        currentConvId = id;
        const conv = conversations.find((c) => c.id === id);
        renderConversationList();
        messagesEl.innerHTML = '';
        if (conv && conv.messages.length > 0) {
          conv.messages.forEach((m) => renderMessage(m.role, m.content));
        } else {
          renderWelcome();
        }
      }

      function renderWelcome() {
        messagesEl.innerHTML = `
          <div class="chat-welcome">
            <div class="chat-welcome-icon">💬</div>
            <h2>AI 智能对话</h2>
            <p>基于 Agentic RAG 的智能问答，支持流式输出和引用溯源</p>
            <div class="chat-suggestions">
              <button class="chat-suggestion-item" data-q="公司报销流程是什么？">公司报销流程是什么？</button>
              <button class="chat-suggestion-item" data-q="年假有多少天？">年假有多少天？</button>
              <button class="chat-suggestion-item" data-q="新人入职需要准备什么材料？">新人入职需要准备什么材料？</button>
            </div>
          </div>`;
        bindSuggestions();
      }

      function renderMessage(role: string, content: string, streaming = false) {
        const welcome = messagesEl.querySelector('.chat-welcome');
        if (welcome) welcome.remove();

        const msgEl = document.createElement('div');
        msgEl.className = `chat-message ${role}`;
        msgEl.innerHTML = `
          <div class="chat-message-avatar">${role === 'user' ? '我' : 'AI'}</div>
          <div class="chat-message-body">
            <div class="chat-message-content">${escapeHtml(content)}${streaming ? '<span class="chat-cursor"></span>' : ''}</div>
          </div>`;
        messagesEl.appendChild(msgEl);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return msgEl;
      }

      function bindSuggestions() {
        messagesEl.querySelectorAll('.chat-suggestion-item').forEach((el) => {
          el.addEventListener('click', () => {
            const q = (el as HTMLElement).dataset.q!;
            inputEl.value = q;
            inputEl.dispatchEvent(new Event('input'));
            sendMessage();
          });
        });
      }

      // 发送消息（SSE 流式）
      async function sendMessage() {
        const query = inputEl.value.trim();
        if (!query || isStreaming) return;

        const token = localStorage.getItem(TOKEN_KEY);
        if (!token) {
          window.location.href = '/auth/login';
          return;
        }

        // 创建新会话
        if (!currentConvId) {
          currentConvId = 'conv-' + Date.now();
          conversations.unshift({
            id: currentConvId,
            title: query.slice(0, 20),
            messages: [],
          });
          renderConversationList();
        }

        // 渲染用户消息
        renderMessage('user', query);
        const conv = conversations.find((c) => c.id === currentConvId);
        conv?.messages.push({ role: 'user', content: query });

        inputEl.value = '';
        inputEl.style.height = 'auto';
        sendBtn.disabled = true;
        isStreaming = true;

        // 渲染 AI 占位消息
        const aiEl = renderMessage('assistant', '', true);
        const contentEl = aiEl.querySelector('.chat-message-content')!;
        let fullText = '';

        try {
          const res = await fetch(`${API_BASE}/api/v1/chat/stream`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'text/event-stream',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              query,
              conversation_id: currentConvId,
              agent_type: currentAgent,
            }),
          });

          if (!res.ok || !res.body) {
            throw new Error('流式连接失败');
          }

          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          const sources: any[] = [];

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop() || '';

            let evtType = '';
            let evtData = '';

            for (const line of lines) {
              const trimmed = line.trim();
              if (trimmed === '') {
                if (evtData) {
                  handleSSEEvent(evtType, evtData, contentEl, sources);
                  evtType = '';
                  evtData = '';
                }
                continue;
              }
              if (trimmed.startsWith('event:')) {
                evtType = trimmed.slice(6).trim();
              } else if (trimmed.startsWith('data:')) {
                const d = trimmed.slice(5).trim();
                evtData = evtData ? `${evtData}\n${d}` : d;
              }
            }
          }

          // 处理最后的数据
          if (buffer.trim().startsWith('data:')) {
            handleSSEEvent('', buffer.trim().slice(5).trim(), contentEl, sources);
          }

          fullText = contentEl.textContent || '';
          conv?.messages.push({ role: 'assistant', content: fullText });
        } catch (err) {
          contentEl.innerHTML =
            '<span class="text-danger">连接异常：' +
            escapeHtml(err instanceof Error ? err.message : String(err)) +
            '</span>';
        } finally {
          const cursor = aiEl.querySelector('.chat-cursor');
          cursor?.remove();
          isStreaming = false;
          sendBtn.disabled = false;
        }
      }

      function handleSSEEvent(
        type: string,
        data: string,
        contentEl: Element,
        sources: any[]
      ) {
        let parsed: any = data;
        try {
          parsed = JSON.parse(data);
        } catch {
          // 纯文本
        }

        const evtType = type || parsed?.type || 'message';

        if (evtType === 'token' || evtType === 'chunk') {
          const text = parsed?.text || String(parsed);
          contentEl.appendChild(document.createTextNode(text));
          messagesEl.scrollTop = messagesEl.scrollHeight;
        } else if (evtType === 'sources') {
          const list = Array.isArray(parsed) ? parsed : parsed?.sources || [];
          sources.push(...list);
          renderReferences(list);
        } else if (evtType === 'error') {
          contentEl.appendChild(
            document.createTextNode('[错误] ' + (parsed?.message || '未知错误'))
          );
        }
      }

      function renderReferences(sources: any[]) {
        if (!sources || sources.length === 0) return;
        refListEl.innerHTML = sources
          .map(
            (s, i) => `
          <div class="reference-card">
            <div class="reference-card-header">
              <span class="reference-index">[${i + 1}]</span>
              <span class="reference-title">${escapeHtml(s.title || s.doc_title || '未知文档')}</span>
            </div>
            <p class="reference-snippet">${escapeHtml(s.snippet || s.content || '')}</p>
            <div class="reference-meta">
              <span class="badge badge-primary">${escapeHtml(s.score ? (s.score * 100).toFixed(0) + '%' : '匹配')}</span>
              ${s.kb_name ? `<span class="text-muted">${escapeHtml(s.kb_name)}</span>` : ''}
            </div>
          </div>`
          )
          .join('');
      }

      function escapeHtml(s: string): string {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      // 事件绑定
      $('new-chat-btn')?.addEventListener('click', () => {
        currentConvId = null;
        renderConversationList();
        renderWelcome();
        inputEl.focus();
      });

      $('conv-search')?.addEventListener('input', renderConversationList);

      inputEl.addEventListener('input', () => {
        sendBtn.disabled = !inputEl.value.trim();
        inputEl.style.height = 'auto';
        inputEl.style.height = Math.min(inputEl.scrollHeight, 200) + 'px';
      });

      inputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });

      sendBtn.addEventListener('click', sendMessage);

      // Agent 切换
      document.querySelectorAll('.agent-tab').forEach((el) => {
        el.addEventListener('click', () => {
          document.querySelectorAll('.agent-tab').forEach((e) => e.classList.remove('active'));
          el.classList.add('active');
          currentAgent = (el as HTMLElement).dataset.agent as any;
        });
      });

      // 引用面板折叠
      $('toggle-right')?.addEventListener('click', () => {
        const right = $('chat-right')!;
        right.classList.toggle('hidden');
        ($('toggle-right') as HTMLElement).textContent = right.classList.contains('hidden')
          ? '引用 ▸'
          : '引用 ◂';
      });

      $('close-right')?.addEventListener('click', () => {
        $('chat-right')!.classList.add('hidden');
        ($('toggle-right') as HTMLElement).textContent = '引用 ▸';
      });

      bindSuggestions();
      loadConversations();
    </script>

    <style>
      .chat-app {
        display: flex;
        height: 100vh;
        background: var(--bg);
        overflow: hidden;
      }
      .chat-sidebar {
        width: 280px;
        background: var(--surface);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
      }
      .chat-sidebar-header {
        padding: var(--space-4);
      }
      .chat-sidebar-search {
        padding: 0 var(--space-4) var(--space-3);
      }
      .chat-conversation-list {
        flex: 1;
        overflow-y: auto;
        padding: 0 var(--space-2);
      }
      .chat-conv-item {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-3);
        border-radius: var(--radius);
        cursor: pointer;
        color: var(--text-secondary);
        transition: all var(--transition-fast);
      }
      .chat-conv-item:hover {
        background: var(--surface-hover);
      }
      .chat-conv-item.active {
        background: var(--primary-bg);
        color: var(--primary);
      }
      .chat-conv-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: var(--text-sm);
      }
      .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .chat-main-header {
        height: 56px;
        padding: 0 var(--space-5);
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .chat-agent-switcher {
        display: flex;
        gap: var(--space-1);
        background: var(--surface-muted);
        padding: var(--space-1);
        border-radius: var(--radius);
      }
      .agent-tab {
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
        font-size: var(--text-sm);
        color: var(--text-muted);
        transition: all var(--transition-fast);
      }
      .agent-tab.active {
        background: var(--surface);
        color: var(--primary);
        box-shadow: var(--shadow-xs);
        font-weight: 500;
      }
      .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: var(--space-6);
      }
      .chat-welcome {
        text-align: center;
        padding-top: 10vh;
      }
      .chat-welcome-icon {
        font-size: 48px;
        margin-bottom: var(--space-4);
      }
      .chat-welcome h2 {
        font-size: var(--text-2xl);
        margin-bottom: var(--space-2);
      }
      .chat-welcome p {
        color: var(--text-muted);
        margin-bottom: var(--space-6);
      }
      .chat-suggestions {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        max-width: 480px;
        margin: 0 auto;
      }
      .chat-suggestion-item {
        padding: var(--space-4);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        text-align: left;
        color: var(--text-secondary);
        transition: all var(--transition-fast);
      }
      .chat-suggestion-item:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-bg);
      }
      .chat-message {
        display: flex;
        gap: var(--space-3);
        margin-bottom: var(--space-5);
        max-width: 820px;
        margin-left: auto;
        margin-right: auto;
      }
      .chat-message.user {
        flex-direction: row-reverse;
      }
      .chat-message-avatar {
        width: 36px;
        height: 36px;
        border-radius: var(--radius-full);
        background: var(--primary);
        color: var(--text-white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-sm);
        font-weight: 600;
        flex-shrink: 0;
      }
      .chat-message.user .chat-message-avatar {
        background: var(--success);
      }
      .chat-message-body {
        flex: 1;
        min-width: 0;
      }
      .chat-message-content {
        padding: var(--space-4);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        font-size: var(--text-base);
        line-height: var(--lh-relaxed);
        word-break: break-word;
        white-space: pre-wrap;
      }
      .chat-message.user .chat-message-content {
        background: var(--primary);
        color: var(--text-white);
        border-color: var(--primary);
      }
      .chat-cursor {
        display: inline-block;
        width: 8px;
        height: 16px;
        background: var(--primary);
        animation: blink 1s infinite;
        vertical-align: middle;
      }
      @keyframes blink {
        50% { opacity: 0; }
      }
      .chat-input-area {
        padding: var(--space-4) var(--space-6);
        background: var(--surface);
        border-top: 1px solid var(--border);
      }
      .chat-input-wrapper {
        display: flex;
        gap: var(--space-3);
        align-items: flex-end;
        max-width: 820px;
        margin: 0 auto;
      }
      .chat-input {
        flex: 1;
        padding: var(--space-3) var(--space-4);
        background: var(--surface-muted);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        resize: none;
        max-height: 200px;
        line-height: var(--lh-normal);
      }
      .chat-input-tip {
        text-align: center;
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin-top: var(--space-2);
      }
      .chat-right {
        width: 320px;
        background: var(--surface);
        border-left: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: width var(--transition);
      }
      .chat-right.hidden {
        width: 0;
        overflow: hidden;
      }
      .chat-right-header {
        height: 56px;
        padding: 0 var(--space-4);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 600;
      }
      .chat-right-body {
        flex: 1;
        overflow-y: auto;
        padding: var(--space-4);
      }
      .reference-card {
        padding: var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin-bottom: var(--space-3);
      }
      .reference-card-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-2);
      }
      .reference-index {
        font-weight: 600;
        color: var(--primary);
        font-size: var(--text-sm);
      }
      .reference-title {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text);
      }
      .reference-snippet {
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: var(--lh-relaxed);
        margin-bottom: var(--space-2);
      }
      .reference-meta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      .chat-empty-hint {
        text-align: center;
        color: var(--text-muted);
        font-size: var(--text-sm);
        padding: var(--space-8);
      }
      @media (max-width: 1024px) {
        .chat-right { display: none; }
      }
      @media (max-width: 768px) {
        .chat-sidebar { display: none; }
      }
    </style>
  </body>
</html>
