---
/**
 * Agent 管理页面
 * 左侧 Agent 列表 + 右侧对话区，通过 SSE 流式调用 Agent invoke 接口
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [
  { label: 'AI 能力', href: '/chat' },
  { label: 'Agent 管理' },
];
---

<DefaultLayout title="Agent 管理" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">Agent 管理</h1>
    <button class="btn btn-primary" id="create-agent-btn">＋ 创建自定义 Agent</button>
  </div>

  <div class="agent-workspace">
    <!-- 左侧：Agent 列表 -->
    <aside class="agent-list-panel">
      <div class="agent-list-header">
        <input
          type="text"
          class="form-input agent-search"
          id="agent-search"
          placeholder="搜索 Agent..."
        />
      </div>
      <div class="agent-list" id="agent-list">
        <div class="agent-list-hint">加载中...</div>
      </div>
    </aside>

    <!-- 右侧：对话区 -->
    <section class="agent-chat-panel">
      <header class="agent-chat-header" id="agent-detail">
        <div class="agent-chat-header-empty">请从左侧选择一个 Agent 开始对话</div>
      </header>

      <div class="agent-messages" id="agent-messages">
        <div class="agent-chat-welcome">
          <div class="agent-chat-welcome-icon">🤖</div>
          <h2>选择一个 Agent</h2>
          <p>从左侧列表选择一个 Agent，输入问题即可开始流式对话</p>
        </div>
      </div>

      <footer class="agent-input-area">
        <div class="agent-input-wrapper">
          <textarea
            id="agent-input"
            class="agent-input"
            placeholder="输入您的问题，按 Enter 发送，Shift+Enter 换行"
            rows="1"
            disabled
          ></textarea>
          <button class="btn btn-primary" id="send-btn" disabled>发送</button>
        </div>
        <div class="agent-input-tip">AI 回复基于 Agent 能力生成，可能存在偏差，请核实重要信息</div>
      </footer>
    </section>
  </div>

  <!-- 创建 Agent 弹窗 -->
  <div class="modal-overlay" id="create-modal" style="display: none;">
    <div class="modal" style="max-width: 560px;">
      <div class="modal-header">
        <h3>创建自定义 Agent</h3>
        <button class="btn btn-ghost btn-sm" id="close-modal">✕</button>
      </div>
      <form id="agent-form">
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label">Agent 名称</label>
            <input type="text" class="form-input" name="name" placeholder="如：合同审查助手" required />
          </div>
          <div class="form-group">
            <label class="form-label">Agent 类型</label>
            <select class="form-input" name="type">
              <option value="qa">问答 Agent</option>
              <option value="workflow">工作流 Agent</option>
              <option value="action">动作 Agent</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Agent 描述</label>
            <textarea class="form-textarea" name="description" placeholder="描述这个 Agent 的用途和能力"></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">系统提示词（Prompt）</label>
            <textarea class="form-textarea" name="system_prompt" placeholder="你是一个...的助手，你的任务是..." style="min-height: 120px;"></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">温度参数</label>
            <input type="range" min="0" max="1" step="0.1" value="0.7" name="temperature" id="temp-range" style="width: 100%;" />
            <span id="temp-value" class="text-muted">0.7</span>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="cancel-btn">取消</button>
          <button type="submit" class="btn btn-primary">创建</button>
        </div>
      </form>
    </div>
  </div>
</DefaultLayout>

<style>
  /* === 工作区两列布局 === */
  .agent-workspace {
    display: flex;
    gap: var(--space-5);
    height: calc(100vh - 180px);
    min-height: 460px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* === 左侧 Agent 列表 === */
  .agent-list-panel {
    width: 300px;
    flex-shrink: 0;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    background: var(--surface-muted);
  }
  .agent-list-header {
    padding: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .agent-search {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }
  .agent-list {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-2);
  }
  .agent-list-hint {
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
    padding: var(--space-8) var(--space-3);
  }
  .agent-item {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background var(--transition-fast);
  }
  .agent-item:hover {
    background: var(--surface-hover);
  }
  .agent-item.active {
    background: var(--primary-bg);
  }
  .agent-item-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }
  .agent-item.active .agent-item-icon {
    background: var(--primary);
    border-color: var(--primary);
  }
  .agent-item-body {
    flex: 1;
    min-width: 0;
  }
  .agent-item-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .agent-item-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--lh-normal);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* === 右侧对话区 === */
  .agent-chat-panel {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--surface);
  }
  .agent-chat-header {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
  }
  .agent-chat-header-empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .agent-detail-info {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    min-width: 0;
    flex: 1;
  }
  .agent-detail-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--primary-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
  }
  .agent-detail-text {
    min-width: 0;
    flex: 1;
  }
  .agent-detail-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-1);
  }
  .agent-detail-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--lh-normal);
    margin-bottom: var(--space-2);
  }
  .agent-detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  /* === 消息流 === */
  .agent-messages {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-5);
  }
  .agent-chat-welcome {
    text-align: center;
    padding-top: 12vh;
    color: var(--text-muted);
  }
  .agent-chat-welcome-icon {
    font-size: 48px;
    margin-bottom: var(--space-4);
  }
  .agent-chat-welcome h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
    color: var(--text);
  }
  .agent-chat-welcome p {
    font-size: var(--text-sm);
  }

  .agent-message {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }
  .agent-message.user {
    flex-direction: row-reverse;
  }
  .agent-message-avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: var(--text-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    font-weight: 600;
    flex-shrink: 0;
  }
  .agent-message.user .agent-message-avatar {
    background: var(--success);
  }
  .agent-message-body {
    flex: 1;
    min-width: 0;
  }
  .agent-message-content {
    display: inline-block;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    word-break: break-word;
    white-space: pre-wrap;
    max-width: 100%;
  }
  .agent-message.user .agent-message-content {
    background: var(--primary);
    color: var(--text-white);
    border-color: var(--primary);
  }

  /* 打字指示器 */
  .agent-typing {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    vertical-align: middle;
    padding: 2px 0;
  }
  .agent-typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-muted);
    animation: agent-typing-bounce 1.2s infinite ease-in-out;
  }
  .agent-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .agent-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes agent-typing-bounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  /* === 输入区 === */
  .agent-input-area {
    padding: var(--space-3) var(--space-5) var(--space-4);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .agent-input-wrapper {
    display: flex;
    gap: var(--space-3);
    align-items: flex-end;
    max-width: 820px;
    margin: 0 auto;
  }
  .agent-input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    resize: none;
    max-height: 200px;
    line-height: var(--lh-normal);
    font-family: inherit;
    font-size: var(--text-base);
    color: var(--text);
  }
  .agent-input:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }
  .agent-input-tip {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  /* === 弹窗 === */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  .modal {
    background: var(--surface);
    border-radius: var(--radius-lg);
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-xl);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .modal-body {
    padding: var(--space-5);
  }
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-5);
    border-top: 1px solid var(--border);
  }

  /* === 响应式 === */
  @media (max-width: 768px) {
    .agent-workspace {
      flex-direction: column;
      height: auto;
      min-height: 600px;
    }
    .agent-list-panel {
      width: 100%;
      max-height: 240px;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
  }
</style>

<script>
  import { getAgents, getAgent, invokeAgent, createAgent } from '@/lib/apis/agents';
  import type { Agent } from '@/lib/apis/agents';

  // ===== 类型映射：后端 type → 展示文案与图标 =====
  const AGENT_TYPE_META: Record<string, { label: string; icon: string }> = {
    qa: { label: '问答', icon: '💬' },
    workflow: { label: '工作流', icon: '🔄' },
    action: { label: '动作', icon: '⚡' },
  };

  function getTypeMeta(type: string): { label: string; icon: string } {
    return AGENT_TYPE_META[type] || { label: '自定义', icon: '🤖' };
  }

  /** HTML 转义，防止 XSS */
  function escapeHtml(s: string): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  /** 从 Agent 配置中提取能力标签 */
  function getCapabilityTags(agent: Agent): string[] {
    const tags: string[] = [getTypeMeta(agent.type).label];
    const cfg = (agent.config || {}) as Record<string, unknown>;
    const raw = cfg.capabilities ?? cfg.tags ?? cfg.tools;
    if (Array.isArray(raw)) {
      for (const item of raw) {
        if (typeof item === 'string') {
          tags.push(item);
        } else if (item && typeof item === 'object' && 'name' in item) {
          tags.push(String((item as Record<string, unknown>).name));
        }
      }
    }
    return Array.from(new Set(tags));
  }

  // ===== DOM 引用 =====
  const $ = (id: string) => document.getElementById(id);
  const listEl = $('agent-list') as HTMLElement;
  const detailEl = $('agent-detail') as HTMLElement;
  const messagesEl = $('agent-messages') as HTMLElement;
  const inputEl = $('agent-input') as HTMLTextAreaElement;
  const sendBtn = $('send-btn') as HTMLButtonElement;
  const searchEl = $('agent-search') as HTMLInputElement;

  // ===== 运行时状态 =====
  let allAgents: Agent[] = [];
  let currentAgent: Agent | null = null;
  let isStreaming = false;

  // ===== 会话管理：同一 Agent 的连续对话共用一个 sessionId =====
  function sessionKey(agentId: string): string {
    return `ekb_agent_session_${agentId}`;
  }

  function getOrCreateSessionId(agentId: string): string {
    const key = sessionKey(agentId);
    let sid = sessionStorage.getItem(key);
    if (!sid) {
      sid = crypto.randomUUID();
      sessionStorage.setItem(key, sid);
    }
    return sid;
  }

  // ===== 加载 Agent 列表 =====
  async function loadAgents(): Promise<void> {
    listEl.innerHTML = '<div class="agent-list-hint">加载中...</div>';
    try {
      // 后端实际返回 { agents: Agent[] }，agents.ts 类型声明为 Agent[]，此处兼容两种结构
      const result = (await getAgents()) as unknown as Agent[] | { agents: Agent[] };
      allAgents = Array.isArray(result) ? result : result.agents;
      renderAgentList();
    } catch (err) {
      listEl.innerHTML = '<div class="agent-list-hint">加载失败</div>';
      alert(err instanceof Error ? err.message : 'Agent 列表加载失败');
    }
  }

  function renderAgentList(): void {
    const keyword = searchEl.value.trim().toLowerCase();
    const list = keyword
      ? allAgents.filter((a) =>
          `${a.name} ${a.description || ''} ${a.type}`.toLowerCase().includes(keyword)
        )
      : allAgents;

    if (list.length === 0) {
      listEl.innerHTML = '<div class="agent-list-hint">暂无可用 Agent</div>';
      return;
    }

    listEl.innerHTML = list
      .map((a) => {
        const meta = getTypeMeta(a.type);
        const active = currentAgent?.id === a.id ? ' active' : '';
        const desc = a.description || `${meta.label} Agent`;
        return `
          <div class="agent-item${active}" data-id="${escapeHtml(a.id)}">
            <div class="agent-item-icon">${meta.icon}</div>
            <div class="agent-item-body">
              <div class="agent-item-title">${escapeHtml(a.name)}</div>
              <div class="agent-item-desc">${escapeHtml(desc)}</div>
            </div>
          </div>`;
      })
      .join('');

    listEl.querySelectorAll('.agent-item').forEach((el) => {
      el.addEventListener('click', () => {
        const id = (el as HTMLElement).dataset.id;
        if (id) void selectAgent(id);
      });
    });
  }

  // ===== 选中 Agent：拉取详情并渲染右侧 =====
  async function selectAgent(id: string): Promise<void> {
    if (isStreaming) {
      alert('当前对话正在生成，请稍候');
      return;
    }
    try {
      const agent = await getAgent(id);
      currentAgent = agent;
      renderAgentList();
      renderDetail(agent);
      renderWelcome(agent);
      inputEl.disabled = false;
      sendBtn.disabled = true;
      inputEl.focus();
    } catch (err) {
      alert(err instanceof Error ? err.message : 'Agent 详情加载失败');
    }
  }

  function renderDetail(agent: Agent): void {
    const meta = getTypeMeta(agent.type);
    const tags = getCapabilityTags(agent);
    detailEl.innerHTML = `
      <div class="agent-detail-info">
        <div class="agent-detail-icon">${meta.icon}</div>
        <div class="agent-detail-text">
          <div class="agent-detail-title">${escapeHtml(agent.name)}</div>
          <div class="agent-detail-desc">${escapeHtml(agent.description || '暂无描述')}</div>
          <div class="agent-detail-tags">
            ${tags.map((t) => `<span class="badge badge-primary">${escapeHtml(t)}</span>`).join('')}
          </div>
        </div>
      </div>
      <button class="btn btn-ghost btn-sm" id="clear-session-btn" title="清空当前 Agent 的对话会话">清空对话</button>`;
    $('clear-session-btn')?.addEventListener('click', clearConversation);
  }

  function renderWelcome(agent: Agent): void {
    const meta = getTypeMeta(agent.type);
    messagesEl.innerHTML = `
      <div class="agent-chat-welcome">
        <div class="agent-chat-welcome-icon">${meta.icon}</div>
        <h2>${escapeHtml(agent.name)}</h2>
        <p>${escapeHtml(agent.description || '开始与该 Agent 对话，输入问题即可获得流式回复')}</p>
      </div>`;
  }

  // ===== 消息渲染 =====
  function appendMessage(
    role: 'user' | 'assistant',
    content: string,
    streaming = false
  ): HTMLElement {
    const welcome = messagesEl.querySelector('.agent-chat-welcome');
    if (welcome) welcome.remove();

    const msg = document.createElement('div');
    msg.className = `agent-message ${role}`;
    const avatar = role === 'user' ? '我' : 'AI';
    const inner = streaming
      ? '<span class="agent-typing"><span></span><span></span><span></span></span>'
      : escapeHtml(content);
    msg.innerHTML = `
      <div class="agent-message-avatar">${avatar}</div>
      <div class="agent-message-body">
        <div class="agent-message-content">${inner}</div>
      </div>`;
    messagesEl.appendChild(msg);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return msg;
  }

  /** 追加一个流式 token 到 assistant 气泡 */
  function appendAssistantChunk(msgEl: HTMLElement, chunk: string): void {
    const content = msgEl.querySelector('.agent-message-content') as HTMLElement;
    const typing = content.querySelector('.agent-typing');
    if (typing) typing.remove();
    content.appendChild(document.createTextNode(chunk));
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  /** 整体替换 assistant 气泡内容（用于错误/空回复） */
  function setAssistantContent(msgEl: HTMLElement, text: string): void {
    const content = msgEl.querySelector('.agent-message-content') as HTMLElement;
    content.textContent = text;
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  /** 移除打字指示器 */
  function removeTyping(msgEl: HTMLElement): void {
    msgEl.querySelector('.agent-typing')?.remove();
  }

  // ===== 发送消息（SSE 流式调用 Agent invoke）=====
  async function sendMessage(): Promise<void> {
    const query = inputEl.value.trim();
    if (!query || isStreaming) return;

    const agent = currentAgent;
    if (!agent) {
      alert('请先选择一个 Agent');
      return;
    }

    // 渲染用户消息气泡
    appendMessage('user', query);

    // 清空输入框
    inputEl.value = '';
    inputEl.style.height = 'auto';
    sendBtn.disabled = true;
    isStreaming = true;

    // 创建空的 assistant 气泡并显示打字指示器
    const aiEl = appendMessage('assistant', '', true);
    const sessionId = getOrCreateSessionId(agent.id);
    let received = '';

    try {
      // 逐 token 追加到 assistant 气泡
      for await (const chunk of invokeAgent(agent.id, { query, session_id: sessionId })) {
        if (typeof chunk === 'string' && chunk) {
          received += chunk;
          appendAssistantChunk(aiEl, chunk);
        }
      }
      // 流正常结束：移除打字指示器，标记完成
      removeTyping(aiEl);
      if (!received) {
        setAssistantContent(aiEl, '（未收到回复内容）');
      }
    } catch (err) {
      // chunk.type === 'error' 等价：异常分支显示错误提示
      removeTyping(aiEl);
      const errMsg = err instanceof Error ? err.message : String(err);
      setAssistantContent(aiEl, `调用失败：${errMsg}`);
      alert(`Agent 调用失败：${errMsg}`);
    } finally {
      isStreaming = false;
      sendBtn.disabled = inputEl.value.trim() === '';
      inputEl.focus();
    }
  }

  // ===== 清空对话：移除 sessionId 后重新加载页面 =====
  function clearConversation(): void {
    const agent = currentAgent;
    if (!agent) return;
    if (!confirm('确定清空当前 Agent 的对话会话吗？将重新开始新的会话。')) return;
    sessionStorage.removeItem(sessionKey(agent.id));
    window.location.reload();
  }

  // ===== 创建 Agent 弹窗 =====
  const modal = $('create-modal') as HTMLElement;

  $('create-agent-btn')?.addEventListener('click', () => {
    modal.style.display = 'flex';
  });
  $('close-modal')?.addEventListener('click', () => (modal.style.display = 'none'));
  $('cancel-btn')?.addEventListener('click', () => (modal.style.display = 'none'));
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.style.display = 'none';
  });

  // 温度滑块实时回显
  const tempRange = $('temp-range') as HTMLInputElement | null;
  tempRange?.addEventListener('input', () => {
    $('temp-value')!.textContent = tempRange.value;
  });

  // 提交创建：使用 agents.ts 提供的 createAgent
  $('agent-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    try {
      await createAgent({
        name: data.name,
        type: data.type || 'qa',
        description: data.description || undefined,
        config: {
          system_prompt: data.system_prompt || '',
          temperature: parseFloat(data.temperature || '0.7'),
        },
      });
      alert('Agent 创建成功');
      modal.style.display = 'none';
      form.reset();
      if (tempRange) $('temp-value')!.textContent = tempRange.value;
      void loadAgents();
    } catch (err) {
      alert(err instanceof Error ? err.message : 'Agent 创建失败');
    }
  });

  // ===== 输入交互 =====
  searchEl.addEventListener('input', renderAgentList);

  inputEl.addEventListener('input', () => {
    sendBtn.disabled = !inputEl.value.trim() || isStreaming;
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 200) + 'px';
  });

  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      void sendMessage();
    }
  });

  sendBtn.addEventListener('click', () => void sendMessage());

  // ===== 初始化：渲染 Agent 列表 =====
  void loadAgents();
</script>
