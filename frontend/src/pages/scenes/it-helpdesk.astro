---
/**
 * IT 工单场景
 * 工单列表 + 创建工单 + AI 自动分类和解答 + 工单状态跟踪
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '场景应用', href: '/scenes/it-helpdesk' }, { label: 'IT 工单' }];
---

<DefaultLayout title="IT 工单" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">IT 工单系统</h1>
    <div style="display: flex; gap: var(--space-3);">
      <a href="/chat?agent=it-helpdesk" class="btn btn-outline btn-sm">🤖 AI 智能解答</a>
      <button class="btn btn-primary btn-sm" id="create-ticket-btn">＋ 提交工单</button>
    </div>
  </div>

  <!-- 统计 -->
  <div class="grid grid-cols-4" style="margin-bottom: var(--space-5);">
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">待处理</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--warning);" id="stat-open">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">处理中</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--primary);" id="stat-progress">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">已解决</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--success);" id="stat-resolved">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">AI 解决率</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--info);" id="stat-ai">--</div>
    </div>
  </div>

  <!-- 工单列表 -->
  <div class="card">
    <div class="card-header">
      <h3>工单列表</h3>
      <div style="display: flex; gap: var(--space-2);">
        <select class="form-input" id="ticket-status" style="width: 120px; font-size: var(--text-sm);">
          <option value="">全部状态</option>
          <option value="open">待处理</option>
          <option value="progress">处理中</option>
          <option value="resolved">已解决</option>
        </select>
        <select class="form-input" id="ticket-category" style="width: 140px; font-size: var(--text-sm);">
          <option value="">全部分类</option>
          <option value="hardware">硬件设备</option>
          <option value="software">软件应用</option>
          <option value="network">网络问题</option>
          <option value="account">账号权限</option>
        </select>
      </div>
    </div>
    <div style="overflow-x: auto;">
      <table class="data-table">
        <thead>
          <tr>
            <th>工单号</th>
            <th>标题</th>
            <th>分类</th>
            <th>优先级</th>
            <th>状态</th>
            <th>提交时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="ticket-list">
          <tr><td colspan="7" class="loading-state">加载中...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 创建工单弹窗 -->
  <div class="modal-overlay" id="create-modal" style="display: none;">
    <div class="modal" style="max-width: 560px;">
      <div class="modal-header">
        <h3>提交 IT 工单</h3>
        <button class="btn btn-ghost btn-sm" id="close-modal">✕</button>
      </div>
      <form id="ticket-form">
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label">问题标题 *</label>
            <input type="text" class="form-input" name="title" required placeholder="简要描述您的问题" />
          </div>
          <div class="form-group">
            <label class="form-label">问题分类</label>
            <select class="form-input" name="category" id="ticket-category-input">
              <option value="hardware">硬件设备</option>
              <option value="software">软件应用</option>
              <option value="network">网络问题</option>
              <option value="account">账号权限</option>
            </select>
            <div class="text-muted" style="font-size: var(--text-xs); margin-top: var(--space-2);">💡 AI 将根据描述自动分类</div>
          </div>
          <div class="form-group">
            <label class="form-label">优先级</label>
            <select class="form-input" name="priority">
              <option value="low">低</option>
              <option value="medium" selected>中</option>
              <option value="high">高</option>
              <option value="urgent">紧急</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">问题描述 *</label>
            <textarea class="form-textarea" name="description" required placeholder="详细描述问题现象、发生时间、影响范围等"></textarea>
            <div style="margin-top: var(--space-2);">
              <button type="button" class="btn btn-outline btn-sm" id="ai-solve-btn">🤖 AI 尝试解答</button>
            </div>
            <div id="ai-solution" style="display: none; margin-top: var(--space-3); padding: var(--space-3); background: var(--primary-bg); border-radius: var(--radius); font-size: var(--text-sm);">
              <div style="font-weight: 500; margin-bottom: var(--space-2); color: var(--primary);">AI 解答建议：</div>
              <div id="ai-solution-content"></div>
              <button type="button" class="btn btn-ghost btn-sm" id="accept-ai" style="margin-top: var(--space-2);">采纳并关闭工单</button>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="cancel-btn">取消</button>
          <button type="submit" class="btn btn-primary">提交工单</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 工单详情弹窗 -->
  <div class="modal-overlay" id="detail-modal" style="display: none;">
    <div class="modal" style="max-width: 640px;">
      <div class="modal-header">
        <h3>工单详情</h3>
        <button class="btn btn-ghost btn-sm" id="close-detail-modal">✕</button>
      </div>
      <div class="modal-body" id="detail-modal-body">
        <!-- 动态填充 -->
      </div>
      <div class="modal-footer" id="detail-modal-footer">
        <!-- 动态填充 -->
      </div>
    </div>
  </div>
</DefaultLayout>

<style>
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table th {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }
  .data-table td {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--border-light);
  }
  .data-table tbody tr:hover {
    background: var(--surface-hover);
    cursor: pointer;
  }
  .loading-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  .modal {
    background: var(--surface);
    border-radius: var(--radius-lg);
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-xl);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .modal-body {
    padding: var(--space-5);
  }
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-5);
    border-top: 1px solid var(--border);
  }
  /* 工单列表错误状态 */
  .ticket-error-cell {
    padding: var(--space-8) !important;
    text-align: center;
  }
  .ticket-error {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .ticket-error-msg {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--danger);
  }
  .ticket-error-detail {
    font-size: var(--text-xs);
    color: var(--text-muted);
    word-break: break-all;
    max-width: 400px;
  }
  /* 工单详情字段 */
  .detail-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-light);
    font-size: var(--text-sm);
    flex-wrap: wrap;
  }
  .detail-label {
    color: var(--text-muted);
    min-width: 64px;
  }
  .detail-block {
    margin-top: var(--space-3);
  }
  .detail-block .detail-label {
    display: block;
    margin-bottom: var(--space-2);
  }
  .detail-content {
    padding: var(--space-3);
    background: var(--surface-muted);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    line-height: var(--lh-relaxed);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .ai-streaming-hint {
    color: var(--text-muted);
    font-size: var(--text-sm);
    padding: var(--space-2) 0;
  }
  /* AI 解答 Markdown 渲染（精简样式） */
  #ai-solution-content .markdown-body,
  .detail-content.markdown-body {
    background: transparent;
    padding: 0;
    white-space: normal;
  }
  .markdown-body h1,
  .markdown-body h2,
  .markdown-body h3 {
    margin: var(--space-3) 0 var(--space-2);
    font-weight: 600;
  }
  .markdown-body h1 { font-size: var(--text-lg); }
  .markdown-body h2 { font-size: var(--text-md); }
  .markdown-body h3 { font-size: var(--text-sm); }
  .markdown-body p {
    margin: var(--space-2) 0;
  }
  .markdown-body ul,
  .markdown-body ol {
    margin: var(--space-2) 0;
    padding-left: var(--space-5);
  }
  .markdown-body ul { list-style: disc; }
  .markdown-body ol { list-style: decimal; }
  .markdown-body li {
    margin: var(--space-1) 0;
  }
  .markdown-body code:not(.hljs) {
    padding: 2px 5px;
    background: var(--surface-muted);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--danger);
  }
  .markdown-body pre {
    margin: var(--space-2) 0;
    padding: var(--space-3);
    background: var(--surface-muted);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: var(--text-sm);
  }
  .markdown-body pre code {
    background: transparent;
    color: var(--text);
    padding: 0;
  }
  .markdown-body blockquote {
    margin: var(--space-2) 0;
    padding: var(--space-1) var(--space-3);
    border-left: 3px solid var(--primary);
    background: var(--primary-bg);
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    color: var(--text-secondary);
  }
  .markdown-body strong { font-weight: 600; }
  .markdown-body table {
    width: 100%;
    margin: var(--space-2) 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .markdown-body th,
  .markdown-body td {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    text-align: left;
  }
  .markdown-body th {
    background: var(--surface-muted);
    font-weight: 600;
  }
</style>

<script>
  import { renderMarkdownStream } from '@/lib/markdown';
  import { getTickets, createTicket, updateTicket } from '@/lib/apis/tickets';
  import { createSSEStream } from '@/lib/sse';
  import { ApiError } from '@/lib/api';
  import { logout } from '@/lib/auth';

  const categoryMap: Record<string, { label: string; badge: string }> = {
    hardware: { label: '硬件设备', badge: 'badge-primary' },
    software: { label: '软件应用', badge: 'badge-success' },
    network: { label: '网络问题', badge: 'badge-warning' },
    account: { label: '账号权限', badge: 'badge-danger' },
  };
  const priorityMap: Record<string, { label: string; badge: string }> = {
    low: { label: '低', badge: 'badge-primary' },
    medium: { label: '中', badge: 'badge-warning' },
    high: { label: '高', badge: 'badge-danger' },
    urgent: { label: '紧急', badge: 'badge-danger' },
  };
  const statusMap: Record<string, { label: string; badge: string }> = {
    open: { label: '待处理', badge: 'badge-warning' },
    progress: { label: '处理中', badge: 'badge-primary' },
    resolved: { label: '已解决', badge: 'badge-success' },
  };

  function getCategory(c: string) {
    return categoryMap[c] || { label: c || '未分类', badge: 'badge-primary' };
  }
  function getPriority(p: string) {
    return priorityMap[p] || { label: p || '中', badge: 'badge-warning' };
  }
  function getStatus(s: string) {
    return statusMap[s] || { label: s || '未知', badge: 'badge-primary' };
  }

  let tickets: any[] = [];

  /** 判断是否为 401/未登录错误（已在底层处理跳转，业务层需静默退出） */
  function isAuthError(err: unknown): boolean {
    return err instanceof ApiError && err.status === 401;
  }

  /** 从接口返回值中提取数组（兼容数组 / { items: [] } / { data: ... } 嵌套） */
  function toItems(raw: unknown): any[] {
    if (Array.isArray(raw)) return raw;
    if (raw && typeof raw === 'object') {
      const obj = raw as { items?: unknown[]; data?: unknown };
      if (Array.isArray(obj.items)) return obj.items as any[];
      if (obj.data !== undefined) return toItems(obj.data);
    }
    return [];
  }

  async function loadTickets() {
    showTicketLoading();
    try {
      const result = await getTickets();
      tickets = toItems(result);
      renderTickets();
      updateStats();
    } catch (err) {
      if (isAuthError(err)) return;
      showTicketError(err instanceof Error ? err.message : String(err));
    }
  }

  function showTicketLoading() {
    const body = document.getElementById('ticket-list')!;
    body.innerHTML = '<tr><td colspan="7" class="loading-state">加载中...</td></tr>';
  }

  function showTicketError(msg: string) {
    const body = document.getElementById('ticket-list')!;
    body.innerHTML = `
      <tr><td colspan="7" class="ticket-error-cell">
        <div class="ticket-error">
          <div class="ticket-error-msg">工单列表加载失败</div>
          <div class="ticket-error-detail">${escapeHtml(msg)}</div>
          <button class="btn btn-outline btn-sm" id="ticket-retry-btn">重试</button>
        </div>
      </td></tr>`;
    ['stat-open', 'stat-progress', 'stat-resolved', 'stat-ai'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.textContent = '--';
    });
    document.getElementById('ticket-retry-btn')?.addEventListener('click', loadTickets);
  }

  function updateStats() {
    const setText = (id: string, v: string | number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(v);
    };
    setText('stat-open', tickets.filter((t) => t.status === 'open').length);
    setText('stat-progress', tickets.filter((t) => t.status === 'progress').length);
    setText('stat-resolved', tickets.filter((t) => t.status === 'resolved').length);
    const resolved = tickets.filter((t) => t.status === 'resolved');
    const aiSolved = resolved.filter((t) => t.ai_solved).length;
    setText('stat-ai', resolved.length > 0 ? Math.round((aiSolved / resolved.length) * 100) + '%' : '0%');
  }

  function renderTickets() {
    const statusFilter = (document.getElementById('ticket-status') as HTMLSelectElement).value;
    const categoryFilter = (document.getElementById('ticket-category') as HTMLSelectElement).value;

    const list = tickets.filter((t) => {
      if (statusFilter && t.status !== statusFilter) return false;
      if (categoryFilter && t.category !== categoryFilter) return false;
      return true;
    });

    const body = document.getElementById('ticket-list')!;
    if (list.length === 0) {
      body.innerHTML = '<tr><td colspan="7" class="loading-state">暂无工单</td></tr>';
      return;
    }
    body.innerHTML = list
      .map((t) => {
        const cat = getCategory(t.category);
        const pri = getPriority(t.priority);
        const sts = getStatus(t.status);
        return `
      <tr data-id="${escapeHtml(String(t.id))}">
        <td><code style="font-size: var(--text-xs);">${escapeHtml(String(t.id))}</code></td>
        <td style="font-weight: 500;">${escapeHtml(t.title)}</td>
        <td><span class="badge ${cat.badge}">${escapeHtml(cat.label)}</span></td>
        <td><span class="badge ${pri.badge}">${escapeHtml(pri.label)}</span></td>
        <td><span class="badge ${sts.badge}">${escapeHtml(sts.label)}</span></td>
        <td class="text-muted">${escapeHtml(String(t.created_at))}</td>
        <td><button class="btn btn-ghost btn-sm">详情</button></td>
      </tr>`;
      })
      .join('');

    body.querySelectorAll('tr[data-id]').forEach((tr) => {
      tr.addEventListener('click', () => {
        const id = (tr as HTMLElement).dataset.id!;
        openDetailModal(id);
      });
    });
  }

  function escapeHtml(s: string): string {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // 弹窗
  const modal = document.getElementById('create-modal')!;
  document.getElementById('create-ticket-btn')?.addEventListener('click', () => (modal.style.display = 'flex'));
  document.getElementById('close-modal')?.addEventListener('click', () => (modal.style.display = 'none'));
  document.getElementById('cancel-btn')?.addEventListener('click', () => (modal.style.display = 'none'));

  // AI 解答（SSE 流式接收，使用 renderMarkdownStream 渲染返回内容）
  document.getElementById('ai-solve-btn')?.addEventListener('click', async () => {
    const desc = (document.querySelector('textarea[name="description"]') as HTMLTextAreaElement).value.trim();
    if (!desc) {
      alert('请先描述问题');
      return;
    }
    const solveBtn = document.getElementById('ai-solve-btn') as HTMLButtonElement;
    const solutionBox = document.getElementById('ai-solution')!;
    const contentBox = document.getElementById('ai-solution-content')!;
    solveBtn.disabled = true;
    solveBtn.textContent = 'AI 分析中...';
    solutionBox.style.display = 'block';
    contentBox.innerHTML = '<div class="ai-streaming-hint">正在生成解答...</div>';

    let fullText = '';
    try {
      // 通过 sse.ts 统一封装的 createSSEStream 接收流式解答（统一处理 Token / 401 / SSE 解析）
      for await (const event of createSSEStream('/api/v1/chat/stream', { query: desc, agent_type: 'qa' })) {
        const { text, error } = parseStreamEvent(event.type, event.data);
        if (error) {
          fullText += `\n\n> **[错误]** ${error}\n`;
        } else if (text) {
          fullText += text;
        }
        if (fullText) {
          contentBox.innerHTML = `<div class="markdown-body">${renderMarkdownStream(fullText)}</div>`;
        }
      }

      if (fullText) {
        contentBox.innerHTML = `<div class="markdown-body">${renderMarkdownStream(fullText)}</div>`;
      } else {
        contentBox.innerHTML = '<div class="ai-streaming-hint">AI 未返回有效内容，请直接提交工单</div>';
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      // createSSEStream 未内置 401 跳转，此处补充处理
      if (msg.includes('(401)')) {
        await logout();
        return;
      }
      contentBox.innerHTML =
        '<div class="ai-streaming-hint">AI 解答失败：' +
        escapeHtml(msg) +
        '</div>';
    } finally {
      solveBtn.disabled = false;
      solveBtn.textContent = '🤖 AI 尝试解答';
    }
  });

  /** 解析 SSE 事件，提取文本或错误信息（兼容字符串与已解析对象） */
  function parseStreamEvent(type: string, data: unknown): { text?: string; error?: string } {
    let parsed: any = data;
    if (typeof data === 'string') {
      try {
        parsed = JSON.parse(data);
      } catch {
        parsed = data;
      }
    }
    const evtType = type || parsed?.type || 'message';
    if (evtType === 'error') {
      return { error: parsed?.message || '未知错误' };
    }
    // token / chunk / message / delta 等事件 - 提取文本片段
    const text =
      parsed?.text ||
      parsed?.delta ||
      parsed?.content ||
      (typeof parsed === 'string' ? parsed : '');
    return text ? { text } : {};
  }

  // 采纳 AI 解答：创建工单后调用 updateTicket 更新状态为 resolved
  document.getElementById('accept-ai')?.addEventListener('click', async () => {
    const form = document.getElementById('ticket-form') as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!data.title || !data.description) {
      alert('请先填写标题和问题描述');
      return;
    }
    const acceptBtn = document.getElementById('accept-ai') as HTMLButtonElement;
    acceptBtn.disabled = true;
    acceptBtn.textContent = '处理中...';
    try {
      // 1. 创建工单（标记 AI 已解决）
      const created = (await createTicket({
        title: String(data.title),
        description: String(data.description),
        category: String(data.category || ''),
        priority: String(data.priority || 'medium'),
      })) as unknown as { id?: string };
      const ticketId = created?.id;

      // 2. 采纳 AI 解答 - 调用 updateTicket 更新工单状态为已解决
      if (ticketId) {
        try {
          await updateTicket(String(ticketId), { status: 'resolved', ai_solved: true });
        } catch {
          alert('工单已创建，但自动关闭失败，请稍后在列表中手动处理');
        }
      }
      alert('已采纳 AI 解答，工单已关闭');
      modal.style.display = 'none';
      form.reset();
      document.getElementById('ai-solution')!.style.display = 'none';
      loadTickets();
    } catch (err) {
      if (isAuthError(err)) return;
      alert('采纳失败：' + (err instanceof Error ? err.message : String(err)));
    } finally {
      acceptBtn.disabled = false;
      acceptBtn.textContent = '采纳并关闭工单';
    }
  });

  document.getElementById('ticket-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form));
    try {
      await createTicket({
        title: String(data.title),
        description: String(data.description),
        category: String(data.category || ''),
        priority: String(data.priority || 'medium'),
      });
      alert('工单已提交，IT 人员将尽快处理');
      modal.style.display = 'none';
      form.reset();
      document.getElementById('ai-solution')!.style.display = 'none';
      loadTickets();
    } catch (err) {
      if (isAuthError(err)) return;
      alert('提交失败：' + (err instanceof Error ? err.message : '网络异常'));
    }
  });

  // ===== 工单详情弹窗 =====
  const detailModal = document.getElementById('detail-modal')!;
  const detailBody = document.getElementById('detail-modal-body')!;
  const detailFooter = document.getElementById('detail-modal-footer')!;

  document.getElementById('close-detail-modal')?.addEventListener('click', () => (detailModal.style.display = 'none'));
  detailModal.addEventListener('click', (e) => {
    if (e.target === detailModal) detailModal.style.display = 'none';
  });

  function openDetailModal(id: string) {
    const t = tickets.find((x) => String(x.id) === String(id));
    if (!t) {
      alert('未找到工单信息');
      return;
    }
    const cat = getCategory(t.category);
    const pri = getPriority(t.priority);
    const sts = getStatus(t.status);
    detailBody.innerHTML = `
      <div class="detail-row"><span class="detail-label">工单号</span><code>${escapeHtml(String(t.id))}</code></div>
      <div class="detail-row"><span class="detail-label">标题</span><span style="font-weight:500;">${escapeHtml(t.title)}</span></div>
      <div class="detail-row">
        <span class="detail-label">分类</span><span class="badge ${cat.badge}">${escapeHtml(cat.label)}</span>
        <span class="detail-label" style="margin-left:var(--space-4);">优先级</span><span class="badge ${pri.badge}">${escapeHtml(pri.label)}</span>
        <span class="detail-label" style="margin-left:var(--space-4);">状态</span><span class="badge ${sts.badge}">${escapeHtml(sts.label)}</span>
      </div>
      <div class="detail-row"><span class="detail-label">提交时间</span><span class="text-muted">${escapeHtml(String(t.created_at))}</span></div>
      ${t.description ? `<div class="detail-block"><div class="detail-label">问题描述</div><div class="detail-content">${escapeHtml(t.description)}</div></div>` : ''}
      ${t.ai_solution ? `<div class="detail-block"><div class="detail-label">AI 解答</div><div class="detail-content markdown-body">${renderMarkdownStream(t.ai_solution)}</div></div>` : ''}
      ${t.ai_solved ? '<div class="badge badge-success">AI 已解决</div>' : ''}
    `;
    if (t.status === 'resolved') {
      detailFooter.innerHTML = '<button class="btn btn-ghost" id="detail-close-btn">关闭</button>';
    } else {
      detailFooter.innerHTML =
        '<button class="btn btn-ghost" id="detail-close-btn">关闭</button>' +
        '<button class="btn btn-primary" id="detail-resolve-btn">标记为已解决</button>';
      document.getElementById('detail-resolve-btn')?.addEventListener('click', () => resolveTicket(t.id));
    }
    document.getElementById('detail-close-btn')?.addEventListener('click', () => (detailModal.style.display = 'none'));
    detailModal.style.display = 'flex';
  }

  /** 调用 updateTicket 更新状态为 resolved */
  async function resolveTicket(id: string) {
    const btn = document.getElementById('detail-resolve-btn') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = '处理中...';
    }
    try {
      await updateTicket(id, { status: 'resolved', ai_solved: true });
      alert('工单已标记为已解决');
      detailModal.style.display = 'none';
      loadTickets();
    } catch (err) {
      if (isAuthError(err)) return;
      alert('关闭工单失败：' + (err instanceof Error ? err.message : String(err)));
      if (btn) {
        btn.disabled = false;
        btn.textContent = '标记为已解决';
      }
    }
  }

  document.getElementById('ticket-status')?.addEventListener('change', renderTickets);
  document.getElementById('ticket-category')?.addEventListener('change', renderTickets);

  loadTickets();
</script>
