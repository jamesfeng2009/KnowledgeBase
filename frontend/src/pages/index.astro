---
/**
 * 首页 - 工作台
 * 显示欢迎信息和功能概览
 * 数据来源：
 *   - GET /api/v1/stats/overview  四项核心统计（文档/知识库/对话/活跃用户）
 *   - getDashboard()              六项运营指标（搜索/文档/用户/零点击/覆盖率/新鲜度）
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '工作台' }];

// 功能概览卡片配置：保留导航能力，badge 改为展示真实运营指标
const features = [
  {
    icon: '💬',
    title: 'AI 智能对话',
    desc: '基于 Agentic RAG 的智能问答，支持流式输出和引用溯源，快速获取知识答案。',
    route: '/chat',
    metricKey: 'total_searches',
    metricLabel: '搜索',
  },
  {
    icon: '📚',
    title: '知识库管理',
    desc: '集中管理企业知识资产，支持多格式文档上传、自动解析和智能分类。',
    route: '/knowledge',
    metricKey: 'total_documents',
    metricLabel: '文档',
  },
  {
    icon: '🔍',
    title: '语义搜索',
    desc: '基于向量检索的语义搜索，理解意图而非关键词匹配，精准定位相关知识。',
    route: '/knowledge/search',
    metricKey: 'zero_click_rate',
    metricLabel: '零点击率',
  },
  {
    icon: '✏️',
    title: '协同编辑',
    desc: '基于 Yjs 的实时协同编辑，支持多人同时编辑文档，变更自动同步。',
    route: '/manage/editor',
    metricKey: 'total_users',
    metricLabel: '用户',
  },
  {
    icon: '📊',
    title: '运营看板',
    desc: '系统运行状态监控、使用统计分析和审计日志，全面掌握平台运营情况。',
    route: '/admin',
    metricKey: 'coverage_rate',
    metricLabel: '覆盖率',
  },
  {
    icon: '⚙️',
    title: '系统设置',
    desc: '租户管理、API 密钥配置、LLM 模型选择和系统参数配置。',
    route: '/settings/system',
    metricKey: 'freshness_rate',
    metricLabel: '新鲜度',
  },
];
---

<DefaultLayout title="工作台" breadcrumb={breadcrumb}>
  <!-- 欢迎区域 -->
  <section class="welcome-section">
    <div class="card" style="background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border: none; color: white;">
      <h1 style="color: white; font-size: var(--text-4xl); margin-bottom: var(--space-3);">
        欢迎使用企业知识库
      </h1>
      <p style="color: rgba(255,255,255,0.9); font-size: var(--text-lg); max-width: 600px; line-height: var(--lh-relaxed);">
        基于 Agentic RAG 的智能知识管理平台，融合 AI 对话、语义搜索、协同编辑与知识图谱，
        让企业知识可检索、可对话、可协作。
      </p>
      <div style="display: flex; gap: var(--space-3); margin-top: var(--space-6);">
        <a href="/chat" class="btn btn-lg" style="background: white; color: var(--primary);">
          开始 AI 对话
        </a>
        <a href="/knowledge" class="btn btn-lg btn-outline" style="border-color: rgba(255,255,255,0.5); color: white;">
          浏览知识库
        </a>
      </div>
    </div>
  </section>

  <!-- 统计概览 -->
  <section style="margin-top: var(--space-6);">
    <div id="stats-error" class="block-error" style="display: none; margin-bottom: var(--space-3);">
      <span class="block-error-msg" id="stats-error-msg">统计数据加载失败</span>
      <button class="btn btn-outline btn-sm" type="button" id="stats-retry">重试</button>
    </div>
    <div class="grid grid-cols-4">
      <div class="card">
        <div class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-2);">文档总数</div>
        <div class="stat-value" id="stat-docs"><div class="skeleton-bar"></div></div>
      </div>
      <div class="card">
        <div class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-2);">知识库数</div>
        <div class="stat-value" id="stat-kbs"><div class="skeleton-bar"></div></div>
      </div>
      <div class="card">
        <div class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-2);">对话次数</div>
        <div class="stat-value" id="stat-chats"><div class="skeleton-bar"></div></div>
      </div>
      <div class="card">
        <div class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-2);">活跃用户</div>
        <div class="stat-value" id="stat-users"><div class="skeleton-bar"></div></div>
      </div>
    </div>
  </section>

  <!-- 功能概览卡片 -->
  <section style="margin-top: var(--space-6);">
    <div class="page-header">
      <h2 class="page-title" style="font-size: var(--text-xl);">功能概览</h2>
    </div>
    <div id="dashboard-error" class="block-error" style="display: none; margin-bottom: var(--space-3);">
      <span class="block-error-msg" id="dashboard-error-msg">运营数据加载失败</span>
      <button class="btn btn-outline btn-sm" type="button" id="dashboard-retry">重试</button>
    </div>
    <div class="grid grid-cols-3">
      {features.map((feature) => (
        <a href={feature.route} class="card feature-card" style="text-decoration: none;">
          <div style="display: flex; align-items: flex-start; justify-content: space-between;">
            <div class="feature-card-icon">{feature.icon}</div>
            <span class="badge badge-primary feature-metric" data-metric={feature.metricKey} data-label={feature.metricLabel}>
              <span class="metric-loading">加载中</span>
            </span>
          </div>
          <h3 class="feature-card-title">{feature.title}</h3>
          <p class="feature-card-desc">{feature.desc}</p>
          <div style="margin-top: auto; color: var(--primary); font-size: var(--text-sm); font-weight: 500;">
            了解更多 →
          </div>
        </a>
      ))}
    </div>
  </section>
</DefaultLayout>

<style>
  .stat-value {
    font-size: var(--text-4xl);
    font-weight: 600;
    min-height: 40px;
    display: flex;
    align-items: center;
  }
  .stat-value.is-error {
    color: var(--text-muted);
    font-size: var(--text-2xl);
  }
  /* 骨架屏动画 */
  .skeleton-bar {
    display: inline-block;
    width: 80px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, var(--surface-muted) 25%, var(--surface-hover) 50%, var(--surface-muted) 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.4s ease-in-out infinite;
  }
  @keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  /* 错误提示条 */
  .block-error {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--danger-bg, #fef2f2);
    border: 1px solid var(--danger, #ef4444);
    border-radius: var(--radius);
    color: var(--danger, #ef4444);
    font-size: var(--text-sm);
  }
  .block-error-msg {
    flex: 1;
    word-break: break-all;
  }
  /* 卡片指标徽章 */
  .feature-metric {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-width: 56px;
    justify-content: center;
  }
  .feature-metric .metric-value {
    font-weight: 600;
  }
  .feature-metric .metric-loading {
    font-size: var(--text-xs);
    opacity: 0.7;
  }
  .feature-metric.is-error {
    background: var(--surface-muted);
    color: var(--text-muted);
  }
</style>

<script>
  import { getDashboard, type DashboardData } from '@/lib/apis/analytics';
  import { ApiError } from '@/lib/api';

  const API_BASE = import.meta.env.PUBLIC_API_BASE || 'http://localhost:8000';

  const STAT_IDS = ['stat-docs', 'stat-kbs', 'stat-chats', 'stat-users'] as const;

  function el(id: string): HTMLElement {
    return document.getElementById(id) as HTMLElement;
  }

  function escapeHtml(s: string): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // ===== 统计概览（/api/v1/stats/overview）=====

  function showStatsSkeleton(): void {
    STAT_IDS.forEach((id) => {
      const node = el(id);
      node.classList.remove('is-error');
      node.innerHTML = '<div class="skeleton-bar"></div>';
    });
  }

  function setStat(id: string, value: number | string): void {
    const node = el(id);
    node.classList.remove('is-error');
    node.textContent = String(value);
  }

  function showStatsError(msg: string): void {
    STAT_IDS.forEach((id) => {
      const node = el(id);
      node.classList.add('is-error');
      node.textContent = '--';
    });
    el('stats-error-msg').textContent = '统计数据加载失败：' + msg;
    el('stats-error').style.display = 'flex';
  }

  function hideStatsError(): void {
    el('stats-error').style.display = 'none';
  }

  async function loadStats(): Promise<void> {
    showStatsSkeleton();
    hideStatsError();
    try {
      // P0 安全修复：认证通过 HttpOnly Cookie 自动携带
      const response = await fetch(`${API_BASE}/api/v1/stats/overview`, {
        credentials: 'include',
      });
      if (response.status === 401) {
        window.location.href = '/auth/login';
        return;
      }
      if (!response.ok) {
        throw new Error(`请求失败 (${response.status})`);
      }
      const result = await response.json();
      const data = result.data || result;

      setStat('stat-docs', data.total_documents ?? 0);
      setStat('stat-kbs', data.total_knowledge_bases ?? 0);
      setStat('stat-chats', data.total_conversations ?? 0);
      setStat('stat-users', data.active_users ?? 0);
    } catch (err) {
      showStatsError(err instanceof Error ? err.message : String(err));
    }
  }

  // ===== 功能概览指标（getDashboard）=====

  function showMetricsLoading(): void {
    document.querySelectorAll<HTMLElement>('.feature-metric').forEach((node) => {
      node.classList.remove('is-error');
      node.innerHTML = '<span class="metric-loading">加载中</span>';
    });
  }

  function showMetricsError(msg: string): void {
    document.querySelectorAll<HTMLElement>('.feature-metric').forEach((node) => {
      node.classList.add('is-error');
      node.innerHTML = '<span class="metric-loading">--</span>';
    });
    el('dashboard-error-msg').textContent = '运营数据加载失败：' + msg;
    el('dashboard-error').style.display = 'flex';
  }

  function hideDashboardError(): void {
    el('dashboard-error').style.display = 'none';
  }

  /** 将指标值格式化为展示文本 */
  function formatMetric(key: string, value: unknown): string {
    if (value == null || value === '') return '--';
    if (key.endsWith('_rate')) {
      const num = typeof value === 'number' ? value : Number(value);
      if (isNaN(num)) return '--';
      // 兼容 0-1 小数与 0-100 百分比
      const pct = num <= 1 ? num * 100 : num;
      return pct.toFixed(1) + '%';
    }
    const num = typeof value === 'number' ? value : Number(value);
    if (!isNaN(num)) return num.toLocaleString('zh-CN');
    return String(value);
  }

  async function loadDashboard(): Promise<void> {
    showMetricsLoading();
    hideDashboardError();
    try {
      const data: DashboardData = await getDashboard(30);
      document.querySelectorAll<HTMLElement>('.feature-metric').forEach((node) => {
        const key = node.dataset.metric || '';
        const label = node.dataset.label || '';
        const raw = (data as unknown as Record<string, unknown>)[key];
        node.classList.remove('is-error');
        node.innerHTML = `<span class="metric-loading">${escapeHtml(label)}</span><span class="metric-value">${escapeHtml(formatMetric(key, raw))}</span>`;
      });
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) return; // 已跳转登录
      showMetricsError(err instanceof Error ? err.message : String(err));
    }
  }

  // 事件绑定
  el('stats-retry').addEventListener('click', loadStats);
  el('dashboard-retry').addEventListener('click', loadDashboard);

  loadStats();
  loadDashboard();
</script>
