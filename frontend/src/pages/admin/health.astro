---
/**
 * 知识健康度页面
 * 整体健康度评分（环形图） + 各知识库健康度 + 低质量文档列表 + 新鲜度分布
 * 数据来源：getCoverage() / getFreshness() / getDashboard() / GET /api/v1/admin/health
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import HealthRing from '@/components/admin/HealthRing.astro';

const breadcrumb = [{ label: '治理后台', href: '/admin' }, { label: '知识健康度' }];
---

<DefaultLayout title="知识健康度" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">知识健康度</h1>
    <button class="btn btn-outline btn-sm" id="scan-btn">🔍 重新扫描</button>
  </div>

  <!-- 加载/错误/重试容器（JS 加载前展示 HealthRing 骨架，加载后由 JS 接管渲染） -->
  <div id="health-root">
    <div class="card text-center">
      <div class="card-header"><h3>整体健康度</h3></div>
      <HealthRing value={0} size="lg" label="加载中..." color="primary" />
    </div>
  </div>
</DefaultLayout>

<style>
  .health-ring-wrapper {
    position: relative;
    display: inline-block;
    margin: var(--space-4) auto;
  }
  .health-ring-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }
  .health-ring-score {
    font-size: var(--text-4xl);
    font-weight: 600;
    color: var(--primary);
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table th {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }
  .data-table td {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--border-light);
  }
  .kb-health-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-light);
  }
  .kb-health-item:last-child {
    border-bottom: none;
  }
  .kb-health-name {
    width: 120px;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .kb-health-bar {
    flex: 1;
    height: 8px;
    background: var(--surface-muted);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .kb-health-bar-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width var(--transition);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .error-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--danger);
    font-size: var(--text-sm);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .retry-btn {
    margin-top: var(--space-3);
  }
</style>

<script>
  import { getCoverage, getFreshness, getDashboard } from '@/lib/apis/analytics';
  import { API_BASE } from '@/lib/api';

  const TOKEN_KEY = 'ekb_access_token';

  interface HealthData {
    score: number;
    good: number;
    warn: number;
    bad: number;
    totalDocs: number;
    kbs: Array<{ name: string; score: number; color: string }>;
    lowQuality: Array<{ id: string; title: string; kb: string; issue: string; score: number }>;
  }

  /** 拉取后端 /admin/health 返回的明细数据（知识库健康度 / 低质量文档） */
  async function fetchAdminHealth(): Promise<{
    kbs?: Array<{ name?: string; score?: number; kb_name?: string; health_score?: number }>;
    low_quality?: Array<Record<string, unknown>>;
    lowQuality?: Array<Record<string, unknown>>;
  } | null> {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      window.location.href = '/auth/login';
      return null;
    }
    try {
      const res = await fetch(`${API_BASE}/api/v1/admin/health`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.status === 401) {
        localStorage.removeItem(TOKEN_KEY);
        window.location.href = '/auth/login';
        return null;
      }
      if (!res.ok) return null;
      const result = await res.json();
      return (result.data || result) as Record<string, unknown> as {
        kbs?: Array<{ name?: string; score?: number; kb_name?: string; health_score?: number }>;
        low_quality?: Array<Record<string, unknown>>;
        lowQuality?: Array<Record<string, unknown>>;
      };
    } catch {
      return null;
    }
  }

  function scoreColor(score: number): string {
    if (score >= 80) return 'var(--success)';
    if (score >= 60) return 'var(--warning)';
    return 'var(--danger)';
  }

  /** 综合健康度评分：覆盖率与新鲜率的加权平均 */
  function computeScore(coverageRate: number, freshRate: number): number {
    const cov = coverageRate <= 1 ? coverageRate * 100 : coverageRate;
    const fresh = freshRate <= 1 ? freshRate * 100 : freshRate;
    return Math.round(cov * 0.5 + fresh * 0.5);
  }

  async function loadHealth(): Promise<void> {
    const root = document.getElementById('health-root')!;
    root.innerHTML = '<div class="loading-state" id="health-loading">加载中...</div>';

    let coverage, freshness, dashboard;
    try {
      [coverage, freshness, dashboard] = await Promise.all([
        getCoverage(),
        getFreshness(),
        getDashboard(30),
      ]);
    } catch (err) {
      const msg = err instanceof Error ? err.message : '加载失败';
      root.innerHTML = `
        <div class="error-state">
          <div>加载健康度数据失败：${escapeHtml(msg)}</div>
          <button class="btn btn-outline btn-sm retry-btn" id="retry-btn">重试</button>
        </div>`;
      document.getElementById('retry-btn')?.addEventListener('click', loadHealth);
      return;
    }

    const adminHealth = await fetchAdminHealth();

    const data: HealthData = {
      score: computeScore(coverage.rate, freshness.fresh_rate),
      good: freshness.fresh,
      warn: freshness.stale,
      bad: freshness.expired,
      totalDocs: dashboard.total_documents,
      kbs: (adminHealth?.kbs || []).map((kb) => {
        const score = typeof kb.score === 'number' ? kb.score : (typeof kb.health_score === 'number' ? kb.health_score : 0);
        return {
          name: kb.name || kb.kb_name || '未命名',
          score,
          color: scoreColor(score),
        };
      }),
      lowQuality: (adminHealth?.low_quality || adminHealth?.lowQuality || []).map((d) => {
        const obj = d as Record<string, unknown>;
        const score = typeof obj.score === 'number' ? obj.score : (typeof obj.quality_score === 'number' ? obj.quality_score : 0);
        return {
          id: String(obj.id || obj.doc_id || ''),
          title: String(obj.title || obj.name || '未命名文档'),
          kb: String(obj.kb || obj.kb_name || '-'),
          issue: String(obj.issue || obj.reason || obj.problem || '需优化'),
          score,
        };
      }),
    };

    renderHealth(data);
  }

  function renderHealth(data: HealthData): void {
    const root = document.getElementById('health-root')!;
    root.innerHTML = `
      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-5); margin-bottom: var(--space-6);">
        <!-- 整体健康度环形图 -->
        <div class="card text-center">
          <div class="card-header"><h3>整体健康度</h3></div>
          <div class="health-ring-wrapper">
            <canvas id="health-ring" width="200" height="200"></canvas>
            <div class="health-ring-center">
              <div class="health-ring-score" id="health-score">${data.score}</div>
              <div class="text-muted" style="font-size: var(--text-sm);">健康度评分</div>
              <div class="text-muted" style="font-size: var(--text-xs); margin-top: var(--space-1);">文档总数 ${data.totalDocs}</div>
            </div>
          </div>
          <div style="display: flex; justify-content: space-around; margin-top: var(--space-4);">
            <div>
              <div class="text-muted" style="font-size: var(--text-xs);">优质</div>
              <div style="font-size: var(--text-xl); font-weight: 600; color: var(--success);">${data.good}</div>
            </div>
            <div>
              <div class="text-muted" style="font-size: var(--text-xs);">待改进</div>
              <div style="font-size: var(--text-xl); font-weight: 600; color: var(--warning);">${data.warn}</div>
            </div>
            <div>
              <div class="text-muted" style="font-size: var(--text-xs);">低质量</div>
              <div style="font-size: var(--text-xl); font-weight: 600; color: var(--danger);">${data.bad}</div>
            </div>
          </div>
        </div>

        <!-- 各知识库健康度 -->
        <div class="card">
          <div class="card-header"><h3>各知识库健康度</h3></div>
          <div id="kb-health-list"></div>
        </div>
      </div>

      <!-- 低质量文档列表 -->
      <div class="card" style="margin-bottom: var(--space-6);">
        <div class="card-header"><h3>低质量文档（建议优化）</h3></div>
        <div style="overflow-x: auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>文档名称</th>
                <th>知识库</th>
                <th>问题</th>
                <th>评分</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="low-quality-list"></tbody>
          </table>
        </div>
      </div>

      <!-- 新鲜度分布 -->
      <div class="card">
        <div class="card-header"><h3>知识新鲜度分布</h3></div>
        <canvas id="quality-trend" style="width: 100%; height: 200px;"></canvas>
      </div>
    `;

    drawRing(data.score);

    const kbList = document.getElementById('kb-health-list')!;
    if (data.kbs.length === 0) {
      kbList.innerHTML = '<div class="empty-state">暂无知识库健康度数据</div>';
    } else {
      kbList.innerHTML = data.kbs
        .map(
          (kb) => `
        <div class="kb-health-item">
          <div class="kb-health-name">${escapeHtml(kb.name)}</div>
          <div class="kb-health-bar">
            <div class="kb-health-bar-fill" style="width: ${kb.score}%; background: ${kb.color};"></div>
          </div>
          <div style="width: 40px; text-align: right; font-size: var(--text-sm); font-weight: 500; color: ${kb.color};">${kb.score}</div>
        </div>`
        )
        .join('');
    }

    const lowList = document.getElementById('low-quality-list')!;
    if (data.lowQuality.length === 0) {
      lowList.innerHTML = '<tr><td colspan="5" class="empty-state">暂无低质量文档，知识库状态良好</td></tr>';
    } else {
      lowList.innerHTML = data.lowQuality
        .map(
          (d) => `
        <tr>
          <td>${escapeHtml(d.title)}</td>
          <td class="text-muted">${escapeHtml(d.kb)}</td>
          <td><span class="badge badge-warning">${escapeHtml(d.issue)}</span></td>
          <td><span style="color: var(--danger); font-weight: 600;">${d.score}</span></td>
          <td>
            <button class="btn btn-ghost btn-sm" data-id="${escapeHtml(d.id)}">优化</button>
          </td>
        </tr>`
        )
        .join('');

      lowList.querySelectorAll('button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id;
          if (id) window.location.href = `/knowledge/detail?id=${encodeURIComponent(id)}`;
        });
      });
    }

    drawTrend(data);
  }

  function drawRing(score: number): void {
    const canvas = document.getElementById('health-ring') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const cx = 100;
    const cy = 100;
    const r = 80;

    // 背景圆
    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, 2 * Math.PI);
    ctx.strokeStyle = '#F0F1F5';
    ctx.lineWidth = 16;
    ctx.stroke();

    // 进度圆
    const color = score >= 80 ? '#00B884' : score >= 60 ? '#FF9500' : '#FF3B5C';
    ctx.beginPath();
    ctx.arc(cx, cy, r, -Math.PI / 2, -Math.PI / 2 + (2 * Math.PI * score) / 100);
    ctx.strokeStyle = color;
    ctx.lineWidth = 16;
    ctx.lineCap = 'round';
    ctx.stroke();
  }

  /** 新鲜度分布柱状图（fresh / stale / expired） */
  function drawTrend(data: HealthData): void {
    const canvas = document.getElementById('quality-trend') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    canvas.width = canvas.offsetWidth * 2;
    canvas.height = 200 * 2;
    ctx.scale(2, 2);
    const w = canvas.offsetWidth;
    const h = 200;

    const bars = [
      { label: '新鲜', value: data.good, color: '#00B884' },
      { label: '陈旧', value: data.warn, color: '#FF9500' },
      { label: '过期', value: data.bad, color: '#FF3B5C' },
    ];
    const max = Math.max(...bars.map((b) => b.value), 1);
    const pad = 40;
    const barWidth = (w - pad * 2) / bars.length / 2;

    // 网格线
    ctx.strokeStyle = '#F0F1F5';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = pad + ((h - pad * 2) / 4) * i;
      ctx.beginPath();
      ctx.moveTo(pad, y);
      ctx.lineTo(w - pad, y);
      ctx.stroke();
    }

    // 柱状
    bars.forEach((b, i) => {
      const x = pad + ((w - pad * 2) / bars.length) * i + ((w - pad * 2) / bars.length - barWidth) / 2;
      const barH = ((h - pad * 2) * b.value) / max;
      const y = h - pad - barH;
      ctx.fillStyle = b.color;
      ctx.fillRect(x, y, barWidth, barH);

      // 数值标签
      ctx.fillStyle = '#333';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(String(b.value), x + barWidth / 2, y - 6);

      // 类别标签
      ctx.fillStyle = '#666';
      ctx.fillText(b.label, x + barWidth / 2, h - pad + 18);
    });
  }

  function escapeHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  document.getElementById('scan-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('scan-btn') as HTMLButtonElement;
    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = '🔍 扫描中...';
    try {
      await loadHealth();
      alert('知识健康度已重新扫描');
    } catch {
      alert('扫描失败，请稍后重试');
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  });

  loadHealth();
</script>
