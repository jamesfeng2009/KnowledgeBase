---
/**
 * 用户管理页面
 * 用户列表表格 + 角色管理 + 部门组织树 + LDAP 同步按钮
 * 数据来源：GET /api/v1/users、PUT /api/v1/users/{id}/role、GET /api/v1/departments、POST /api/v1/users/sync-ldap
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '治理后台', href: '/admin' }, { label: '用户管理' }];
---

<DefaultLayout title="用户管理" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">用户管理</h1>
    <div style="display: flex; gap: var(--space-3);">
      <button class="btn btn-outline btn-sm" id="ldap-btn">🔄 LDAP 同步</button>
      <button class="btn btn-primary btn-sm" id="invite-btn">＋ 邀请用户</button>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 240px 1fr; gap: var(--space-5);">
    <!-- 部门组织树 -->
    <div class="card">
      <div class="card-header"><h3>部门</h3></div>
      <div id="org-tree">
        <div class="org-node active" data-dept="all" style="font-weight: 600;">🏢 全部</div>
        <div class="loading-state" style="padding: var(--space-3);">加载中...</div>
      </div>
    </div>

    <!-- 用户列表 -->
    <div class="card">
      <div class="table-toolbar">
        <input type="text" class="form-input" id="user-search" placeholder="搜索用户..." style="max-width: 240px;" />
        <select class="form-input" id="role-filter" style="width: 140px;">
          <option value="">全部角色</option>
          <option value="admin">管理员</option>
          <option value="editor">编辑者</option>
          <option value="viewer">查看者</option>
        </select>
      </div>
      <div style="overflow-x: auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th>用户</th>
              <th>邮箱</th>
              <th>部门</th>
              <th>角色</th>
              <th>状态</th>
              <th>最近登录</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody id="user-table-body">
            <tr><td colspan="7" class="loading-state">加载中...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DefaultLayout>

<style>
  .org-node {
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    cursor: pointer;
    transition: color var(--transition-fast);
  }
  .org-node:hover {
    color: var(--primary);
  }
  .org-node.active {
    color: var(--primary);
    font-weight: 500;
  }
  .table-toolbar {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table th {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }
  .data-table td {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--border-light);
  }
  .data-table tbody tr:hover {
    background: var(--surface-hover);
  }
  .user-cell {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
  }
  .loading-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .error-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--danger);
    font-size: var(--text-sm);
  }
</style>

<script>
  import { getUsers, updateUserRole, getDepartments, syncLdap } from '@/lib/apis/users';
  import { ApiError } from '@/lib/api';

  interface User {
    id: string;
    name: string;
    email: string;
    dept: string;
    dept_name: string;
    role: string;
    status: string;
    last_login: string;
  }

  let currentDept = 'all';
  let users: User[] = [];

  /** 判断是否为 401/未登录错误（已在底层处理跳转，业务层需静默退出） */
  function isAuthError(err: unknown): boolean {
    return err instanceof ApiError && err.status === 401;
  }

  /** 从接口返回值中提取数组（兼容数组 / { items: [] } / 分页对象） */
  function toItems(raw: unknown): Record<string, unknown>[] {
    if (Array.isArray(raw)) return raw as Record<string, unknown>[];
    if (raw && typeof raw === 'object') {
      const obj = raw as { items?: unknown[] };
      if (Array.isArray(obj.items)) return obj.items as Record<string, unknown>[];
    }
    return [];
  }

  /** 规范化用户对象（兼容后端不同字段命名） */
  function normalizeUser(raw: Record<string, unknown>): User {
    return {
      id: String(raw.id || raw.user_id || ''),
      name: String(raw.name || raw.username || raw.display_name || '-'),
      email: String(raw.email || '-'),
      dept: String(raw.dept || raw.department || raw.dept_id || ''),
      dept_name: String(raw.dept_name || raw.department_name || raw.department || '-'),
      role: String(raw.role || 'viewer'),
      status: String(raw.status || 'active'),
      last_login: String(raw.last_login || raw.last_login_at || '从未登录'),
    };
  }

  async function loadDepartments(): Promise<void> {
    const tree = document.getElementById('org-tree')!;
    try {
      const depts = (await getDepartments()) as unknown as Record<string, unknown>[];
      const arr = Array.isArray(depts) ? depts : [];
      if (arr.length === 0) {
        tree.innerHTML = '<div class="org-node active" data-dept="all" style="font-weight: 600;">🏢 全部</div><div class="empty-state" style="padding: var(--space-3);">暂无部门数据</div>';
      } else {
        tree.innerHTML =
          '<div class="org-node active" data-dept="all" style="font-weight: 600;">🏢 全部</div>' +
          arr
            .map(
              (d) =>
                `<div class="org-node" data-dept="${escapeHtml(String(d.id || d.code || ''))}" style="padding-left: var(--space-4);">${escapeHtml(String(d.name || d.dept_name || '未命名'))}</div>`
            )
            .join('');
      }
      bindOrgNodes();
    } catch (err) {
      if (isAuthError(err)) return;
      const msg = err instanceof Error ? err.message : '网络异常';
      tree.innerHTML = `<div class="org-node active" data-dept="all" style="font-weight: 600;">🏢 全部</div><div class="error-state" style="padding: var(--space-3);">${escapeHtml(msg)}</div>`;
      bindOrgNodes();
    }
  }

  function bindOrgNodes(): void {
    document.querySelectorAll('.org-node').forEach((el) => {
      el.addEventListener('click', () => {
        document.querySelectorAll('.org-node').forEach((e) => e.classList.remove('active'));
        el.classList.add('active');
        currentDept = (el as HTMLElement).dataset.dept || 'all';
        renderTable();
      });
    });
  }

  async function loadUsers(): Promise<void> {
    const body = document.getElementById('user-table-body')!;
    body.innerHTML = '<tr><td colspan="7" class="loading-state">加载中...</td></tr>';
    try {
      const result = await getUsers();
      users = toItems(result).map(normalizeUser);
    } catch (err) {
      if (isAuthError(err)) return;
      const msg = err instanceof Error ? err.message : '网络异常';
      body.innerHTML = `<tr><td colspan="7" class="error-state">加载用户列表失败：${escapeHtml(msg)}<br/><button class="btn btn-outline btn-sm" id="retry-users" style="margin-top: var(--space-3);">重试</button></td></tr>`;
      document.getElementById('retry-users')?.addEventListener('click', loadUsers);
      return;
    }
    renderTable();
  }

  function renderTable(): void {
    const keyword = (document.getElementById('user-search') as HTMLInputElement).value.trim().toLowerCase();
    const roleFilter = (document.getElementById('role-filter') as HTMLSelectElement).value;

    const list = users.filter((u) => {
      if (currentDept !== 'all' && u.dept !== currentDept && u.dept_name !== currentDept) return false;
      if (keyword && !u.name.toLowerCase().includes(keyword) && !u.email.toLowerCase().includes(keyword)) return false;
      if (roleFilter && u.role !== roleFilter) return false;
      return true;
    });

    const roleMap: Record<string, { label: string; badge: string }> = {
      admin: { label: '管理员', badge: 'badge-primary' },
      editor: { label: '编辑者', badge: 'badge-success' },
      viewer: { label: '查看者', badge: 'badge-warning' },
    };

    const body = document.getElementById('user-table-body')!;
    if (list.length === 0) {
      body.innerHTML = '<tr><td colspan="7" class="empty-state">暂无用户</td></tr>';
      return;
    }
    body.innerHTML = list
      .map(
        (u) => {
          const roleInfo = roleMap[u.role] || { label: u.role, badge: 'badge-warning' };
          return `
        <tr>
          <td>
            <div class="user-cell">
              <div class="avatar avatar-sm">${escapeHtml(u.name.charAt(0))}</div>
              ${escapeHtml(u.name)}
            </div>
          </td>
          <td class="text-muted">${escapeHtml(u.email)}</td>
          <td>${escapeHtml(u.dept_name)}</td>
          <td><span class="badge ${roleInfo.badge}">${escapeHtml(roleInfo.label)}</span></td>
          <td><span class="badge ${u.status === 'active' ? 'badge-success' : 'badge-danger'}">${u.status === 'active' ? '启用' : '禁用'}</span></td>
          <td class="text-muted">${escapeHtml(u.last_login)}</td>
          <td>
            <div style="display: flex; gap: var(--space-2);">
              <button class="btn btn-ghost btn-sm" data-action="role" data-id="${escapeHtml(u.id)}">角色</button>
              <button class="btn btn-ghost btn-sm" data-action="toggle" data-id="${escapeHtml(u.id)}">${u.status === 'active' ? '禁用' : '启用'}</button>
            </div>
          </td>
        </tr>`;
        }
      )
      .join('');

    body.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = (btn as HTMLElement).dataset.action!;
        const id = (btn as HTMLElement).dataset.id!;
        const user = users.find((u) => u.id === id);
        if (!user) return;
        if (action === 'role') {
          const newRole = prompt(`修改 ${user.name} 的角色（admin/editor/viewer）:`, user.role);
          if (newRole && ['admin', 'editor', 'viewer'].includes(newRole) && newRole !== user.role) {
            try {
              await updateUserRole(id, newRole);
              user.role = newRole;
              renderTable();
              alert('角色已更新');
            } catch (err) {
              if (isAuthError(err)) return;
              alert(err instanceof Error ? err.message : '网络异常');
            }
          }
        } else if (action === 'toggle') {
          alert('启用/禁用功能开发中');
        }
      });
    });
  }

  function escapeHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  document.getElementById('user-search')?.addEventListener('input', renderTable);
  document.getElementById('role-filter')?.addEventListener('change', renderTable);

  document.getElementById('ldap-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('ldap-btn') as HTMLButtonElement;
    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = '🔄 同步中...';
    try {
      await syncLdap();
      alert('LDAP 同步已完成');
      await loadUsers();
    } catch (err) {
      if (isAuthError(err)) return;
      alert(err instanceof Error ? err.message : '网络异常');
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  });

  document.getElementById('invite-btn')?.addEventListener('click', () => {
    const email = prompt('请输入被邀请人的邮箱：');
    if (email) {
      alert('邀请功能开发中');
    }
  });

  // 初始化
  loadDepartments();
  loadUsers();
</script>
