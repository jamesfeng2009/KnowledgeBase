---
/**
 * 反馈管理页面
 * 反馈列表 + 反馈统计 + 反馈处理流程 + 改进建议
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '治理后台', href: '/admin' }, { label: '反馈管理' }];
---

<DefaultLayout title="反馈管理" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">反馈管理</h1>
  </div>

  <!-- 反馈统计 -->
  <div class="grid grid-cols-4" style="margin-bottom: var(--space-5);">
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">反馈总数</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--primary);" id="stat-total">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">待处理</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--warning);" id="stat-pending">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">已处理</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--success);" id="stat-resolved">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">满意度</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--info);" id="stat-satisfaction">--</div>
    </div>
  </div>

  <!-- 反馈类型分布 -->
  <div class="grid grid-cols-2" style="margin-bottom: var(--space-5);">
    <div class="card">
      <div class="card-header"><h3>反馈类型分布</h3></div>
      <div id="type-distribution"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3>改进建议（AI 生成）</h3></div>
      <div id="suggestions">
        <div class="suggestion-item">
          <span class="suggestion-priority high">高</span>
          <div>
            <div style="font-weight: 500; font-size: var(--text-sm);">优化搜索响应速度</div>
            <div class="text-muted" style="font-size: var(--text-xs);">23 条反馈提及搜索慢，建议增加缓存层</div>
          </div>
        </div>
        <div class="suggestion-item">
          <span class="suggestion-priority medium">中</span>
          <div>
            <div style="font-weight: 500; font-size: var(--text-sm);">增强移动端适配</div>
            <div class="text-muted" style="font-size: var(--text-xs);">15 条反馈反映手机端体验不佳</div>
          </div>
        </div>
        <div class="suggestion-item">
          <span class="suggestion-priority medium">中</span>
          <div>
            <div style="font-weight: 500; font-size: var(--text-sm);">补充搜索结果排序</div>
            <div class="text-muted" style="font-size: var(--text-xs);">8 条反馈希望按相关度/时间排序</div>
          </div>
        </div>
        <div class="suggestion-item">
          <span class="suggestion-priority low">低</span>
          <div>
            <div style="font-weight: 500; font-size: var(--text-sm);">增加深色模式</div>
            <div class="text-muted" style="font-size: var(--text-xs);">5 条反馈建议增加夜间模式</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 反馈列表 -->
  <div class="card">
    <div class="card-header">
      <h3>反馈列表</h3>
      <div style="display: flex; gap: var(--space-2);">
        <select class="form-input" id="feedback-type" style="width: 140px; font-size: var(--text-sm);">
          <option value="">全部类型</option>
          <option value="bug">问题反馈</option>
          <option value="feature">功能建议</option>
          <option value="experience">体验反馈</option>
        </select>
        <select class="form-input" id="feedback-status" style="width: 120px; font-size: var(--text-sm);">
          <option value="">全部状态</option>
          <option value="pending">待处理</option>
          <option value="processing">处理中</option>
          <option value="resolved">已解决</option>
        </select>
      </div>
    </div>
    <div id="feedback-list">
      <div class="loading-state">加载中...</div>
    </div>
  </div>
</DefaultLayout>

<style>
  .feedback-item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-light);
  }
  .feedback-item:last-child {
    border-bottom: none;
  }
  .feedback-item-body {
    flex: 1;
    min-width: 0;
  }
  .feedback-item-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .feedback-item-title {
    font-weight: 500;
    font-size: var(--text-base);
    color: var(--text);
  }
  .feedback-item-content {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-2);
  }
  .feedback-item-meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .type-bar-item {
    margin-bottom: var(--space-3);
  }
  .type-bar-header {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }
  .type-bar {
    height: 8px;
    background: var(--surface-muted);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .type-bar-fill {
    height: 100%;
    border-radius: var(--radius-full);
  }
  .suggestion-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-light);
  }
  .suggestion-item:last-child {
    border-bottom: none;
  }
  .suggestion-priority {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-white);
    flex-shrink: 0;
  }
  .suggestion-priority.high {
    background: var(--danger);
  }
  .suggestion-priority.medium {
    background: var(--warning);
  }
  .suggestion-priority.low {
    background: var(--info);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--text-muted);
  }
</style>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_BASE || 'http://localhost:8000';
  const TOKEN_KEY = 'ekb_access_token';

  const typeMap: Record<string, { label: string; badge: string; color: string }> = {
    bug: { label: '问题反馈', badge: 'badge-danger', color: 'var(--danger)' },
    feature: { label: '功能建议', badge: 'badge-primary', color: 'var(--primary)' },
    experience: { label: '体验反馈', badge: 'badge-warning', color: 'var(--warning)' },
  };
  const statusMap: Record<string, { label: string; badge: string }> = {
    pending: { label: '待处理', badge: 'badge-warning' },
    processing: { label: '处理中', badge: 'badge-primary' },
    resolved: { label: '已解决', badge: 'badge-success' },
  };

  function mockFeedbacks() {
    return [
      { id: 'f1', type: 'bug', title: '搜索结果加载缓慢', content: '输入关键词后，搜索结果需要 5 秒以上才显示，影响使用体验。', user: '张三', status: 'pending', time: '2 小时前' },
      { id: 'f2', type: 'feature', title: '希望增加文档收藏功能', content: '经常需要查阅某些文档，希望可以收藏到个人书签。', user: '李四', status: 'processing', time: '昨天' },
      { id: 'f3', type: 'experience', title: '移动端排版有问题', content: '手机端访问时，侧边栏菜单无法正常展开。', user: '王五', status: 'pending', time: '2 天前' },
      { id: 'f4', type: 'feature', title: '希望支持 Markdown 编辑', content: '协同编辑器如果能支持 Markdown 语法会方便很多。', user: '赵六', status: 'resolved', time: '3 天前' },
      { id: 'f5', type: 'bug', title: '导出 PDF 格式错误', content: '导出 PDF 时部分表格显示错位。', user: '钱七', status: 'resolved', time: '5 天前' },
    ];
  }

  async function loadFeedbacks() {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      window.location.href = '/auth/login';
      return;
    }
    let list: any[] = [];
    try {
      const res = await fetch(`${API_BASE}/api/v1/admin/feedback`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const result = await res.json();
        list = result.data?.items || result.data || [];
      } else if (res.status === 401) {
        window.location.href = '/auth/login';
        return;
      }
    } catch {
      // ignore
    }
    if (list.length === 0) list = mockFeedbacks();
    renderList(list);
    renderTypeDist(list);
    updateStats(list);
  }

  function updateStats(list: any[]) {
    const setText = (id: string, v: string | number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(v);
    };
    setText('stat-total', list.length);
    setText('stat-pending', list.filter((f) => f.status === 'pending').length);
    setText('stat-resolved', list.filter((f) => f.status === 'resolved').length);
    setText('stat-satisfaction', '92%');
  }

  function renderTypeDist(list: any[]) {
    const counts: Record<string, number> = {};
    list.forEach((f) => {
      counts[f.type] = (counts[f.type] || 0) + 1;
    });
    const max = Math.max(...Object.values(counts), 1);
    document.getElementById('type-distribution')!.innerHTML = Object.entries(counts)
      .map(
        ([type, count]) => `
      <div class="type-bar-item">
        <div class="type-bar-header">
          <span>${typeMap[type]?.label || type}</span>
          <span class="text-muted">${count} 条</span>
        </div>
        <div class="type-bar">
          <div class="type-bar-fill" style="width: ${(count / max) * 100}%; background: ${typeMap[type]?.color};"></div>
        </div>
      </div>`
      )
      .join('');
  }

  function renderList(list: any[]) {
    const typeFilter = (document.getElementById('feedback-type') as HTMLSelectElement).value;
    const statusFilter = (document.getElementById('feedback-status') as HTMLSelectElement).value;

    const filtered = list.filter((f) => {
      if (typeFilter && f.type !== typeFilter) return false;
      if (statusFilter && f.status !== statusFilter) return false;
      return true;
    });

    const container = document.getElementById('feedback-list')!;
    if (filtered.length === 0) {
      container.innerHTML = '<div class="loading-state">暂无反馈</div>';
      return;
    }
    container.innerHTML = filtered
      .map(
        (f) => `
      <div class="feedback-item">
        <div class="avatar avatar-sm">${escapeHtml(f.user.charAt(0))}</div>
        <div class="feedback-item-body">
          <div class="feedback-item-header">
            <span class="feedback-item-title">${escapeHtml(f.title)}</span>
            <span class="badge ${typeMap[f.type].badge}">${typeMap[f.type].label}</span>
            <span class="badge ${statusMap[f.status].badge}">${statusMap[f.status].label}</span>
          </div>
          <p class="feedback-item-content">${escapeHtml(f.content)}</p>
          <div class="feedback-item-meta">
            <span>提交人：${escapeHtml(f.user)}</span>
            <span>${escapeHtml(f.time)}</span>
          </div>
        </div>
        <div style="display: flex; flex-direction: column; gap: var(--space-2);">
          ${f.status === 'pending' ? `<button class="btn btn-primary btn-sm" data-action="process" data-id="${f.id}">开始处理</button>` : ''}
          ${f.status === 'processing' ? `<button class="btn btn-success btn-sm" data-action="resolve" data-id="${f.id}">标记解决</button>` : ''}
          <button class="btn btn-ghost btn-sm" data-action="reply" data-id="${f.id}">回复</button>
        </div>
      </div>`
      )
      .join('');

    container.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = (btn as HTMLElement).dataset.action!;
        const id = (btn as HTMLElement).dataset.id!;
        if (action === 'reply') {
          const reply = prompt('输入回复内容：');
          if (reply) {
            alert('回复已发送');
          }
        } else {
          const token = localStorage.getItem(TOKEN_KEY);
          const newStatus = action === 'process' ? 'processing' : 'resolved';
          try {
            await fetch(`${API_BASE}/api/v1/admin/feedback/${id}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
              body: JSON.stringify({ status: newStatus }),
            });
            loadFeedbacks();
          } catch {
            alert('操作失败');
          }
        }
      });
    });
  }

  function escapeHtml(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  document.getElementById('feedback-type')?.addEventListener('change', () => {
    const list = mockFeedbacks();
    renderList(list);
  });
  document.getElementById('feedback-status')?.addEventListener('change', () => {
    const list = mockFeedbacks();
    renderList(list);
  });

  loadFeedbacks();
</script>
