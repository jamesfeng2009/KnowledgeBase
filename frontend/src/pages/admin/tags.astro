---
/**
 * 标签管理页面
 * 标签列表 + 标签分组 + 合并标签 + 标签使用统计
 * 数据来源：GET /api/v1/admin/tags（若后端无独立标签 API，标签通过文档智能处理自动提取）
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const breadcrumb = [{ label: '治理后台', href: '/admin' }, { label: '标签管理' }];
---

<DefaultLayout title="标签管理" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">标签管理</h1>
    <button class="btn btn-primary btn-sm" id="create-tag-btn">＋ 新建标签</button>
  </div>

  <!-- 统计 -->
  <div class="grid grid-cols-4" style="margin-bottom: var(--space-5);">
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">标签总数</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--primary);" id="stat-total">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">分组数</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--success);" id="stat-groups">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">最常用</div>
      <div style="font-size: var(--text-lg); font-weight: 600; color: var(--warning); padding-top: var(--space-2);" id="stat-popular">--</div>
    </div>
    <div class="card">
      <div class="text-muted" style="font-size: var(--text-sm);">未使用</div>
      <div style="font-size: var(--text-3xl); font-weight: 600; color: var(--text-muted);" id="stat-unused">--</div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5);">
    <!-- 标签列表 -->
    <div class="card">
      <div class="card-header">
        <h3>标签列表</h3>
        <div style="display: flex; gap: var(--space-2); align-items: center;">
          <input type="text" class="form-input" id="tag-search" placeholder="搜索..." style="width: 160px; font-size: var(--text-sm);" />
          <button class="btn btn-outline btn-sm" id="merge-btn">合并标签</button>
        </div>
      </div>
      <div id="tag-groups">
        <div class="loading-state">加载中...</div>
      </div>
    </div>

    <!-- 标签使用统计 -->
    <div class="card">
      <div class="card-header"><h3>使用统计（Top 10）</h3></div>
      <div id="tag-stats">
        <div class="loading-state">加载中...</div>
      </div>
    </div>
  </div>
</DefaultLayout>

<style>
  .tag-group {
    margin-bottom: var(--space-4);
  }
  .tag-group-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-light);
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .tag-item:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .tag-item.selected {
    background: var(--primary);
    color: var(--text-white);
    border-color: var(--primary);
  }
  .tag-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .tag-item.selected .tag-count {
    color: rgba(255, 255, 255, 0.8);
  }
  .stat-bar-item {
    margin-bottom: var(--space-3);
  }
  .stat-bar-header {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }
  .stat-bar {
    height: 6px;
    background: var(--surface-muted);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .stat-bar-fill {
    height: 100%;
    background: var(--primary);
    border-radius: var(--radius-full);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--text-muted);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .error-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--danger);
    font-size: var(--text-sm);
  }
</style>

<script>
  import { API_BASE } from '@/lib/api';

  interface Tag {
    id: string;
    name: string;
    group: string;
    count: number;
  }

  let tags: Tag[] = [];
  let selectedTags: Set<string> = new Set();
  let apiAvailable = true;

  /** 统一鉴权 fetch */
  async function authFetch(path: string, options: RequestInit = {}): Promise<Response> {
    // P0 安全修复：认证通过 HttpOnly Cookie 自动携带
    const res = await fetch(`${API_BASE}${path}`, {
      ...options,
      credentials: 'include',
    });
    if (res.status === 401) {
      window.location.href = '/auth/login';
      throw new Error('登录已过期，请重新登录');
    }
    return res;
  }

  async function extractData<T>(res: Response): Promise<T> {
    const result = await res.json().catch(() => null);
    if (result && typeof result === 'object' && 'data' in result && 'code' in result) {
      return result.data as T;
    }
    return result as T;
  }

  function normalizeTag(raw: Record<string, unknown>): Tag {
    return {
      id: String(raw.id || raw.tag_id || raw.name || ''),
      name: String(raw.name || raw.tag || raw.label || '未命名'),
      group: String(raw.group || raw.category || raw.type || '其他'),
      count: typeof raw.count === 'number' ? raw.count : (typeof raw.usage_count === 'number' ? raw.usage_count : 0),
    };
  }

  async function loadTags(): Promise<void> {
    const groupsEl = document.getElementById('tag-groups')!;
    const statsEl = document.getElementById('tag-stats')!;
    groupsEl.innerHTML = '<div class="loading-state">加载中...</div>';
    statsEl.innerHTML = '<div class="loading-state">加载中...</div>';

    try {
      const res = await authFetch('/api/v1/admin/tags');
      if (res.status === 404) {
        apiAvailable = false;
        tags = [];
      } else if (res.ok) {
        const raw = await extractData<unknown>(res);
        const arr = Array.isArray(raw) ? raw : ((raw as { items?: unknown[] })?.items || []);
        tags = (arr as Record<string, unknown>[]).map(normalizeTag);
      } else {
        apiAvailable = false;
        tags = [];
      }
    } catch (err) {
      // 401 已在 authFetch 处理；其他错误显示空状态
      if (err instanceof Error && err.message.includes('登录')) {
        return;
      }
      apiAvailable = false;
      tags = [];
    }

    if (!apiAvailable || tags.length === 0) {
      groupsEl.innerHTML = '<div class="empty-state">暂无标签数据，文档智能处理后将自动生成</div>';
      statsEl.innerHTML = '<div class="empty-state">暂无标签使用统计</div>';
      updateStats();
      return;
    }

    renderTags();
    renderStats();
    updateStats();
  }

  function renderTags(): void {
    const keyword = (document.getElementById('tag-search') as HTMLInputElement).value.trim().toLowerCase();
    const list = keyword ? tags.filter((t) => t.name.toLowerCase().includes(keyword)) : tags;

    // 按分组归类
    const groups: Record<string, Tag[]> = {};
    list.forEach((t) => {
      if (!groups[t.group]) groups[t.group] = [];
      groups[t.group].push(t);
    });

    const container = document.getElementById('tag-groups')!;
    const groupKeys = Object.keys(groups);
    if (groupKeys.length === 0) {
      container.innerHTML = '<div class="empty-state">未找到匹配的标签</div>';
      return;
    }
    container.innerHTML = groupKeys
      .map(
        (group) => `
      <div class="tag-group">
        <div class="tag-group-title">${escapeHtml(group)} (${groups[group].length})</div>
        <div class="tag-list">
          ${groups[group]
            .map(
              (t) => `
            <span class="tag-item ${selectedTags.has(t.id) ? 'selected' : ''}" data-id="${escapeHtml(t.id)}">
              ${escapeHtml(t.name)}
              <span class="tag-count">${t.count}</span>
            </span>`
            )
            .join('')}
        </div>
      </div>`
      )
      .join('');

    document.querySelectorAll('.tag-item').forEach((el) => {
      el.addEventListener('click', () => {
        const id = (el as HTMLElement).dataset.id!;
        if (selectedTags.has(id)) selectedTags.delete(id);
        else selectedTags.add(id);
        renderTags();
      });
    });
  }

  function renderStats(): void {
    const sorted = [...tags].sort((a, b) => b.count - a.count).slice(0, 10);
    const max = sorted[0]?.count || 1;
    const container = document.getElementById('tag-stats')!;
    if (sorted.length === 0 || sorted.every((t) => t.count === 0)) {
      container.innerHTML = '<div class="empty-state">暂无标签使用统计</div>';
      return;
    }
    container.innerHTML = sorted
      .map(
        (t) => `
      <div class="stat-bar-item">
        <div class="stat-bar-header">
          <span>${escapeHtml(t.name)}</span>
          <span class="text-muted">${t.count} 次</span>
        </div>
        <div class="stat-bar">
          <div class="stat-bar-fill" style="width: ${(t.count / max) * 100}%;"></div>
        </div>
      </div>`
      )
      .join('');
  }

  function updateStats(): void {
    const setText = (id: string, v: string | number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(v);
    };
    setText('stat-total', tags.length);
    setText('stat-groups', new Set(tags.map((t) => t.group)).size);
    const sorted = [...tags].sort((a, b) => b.count - a.count);
    setText('stat-popular', sorted[0]?.name || '--');
    setText('stat-unused', tags.filter((t) => t.count === 0).length);
  }

  function escapeHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  document.getElementById('tag-search')?.addEventListener('input', renderTags);

  document.getElementById('create-tag-btn')?.addEventListener('click', () => {
    alert('标签通过文档智能处理自动提取，可在文档详情页编辑');
  });

  document.getElementById('merge-btn')?.addEventListener('click', () => {
    if (selectedTags.size < 2) {
      alert('请选择至少 2 个标签进行合并');
      return;
    }
    alert('标签合并功能需要后端支持');
  });

  loadTags();
</script>
