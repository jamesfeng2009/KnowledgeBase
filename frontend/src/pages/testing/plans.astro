---
/**
 * 测试计划 + AI 编排页面
 * 计划列表 + 新建计划 + AI 编排结果 + 执行记录
 * 数据来源：GET/POST /api/v1/testing/plans、POST /api/v1/testing/plans/{id}/orchestrate、GET /api/v1/testing/executions
 */
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import Modal from '@/components/common/Modal.astro';

const breadcrumb = [{ label: '测试平台', href: '/testing' }, { label: '测试计划' }];
---

<DefaultLayout title="测试计划" breadcrumb={breadcrumb}>
  <div class="page-header">
    <h1 class="page-title">测试计划</h1>
    <button class="btn btn-primary btn-sm" id="new-plan-btn" data-modal-open="plan-modal">
      ＋ 新建计划
    </button>
  </div>

  <!-- 计划列表 -->
  <div class="card" style="margin-bottom: var(--space-5);">
    <div class="card-header">
      <h3>计划列表</h3>
    </div>
    <div id="plan-list">
      <div class="loading-state">加载中...</div>
    </div>
  </div>

  <!-- AI 编排结果 -->
  <div class="card" style="margin-bottom: var(--space-5);">
    <div class="card-header">
      <h3>AI 编排结果</h3>
    </div>
    <div id="orchestration-result">
      <div class="empty-state">点击计划操作中的「AI 编排」按钮查看编排方案</div>
    </div>
  </div>

  <!-- 执行记录 -->
  <div class="card">
    <div class="card-header">
      <h3>执行记录<span id="execution-plan-name" style="font-size: var(--text-sm); font-weight: 400; color: var(--text-muted); margin-left: var(--space-2);"></span></h3>
    </div>
    <div id="execution-list">
      <div class="empty-state">点击计划操作中的「查看执行」按钮查看执行记录</div>
    </div>
  </div>

  <!-- 新建计划弹窗 -->
  <Modal id="plan-modal" title="新建测试计划" size="md">
    <div class="form-group">
      <label class="form-label">计划名称（必填）</label>
      <input type="text" class="form-input" id="plan-name" placeholder="请输入计划名称" />
      <div class="form-error" id="plan-name-error" style="display: none;">请输入计划名称</div>
    </div>
    <div class="form-group">
      <label class="form-label">计划描述</label>
      <textarea
        class="form-textarea"
        id="plan-description"
        placeholder="请输入计划描述..."
        rows="3"
      ></textarea>
    </div>
    <div class="form-group">
      <label class="form-label">执行策略</label>
      <select class="form-select" id="plan-strategy">
        <option value="sequential">顺序执行</option>
        <option value="parallel">并行执行</option>
        <option value="priority">优先级执行</option>
        <option value="batch">批量执行</option>
      </select>
    </div>
    <div class="modal-footer" slot="footer">
      <button class="btn btn-ghost" data-modal-close>取消</button>
      <button class="btn btn-primary" id="plan-create-confirm">创建计划</button>
    </div>
  </Modal>
</DefaultLayout>

<style is:global>
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table th {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }
  .data-table td {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--border-light);
  }
  .data-table tbody tr:hover {
    background: var(--surface-hover);
  }
  .data-table tbody tr.row-selected {
    background: var(--primary-bg);
  }
  .loading-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
  }
  .empty-state {
    text-align: center;
    padding: var(--space-8);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .error-state {
    text-align: center;
    padding: var(--space-6);
    color: var(--danger);
    font-size: var(--text-sm);
  }

  /* 自定义 badge 颜色 */
  .badge-info {
    background: var(--info-bg);
    color: var(--info);
  }
  .badge-muted {
    background: var(--surface-hover);
    color: var(--text-muted);
  }

  /* AI 编排结果样式 */
  .orchestration-section {
    margin-bottom: var(--space-4);
  }
  .orchestration-section:last-child {
    margin-bottom: 0;
  }
  .orchestration-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }
  .orchestration-content {
    font-size: var(--text-sm);
    color: var(--text);
    line-height: var(--lh-relaxed);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-muted);
    border-radius: var(--radius);
  }
  .orchestration-order {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .orchestration-order-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    background: var(--primary-bg);
    color: var(--primary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }
  .orchestration-order-arrow {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
  .orchestration-node {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-light);
  }
  .orchestration-node:last-child {
    border-bottom: none;
  }
  .orchestration-node-name {
    font-weight: 500;
    color: var(--text);
    min-width: 120px;
    flex-shrink: 0;
  }
  .orchestration-node-cases {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .orchestration-dep {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    font-size: var(--text-sm);
  }
  .orchestration-dep-key {
    font-family: var(--font-mono);
    color: var(--primary);
    min-width: 120px;
    flex-shrink: 0;
  }
  .orchestration-dep-arrow {
    color: var(--text-muted);
  }
  .orchestration-dep-val {
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }
</style>

<script>
  import {
    getPlans,
    createPlan,
    orchestratePlan,
    getExecutions,
    type TestPlan,
    type TestExecution,
  } from '@/lib/apis/testing';
  import { ApiError } from '@/lib/api';

  /** 当前选中的计划 ID */
  let selectedPlanId: string | null = null;

  /** HTML 转义 */
  function escapeHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /** 判断是否为 401/未登录错误 */
  function isAuthError(err: unknown): boolean {
    return err instanceof ApiError && err.status === 401;
  }

  /** 从接口返回值中提取数组 */
  function toItems(raw: unknown): Record<string, unknown>[] {
    if (Array.isArray(raw)) return raw as Record<string, unknown>[];
    if (raw && typeof raw === 'object') {
      const obj = raw as { items?: unknown[] };
      if (Array.isArray(obj.items)) return obj.items as Record<string, unknown>[];
    }
    return [];
  }

  /** 规范化计划对象 */
  function normalizePlan(raw: Record<string, unknown>): TestPlan {
    const orchestration = raw.ai_orchestration as TestPlan['ai_orchestration'];
    return {
      id: String(raw.id || raw.plan_id || ''),
      project_id: String(raw.project_id || raw.projectId || ''),
      name: String(raw.name || raw.plan_name || '未命名计划'),
      description: typeof raw.description === 'string' ? raw.description : undefined,
      case_ids: Array.isArray(raw.case_ids) ? (raw.case_ids as string[]) : undefined,
      execution_strategy: String(raw.execution_strategy || raw.strategy || 'sequential'),
      ai_orchestration: orchestration || undefined,
      status: String(raw.status || 'draft'),
      created_by: String(raw.created_by || raw.createdBy || '-'),
      created_at: raw.created_at ? String(raw.created_at) : undefined,
    };
  }

  /** 规范化执行记录对象 */
  function normalizeExecution(raw: Record<string, unknown>): TestExecution {
    return {
      id: String(raw.id || raw.execution_id || ''),
      plan_id: raw.plan_id ? String(raw.plan_id) : undefined,
      case_id: String(raw.case_id || raw.caseId || '-'),
      executor_id: raw.executor_id ? String(raw.executor_id) : undefined,
      executor: String(raw.executor || raw.executor_name || '-'),
      status: String(raw.status || 'pending'),
      result: typeof raw.result === 'string' ? raw.result : undefined,
      execution_log: raw.execution_log as Record<string, unknown>,
      failure_reason: typeof raw.failure_reason === 'string' ? raw.failure_reason : undefined,
      duration_seconds: typeof raw.duration_seconds === 'number'
        ? raw.duration_seconds
        : Number(raw.duration_seconds) || 0,
      started_at: raw.started_at ? String(raw.started_at) : undefined,
      completed_at: raw.completed_at ? String(raw.completed_at) : undefined,
      evidence_ref: raw.evidence_ref as Record<string, unknown>,
      compounding_status: typeof raw.compounding_status === 'string' ? raw.compounding_status : undefined,
    };
  }

  /** 执行策略 → 标签 */
  const strategyMap: Record<string, string> = {
    sequential: '顺序执行',
    parallel: '并行执行',
    priority: '优先级执行',
    batch: '批量执行',
  };

  /** 计划状态 → badge */
  const planStatusMap: Record<string, { label: string; badge: string }> = {
    draft: { label: '草稿', badge: 'badge-muted' },
    ready: { label: '就绪', badge: 'badge-primary' },
    running: { label: '执行中', badge: 'badge-info' },
    completed: { label: '已完成', badge: 'badge-success' },
    archived: { label: '已归档', badge: 'badge-muted' },
  };

  /** 执行状态 → badge */
  const execStatusMap: Record<string, { label: string; badge: string }> = {
    passed: { label: '通过', badge: 'badge-success' },
    failed: { label: '失败', badge: 'badge-danger' },
    blocked: { label: '阻塞', badge: 'badge-warning' },
    pending: { label: '待执行', badge: 'badge-muted' },
    running: { label: '执行中', badge: 'badge-info' },
  };

  /** 格式化耗时 */
  function formatDuration(seconds: number): string {
    if (seconds <= 0) return '-';
    if (seconds < 60) return `${seconds.toFixed(1)}s`;
    const m = Math.floor(seconds / 60);
    const s = Math.round(seconds % 60);
    return `${m}m ${s}s`;
  }

  /** 加载计划列表 */
  async function loadPlans(): Promise<void> {
    const container = document.getElementById('plan-list')!;
    container.innerHTML = '<div class="loading-state">加载中...</div>';

    let list: TestPlan[] = [];
    try {
      const page = await getPlans(undefined, 1, 50);
      list = toItems(page).map(normalizePlan);
    } catch (err) {
      if (isAuthError(err)) return;
      const msg = err instanceof Error ? err.message : '网络异常';
      container.innerHTML = `
        <div class="error-state">
          <div>加载计划列表失败：${escapeHtml(msg)}</div>
          <button class="btn btn-outline btn-sm" id="retry-plans" style="margin-top: var(--space-3);">重试</button>
        </div>`;
      document.getElementById('retry-plans')?.addEventListener('click', loadPlans);
      return;
    }

    renderPlans(list);
  }

  /** 渲染计划列表表格 */
  function renderPlans(list: TestPlan[]): void {
    const container = document.getElementById('plan-list')!;

    if (list.length === 0) {
      container.innerHTML = '<div class="empty-state">暂无数据</div>';
      return;
    }

    container.innerHTML = `
      <div style="overflow-x: auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th>计划名</th>
              <th>执行策略</th>
              <th>状态</th>
              <th>用例数</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${list
              .map((plan) => {
                const statusInfo = planStatusMap[plan.status] || { label: plan.status, badge: 'badge-muted' };
                const caseCount = plan.case_ids?.length ?? 0;
                const isSelected = plan.id === selectedPlanId;
                return `
              <tr data-plan-id="${escapeHtml(plan.id)}" ${isSelected ? 'class="row-selected"' : ''}>
                <td>${escapeHtml(plan.name)}</td>
                <td><span class="badge badge-primary">${escapeHtml(strategyMap[plan.execution_strategy] || plan.execution_strategy)}</span></td>
                <td><span class="badge ${statusInfo.badge}">${escapeHtml(statusInfo.label)}</span></td>
                <td>${caseCount}</td>
                <td>
                  <div style="display: flex; gap: var(--space-2);">
                    <button class="btn btn-outline btn-sm" data-action="orchestrate" data-id="${escapeHtml(plan.id)}">AI 编排</button>
                    <button class="btn btn-ghost btn-sm" data-action="executions" data-id="${escapeHtml(plan.id)}" data-name="${escapeHtml(plan.name)}">查看执行</button>
                  </div>
                </td>
              </tr>`;
              })
              .join('')}
          </tbody>
        </table>
      </div>`;

    // 绑定操作按钮
    container.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = (btn as HTMLElement).dataset.action!;
        const id = (btn as HTMLElement).dataset.id!;
        if (action === 'orchestrate') {
          doOrchestrate(id);
        } else if (action === 'executions') {
          const name = (btn as HTMLElement).dataset.name || '';
          selectPlan(id, name);
        }
      });
    });
  }

  /** AI 编排 */
  async function doOrchestrate(planId: string): Promise<void> {
    const container = document.getElementById('orchestration-result')!;
    container.innerHTML = '<div class="loading-state">AI 编排中，请稍候...</div>';

    try {
      const plan = await orchestratePlan(planId);
      renderOrchestration(plan);
    } catch (err) {
      if (isAuthError(err)) return;
      const msg = err instanceof Error ? err.message : '网络异常';
      container.innerHTML = `
        <div class="error-state">
          <div>AI 编排失败：${escapeHtml(msg)}</div>
          <button class="btn btn-outline btn-sm" id="retry-orchestrate" style="margin-top: var(--space-3);">重试</button>
        </div>`;
      document.getElementById('retry-orchestrate')?.addEventListener('click', () => doOrchestrate(planId));
    }
  }

  /** 渲染编排结果 */
  function renderOrchestration(plan: TestPlan): void {
    const container = document.getElementById('orchestration-result')!;
    const orch = plan.ai_orchestration;

    if (!orch) {
      container.innerHTML = '<div class="empty-state">该计划暂无 AI 编排方案</div>';
      return;
    }

    // 执行顺序
    const orderHtml = orch.execution_order && orch.execution_order.length > 0
      ? `<div class="orchestration-order">
          ${orch.execution_order
            .map(
              (caseId, i) =>
                `<span class="orchestration-order-item">${escapeHtml(caseId)}</span>` +
                (i < orch.execution_order!.length - 1 ? '<span class="orchestration-order-arrow">→</span>' : '')
            )
            .join('')}
        </div>`
      : '<div class="orchestration-content">暂无执行顺序数据</div>';

    // 节点分配
    const nodeAssignments = orch.node_assignments || {};
    const nodeKeys = Object.keys(nodeAssignments);
    const nodesHtml = nodeKeys.length > 0
      ? `<div class="orchestration-content">
          ${nodeKeys
            .map((node) => {
              const cases = nodeAssignments[node] || [];
              return `
              <div class="orchestration-node">
                <span class="orchestration-node-name">${escapeHtml(node)}</span>
                <span class="orchestration-node-cases">${cases.map(escapeHtml).join(', ') || '无分配'}</span>
              </div>`;
            })
            .join('')}
        </div>`
      : '<div class="orchestration-content">暂无节点分配数据</div>';

    // 依赖关系
    const dependencies = orch.dependencies || {};
    const depKeys = Object.keys(dependencies);
    const depsHtml = depKeys.length > 0
      ? `<div class="orchestration-content">
          ${depKeys
            .map((key) => {
              const deps = dependencies[key] || [];
              return `
              <div class="orchestration-dep">
                <span class="orchestration-dep-key">${escapeHtml(key)}</span>
                <span class="orchestration-dep-arrow">依赖于 →</span>
                <span class="orchestration-dep-val">${deps.map(escapeHtml).join(', ') || '无'}</span>
              </div>`;
            })
            .join('')}
        </div>`
      : '<div class="orchestration-content">暂无依赖关系数据</div>';

    // 编排理由
    const rationaleHtml = orch.rationale
      ? `<div class="orchestration-content">${escapeHtml(orch.rationale)}</div>`
      : '<div class="orchestration-content">暂无编排理由</div>';

    container.innerHTML = `
      <div class="orchestration-section">
        <div class="orchestration-label">计划：${escapeHtml(plan.name)}</div>
      </div>
      <div class="orchestration-section">
        <div class="orchestration-label">执行顺序</div>
        ${orderHtml}
      </div>
      <div class="orchestration-section">
        <div class="orchestration-label">节点分配</div>
        ${nodesHtml}
      </div>
      <div class="orchestration-section">
        <div class="orchestration-label">依赖关系</div>
        ${depsHtml}
      </div>
      <div class="orchestration-section">
        <div class="orchestration-label">编排理由</div>
        ${rationaleHtml}
      </div>`;
  }

  /** 选中计划并加载执行记录 */
  function selectPlan(planId: string, planName: string): void {
    selectedPlanId = planId;

    // 更新执行记录标题
    const nameEl = document.getElementById('execution-plan-name');
    if (nameEl) nameEl.textContent = `· ${planName}`;

    // 更新选中行高亮
    document.querySelectorAll('#plan-list tbody tr').forEach((tr) => {
      tr.classList.toggle('row-selected', tr.getAttribute('data-plan-id') === planId);
    });

    loadExecutions(planId);
  }

  /** 加载执行记录 */
  async function loadExecutions(planId: string): Promise<void> {
    const container = document.getElementById('execution-list')!;
    container.innerHTML = '<div class="loading-state">加载中...</div>';

    let list: TestExecution[] = [];
    try {
      const page = await getExecutions(planId, 1, 50);
      list = toItems(page).map(normalizeExecution);
    } catch (err) {
      if (isAuthError(err)) return;
      const msg = err instanceof Error ? err.message : '网络异常';
      container.innerHTML = `
        <div class="error-state">
          <div>加载执行记录失败：${escapeHtml(msg)}</div>
          <button class="btn btn-outline btn-sm" id="retry-executions" style="margin-top: var(--space-3);">重试</button>
        </div>`;
      document.getElementById('retry-executions')?.addEventListener('click', () => loadExecutions(planId));
      return;
    }

    renderExecutions(list);
  }

  /** 渲染执行记录表格 */
  function renderExecutions(list: TestExecution[]): void {
    const container = document.getElementById('execution-list')!;

    if (list.length === 0) {
      container.innerHTML = '<div class="empty-state">暂无数据</div>';
      return;
    }

    container.innerHTML = `
      <div style="overflow-x: auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th>用例</th>
              <th>状态</th>
              <th>执行者</th>
              <th>耗时</th>
              <th>失败原因</th>
            </tr>
          </thead>
          <tbody>
            ${list
              .map((exec) => {
                const statusInfo = execStatusMap[exec.status] || { label: exec.status, badge: 'badge-muted' };
                return `
              <tr>
                <td class="font-mono">${escapeHtml(exec.case_id)}</td>
                <td><span class="badge ${statusInfo.badge}">${escapeHtml(statusInfo.label)}</span></td>
                <td>${escapeHtml(exec.executor)}</td>
                <td class="text-muted">${formatDuration(exec.duration_seconds)}</td>
                <td class="text-muted" style="max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(exec.failure_reason || '-')}</td>
              </tr>`;
              })
              .join('')}
          </tbody>
        </table>
      </div>`;
  }

  /** 创建计划 */
  async function doCreatePlan(): Promise<void> {
    const nameEl = document.getElementById('plan-name') as HTMLInputElement;
    const descEl = document.getElementById('plan-description') as HTMLTextAreaElement;
    const strategyEl = document.getElementById('plan-strategy') as HTMLSelectElement;
    const errorEl = document.getElementById('plan-name-error');

    const name = nameEl.value.trim();

    // 校验：计划名称必填
    if (!name) {
      if (errorEl) errorEl.style.display = 'block';
      return;
    }
    if (errorEl) errorEl.style.display = 'none';

    const btn = document.getElementById('plan-create-confirm') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = '创建中...';

    try {
      await createPlan({
        name,
        description: descEl.value.trim() || undefined,
        execution_strategy: strategyEl.value,
      });

      // 关闭弹窗
      document.getElementById('plan-modal')?.classList.remove('is-open');
      // 清空表单
      nameEl.value = '';
      descEl.value = '';
      strategyEl.value = 'sequential';
      // 刷新列表
      await loadPlans();
    } catch (err) {
      if (isAuthError(err)) return;
      const msg = err instanceof Error ? err.message : '网络异常';
      alert(`创建计划失败：${msg}`);
    } finally {
      btn.disabled = false;
      btn.textContent = '创建计划';
    }
  }

  // 绑定新建计划按钮
  document.getElementById('plan-create-confirm')?.addEventListener('click', doCreatePlan);

  // 新建计划弹窗打开时清空表单
  document.getElementById('new-plan-btn')?.addEventListener('click', () => {
    const nameEl = document.getElementById('plan-name') as HTMLInputElement;
    const descEl = document.getElementById('plan-description') as HTMLTextAreaElement;
    const strategyEl = document.getElementById('plan-strategy') as HTMLSelectElement;
    const errorEl = document.getElementById('plan-name-error');
    if (nameEl) nameEl.value = '';
    if (descEl) descEl.value = '';
    if (strategyEl) strategyEl.value = 'sequential';
    if (errorEl) errorEl.style.display = 'none';
  });

  // 初始化
  loadPlans();
</script>
