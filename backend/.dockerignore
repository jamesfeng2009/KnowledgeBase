# 版本控制
.git
.gitignore

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
venv/
.venv/
env/

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/
test-results/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 环境变量（敏感信息，不进镜像）
.env
.env.*
!.env.example

# 日志
logs/
*.log

# 数据库迁移版本（alembic 会自动生成）
# 保留 versions/ 目录，只忽略临时文件
*.sql

# Docker 自身文件
Dockerfile
docker-compose*.yml
.dockerignore

# 文档
*.md
docs/

# 训练/开发产物（体积大，不进运行时镜像）
# 模型权重由模型服务（vLLM/TEI）加载，不经后端镜像
models/
outputs/
.hf_cache/
