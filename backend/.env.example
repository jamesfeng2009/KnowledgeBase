# === .env 示例文件 ===
# 复制为 .env 并修改

# 应用
DEBUG=true
SECRET_KEY=change-me-in-production

# 数据库
DATABASE_URL=postgresql+asyncpg://ekb:ekb@localhost:5432/ekb

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ — Celery broker（消息磁盘级持久化）
BROKER_URL=amqp://guest:guest@localhost:5672//

# Celery result backend — RabbitMQ rpc（消息链路去 Redis；结果按任务一次性消费，
# 无跨请求轮询依赖，配合 task_ignore_result 避免 reply 队列堆积）
CELERY_RESULT_BACKEND=rpc://

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ekb-documents

# 部署模式
DEPLOY_MODE=saas  # saas / saas_dashscope / private_overseas / private_domestic

# C6 fix: 开放注册开关（SaaS 默认关闭，私有部署可设为 true）
REGISTRATION_ENABLED=false

# SaaS 模式 API Keys（saas 模式用）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# SaaS·国内模式（saas_dashscope 模式用 — 通义千问，国内直连，Qwen-7B 免费）
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_LLM_MODEL=qwen-turbo
# DASHSCOPE_EMBED_MODEL=text-embedding-v3
# DASHSCOPE_EMBED_DIM=1024

# 私有部署模型服务
# VLLM_HOST=llm-server
# VLLM_PORT=8003
# VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# === LangFuse 可观测性 ===
# 项目锁定 langfuse v2 SDK，需配套自托管 v2 Server（见 infra/langfuse/docker-compose.langfuse.yml）
# 启动后访问 http://localhost:3000 注册账号 → 新建项目 → Settings → API Keys 获取下列 Key
# 未配置时自动降级为纯日志，不影响主流程
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=http://localhost:3100

# === TTS 语音合成 ===
# 基于 edge-tts（Microsoft Edge 在线 TTS，免费无 API Key）
# TTS_ENABLED=true
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE=+0%
# TTS_VOLUME=+0%

# === P2 跨模态向量检索（jina-clip-v2）===
# 启用后文档图片直接向量化入库，支持文本→图片跨模态检索
# CROSS_MODAL_ENABLED=false
# JINA_API_KEY=  # Jina AI API Key（免费额度）
# JINA_CLIP_MODEL=jina-clip-v2
# JINA_CLIP_DIM=1024

# === OA 连接器（审批流查询 / IT 服务台对接）===
# 启用且配置 API URL 后，MCP query_oa_approval / create_it_ticket 工具
# 走真实 OA 系统 API（Bearer 认证）；未启用时返回模拟数据（开发默认）
# CONNECTOR_OA_ENABLED=false
# CONNECTOR_OA_API_URL=https://oa.example.com
# CONNECTOR_OA_API_KEY=

# === 解析路由（P1.5 DOC_PARSER_ROUTE）===
# 由解析消融（evals/parse_ablation.py --selfcheck/真实引擎）的路由建议落地
# 默认 docling_default_conditional_mineru：Docling 主引擎，仅图片/纯扫描 PDF 升级 MinerU
# 备选 mineru_by_doc_complexity：复杂度评分达到阈值即升级 MinerU（需先跑消融标定）
# DOC_PARSER_ROUTE=docling_default_conditional_mineru
# DOC_PARSER_COMPLEXITY_THRESHOLD=0.6

# === P0 密级下推 strict 开关（回填完成后开启）===
# 默认 False（容忍模式）：OpenSearch 召回层用 should[terms, must_not exists]
#   子句 — 存量索引中无 classification 字段的旧文档放行到 Final Gate
#   （DB 权威复检兜底，安全性不变）；Milvus 路不下推密级。
# 回填完成后开启 True（strict 模式）：纯 terms / in [...] 白名单过滤。
# 开启前必须先运行：python scripts/backfill_index_classification.py
# CLASSIFICATION_PUSHDOWN_STRICT=false

# === P2 最小化部署降级开关（docker-compose.minimal.yml 配套）===
# 小规模私有部署（无 GPU / 单机 8GB+）不部署 Milvus 与 Neo4j 时，
# 按下列开关降级。完整部署无需设置（默认值即为完整版行为）。
# VECTOR_STORE=os_knn                # 向量检索走 OpenSearch k-NN（不部署 Milvus）
# GRAPH_SEARCH_ENABLED=false         # 不部署 Neo4j，图谱召回第四路关闭
# ENTITY_REGISTRY_ENABLED=false      # 实体/同义词扩展关闭（BM25 召回略降）
# CROSS_MODAL_ENABLED=false          # 跨模态检索关闭
# MEMORY_SIDECAR_ENABLED=false       # 记忆 sidecar 关闭
