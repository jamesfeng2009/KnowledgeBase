# === .env 示例文件 ===
# 复制为 .env 并修改

# 应用
DEBUG=true
SECRET_KEY=change-me-in-production

# 数据库
DATABASE_URL=postgresql+asyncpg://ekb:ekb@localhost:5432/ekb

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ekb-documents

# 部署模式
DEPLOY_MODE=saas  # saas / private_overseas / private_domestic

# SaaS 模式 API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# 私有部署模型服务
# VLLM_HOST=llm-server
# VLLM_PORT=8003
# VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# CORS
CORS_ORIGINS=["http://localhost:3000"]
