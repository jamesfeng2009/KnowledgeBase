# === .env 示例文件 ===
# 复制为 .env 并修改

# 应用
DEBUG=true
SECRET_KEY=change-me-in-production

# 数据库
DATABASE_URL=postgresql+asyncpg://ekb:ekb@localhost:5432/ekb

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ekb-documents

# 部署模式
DEPLOY_MODE=saas  # saas / saas_dashscope / private_overseas / private_domestic

# C6 fix: 开放注册开关（SaaS 默认关闭，私有部署可设为 true）
REGISTRATION_ENABLED=false

# SaaS 模式 API Keys（saas 模式用）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# SaaS·国内模式（saas_dashscope 模式用 — 通义千问，国内直连，Qwen-7B 免费）
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_LLM_MODEL=qwen-turbo
# DASHSCOPE_EMBED_MODEL=text-embedding-v3
# DASHSCOPE_EMBED_DIM=1024

# 私有部署模型服务
# VLLM_HOST=llm-server
# VLLM_PORT=8003
# VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# === LangFuse 可观测性 ===
# 未配置时自动降级为纯日志，不影响主流程
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# === TTS 语音合成 ===
# 基于 edge-tts（Microsoft Edge 在线 TTS，免费无 API Key）
# TTS_ENABLED=true
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE=+0%
# TTS_VOLUME=+0%

# === P2 跨模态向量检索（jina-clip-v2）===
# 启用后文档图片直接向量化入库，支持文本→图片跨模态检索
# CROSS_MODAL_ENABLED=false
# JINA_API_KEY=  # Jina AI API Key（免费额度）
# JINA_CLIP_MODEL=jina-clip-v2
# JINA_CLIP_DIM=1024
