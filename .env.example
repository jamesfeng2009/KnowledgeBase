# === Docker Compose 基础设施凭证示例 ===
# 复制为 .env 并在生产环境修改所有默认值。
# 以下变量在 docker-compose.yml 中通过 ${VAR:-default} 注入，
# 未设置时使用默认值；生产部署前请务必修改默认值，避免使用弱口令。

# PostgreSQL
POSTGRES_USER=ekb
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ekb

# MinIO（对象存储）
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# MinIO for Milvus（向量库内部对象存储，建议与主 MinIO 隔离）
MILVUS_MINIO_ROOT_USER=change-me-milvus-minio-user
MILVUS_MINIO_ROOT_PASSWORD=change-me-milvus-minio-password

# Neo4j（知识图谱）
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
